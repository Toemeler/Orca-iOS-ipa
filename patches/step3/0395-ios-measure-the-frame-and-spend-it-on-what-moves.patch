+// Adds its own lifetime to a counter, so that the six phases of the frame below
+// can be timed without a return path being able to skip one.
+namespace {
+struct OrcaIosPhaseTimer
+{
+    std::atomic<uint64_t> &total;
+    std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+    explicit OrcaIosPhaseTimer(std::atomic<uint64_t> &t) : total(t) {}
+    uint64_t elapsed_us() const
+    {
+        return (uint64_t) std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now() - t0).count();
+    }
+    ~OrcaIosPhaseTimer() { total += elapsed_us(); }
+};
+} // namespace
+
+// How many toolpath instances the next frame may submit.
+//
+// The measured cost of a full-detail frame on the 2.4 million segment preview
+// was 2.4 seconds, and none of it was a libvgcode rebuild - it is the single
+// glDrawArraysInstanced, 57.6 million vertices of it, which is past what a
+// tile-based GPU takes in one pass. Nothing about that number is predictable:
+// it depends on the model, on the device, on how much of the screen the scene
+// covers, and it is badly non-linear because once the tiler's parameter buffer
+// overruns the driver starts splitting the render. So the budget is measured
+// rather than chosen, and measured separately for the two states, whose targets
+// are twelve times apart.
+//
+// Climb by doubling, fall by calculation:
+//
+//   * a frame that fitted its target while still leaving detail undrawn may
+//     have room for more, so allow twice as much next time - which cannot
+//     overshoot by more than one frame's worth, and reaches any budget in a
+//     few frames;
+//   * a frame that overran gets no averaging. Its own cost per instance says
+//     directly how many instances would have fitted, and that is the new
+//     budget, applied at once.
+//
+// The climb stops on its own: once the budget exceeds the enabled count the
+// stride is 1 and the frame draws everything, so there is nothing left to ask
+// for. The test is against the enabled count and not against the budget,
+// because a stride is a whole number - at budget 100000 and 2401216 enabled the
+// stride is 25 and the frame draws 96049, which is forever just under its own
+// budget and would never have asked for more.
+static uint32_t orca_ios_next_detail_budget(bool moving, uint32_t stride_used, size_t enabled, uint64_t elapsed_us)
+{
+    static uint32_t moving_budget  = ORCA_IOS_INITIAL_INSTANCES;
+    static uint32_t settled_budget = ORCA_IOS_INITIAL_INSTANCES;
+
+    uint32_t       &budget = moving ? moving_budget : settled_budget;
+    const uint64_t  target = moving ? ORCA_IOS_MOVING_BUDGET_US : ORCA_IOS_SETTLED_BUDGET_US;
+
+    if (enabled > 0 && elapsed_us > 0) {
+        const uint32_t stride = std::max<uint32_t>(stride_used, 1);
+        const size_t   drawn  = (enabled + stride - 1) / stride;
+        if (elapsed_us > target) {
+            const double per  = double(elapsed_us) / double(drawn);
+            const double fits = double(target) / per;
+            budget = (uint32_t) std::clamp(fits, double(ORCA_IOS_MIN_INSTANCES), double(ORCA_IOS_MAX_INSTANCES));
+        }
+        else if (drawn < enabled)
+            budget = (uint32_t) std::clamp(uint64_t(budget) * 2,
+                                           uint64_t(ORCA_IOS_MIN_INSTANCES), uint64_t(ORCA_IOS_MAX_INSTANCES));
+    }
+    return budget;
+}
