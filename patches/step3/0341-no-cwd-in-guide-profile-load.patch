 namespace Slic3r { namespace GUI {
 
+// boost::filesystem::absolute(p) is absolute(p, current_path()) - the default
+// argument is evaluated whether or not p is already absolute - and iOS refuses
+// getcwd() outside the sandbox's working directory, so current_path() throws
+// boost::filesystem::filesystem_error there.
+//
+// Every use below is on a path that is already absolute (resources_dir(), or a
+// directory derived from it), so the call was a no-op that only ever cost a
+// getcwd. On an iPad it cost the whole first-launch experience: LoadProfileData
+// runs on its own thread, the exception aborted it before it could push the
+// vendor list into the setup wizard's web page, and the wizard sat on
+// "Loading......" for ever with nothing in the log but
+//
+//   LoadProfileData, error: boost::filesystem::current_path: Operation not
+//   permitted [system:1]
+//
+// Same defect and same fix as patches/step3/0339 in Preset.cpp.
+static boost::filesystem::path orca_absolute_no_cwd(const boost::filesystem::path &p)
+{
+    return p.is_absolute() ? p : boost::filesystem::absolute(p);
+}
+
 json m_ProfileJson;
 
 static wxString update_custom_filaments()
