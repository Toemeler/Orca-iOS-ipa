 void wxWebViewWebKit::LoadURL(const wxString& url)
 {
-    [m_webView loadRequest:[NSURLRequest requestWithURL:
-            [NSURL URLWithString:wxCFStringRef(url).AsNSString()]]];
+    NSURL* nsurl = [NSURL URLWithString:wxCFStringRef(url).AsNSString()];
+    NSURLRequest* request = [NSURLRequest requestWithURL:nsurl];
+
+#if defined(__WXOSX_IPHONE__)
+    // A file: page loaded with -loadRequest: gets read access to its own
+    // directory only, so a navigation to a sibling directory can be refused in
+    // silence - and OrcaSlicer's setup wizard needs exactly that hop, from
+    // web/guide/0/ (a "Loading......" splash) to web/guide/1/.
+    //
+    // -loadFileRequest:allowingReadAccessToURL: grants a directory and takes a
+    // request, so the query string survives; these URLs carry one
+    // (index.html?target=1&lang=en) and the page reads its target from it.
+    //
+    // Both paths are put through -stringByResolvingSymlinksInPath FIRST, and
+    // whatever comes out is what gets loaded and what gets granted. That method
+    // does not only follow symlinks, it also strips a leading /private - so
+    // resolving one side and not the other produced a file under
+    // /private/var/... granted read access to /var/..., which is not a prefix
+    // of it. WebKit then refused every page in the application and reported
+    // nothing: the load returns a navigation object and simply never arrives.
+    if ( [nsurl isFileURL] )
+    {
+        NSString* path = [[nsurl path] stringByResolvingSymlinksInPath];
+        if ( path != nil && [path length] > 0 )
+        {
+            NSURL* fileURL = [NSURL fileURLWithPath:path];
+            NSString* query = [nsurl query];
+            if ( query != nil && [query length] > 0 )
+            {
+                NSURLComponents* comps =
+                    [NSURLComponents componentsWithURL:fileURL
+                               resolvingAgainstBaseURL:NO];
+                comps.query = query;
+                if ( [comps URL] != nil )
+                    fileURL = [comps URL];
+            }
+
+            NSString* bundlePath =
+                [[[NSBundle mainBundle] bundlePath] stringByResolvingSymlinksInPath];
+
+            NSURL* readAccess;
+            if ( bundlePath != nil && [path hasPrefix:bundlePath] )
+                readAccess = [NSURL fileURLWithPath:bundlePath isDirectory:YES];
+            else
+                readAccess = [[fileURL URLByDeletingLastPathComponent]
+                                  URLByDeletingLastPathComponent];
+
+            NSURLRequest* fileRequest = [NSURLRequest requestWithURL:fileURL];
+
+            if ( [m_webView respondsToSelector:
+                     @selector(loadFileRequest:allowingReadAccessToURL:)] )
+            {
+                WKNavigation* nav = [m_webView loadFileRequest:fileRequest
+                                      allowingReadAccessToURL:readAccess];
+                if ( nav != nil )
+                {
+                    wxLogMessage("wx-ios webview: loadFileRequest %s (read access %s)",
+                                 wxCFStringRef::AsString([fileURL absoluteString]),
+                                 wxCFStringRef::AsString([readAccess path]));
+                    return;
+                }
+
+                wxLogMessage("wx-ios webview: loadFileRequest started nothing for %s"
+                             " - falling back to loadRequest",
+                             wxCFStringRef::AsString([fileURL absoluteString]));
+            }
+
+            request = fileRequest;
+        }
+    }
+#endif
+
+    [m_webView loadRequest:request];
 }
 
