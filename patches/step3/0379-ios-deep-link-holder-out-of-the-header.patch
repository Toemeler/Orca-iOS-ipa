+#if defined(__APPLE__) && !TARGET_OS_OSX
+// A deep link that arrived before the Plater existed. On iOS the usual way in
+// is a cold start - the user taps "Open in Bambu Studio" on MakerWorld in
+// Safari and iOS launches the app for the URL - so the link is nearly always
+// ahead of the window it needs. Replayed from post_init().
+//
+// DELIBERATELY NOT A MEMBER OF GUI_App. It was one, for exactly one build, and
+// it crashed the application at launch. Adding a conditionally compiled member
+// to GUI_App.hpp shifts the offset of every member declared after it, and
+// `app_config` sits 450 lines further down that class. Any translation unit
+// that did not agree about the new layout then read `app_config` from the
+// wrong offset and got a garbage pointer - which is how
+// PresetUpdater::priv::set_download_prefs came to hand a junk AppConfig* to
+// version_check_url() and SIGSEGV inside it, in a subsystem with nothing
+// whatsoever to do with deep links. GUI_App.hpp is included by several hundred
+// translation units and a one-shot launch value has no business in it. A
+// file-static costs nothing and cannot change anyone's layout.
+static wxString gs_ios_pending_open_url;
+#endif
+
 class MainFrame;
 
