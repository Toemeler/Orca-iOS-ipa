@@ -4158,6 +4158,28 @@ std::string& Sidebar::get_search_line()
 
 static std::map<std::string, std::string> printer_thumbnails = {};
 
+// boost::filesystem::absolute(p) is absolute(p, current_path()) - the default
+// second argument is evaluated even when p is already absolute - and on iOS
+// current_path() throws
+//
+//   boost::filesystem::current_path: Operation not permitted [system:1]
+//
+// because the process cannot getcwd() from the working directory it is started
+// on (see patch 0344, which stops taking that working directory in the first
+// place). Same defect and same fix as patches/step3/0339 in Preset.cpp and 0341
+// in WebGuideDialog.cpp; the path here is resources_dir()-derived and therefore
+// already absolute, so the cwd was never actually needed.
+//
+// This is the call that killed the app on the *second* launch and every launch
+// after it. The loop below is only reached once a printer model is selected and
+// its vendor profile is installed, so a fresh install first hit it when the
+// setup wizard finished - and from then on hit it while the main frame was
+// still coming up.
+static boost::filesystem::path orca_absolute_no_cwd(const boost::filesystem::path &p)
+{
+    return p.is_absolute() ? p : boost::filesystem::absolute(p);
+}
