+// ---------------------------------------------------------------------------
+// What was here, and why none of it worked
+// ---------------------------------------------------------------------------
+//
+// The previous implementation built a UIAlertView, called -show on it, and
+// then - without waiting for anything at all - returned wxID_CANCEL. Three
+// things were wrong with that, and any one of them is fatal:
+//
+//  1. UIAlertView has been deprecated since iOS 8 and does nothing on a modern
+//     system. Nothing appeared.
+//  2. Even if it had appeared, ShowModal() returned immediately, so the caller
+//     read its answer before the user could give one.
+//  3. The answer it read was always wxID_CANCEL, whatever the user would have
+//     said, and whatever buttons the dialog had been given.
+//
+// wxMessageBox() is what wx itself uses for wxLogError and wxLogMessage, and
+// it is what an application reaches for when it has a yes/no question. On this
+// port every one of those was silently answered "cancel" by a dialog nobody
+// ever saw.
+//
+// It is now a UIAlertController - the presentation that replaced UIAlertView,
+// and the one iOS actually draws - with a nested wxModalEventLoop underneath
+// it so that ShowModal() keeps the contract every caller is written against:
+// it does not return until the user has pressed something. The loop is the
+// same one wxDialog::ShowModal() runs (src/osx/dialog_osx.cpp), made real on
+// this port by the iphone wxModalEventLoop::OSXDoRun() implementation.
+
+// The controller a modal presentation has to be made from: the deepest one
+// that is not already presenting something, in the topmost window.
+//
+// BY WINDOW LEVEL. A wxDialog is its own UIWindow on this port and sits at
+// UIWindowLevelAlert + 1, above the application's frame at
+// UIWindowLevelNormal. An alert presented from the frame would be drawn inside
+// the frame's window - underneath every dialog on screen - and the loop below
+// would then be waiting on a button nobody can reach.
+static UIViewController* wxOSXIPhoneAlertPresenter()
+{
+    UIWindow* best = nil;
+
+    for ( UIScene* scene in [[UIApplication sharedApplication] connectedScenes] )
+    {
+        if ( ![scene isKindOfClass:[UIWindowScene class]] )
+            continue;
+        for ( UIWindow* w in ((UIWindowScene*) scene).windows )
+        {
+            if ( w.hidden || w.alpha <= 0.01 || w.rootViewController == nil )
+                continue;
+            if ( !w.userInteractionEnabled )
+                continue;           // the dim backdrop behind a dialog
+            if ( best == nil || w.windowLevel >= best.windowLevel )
+                best = w;
+        }
+    }
+
+    UIViewController* vc = best.rootViewController;
+    while ( vc != nil && vc.presentedViewController != nil &&
+            !vc.presentedViewController.isBeingDismissed )
+        vc = vc.presentedViewController;
+
+    return vc;
+}
+
+// One presentation's state, shared between the rows' handlers, the watchdog
+// and the loop.
+//
+// AN OBJECTIVE-C OBJECT AND NOT A C++ ONE, for a reason that decides whether
+// this leaks: UIAlertAction copies its handler block, and copying a block
+// retains every Objective-C object it captured. So the state lives exactly as
+// long as the actions and the alert do, and is freed with them - including the
+// actions belonging to buttons that were never pressed, which is precisely the
+// case a hand-rolled reference count gets wrong.
+@interface wxOSXAlertBox : NSObject
+{
+@public
+    wxEventLoopBase* loop;      // not owned; valid only while Run() is on the stack
+    int              code;
+    BOOL             chosen;    // a row's handler has run
+    BOOL             finished;  // the loop has been told
+}
+@end
+
+@implementation wxOSXAlertBox
+@end
+
+static void wxOSXAlertFinish(wxOSXAlertBox* box, int code)
+{
+    if ( box->finished )
+        return;
+    box->finished = YES;
+    box->code     = code;
+    if ( box->loop != nullptr && box->loop->IsRunning() )
+        box->loop->Exit(code);
+}
+
+// The watchdog. An alert that leaves the screen without a row being chosen
+// would strand the loop below with nothing left to end it - the application
+// stopped, waiting on a button that is not there. An alert-style
+// UIAlertController cannot be dismissed by tapping outside it, so this should
+// be unreachable; a presenting controller can still be torn down underneath
+// one, and a hang is not an acceptable outcome for a case that cannot happen.
+static void wxOSXAlertWatch(UIAlertController* ac, wxOSXAlertBox* box, int misses)
+{
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t) (0.75 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+        if ( box->finished || box->chosen )
+            return;
+        // Two consecutive misses, so that the gap between -present… being
+        // called and the presentation taking effect is not read as one.
+        const bool gone = ac.presentingViewController == nil;
+        if ( gone && misses >= 1 )
+        {
+            wxLogDebug("wx-ios: message dialog went away with no button chosen");
+            wxOSXAlertFinish(box, wxID_CANCEL);
+            return;
+        }
+        wxOSXAlertWatch(ac, box, gone ? misses + 1 : 0);
+    });
+}
