+// detail is only affordable if it is drawn once; these name whatever is asking
+// for it again.
+extern std::atomic<unsigned> orca_ios_dirty_toolbar;
+extern std::atomic<unsigned> orca_ios_dirty_notifications;
+extern std::atomic<unsigned> orca_ios_dirty_imgui;
