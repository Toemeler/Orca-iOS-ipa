+// Where that pointer, finger or pencil last was, in screen coordinates. See
+// the long comment on the declaration in wx/osx/iphone/private.h: this is what
+// wxGetMousePosition() and wxGetMouseState() answer from, and a great deal
+// more of an application depends on those than one would expect.
+WXDLLIMPEXP_DATA_CORE(wxOSXIPhonePointerState) g_wxOSXIPhonePointer;
+
+// "Screen" here is what wxNonOwnedWindowIPhoneImpl::WindowToScreen() produces,
+// because that is what every wx coordinate conversion on this port goes
+// through: the point in the window's own space, then converted out of the
+// window into the fixed coordinate space. A point recorded any other way would
+// not survive a round trip through wxWindow::ScreenToClient().
+void wxOSXIPhoneRecordPointerPosition( WXWidget widget, CGPoint inView )
+{
+    UIView* const view = (UIView*) widget;
+    if ( view == nil )
+        return;
+
+    UIWindow* const window = view.window;
+    if ( window == nil )
+        return;     // not on screen: there is no screen point to record
+
+    CGPoint p = [view convertPoint:inView toView:nil];
+    p = [window convertPoint:p toWindow:nil];
+
+    g_wxOSXIPhonePointer.pos = wxPoint((int) lround(p.x), (int) lround(p.y));
+}
+
+// The buttons and modifiers of the event about to be sent. Kept beside the
+// position so that wxGetMouseState() describes one consistent moment.
+static void wxOSXIPhoneRecordPointerState( const wxMouseEvent& wxevent )
+{
+    g_wxOSXIPhonePointer.leftDown    = wxevent.m_leftDown;
+    g_wxOSXIPhonePointer.middleDown  = wxevent.m_middleDown;
+    g_wxOSXIPhonePointer.rightDown   = wxevent.m_rightDown;
+    g_wxOSXIPhonePointer.shiftDown   = wxevent.m_shiftDown;
+    g_wxOSXIPhonePointer.controlDown = wxevent.m_rawControlDown;
+    g_wxOSXIPhonePointer.altDown     = wxevent.m_altDown;
+    g_wxOSXIPhonePointer.cmdDown     = wxevent.m_controlDown;
+}
