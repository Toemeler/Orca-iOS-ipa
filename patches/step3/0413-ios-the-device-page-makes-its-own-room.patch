+
 class Tabbook: public wxBookCtrlBase
 {
 public:
@@ -385,8 +396,26 @@ protected:
     virtual void DoSize() override
     {
         wxWindow* const page = GetCurrentPage();
-        if (page)
-            page->SetSize(GetPageRect());
+        if (page == nullptr)
+            return;
+#if defined(__APPLE__) && !TARGET_OS_OSX
+        // ONLY THE PAGE MOVES DOWN.
+        //
+        // The floating tab bar covers the top of the window, and this book's
+        // page lays its own header - Camera, Control, Printer Parts - straight
+        // across it. Insetting the whole Device page pushed the vertical strip
+        // of tabs beside it down as well, and that strip has nothing above it:
+        // the bar is centred and the strip is at the leading edge. So the inset
+        // goes on the page rect alone. m_bookctrl is positioned by the sizer
+        // and keeps the top.
+        wxRect r = GetPageRect();
+        const int inset = Slic3r::GUI::orca_ios_tab_bar_inset();
+        r.y      += inset;
+        r.height -= inset;
+        page->SetSize(r);
+#else
+        page->SetSize(GetPageRect());
+#endif
     }
 
     virtual void DoShowPage(wxWindow * page, bool show) override
