+// -- something was dropped on the window ------------------------------------
+//
+// The desktop's answer to this is PlaterDropTarget, a wxFileDropTarget on the
+// 3D canvas: it exists only there, and it always means "add to what is open".
+// Neither half of that is right here. A drop on iPadOS comes from the Files
+// app, from Safari, from another application's share sheet, and it lands
+// wherever the finger let go of it - which is most often not the plate,
+// because the plate is one of five pages. So the whole window takes drops
+// (patch 0431) and what the drop MEANS is read off the page it landed on:
+//
+//   Prepare, Preview   the model joins the project that is open
+//   Home, Device, …    there is nothing to join, so it gets a project of
+//                      its own, and the application goes there to show it
+//   any .3mf           a project, always, whatever page it landed on - a 3MF
+//                      *is* a project, with its plates, its presets and its
+//                      settings, and merging one into another silently throws
+//                      all of that away
+//
+// The files themselves have already been copied into Documents by the time
+// this is called: what the drop hands over is a URL that is only valid for
+// the length of the callback.
+namespace {
+std::vector<std::string> gs_orca_dropped;
+
+bool orca_ios_is_gcode(const std::string &path)
+{
+    return boost::iends_with(path, ".gcode") || boost::iends_with(path, ".g");
+}
+} // namespace
+
+void orca_ios_drop_begin() { gs_orca_dropped.clear(); }
+
+void orca_ios_drop_add(const char *path)
+{
+    if (path != nullptr && *path != '\0')
+        gs_orca_dropped.emplace_back(path);
+}
+
+void orca_ios_drop_commit()
+{
+    if (gs_orca_dropped.empty())
+        return;
+    const std::vector<std::string> files = gs_orca_dropped;
+    gs_orca_dropped.clear();
+
+    // Deferred, like everything else that arrives from UIKit: this runs inside
+    // the drop interaction's completion, and load_project() can put a modal
+    // window up.
+    wxGetApp().CallAfter([files] {
+        MainFrame *const mf     = wxGetApp().mainframe;
+        Plater    *const plater = wxGetApp().plater();
+        if (mf == nullptr || plater == nullptr)
+            return;
+
+        const int page = mf->m_tabpanel != nullptr ? mf->m_tabpanel->GetSelection() : -1;
+        const bool on_plate = page == MainFrame::tp3DEditor || page == MainFrame::tpPreview;
+
+        std::string   project;      // the first 3MF, if any was dropped
+        wxArrayString others;
+        bool          gcode = false;
+        for (const std::string &f : files) {
+            if (boost::iends_with(f, ".3mf") && project.empty())
+                project = f;
+            else {
+                gcode = gcode || orca_ios_is_gcode(f);
+                others.Add(from_u8(f));
+            }
+        }
+
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-drop: " << files.size() << " file(s) on page "
+                                 << page << ", project=" << project
+                                 << ", others=" << others.GetCount();
+
+        if (!project.empty()) {
+            if (!wxGetApp().can_load_project())
+                return;
+            plater->load_project(from_u8(project));
+        } else if (!on_plate) {
+            // skip_confirm: 0428 established that there is nothing to confirm
+            // on this port - the project on screen is already on disk, twice.
+            plater->new_project(true);
+        }
+
+        if (!others.IsEmpty())
+            plater->load_files(others);
+
+        // A G-code file takes itself to the preview; anything else belongs on
+        // the plate, and a drop that appears to do nothing because the page
+        // did not change is the whole feature failing quietly.
+        if (!gcode && !on_plate)
+            mf->select_tab(size_t(MainFrame::tp3DEditor));
+    });
+}
