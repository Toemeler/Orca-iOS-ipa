diff --git a/src/slic3r/GUI/MainFrame.cpp b/src/slic3r/GUI/MainFrame.cpp
index d1c915d61..df45bf30e 100644
--- a/src/slic3r/GUI/MainFrame.cpp
+++ b/src/slic3r/GUI/MainFrame.cpp
@@ -1003,9 +1003,39 @@ DPIFrame(NULL, wxID_ANY, "", wxDefaultPosition, wxDefaultSize, BORDERLESS_FRAME_
 
         this->Bind(wxEVT_TIMER, [timer, driving](wxTimerEvent &) {
             if (!driving) {
-                // A device build only wants the one dump.
-                orca_ios_dump_all_windows("20s after MainFrame");
-                timer->Stop();
+                // One dump 20 s in is a picture of an empty shell: on a first
+                // launch the setup wizard is still up and no preset exists yet.
+                // Take three, and turn the log up once startup is behind us.
+                static int tick = 0;
+                ++tick;
+                if (tick == 1) {
+                    // The reason for the clamp is over. 0341 pins iOS to
+                    // "warning" because a first launch at "info" writes 49 MB in
+                    // 61 s, almost all of it the wizard's profile JSON - which
+                    // is long finished by now. Everything from here on is the
+                    // user importing, slicing and talking to the printer, and
+                    // that is exactly what we have been unable to see.
+                    //
+                    // Deliberately debug and not trace: glsafe() calls
+                    // glGetError() after every GL call and only reports at
+                    // level 5, so trace adds a driver round trip per call
+                    // inside the render loop. Ask for trace explicitly, in
+                    // Documents/orca-log-level.txt, when that is what is
+                    // wanted - the check below only ever raises the level, so
+                    // it will not undo it.
+                    if (Slic3r::get_logging_level() < 4) {
+                        Slic3r::set_logging_level(4);
+                        BOOST_LOG_TRIVIAL(error)
+                            << "orca-ios-log: startup done, level raised to debug"
+                               " (Documents/orca-log-level.txt overrides; 'trace' also turns on OpenGL error checking)";
+                    }
+                    orca_ios_dump_all_windows("30s after MainFrame");
+                } else if (tick == 2) {
+                    orca_ios_dump_all_windows("60s after MainFrame");
+                } else if (tick >= 5) {
+                    orca_ios_dump_all_windows("150s after MainFrame");
+                    timer->Stop();
+                }
                 return;
             }
             orca_ios_drive_step(s_orca_ios_drive_step);
@@ -1013,8 +1043,8 @@ DPIFrame(NULL, wxID_ANY, "", wxDefaultPosition, wxDefaultSize, BORDERLESS_FRAME_
                 timer->Stop();
         }, timer->GetId());
 
-        timer->Start(driving ? 10000 : 20000, driving ? wxTIMER_CONTINUOUS
-                                                      : wxTIMER_ONE_SHOT);
+        // 30 s ticks on a device: dumps at 30, 60 and 150 seconds.
+        timer->Start(driving ? 10000 : 30000, wxTIMER_CONTINUOUS);
     }
 #endif // __WXOSX_IPHONE__
 }
