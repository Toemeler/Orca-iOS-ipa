 std::atomic<uint64_t> orca_ios_canvas_gcode_us{0};
 std::atomic<uint64_t> orca_ios_canvas_swap_us{0};
 
+// Is the user moving the view right now?
+//
+// Patch 0390 answered this for the layer and moves sliders only, because at the
+// time the slider was the only thing known to make a frame expensive. It is not:
+// the toolpath draw costs the same whether the camera is being orbited, the
+// scene panned or a slider dragged, and all three want the same answer - draw
+// something cheaper until the motion stops, then draw it properly.
+//
+// So there is one clock for all of them. Anything that changes what the frame
+// looks like stamps it; anyone deciding how much detail to draw asks whether it
+// was stamped recently. 250 ms of quiet is "stopped" - long enough that a drag
+// with a pause in it does not flicker between detail levels, short enough that
+// letting go feels immediate.
+static std::atomic<uint64_t> orca_ios_last_interaction_us{0};
+
+static uint64_t orca_ios_steady_us()
+{
+    return (uint64_t) std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+void orca_ios_note_interaction()
+{
+    orca_ios_last_interaction_us.store(orca_ios_steady_us());
+}
+
+bool orca_ios_is_interacting()
+{
+    const uint64_t last = orca_ios_last_interaction_us.load();
+    if (last == 0)
+        return false;
+    return orca_ios_steady_us() - last < 250000;
+}
