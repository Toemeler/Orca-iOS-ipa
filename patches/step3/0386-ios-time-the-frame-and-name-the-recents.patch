+// Where the frame goes, in microseconds.
+//
+// "render +109" and "render +4" in the same session say the frame cost moved
+// by two orders of magnitude, and nothing said why. A 2.4 million segment
+// preview - measured, orca-ios-preview - is heavy to draw once; it is heavy
+// twice if the picking pass draws it again, and the picking pass ends in
+// glReadPixels, which stalls the CPU until the GPU has finished everything
+// queued. That is the difference between a slow frame and a frozen one, and
+// these three numbers tell them apart.
+std::atomic<uint64_t> orca_ios_canvas_render_us{0};
+std::atomic<uint64_t> orca_ios_canvas_pick_us{0};
+std::atomic<uint64_t> orca_ios_canvas_render_max_us{0};
+
+namespace {
+// Adds its own lifetime to a counter. A scope guard rather than a pair of
+// calls because GLCanvas3D::render() has several early returns.
+struct OrcaIosScopedTimer
+{
+    std::atomic<uint64_t> &total;
+    std::atomic<uint64_t> *high_water;
+    std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+
+    explicit OrcaIosScopedTimer(std::atomic<uint64_t> &t, std::atomic<uint64_t> *hw = nullptr)
+        : total(t), high_water(hw) {}
+
+    ~OrcaIosScopedTimer()
+    {
+        const uint64_t us = (uint64_t) std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now() - t0).count();
+        total += us;
+        if (high_water != nullptr) {
+            uint64_t prev = high_water->load();
+            while (us > prev && !high_water->compare_exchange_weak(prev, us)) {}
+        }
+    }
+};
+} // namespace
