+    { reinterpret_cast<void **>(&glad_glProgramParameteri),          "glProgramParameteri" },
+    { reinterpret_cast<void **>(&glad_glReleaseShaderCompiler),      "glReleaseShaderCompiler" },
+    { reinterpret_cast<void **>(&glad_glResumeTransformFeedback),    "glResumeTransformFeedback" },
+    { reinterpret_cast<void **>(&glad_glSamplerParameterf),          "glSamplerParameterf" },
+    { reinterpret_cast<void **>(&glad_glSamplerParameterfv),         "glSamplerParameterfv" },
+    { reinterpret_cast<void **>(&glad_glSamplerParameteri),          "glSamplerParameteri" },
+    { reinterpret_cast<void **>(&glad_glSamplerParameteriv),         "glSamplerParameteriv" },
+    { reinterpret_cast<void **>(&glad_glShaderBinary),               "glShaderBinary" },
+    { reinterpret_cast<void **>(&glad_glTexStorage2D),               "glTexStorage2D" },
+    { reinterpret_cast<void **>(&glad_glTexStorage3D),               "glTexStorage3D" },
+    { reinterpret_cast<void **>(&glad_glUniformBlockBinding),        "glUniformBlockBinding" },
+    { reinterpret_cast<void **>(&glad_glVertexAttribDivisor),        "glVertexAttribDivisor" },
+    { reinterpret_cast<void **>(&glad_glWaitSync),                   "glWaitSync" },
+};
