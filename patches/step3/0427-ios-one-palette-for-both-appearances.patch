+//
+// A dynamic colour rather than two: UIKit resolves it against whatever
+// appearance the view is drawn in, so a switch needs nothing re-set here.
+static UIColor *orca_ios_tone(unsigned light, unsigned dark)
+{
+    const CGFloat lr = ((light >> 16) & 0xFF) / 255.0, lg = ((light >> 8) & 0xFF) / 255.0,
+                  lb = (light & 0xFF) / 255.0;
+    const CGFloat dr = ((dark >> 16) & 0xFF) / 255.0, dg = ((dark >> 8) & 0xFF) / 255.0,
+                  db = (dark & 0xFF) / 255.0;
+    return [[UIColor colorWithDynamicProvider:^UIColor *(UITraitCollection *traits) {
+        return traits.userInterfaceStyle == UIUserInterfaceStyleDark
+                   ? [UIColor colorWithRed:dr green:dg blue:db alpha:1]
+                   : [UIColor colorWithRed:lr green:lg blue:lb alpha:1];
+    }] retain];
