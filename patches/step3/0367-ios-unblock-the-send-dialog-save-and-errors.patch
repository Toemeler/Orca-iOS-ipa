+// Never swallow a real error just because its description is missing.
+//
+// Every lookup below returns an empty string when the tables have no entry for
+// the code, and the device page renders that as nothing at all - so a printer
+// that has genuinely stopped looks the same as one that is fine. The tables
+// only ship for four device types (093, 094, 22E and 239) and are otherwise
+// downloaded, so any other printer - an A1 reports 039 - has no text offline.
+// The code itself is still worth showing: it is what the wiki and the support
+// pages are indexed by.
+static wxString orca_ios_bare_code(const std::string& code)
+{
+    return wxString::Format(_L("Printer reported %s.\n\nNo description is available for this "
+                               "code - the message tables for this printer model could not be "
+                               "downloaded. Search the code on the Bambu Lab wiki for details."),
+                            wxString::FromUTF8(code));
+}
+#endif
