+
+// ---------------------------------------------------------------------------
+// The busy overlay
+// ---------------------------------------------------------------------------
+//
+// wxBusyInfo is a wxFrame on every other port: a small window with a border
+// and a piece of static text in it, put up before a long operation and taken
+// down after. On this one every top level window is a UIWindow of its own, so
+// what that produces is a grey four-hundred-point rectangle floating at normal
+// window level - underneath every dialog on screen, in a style belonging to no
+// platform, and with no way for the system to know it should not be a separate
+// entry in the app switcher. It is replaced here by the thing iOS puts up
+// while it is working: a rounded material card with a spinner in it, over a
+// dimmed backdrop.
+//
+// IT CANNOT BE A PRESENTED VIEW CONTROLLER, and that constraint is what shapes
+// everything below. A wxBusyInfo goes up immediately before the main thread
+// stops answering - that is the entire purpose of it - and a presentation, even
+// an unanimated one, only reaches the screen when the run loop next turns.
+// It never would: the caller's next statement is the long operation. So this
+// is a plain view added straight to the window, laid out by hand in one pass,
+// and pushed to the render server with -[CATransaction flush] before the
+// function returns. The spinner keeps turning for the same reason a spinner in
+// a launch screen does - Core Animation runs it out of process, and does not
+// need the thread that started it.
+
+@interface wxOSXBusyOverlay : UIView
+{
+@public
+    UIVisualEffectView* card;
+    UIActivityIndicatorView* spinner;
+    UILabel* headline;
+    UILabel* message;
+}
+@end
+
+@implementation wxOSXBusyOverlay
+
+// Each of the four is created with +alloc and handed to a superview, so the
+// overlay owns one reference to each and has to give it back. Without this the
+// card, the spinner and both labels outlive every busy info this port shows.
+- (void)dealloc
+{
+    [message release];
+    [headline release];
+    [spinner release];
+    [card release];
+    [super dealloc];
+}
+
+- (void)layoutSubviews
+{
+    [super layoutSubviews];
+
+    const CGFloat inset = 22;
+
+    CGFloat width = self.bounds.size.width - 80;
+    if ( width > 360 )
+        width = 360;
+    if ( width < 200 )
+        width = self.bounds.size.width - 32;
+
+    const CGFloat contentWidth = width - 2 * inset;
+    const CGSize  room = CGSizeMake(contentWidth, CGFLOAT_MAX);
+
+    const CGSize spinnerSize = [spinner sizeThatFits:room];
+    CGSize headSize = CGSizeZero;
+    CGSize bodySize = CGSizeZero;
+
+    if ( headline.text.length != 0 )
+        headSize = [headline sizeThatFits:room];
+    if ( message.text.length != 0 )
+        bodySize = [message sizeThatFits:room];
+
+    CGFloat height = inset + spinnerSize.height + inset;
+    if ( headSize.height > 0 )
+        height += headSize.height + 12;
+    if ( bodySize.height > 0 )
+        height += bodySize.height + 8;
+
+    card.frame = CGRectMake(floor((self.bounds.size.width  - width)  / 2),
+                            floor((self.bounds.size.height - height) / 2),
+                            width, height);
+
+    CGFloat y = inset;
+    spinner.frame = CGRectMake(floor((width - spinnerSize.width) / 2), y,
+                               spinnerSize.width, spinnerSize.height);
+    y += spinnerSize.height;
+
+    if ( headSize.height > 0 )
+    {
+        y += 12;
+        headline.frame = CGRectMake(inset, y, contentWidth, headSize.height);
+        y += headSize.height;
+    }
+    if ( bodySize.height > 0 )
+    {
+        y += 8;
+        message.frame = CGRectMake(inset, y, contentWidth, bodySize.height);
+    }
+}
+
+@end
+
+// Puts the overlay up and returns the handle wxBusyInfo holds on to, or null
+// when there is no window to put it in - in which case the caller falls back
+// to the frame it would have built anyway. Never a partial result: an overlay
+// that is returned is on screen.
+//
+// src/generic/busyinfo.cpp.
+void* wxOSXIPhoneBusyInfoShow(const wxString& title, const wxString& text)
+{
+    if ( !wxThread::IsMain() )
+        return nullptr;
+
+    UIWindow* const window = wxOSXIPhoneTopWindow();
+    if ( window == nil )
+        return nullptr;
+
+    wxOSXBusyOverlay* const overlay =
+        [[wxOSXBusyOverlay alloc] initWithFrame:window.bounds];
+    if ( overlay == nil )
+        return nullptr;
+
+    overlay.autoresizingMask =
+        UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+    overlay.backgroundColor = [UIColor colorWithWhite:0 alpha:0.24];
+    // Every touch, and nothing done with any of them. The application is about
+    // to stop answering: a tap that lands during that would be delivered when
+    // it starts again, to a screen that has meanwhile changed underneath the
+    // finger, which is exactly the class of accident this stands in the way of.
+    overlay.userInteractionEnabled = YES;
+
+    UIVisualEffect* material = nil;
+#if defined(__IPHONE_OS_VERSION_MAX_ALLOWED) && __IPHONE_OS_VERSION_MAX_ALLOWED >= 260000
+    if ( @available(iOS 26.0, *) )
+        material = [[[UIGlassEffect alloc] init] autorelease];
+#endif
+    if ( material == nil )
+        material = [UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemThickMaterial];
+
+    overlay->card = [[UIVisualEffectView alloc] initWithEffect:material];
+    overlay->card.layer.cornerRadius = 26;
+    overlay->card.layer.cornerCurve  = kCACornerCurveContinuous;
+    overlay->card.clipsToBounds      = YES;
+    [overlay addSubview:overlay->card];
+
+    overlay->spinner = [[UIActivityIndicatorView alloc]
+                           initWithActivityIndicatorStyle:UIActivityIndicatorViewStyleLarge];
+    [overlay->spinner startAnimating];
+    [overlay->card.contentView addSubview:overlay->spinner];
+
+    overlay->headline               = [[UILabel alloc] initWithFrame:CGRectZero];
+    overlay->headline.font          = [UIFont preferredFontForTextStyle:UIFontTextStyleHeadline];
+    overlay->headline.adjustsFontForContentSizeCategory = YES;
+    overlay->headline.textColor     = [UIColor labelColor];
+    overlay->headline.textAlignment = NSTextAlignmentCenter;
+    overlay->headline.numberOfLines = 2;
+    if ( !title.empty() )
+    {
+        wxCFStringRef cfTitle( title );
+        overlay->headline.text = cfTitle.AsNSString();
+    }
+    [overlay->card.contentView addSubview:overlay->headline];
+
+    overlay->message               = [[UILabel alloc] initWithFrame:CGRectZero];
+    overlay->message.font          = [UIFont preferredFontForTextStyle:UIFontTextStyleSubheadline];
+    overlay->message.adjustsFontForContentSizeCategory = YES;
+    overlay->message.textColor     = [UIColor secondaryLabelColor];
+    overlay->message.textAlignment = NSTextAlignmentCenter;
+    overlay->message.numberOfLines = 4;
+    overlay->message.lineBreakMode = NSLineBreakByTruncatingMiddle;
+    if ( !text.empty() )
+    {
+        wxCFStringRef cfText( text );
+        overlay->message.text = cfText.AsNSString();
+    }
+    [overlay->card.contentView addSubview:overlay->message];
+
+    [window addSubview:overlay];
+    [window bringSubviewToFront:overlay];
+
+    [overlay setNeedsLayout];
+    [overlay layoutIfNeeded];
+    [CATransaction flush];
+
+    return overlay;
+}
+
+// src/generic/busyinfo.cpp.
+void wxOSXIPhoneBusyInfoUpdate(void* handle, const wxString& text)
+{
+    if ( handle == nullptr || !wxThread::IsMain() )
+        return;
+
+    wxOSXBusyOverlay* const overlay = (wxOSXBusyOverlay*) handle;
+
+    wxCFStringRef cfText( text );
+    overlay->message.text = text.empty() ? @"" : cfText.AsNSString();
+
+    [overlay setNeedsLayout];
+    [overlay layoutIfNeeded];
+    [CATransaction flush];
+}
+
+// src/generic/busyinfo.cpp.
+void wxOSXIPhoneBusyInfoHide(void* handle)
+{
+    if ( handle == nullptr )
+        return;
+
+    wxOSXBusyOverlay* const overlay = (wxOSXBusyOverlay*) handle;
+
+    if ( !wxThread::IsMain() )
+    {
+        // A wxBusyInfo destroyed off the main thread is a bug in the caller,
+        // but a view removed off the main thread is a crash in this one.
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [overlay removeFromSuperview];
+            [overlay release];
+        });
+        return;
+    }
+
+    [overlay removeFromSuperview];
+    [overlay release];
+    // The operation the overlay was covering has finished, and whatever the
+    // caller does next may well block again. Same reasoning as putting it up:
+    // it has to be gone before this returns, not at the next turn of the loop.
+    [CATransaction flush];
+}
