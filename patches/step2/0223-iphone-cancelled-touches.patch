--- a/src/osx/iphone/window.mm
+++ b/src/osx/iphone/window.mm
@@ -312,6 +312,26 @@
             gs_lastPointerButton = 0;
             break ;
 
+        case UITouchPhaseCancelled :
+            // A cancelled touch is still a release, and has to be reported as
+            // one. iOS cancels rather than ends whenever something else claims
+            // the sequence - a system edge gesture, an alert, or a scroll view
+            // deciding the drag was meant for it. Falling through to default
+            // and reporting nothing leaves the application holding a button the
+            // user let go of: wxWidgets keeps the mouse captured, OrcaSlicer
+            // keeps m_mouse.dragging set, and the 3D view stops responding for
+            // good while still drawing happily. The counters showed exactly
+            // that - "render +123 mouse +125" while it worked, then
+            // "render +1 mouse +0" with the finger still moving.
+            switch ( gs_lastPointerButton )
+            {
+                case 1 : wxevent.SetEventType( wxEVT_RIGHT_UP );  wxevent.SetRightDown(false);  break ;
+                case 2 : wxevent.SetEventType( wxEVT_MIDDLE_UP ); wxevent.SetMiddleDown(false); break ;
+                default: wxevent.SetEventType( wxEVT_LEFT_UP );   wxevent.SetLeftDown(false);   break ;
+            }
+            gs_lastPointerButton = 0;
+            break ;
+
         case UITouchPhaseMoved :
             wxevent.SetEventType( wxEVT_MOTION );
             switch ( gs_lastPointerButton )
@@ -501,6 +521,10 @@
     class_addMethod(c, @selector(touchesBegan:withEvent:), (IMP) wxOSX_touchEvent, "v@:@@");
     class_addMethod(c, @selector(touchesMoved:withEvent:), (IMP) wxOSX_touchEvent, "v@:@@");
     class_addMethod(c, @selector(touchesEnded:withEvent:), (IMP) wxOSX_touchEvent, "v@:@@");
+    // Without this the phase above is never seen: UIKit sends touchesCancelled:
+    // instead of touchesEnded:, and an unregistered selector means wx is never
+    // told the sequence finished at all.
+    class_addMethod(c, @selector(touchesCancelled:withEvent:), (IMP) wxOSX_touchEvent, "v@:@@");
     class_addMethod(c, @selector(becomeFirstResponder), (IMP) wxOSX_becomeFirstResponder, "c@:" );
     class_addMethod(c, @selector(resignFirstResponder), (IMP) wxOSX_resignFirstResponder, "c@:" );
 
--- a/src/osx/iphone/glcanvas.mm
+++ b/src/osx/iphone/glcanvas.mm
@@ -203,6 +203,31 @@
     SetPeer(c);
     MacPostControlCreate(pos, size) ;
 
+    // Keep a drag on this canvas out of the scroll views above it.
+    //
+    // wxUIView - what every wx pane is made of - is a UIScrollView subclass, so
+    // it comes with pan and pinch recognisers. A sustained drag across a GL
+    // canvas eventually reads as a scroll to one of the ancestors, and the
+    // moment it does that ancestor cancels the touches it had been forwarding
+    // and keeps every one after it. The canvas carries on rendering and never
+    // hears the finger again, which is a 3D view frozen for good.
+    //
+    // Only the ancestors of a GL canvas are treated this way, and only for
+    // touches that started inside one: a scrolled page still scrolls when
+    // dragged, because nothing here disables scrolling itself. Doing this in
+    // the generic pane constructor instead would have stopped every scrolled
+    // page in the application scrolling by drag, which is not a trade worth
+    // making for a fix aimed at the canvas.
+    for ( UIView* a = [v superview]; a != nil; a = [a superview] )
+    {
+        if ( [a isKindOfClass:[UIScrollView class]] )
+        {
+            UIScrollView* sv = (UIScrollView*) a;
+            sv.canCancelContentTouches = NO;
+            sv.delaysContentTouches    = NO;
+        }
+    }
+
     return true;
 }
 
