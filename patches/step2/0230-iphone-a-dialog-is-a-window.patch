@@ -109,6 +382,23 @@
 
 void wxNonOwnedWindowIPhoneImpl::WillBeDestroyed()
 {
+    // The title bar holds a raw pointer to the window it closes. A tap is
+    // dispatched to the next turn of the run loop, so it can outlive the tap
+    // that queued it - but never this call, which is the last moment the peer
+    // is known to be alive.
+    if ( m_macWindow != nil )
+    {
+        for ( UIView* v in [m_macWindow subviews] )
+        {
+            if ( [v isKindOfClass:[wxOSXDialogChrome class]] )
+                ((wxOSXDialogChrome*) v).peer = nullptr;
+        }
+        if ( gs_dialogWindows != nil )
+        {
+            [gs_dialogWindows removeObject:m_macWindow];
+            wxOSXUpdateDialogBackdrop(nil);
+        }
+    }
 }
 
