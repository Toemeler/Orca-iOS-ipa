 // Called from OpenGLManager::init_gl once the loader has run, before anything
 // renders.
 void orca_ios_install_gl_es_compat()
 {
+    // First the ES 3.0 core the desktop loader skipped over - these are real
+    // driver functions, so they must be filled in before any of the no-op
+    // stubs below could shadow one.
+    int filled = 0, still_null = 0;
+    for (const EsCoreEntry &entry : ES3_CORE_MISSED_BY_DESKTOP_LOADER) {
+        if (*entry.slot != nullptr)
+            continue;
+        *entry.slot = dlsym(RTLD_DEFAULT, entry.name);
+        if (*entry.slot != nullptr)
+            ++filled;
+        else {
+            ++still_null;
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-gl: no ES entry point for " << entry.name;
+        }
+    }
+    BOOST_LOG_TRIVIAL(error) << "orca-ios-gl: filled " << filled << " ES 3.0 core entry points the desktop loader skipped, "
+                             << still_null << " still null";
