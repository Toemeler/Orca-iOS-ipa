+    // Dial the printer, and keep dialling until the session is actually up.
+    //
+    // Selecting is what dials, and re-selecting a LAN machine tears the session
+    // down and starts over - which is why this used to happen exactly once. But
+    // that once was at launch, a few milliseconds after the local-network
+    // prompt went up: on a fresh install the only attempt ever made is the one
+    // made before the user has tapped Allow, and it cannot succeed. Nothing
+    // retried it, so the connection only appeared when something else selected
+    // the machine - and opening the Device tab is exactly that. Hence "it only
+    // connects when I go to the device tab".
+    //
+    // So ask the LAN agent whether the session is up, and dial again when it is
+    // not. Never on top of an attempt already in flight, and never twice inside
+    // six seconds: a connect runs on its own thread with a six second timeout,
+    // against a printer that may be asleep.
+    static wxDateTime s_last_dial;              // invalid until the first attempt
+    static bool       s_was_connected = false;
+
+    const bool connected  = bambu_lan_agent_is_connected();
+    const bool connecting = bambu_lan_agent_is_connecting();
