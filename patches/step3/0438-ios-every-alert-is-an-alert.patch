diff --git a/src/slic3r/GUI/ios_native_ui.hpp b/src/slic3r/GUI/ios_native_ui.hpp
new file mode 100644
index 000000000..2b318ee6f
--- /dev/null
+++ b/src/slic3r/GUI/ios_native_ui.hpp
@@ -0,0 +1,261 @@
+///|/ Copyright (c) 2026 Orca-iOS-ipa contributors
+///|/
+///|/ Orca-iOS-ipa is released under the terms of the AGPLv3 or higher
+///|/
+// The native side of everything in this application that pops up.
+//
+// Orca draws its own alerts, its own notifications and its own progress
+// windows, and on a desktop that is the right answer: they are wxDialogs and
+// ImGui windows over a wxFrame, and they look like the rest of the window they
+// came out of. On iPadOS none of it is: an alert is a UIAlertController, a
+// notification is a banner the system draws, and progress is a sheet - and an
+// application that draws its own is immediately recognisable as one that was
+// not written for the platform.
+//
+// This header is the whole of the interface between Orca's C++ and the UIKit
+// that stands in for it. Everything behind it is in
+//
+//   ios_native_ui.mm             - the presenter, and the alert bridge
+//   ios_native_notifications.mm  - the banner stack
+//   ios_native_progress.mm       - the progress sheet
+//
+// and nothing in Orca includes UIKit to reach any of it.
+//
+// EVERY DECLARATION HERE IS COMPILED OUT OFF iOS. The header is included by
+// files that build on all five platforms (MsgDialog.cpp, NotificationManager.
+// cpp), so the guard is what keeps those builds from seeing a single new
+// symbol. <wx/defs.h> comes first because __WXOSX_IPHONE__ is wx's, and wx
+// only defines it once its own platform header has run.
+
+#ifndef slic3r_GUI_ios_native_ui_hpp_
+#define slic3r_GUI_ios_native_ui_hpp_
+
+#include <wx/defs.h>
+
+#ifdef __WXOSX_IPHONE__
+
+#include <functional>
+#include <string>
+#include <vector>
+
+#include <wx/string.h>
+
+class wxDialog;
+class wxWindow;
+
+namespace Slic3r {
+namespace GUI {
+
+// ---------------------------------------------------------------------------
+// Alerts
+// ---------------------------------------------------------------------------
+
+// One row of a native alert, and the wx button it stands for.
+//
+// `widget` is what makes this a presentation of the dialog rather than a
+// replacement for it: choosing the row sends wxEVT_BUTTON to that button, so
+// whatever the dialog bound to it runs exactly as it would have on a desktop -
+// including the handlers that do more than EndModal(), which several dialogs
+// in this application have.
+struct IOSAlertButton
+{
+    wxString  label;
+    int       id          = 0;        // wxID_OK, wxID_CANCEL, a custom id, …
+    wxWindow *widget      = nullptr;  // the wx button, or null for a plain row
+    bool      preferred   = false;    // drawn bold; Return chooses it
+    bool      cancel      = false;    // the row iOS puts last and Escape chooses
+    bool      destructive = false;    // drawn red
+    bool      enabled     = true;
+    // Run on the GUI thread just before `widget` is clicked, for the rows that
+    // are not a button of the dialog's at all: the "don't show again" tick,
+    // which has to be set before the affirmative button acts on it, and the
+    // hyperlink, which has no button to click afterwards but does have a page
+    // to open. Empty for an ordinary row.
+    std::function<void()> before;
+};
+
+// A text field inside the alert. UIAlertController is the one presentation on
+// this platform that can carry them, which is why the rename/new-name prompts
+// do not need a sheet of their own.
+struct IOSAlertField
+{
+    wxString    placeholder;
+    wxString    value;
+    bool        secure   = false;
+    bool        numeric  = false;
+    // Filled in with what the field held when a row was chosen.
+    wxString   *out      = nullptr;
+};
+
+// Presents `buttons` as a UIAlertController over whatever is frontmost, runs a
+// nested wx modal event loop, and returns once a row has been chosen - which
+// is the contract wxDialog::ShowModal() has, so a caller cannot tell the two
+// apart.
+//
+// Returns false, having shown nothing and run no loop, when there is no
+// controller to present from or UIKit refuses the presentation. The caller
+// must then fall back to the wx dialog: a dialog that fails to appear is worse
+// than one that appears in the wrong style.
+//
+// `dlg` is the dialog the alert stands in for. It is never shown, but it is
+// still the object the buttons belong to and the object whose return code the
+// caller reads afterwards, so it is kept alive and its return code is set.
+bool orca_ios_alert_run(wxDialog                          *dlg,
+                        const wxString                    &title,
+                        const wxString                    &message,
+                        const std::vector<IOSAlertButton> &buttons,
+                        std::vector<IOSAlertField>        *fields,
+                        int                               *result);
+
+// The same alert, presented and returned from immediately, for the windows in
+// this application that are modeless: SecondaryCheckDialog is a wxFrame that
+// posts an event when a button is pressed and never waits for one. The row's
+// wxEVT_BUTTON is sent when it is chosen, a turn of the run loop later.
+bool orca_ios_alert_post(wxWindow                          *owner,
+                         const wxString                    &title,
+                         const wxString                    &message,
+                         const std::vector<IOSAlertButton> &buttons);
+
+// Takes down an alert posted by orca_ios_alert_post() for this owner, if one
+// is still up. A modeless window is entitled to be hidden by something other
+// than its own buttons - SecondaryCheckDialog is hidden by the printer going
+// away, by the job finishing, by the page being left - and the alert standing
+// in for it has to go at the same moment.
+void orca_ios_alert_dismiss(wxWindow *owner);
+
+// True while an alert put up by either of the two above is on screen. The
+// notification banners read it: a banner sliding in over an alert is the one
+// place UIKit will happily draw two things that both want to be frontmost.
+bool orca_ios_alert_is_up();
+
+// ---------------------------------------------------------------------------
+// Pickers
+// ---------------------------------------------------------------------------
+
+// One row of a drop-down list.
+struct IOSPickerItem
+{
+    wxString text;
+    // The section this row belongs in, empty for the unlabelled first one.
+    // Orca's groups are meaningful (vendor, then material) and the order they
+    // arrive in is theirs, so nothing here sorts them.
+    wxString group;
+    // The index into the DropDown's own vector, which is what the wxEVT_COMBOBOX
+    // it sends afterwards carries - and which is NOT the row number, because a
+    // search filters rows out.
+    int      index   = 0;
+    bool     enabled = true;
+};
+
+// Presents `items` as a UITableView in a popover anchored at `anchor`, or as a
+// sheet when there is nothing to anchor to. Exactly one picker is up at a
+// time; presenting a second takes the first down.
+//
+// `owner` is what orca_ios_picker_dismiss() matches on - the control the list
+// belongs to - so that a drop-down closing itself cannot take down a list that
+// has since been opened by something else.
+bool orca_ios_picker_present(wxWindow                         *owner,
+                             wxWindow                         *anchor,
+                             const wxString                   &title,
+                             const std::vector<IOSPickerItem> &items,
+                             int                               selected,
+                             std::function<void(int)>          on_pick,
+                             std::function<void()>             on_dismiss);
+
+// The same list, with a checkmark per row instead of one, a Select All in the
+// toolbar and a Done that hands back everything ticked. This is what a
+// multiple-choice dialog is on this platform, and it is the same table so a
+// long list is searchable here too.
+//
+// `on_done` is called with the chosen indices - the `index` field of the items,
+// not row numbers - and `on_cancel` when the sheet is left without confirming.
+// Exactly one of the two runs.
+bool orca_ios_multi_picker_present(wxWindow                         *owner,
+                                   const wxString                   &title,
+                                   const std::vector<IOSPickerItem> &items,
+                                   const std::vector<int>           &selected,
+                                   std::function<void(const std::vector<int> &)> on_done,
+                                   std::function<void()>             on_cancel);
+
+// Takes the picker down. A null owner means "whichever one is up".
+void orca_ios_picker_dismiss(wxWindow *owner);
+
+// ---------------------------------------------------------------------------
+// Notifications
+// ---------------------------------------------------------------------------
+
+// How a notification is drawn, which on this platform is entirely a matter of
+// which symbol and which tint the banner gets.
+enum class IOSNoticeKind
+{
+    Info,
+    Success,
+    Warning,
+    Error,
+    Progress,
+};
+
+// A single banner, as the notification manager has it this frame. Everything
+// is by value: the manager owns its notifications, this crosses to UIKit, and
+// the two must not share a pointer that the next update can free.
+struct IOSNotice
+{
+    // Stable for the life of one notification, so an update moves a banner
+    // rather than replacing it. The notification's own address is what Orca
+    // has to identify one with, and it is stable: PopNotification objects are
+    // held by pointer in a deque and never move.
+    uintptr_t       key = 0;
+    IOSNoticeKind   kind = IOSNoticeKind::Info;
+    wxString        text;
+    // The clickable run of text Orca calls hypertext - "Export G-code",
+    // "Undo", "More info". A button on the banner here.
+    wxString        action_label;
+    // -1 when this notification is not a progress bar, 0…1 when it is.
+    float           progress = -1.0f;
+    bool            closable = true;
+    // Seconds before the banner takes itself down, 0 meaning "never, until
+    // Orca closes it" - which is what an error and a progress bar want.
+    //
+    // A SECOND COUNTDOWN, DELIBERATELY. Orca's own is inside
+    // update_notifications(), which only runs while the 3D canvas is drawing;
+    // leave Prepare and it stops. That was invisible when the notification was
+    // drawn in the canvas, because it left the screen at the same moment, and
+    // it is very visible now that the banner is in the window.
+    int             duration = 0;
+    // Run on the GUI thread when the banner's action button is pressed, and
+    // when its close button is. Copied into the banner and released with it.
+    std::function<void()> on_action;
+    std::function<void()> on_close;
+};
+
+// The whole set of banners that should be on screen, in the order Orca stacks
+// them. Called on every notification render pass; banners that are no longer
+// in the set slide out, ones that are new slide in, and ones that are both
+// keep their place and take the new text.
+void orca_ios_notices_sync(const std::vector<IOSNotice> &notices);
+
+// Everything goes away. Used when the canvas the notifications belonged to is
+// destroyed - the banners live in the window, not in the canvas, so nothing
+// else would take them down.
+void orca_ios_notices_clear();
+
+// ---------------------------------------------------------------------------
+// Progress
+// ---------------------------------------------------------------------------
+
+// A determinate or indeterminate progress sheet, which is what a
+// wxProgressDialog is on this platform. `range` of 0 means indeterminate.
+//
+// The token identifies one sheet across its life; pass the same one to update
+// and to close it. Zero is never a valid token.
+uintptr_t orca_ios_progress_open(const wxString &title, const wxString &message,
+                                 bool cancellable, std::function<void()> on_cancel);
+void      orca_ios_progress_update(uintptr_t token, const wxString &message, float fraction);
+void      orca_ios_progress_close(uintptr_t token);
+bool      orca_ios_progress_cancelled(uintptr_t token);
+
+} // namespace GUI
+} // namespace Slic3r
+
+#endif // __WXOSX_IPHONE__
+#endif // slic3r_GUI_ios_native_ui_hpp_
diff --git a/src/slic3r/GUI/ios_native_ui.mm b/src/slic3r/GUI/ios_native_ui.mm
new file mode 100644
index 000000000..efda8a4a2
--- /dev/null
+++ b/src/slic3r/GUI/ios_native_ui.mm
@@ -0,0 +1,544 @@
+///|/ Copyright (c) 2026 Orca-iOS-ipa contributors
+///|/
+///|/ Orca-iOS-ipa is released under the terms of the AGPLv3 or higher
+///|/
+// Every alert in this application, as a UIAlertController.
+//
+// WHAT WAS THERE BEFORE.
+//
+// Orca has one alert class - MsgDialog, in MsgDialog.hpp - and nearly
+// everything the application asks the user derives from it: MessageDialog (322
+// call sites), ErrorDialog, WarningDialog, InfoDialog, RichMessageDialog,
+// DownloadDialog, the three MsgUpdate* dialogs. It is a wxDialog holding a
+// bitmap, an HTML window and a row of Orca's own Button widgets, and on this
+// port patch step2/0230 gives it a glass title bar, rounded corners and a
+// dimmed backdrop so that it at least reads as a window standing in front of
+// something. It is still a desktop dialog: a 360 pt box of custom-painted
+// controls with hit targets built for a mouse, no Dynamic Type, no VoiceOver
+// order, no keyboard dismissal, and none of what the platform's own alerts
+// have.
+//
+// WHY THE ALERT IS A PRESENTATION OF THE DIALOG AND NOT A REPLACEMENT FOR IT.
+//
+// The obvious implementation - read the message, show an alert, return the id
+// of the row that was chosen - is wrong for this application, because a
+// MsgDialog button is not always a plain "end with this code". Several dialogs
+// bind their own handler to a button and do real work in it: writing a config
+// key, starting a download, marking a preset, sending a job. So the dialog is
+// built exactly as it always was, its buttons are read out of it, and choosing
+// a row sends wxEVT_BUTTON to the actual wx button - after which the dialog's
+// own handler runs, unchanged and unaware. The window itself is simply never
+// shown.
+//
+// That also settles what ShowModal() returns. If the handler ended the dialog
+// itself, its code is what the caller gets; if it did not, the row's id is.
+//
+// THE NESTED EVENT LOOP IS THE POINT.
+//
+// wxDialog::ShowModal() does not return until the dialog is dismissed, and 596
+// call sites in Orca are written against that. UIKit presentation is
+// asynchronous and returns at once. wxModalEventLoop is what bridges the two:
+// it is the same loop wxDialog::ShowModal() runs (src/osx/dialog_osx.cpp), it
+// pumps CFRunLoop so UIKit keeps delivering touches to the alert, and it comes
+// back when Exit() is called from the row's handler. Patch step2/0216 is what
+// made that loop real on this port; without it none of this would return
+// anything.
+
+#import <UIKit/UIKit.h>
+
+#include "libslic3r/libslic3r.h"
+
+#include <wx/dialog.h>
+#include <wx/evtloop.h>
+#include <wx/thread.h>
+#include <wx/window.h>
+#include <wx/osx/core/cfstring.h>
+
+#include <boost/log/trivial.hpp>
+
+#include <functional>
+#include <map>
+#include <memory>
+#include <vector>
+
+#include "ios_native_ui.hpp"
+
+namespace Slic3r {
+namespace GUI {
+
+// ---------------------------------------------------------------------------
+// Where a modal presentation goes
+// ---------------------------------------------------------------------------
+//
+// THE TOPMOST WINDOW, NOT THE KEY WINDOW AND NOT THE APPLICATION'S.
+//
+// A wxDialog is its own UIWindow on this port, at UIWindowLevelAlert + 1
+// (step2/0230), and the main frame is at UIWindowLevelNormal. A controller
+// presented from the main window draws inside that window - which is
+// underneath every dialog on screen. An alert raised by a dialog would then
+// appear behind the dialog that raised it, which is indistinguishable from an
+// alert that never appeared, and the modal loop below would be waiting on a
+// row nobody can reach: a hang, not a cosmetic fault.
+//
+// So the window is chosen by level, and the presenter is the deepest
+// controller in it that is not already presenting something. The dim backdrop
+// 0230 puts behind a dialog is skipped by the interaction test - it is a
+// window with a root controller like any other, and presenting into a window
+// that takes no touches would be the same hang.
+UIWindow *orca_ios_topmost_window()
+{
+    UIWindow *best = nil;
+
+    for (UIScene *scene in [[UIApplication sharedApplication] connectedScenes]) {
+        if (![scene isKindOfClass:[UIWindowScene class]])
+            continue;
+        for (UIWindow *w in ((UIWindowScene *) scene).windows) {
+            if (w.hidden || w.alpha <= 0.01f)
+                continue;
+            if (w.rootViewController == nil)
+                continue;
+            if (!w.userInteractionEnabled)
+                continue;               // the dim backdrop behind a dialog
+            if (best == nil || w.windowLevel >= best.windowLevel)
+                best = w;
+        }
+    }
+
+    return best;
+}
+
+UIViewController *orca_ios_top_presenter()
+{
+    UIWindow *const window = orca_ios_topmost_window();
+    UIViewController *vc = window.rootViewController;
+
+    // Presenting from a controller that already has a presented controller
+    // throws NSInternalInconsistencyException, so walk to the end of the
+    // chain. A controller that is on its way out is not a destination either -
+    // presenting from it throws just the same.
+    while (vc != nil && vc.presentedViewController != nil &&
+           !vc.presentedViewController.isBeingDismissed)
+        vc = vc.presentedViewController;
+
+    return vc;
+}
+
+// ---------------------------------------------------------------------------
+// The alert itself
+// ---------------------------------------------------------------------------
+
+// A return code no dialog in this application uses, so that "the handler ended
+// the dialog itself" can be told from "the handler left it to us". wxID_ values
+// are in the low thousands and Orca's custom ids sit alongside them; this is
+// INT_MIN, which is not a wxWindowID anybody hands out.
+static const int kOrcaAlertNoReturn = (-2147483647 - 1);
+
+// How many alerts are up. Read by the banner stack, which has to know whether
+// something is already frontmost.
+static int gs_orca_alerts_up = 0;
+
+bool orca_ios_alert_is_up()
+{
+    return gs_orca_alerts_up > 0;
+}
+
+// What one presentation needs to survive from the tap to the row's handler,
+// held by shared_ptr because a block outlives the stack frame that made it and
+// three of them - each row's, and the watchdog's - share it.
+namespace {
+struct OrcaAlertState
+{
+    wxEventLoopBase *loop        = nullptr;   // null once Run() has returned
+    wxDialog        *dlg         = nullptr;   // null for a modeless presentation
+    bool             finished    = false;
+    bool             pending     = false;     // a row was chosen; delivery queued
+    int              code        = wxID_CANCEL;
+    int              cancel_code = wxID_CANCEL;
+    std::vector<IOSAlertField> *fields = nullptr;
+    UIAlertController          *alert  = nil; // retained; released on delivery
+};
+} // namespace
+
+// Reads the text fields back and runs the row.
+//
+// ON THE MAIN THREAD AND A TURN AFTER THE TAP. A UIAlertAction handler runs
+// while the alert it belongs to is still being dismissed, and a wx handler is
+// entitled to open another dialog - which would be a presentation from a
+// controller in the middle of a dismissal, the "already presenting" exception.
+// One dispatch_async puts the whole thing after the dismissal instead.
+static void orca_ios_alert_deliver(std::shared_ptr<OrcaAlertState> state,
+                                   wxWindow *widget, int id,
+                                   std::function<void()> before)
+{
+    if (state->finished)
+        return;
+    state->finished = true;
+    state->code     = id;
+
+    // Exactly once per presentation, and here rather than after the loop below
+    // returns, because a modeless alert has no loop to come back to. The early
+    // return above is what makes it once.
+    if (gs_orca_alerts_up > 0)
+        --gs_orca_alerts_up;
+
+    // The fields first: the row's handler is entitled to read them.
+    if (state->fields != nullptr && state->alert != nil) {
+        NSArray<UITextField *> *const tfs = state->alert.textFields;
+        for (size_t i = 0; i < state->fields->size() && i < (size_t) tfs.count; ++i) {
+            IOSAlertField &f  = (*state->fields)[i];
+            NSString *const s = [tfs objectAtIndex:i].text;
+            f.value = wxString::FromUTF8(s != nil ? [s UTF8String] : "");
+            if (f.out != nullptr)
+                *f.out = f.value;
+        }
+    }
+
+    if (state->alert != nil) {
+        [state->alert release];
+        state->alert = nil;
+    }
+
+    // The row's own work, if it has any: ticking the "don't show again" box,
+    // or opening the page a hyperlink row stands for. Before the button, so
+    // that a handler reading the box sees the state the user just chose.
+    if (before)
+        before();
+
+    if (widget != nullptr) {
+        // The sentinel is how "the handler ended the dialog" is told from "the
+        // handler left it to us" without asking the dialog a question it has
+        // no way to answer.
+        if (state->dlg != nullptr)
+            state->dlg->SetReturnCode(kOrcaAlertNoReturn);
+
+        wxCommandEvent evt(wxEVT_BUTTON, widget->GetId());
+        evt.SetEventObject(widget);
+        widget->GetEventHandler()->ProcessEvent(evt);
+
+        if (state->dlg != nullptr) {
+            if (state->dlg->GetReturnCode() == kOrcaAlertNoReturn)
+                state->dlg->SetReturnCode(id);
+            else
+                state->code = state->dlg->GetReturnCode();
+        }
+    } else if (state->dlg != nullptr) {
+        state->dlg->SetReturnCode(id);
+    }
+
+    // And out of the loop, if there is one and it is still running. EndModal()
+    // inside the handler above cannot have ended it - this loop is deliberately
+    // not installed as the dialog's own m_eventLoop, because the dialog was
+    // never shown and must not be handed a loop it would then end twice.
+    if (state->loop != nullptr && state->loop->IsRunning())
+        state->loop->Exit(state->code);
+}
+
+// The watchdog.
+//
+// An alert that goes away without a row being chosen would leave the modal loop
+// below running with nothing on screen left to end it: the whole application
+// stopped, waiting for a button that is not there. It should not be reachable -
+// an alert-style UIAlertController cannot be dismissed by tapping outside it,
+// which is exactly why this is an alert and not an action sheet - but a
+// presenting controller can be torn down underneath it, and a hang is not an
+// acceptable outcome for a case that "should not happen".
+//
+// A poll rather than a lifecycle callback because UIAlertController is
+// documented as not supporting subclassing, so there is no -viewDidDisappear:
+// of ours to put this in, and a presentation delegate is only consulted for
+// the interactive dismissals this style does not have. The block retains the
+// controller, so the thing being watched cannot be freed while it is watched.
+static void orca_ios_alert_watch(UIAlertController *ac,
+                                 std::shared_ptr<OrcaAlertState> state, int misses)
+{
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t) (0.75 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+        if (state->finished || state->pending)
+            return;                       // done, or a row is on its way
+        // Two consecutive misses, so that the window between -present… being
+        // called and the presentation taking effect is not read as a
+        // disappearance.
+        const bool gone = ac.presentingViewController == nil;
+        if (gone && misses >= 1) {
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-alert: gone with no row chosen; "
+                                        "ending it as cancel";
+            orca_ios_alert_deliver(state, nullptr, state->cancel_code, nullptr);
+            return;
+        }
+        orca_ios_alert_watch(ac, state, gone ? misses + 1 : 0);
+    });
+}
+
+// Builds the controller. Returns nil when the caller gave it no usable rows -
+// an alert with no way out is the one thing worse than a desktop-shaped dialog.
+static UIAlertController *orca_ios_alert_build(const wxString                    &title,
+                                               const wxString                    &message,
+                                               const std::vector<IOSAlertButton> &buttons,
+                                               std::vector<IOSAlertField>        *fields,
+                                               std::shared_ptr<OrcaAlertState>    state)
+{
+    if (buttons.empty())
+        return nil;
+
+    // NAMED, AND NOT A TEMPORARY IN THE ARGUMENT.
+    //
+    // wxCFStringRef owns the CFString it makes and releases it when it goes out
+    // of scope, and AsNSString() is a cast rather than a retain - so
+    //
+    //     NSString *s = wxCFStringRef(title).AsNSString();
+    //
+    // leaves `s` pointing at a string that was deallocated at the end of that
+    // statement. Passing the temporary straight into a message send is safe
+    // (it lives to the end of the full expression, by which time UIKit has
+    // copied it); holding the result in a variable first is not.
+    const wxCFStringRef cf_title(title);
+    const wxCFStringRef cf_message(message);
+
+    // An empty title is passed as nil rather than as "": UIAlertController
+    // gives the bold first line to the message when there is no title, which
+    // reads better than a blank line above the text.
+    UIAlertController *const ac =
+        [UIAlertController alertControllerWithTitle:(title.IsEmpty() ? nil
+                                                                    : cf_title.AsNSString())
+                                            message:(message.IsEmpty() ? nil
+                                                                       : cf_message.AsNSString())
+                                     preferredStyle:UIAlertControllerStyleAlert];
+    if (ac == nil)
+        return nil;
+
+    if (fields != nullptr) {
+        for (const IOSAlertField &f : *fields) {
+            const wxString placeholder = f.placeholder;
+            const wxString value       = f.value;
+            const bool     secure      = f.secure;
+            const bool     numeric     = f.numeric;
+            [ac addTextFieldWithConfigurationHandler:^(UITextField *tf) {
+                tf.placeholder            = wxCFStringRef(placeholder).AsNSString();
+                tf.text                   = wxCFStringRef(value).AsNSString();
+                tf.secureTextEntry        = secure ? YES : NO;
+                tf.keyboardType           = numeric ? UIKeyboardTypeDecimalPad
+                                                    : UIKeyboardTypeDefault;
+                tf.clearButtonMode        = UITextFieldViewModeWhileEditing;
+                tf.autocorrectionType     = UITextAutocorrectionTypeNo;
+                tf.autocapitalizationType = UITextAutocapitalizationTypeNone;
+            }];
+        }
+    }
+
+    UIAlertAction *preferred   = nil;
+    bool           have_cancel = false;
+
+    for (const IOSAlertButton &b : buttons) {
+        if (b.label.IsEmpty())
+            continue;
+
+        // ONE cancel row at most: UIKit throws on the second one.
+        const bool as_cancel = b.cancel && !have_cancel && !b.destructive;
+
+        UIAlertActionStyle style = UIAlertActionStyleDefault;
+        if (b.destructive)
+            style = UIAlertActionStyleDestructive;
+        else if (as_cancel)
+            style = UIAlertActionStyleCancel;
+
+        wxWindow *const             widget = b.widget;
+        const int                   id     = b.id;
+        const std::function<void()> before = b.before;
+
+        UIAlertAction *const action =
+            [UIAlertAction actionWithTitle:wxCFStringRef(b.label).AsNSString()
+                                     style:style
+                                   handler:^(UIAlertAction *a) {
+                (void) a;
+                // Marked chosen NOW, synchronously, so the watchdog can tell
+                // that a row won even though the row is delivered a turn later.
+                state->pending = true;
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    orca_ios_alert_deliver(state, widget, id, before);
+                });
+            }];
+        action.enabled = b.enabled ? YES : NO;
+        [ac addAction:action];
+
+        if (as_cancel) {
+            have_cancel        = true;
+            state->cancel_code = id;
+        }
+        if (b.preferred && preferred == nil)
+            preferred = action;
+    }
+
+    if (ac.actions.count == 0)
+        return nil;
+    if (preferred != nil)
+        ac.preferredAction = preferred;
+    // Nothing was marked as the way out, so the first row is it. The watchdog
+    // and every "the alert went away by itself" path answer with this code.
+    if (!have_cancel && !buttons.empty())
+        state->cancel_code = buttons.front().id;
+
+    return ac;
+}
+
+// Presents it, and says whether it went up. @try because presentation is the
+// call that throws when the controller chain has moved under us between
+// choosing a presenter and using it; the caller then falls back to the wx
+// dialog, which is ugly and works.
+static bool orca_ios_alert_present(UIAlertController *ac)
+{
+    UIViewController *const presenter = orca_ios_top_presenter();
+    if (presenter == nil || presenter.view.window == nil) {
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-alert: no controller to present from";
+        return false;
+    }
+
+    @try {
+        [presenter presentViewController:ac animated:YES completion:nil];
+    }
+    @catch (NSException *e) {
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-alert: presentation THREW "
+                                 << [[e name] UTF8String] << ": " << [[e reason] UTF8String];
+        return false;
+    }
+
+    return true;
+}
+
+bool orca_ios_alert_run(wxDialog                          *dlg,
+                        const wxString                    &title,
+                        const wxString                    &message,
+                        const std::vector<IOSAlertButton> &buttons,
+                        std::vector<IOSAlertField>        *fields,
+                        int                               *result)
+{
+    if (dlg == nullptr || result == nullptr)
+        return false;
+
+    // Not from a worker thread. Orca does put dialogs up from jobs, but always
+    // by hopping to the GUI thread first; if one ever does not, refusing here
+    // sends it back to the wx path rather than into UIKit off the main thread.
+    if (!wxThread::IsMain())
+        return false;
+
+    std::shared_ptr<OrcaAlertState> state = std::make_shared<OrcaAlertState>();
+    state->dlg    = dlg;
+    state->fields = fields;
+
+    UIAlertController *const ac = orca_ios_alert_build(title, message, buttons, fields, state);
+    if (ac == nil)
+        return false;
+    // Held until the row is delivered: the text fields are read out of it then,
+    // long after UIKit has let go of the dismissed controller.
+    state->alert = [ac retain];
+
+    if (!orca_ios_alert_present(ac)) {
+        [state->alert release];
+        state->alert = nil;
+        return false;
+    }
+
+    ++gs_orca_alerts_up;
+    orca_ios_alert_watch(ac, state, 0);
+
+    BOOST_LOG_TRIVIAL(error) << "orca-ios-alert: [" << title.utf8_string() << "] "
+                             << message.utf8_string() << " (" << buttons.size() << " rows)";
+
+    // The loop. Deliberately not installed as the dialog's own m_eventLoop:
+    // the dialog is not showing, EndModal() from a row's handler must not try
+    // to end a loop this function owns, and the delivery above ends it
+    // explicitly with the code the handler settled on.
+    wxModalEventLoop loop(dlg);
+    state->loop = &loop;
+    const int rc = loop.Run();
+    state->loop  = nullptr;
+
+    // Gone by now in every ordinary path. Dismissing an already-dismissed
+    // controller is a no-op, so this is unconditional rather than guessed at.
+    if (ac.presentingViewController != nil)
+        [ac dismissViewControllerAnimated:YES completion:nil];
+
+    *result = state->finished ? state->code : rc;
+    return true;
+}
+
+// The modeless alerts that are up, by the window they stand in for. Only ever
+// touched from the main thread, which is where both of the functions below
+// refuse to run otherwise.
+static std::map<wxWindow *, std::shared_ptr<OrcaAlertState>> gs_posted;
+
+void orca_ios_alert_dismiss(wxWindow *owner)
+{
+    if (!wxThread::IsMain())
+        return;
+
+    const auto it = gs_posted.find(owner);
+    if (it == gs_posted.end())
+        return;
+
+    std::shared_ptr<OrcaAlertState> state = it->second;
+    gs_posted.erase(it);
+
+    if (state->finished)
+        return;
+    // Marked finished before the dismissal so that the watchdog does not read
+    // the disappearance as a row nobody chose and deliver a cancel for it.
+    state->finished = true;
+    if (gs_orca_alerts_up > 0)
+        --gs_orca_alerts_up;
+
+    UIAlertController *const ac = state->alert;
+    state->alert = nil;
+    if (ac != nil) {
+        if (ac.presentingViewController != nil)
+            [ac dismissViewControllerAnimated:YES completion:nil];
+        [ac release];
+    }
+}
+
+bool orca_ios_alert_post(wxWindow                          *owner,
+                         const wxString                    &title,
+                         const wxString                    &message,
+                         const std::vector<IOSAlertButton> &buttons)
+{
+    if (!wxThread::IsMain())
+        return false;
+
+    // WHATEVER THIS WINDOW ALREADY HAS UP GOES FIRST.
+    //
+    // SecondaryCheckDialog is reused: update_title_style() followed by
+    // on_show() is how the Device page asks its next question through the same
+    // frame, without hiding it in between. Merely forgetting the old alert
+    // would leave it on screen with the new one presented on top of it - two
+    // questions, one of them stale. Dismissing is asynchronous, and the
+    // presenter walk below skips a controller that is being dismissed, so the
+    // new one lands where the old one was.
+    orca_ios_alert_dismiss(owner);
+
+    // No dialog and no loop: nothing here waits, and nothing here has a return
+    // code to set. The row's wxEVT_BUTTON is the whole of the result, which is
+    // exactly what a modeless window's buttons already do.
+    std::shared_ptr<OrcaAlertState> state = std::make_shared<OrcaAlertState>();
+
+    UIAlertController *const ac = orca_ios_alert_build(title, message, buttons, nullptr, state);
+    if (ac == nil)
+        return false;
+    state->alert = [ac retain];
+
+    if (!orca_ios_alert_present(ac)) {
+        [state->alert release];
+        state->alert = nil;
+        return false;
+    }
+
+    ++gs_orca_alerts_up;
+    orca_ios_alert_watch(ac, state, 0);
+    if (owner != nullptr)
+        gs_posted[owner] = state;
+
+    BOOST_LOG_TRIVIAL(error) << "orca-ios-alert: (modeless) [" << title.utf8_string() << "] "
+                             << message.utf8_string();
+    return true;
+}
