--- a/src/slic3r/GUI/GLCanvas3D.cpp
+++ b/src/slic3r/GUI/GLCanvas3D.cpp
@@ -5841,13 +5841,36 @@
     // exactly: idle events keep arriving in the hundreds while render stays at
     // zero, until a tab switch rebuilds the panel and it recovers.
     //
-    // What this gate is actually for is not drawing the panel that is not on
-    // top - Prepare while Preview is showing - and that is decided by the
-    // panels' own Show/Hide, below the frame. So walk exactly that far.
-    for (const wxWindow *w = m_canvas; w != nullptr && !w->IsTopLevel(); w = w->GetParent())
+    // What this gate is actually for is two separate things, and only one of
+    // them goes stale. Keep them apart.
+    //
+    // The first is not drawing the panel that is not on top - Prepare while
+    // Preview is showing - which the panels' own Show/Hide decides, below the
+    // frame. Walk exactly that far and no further.
+    const wxWindow *top = nullptr;
+    for (const wxWindow *w = m_canvas; w != nullptr; w = w->GetParent()) {
+        if (w->IsTopLevel()) { top = w; break; }
         if (!w->IsShown())
             return false;
-    return true;
+    }
+    if (top == nullptr)
+        return false;
+
+    // The second is not drawing before there is a frame to draw into, and that
+    // one matters more than it looks: Plater::priv's constructor calls
+    // update(), which reaches AssembleView::reload_scene() and render() while
+    // the Plater is still being built. IsShownOnScreen() used to stop that
+    // because the frame is not shown yet during startup, and dropping it
+    // outright turned a stale-canvas bug into a crash on launch, in
+    // GLCanvas3D::init() -> on_change_color_mode().
+    //
+    // So latch it instead of reading it live: once the frame has been shown,
+    // it stays "shown" for this purpose. Startup is still guarded, and a modal
+    // dialog dismissed later cannot switch rendering off for good.
+    static bool s_frame_was_shown = false;
+    if (!s_frame_was_shown && top->IsShown())
+        s_frame_was_shown = true;
+    return s_frame_was_shown;
 #else
     return m_canvas->IsShownOnScreen();
 #endif
