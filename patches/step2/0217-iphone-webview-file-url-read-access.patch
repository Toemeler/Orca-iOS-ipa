 void wxWebViewWebKit::LoadURL(const wxString& url)
 {
-    [m_webView loadRequest:[NSURLRequest requestWithURL:
-            [NSURL URLWithString:wxCFStringRef(url).AsNSString()]]];
+    NSURL* nsurl = [NSURL URLWithString:wxCFStringRef(url).AsNSString()];
+    NSURLRequest* request = [NSURLRequest requestWithURL:nsurl];
+
+#if defined(__WXOSX_IPHONE__)
+    // A file: page loaded with -loadRequest: gets read access to its own
+    // directory and nothing else, so a navigation to a sibling directory can be
+    // refused, silently. OrcaSlicer's setup wizard needs exactly that hop:
+    // resources/web/guide/0/index.html is only a "Loading......" splash and
+    // jumps to guide/1/.
+    //
+    // -loadFileURL:allowingReadAccessToURL: is the usual answer and is the
+    // wrong one here: it takes a bare URL, and these URLs carry a query string
+    // (index.html?target=1&lang=en, which the page reads the target page
+    // number out of). It refuses them, loading nothing at all and leaving every
+    // web panel in the application blank. -loadFileRequest: takes a request, so
+    // the query survives.
+    if ( [nsurl isFileURL] )
+    {
+        // Rebuild the URL from its path rather than trusting the string form:
+        // Orca composes it as "file://" + an absolute path, and the result does
+        // not always round-trip through NSURL as a well formed file URL.
+        NSString* path = [nsurl path];
+        if ( path != nil && [path length] > 0 )
+        {
+            NSURL* fileURL = [NSURL fileURLWithPath:path];
+            NSString* query = [nsurl query];
+            if ( query != nil && [query length] > 0 )
+            {
+                NSURLComponents* comps =
+                    [NSURLComponents componentsWithURL:fileURL
+                               resolvingAgainstBaseURL:NO];
+                comps.query = query;
+                if ( [comps URL] != nil )
+                    fileURL = [comps URL];
+            }
+
+            // Symlinks, not just . and .. : a bundle is reachable as both
+            // /var/containers/... and /private/var/containers/..., /var being a
+            // symlink to /private/var, and a missed match would silently fall
+            // back to the single-directory grant this exists to avoid.
+            NSURL* bundleURL = [[[NSBundle mainBundle] bundleURL]
+                                    URLByResolvingSymlinksInPath];
+            NSString* bundlePath = [bundleURL path];
+            NSString* filePath = [[fileURL URLByResolvingSymlinksInPath] path];
+
+            NSURL* readAccess;
+            if ( bundlePath != nil && filePath != nil &&
+                 [filePath hasPrefix:bundlePath] )
+                readAccess = bundleURL;   // where a packaged app's web content lives
+            else
+                readAccess = [[fileURL URLByDeletingLastPathComponent]
+                                  URLByDeletingLastPathComponent];
+
+            NSURLRequest* fileRequest = [NSURLRequest requestWithURL:fileURL];
+
+            if ( [m_webView respondsToSelector:
+                     @selector(loadFileRequest:allowingReadAccessToURL:)] )
+            {
+                WKNavigation* nav = [m_webView loadFileRequest:fileRequest
+                                      allowingReadAccessToURL:readAccess];
+
+                // A nil navigation means nothing started. Never leave the page
+                // blank over this: fall back to the load that has always
+                // worked, and say so.
+                if ( nav != nil )
+                {
+                    wxLogMessage("wx-ios webview: loadFileRequest %s (read access %s)",
+                                 wxCFStringRef::AsString([fileURL absoluteString]),
+                                 wxCFStringRef::AsString([readAccess path]));
+                    return;
+                }
+
+                wxLogMessage("wx-ios webview: loadFileRequest started nothing for %s"
+                             " - falling back to loadRequest",
+                             wxCFStringRef::AsString([fileURL absoluteString]));
+            }
+
+            request = fileRequest;
+        }
+    }
+#endif
+
+    [m_webView loadRequest:request];
 }
 
