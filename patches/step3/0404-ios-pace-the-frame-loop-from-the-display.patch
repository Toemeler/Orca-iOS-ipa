+void orca_ios_start_display_link()
+{
+    static CADisplayLink *s_link = nil;
+    if (s_link != nil)
+        return;
+
+    OrcaDisplayLinkTarget *const target = [[OrcaDisplayLinkTarget alloc] init];
+    s_link = [CADisplayLink displayLinkWithTarget:target selector:@selector(tick:)];
+    if (@available(iOS 15.0, *))
+        s_link.preferredFrameRateRange = CAFrameRateRangeMake(60.0f, 120.0f, 120.0f);
+
+    // Common modes, so the link keeps firing inside the nested run loops wx
+    // spins for modal dialogs (step2/0216). A link on the default mode alone
+    // would stop the viewport dead behind every modal - the state patch 0364
+    // was written to get out of.
+    //
+    // The run loop retains the link and the link retains its target. This file
+    // is built without ARC and neither is ever torn down - both live as long as
+    // the process - so there is nothing to release.
+    [s_link addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
+
+    BOOST_LOG_TRIVIAL(error) << "orca-ios-displaylink: started";
+}
