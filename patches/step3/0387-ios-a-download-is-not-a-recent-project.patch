+
+namespace {
+// Is this the staging copy of a MakerWorld download?
+//
+// Opening one puts it on the home page, and saving the model the user actually
+// wants puts *that* on the home page too - the same model twice, one of which
+// they never asked for and cannot tell apart by name. Documents/Downloads is
+// where init_download_path() sends them (patch 0377), and nothing else writes
+// there, so the directory is the test.
+bool orca_ios_is_downloaded_copy(const std::string &path)
+{
+    const char *home = ::getenv("HOME");
+    if (home == nullptr || path.empty())
+        return false;
+    const std::string downloads = std::string(home) + "/Documents/Downloads/";
+    return path.compare(0, downloads.size(), downloads) == 0;
+}
+} // namespace
