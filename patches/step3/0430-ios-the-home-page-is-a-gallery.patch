+@interface OrcaGallery : UIView <UICollectionViewDataSource, UICollectionViewDelegate>
+@property (nonatomic, retain) UICollectionView            *grid;
+@property (nonatomic, retain) NSMutableArray<OrcaProject *> *items;
+@property (nonatomic, retain) NSMutableSet<NSString *>    *picked;
+@property (nonatomic, retain) UILabel                     *heading;
+@property (nonatomic, retain) UILabel                     *nothing;
+@property (nonatomic, retain) UIVisualEffectView           *bar;
+@property (nonatomic, assign) UIStackView                  *barRow;   // the bar holds it
+@property (nonatomic, assign) BOOL                         selecting;
++ (UICollectionViewLayout *)layout;
+- (void)setProjects:(NSArray<OrcaProject *> *)projects;
+- (void)toggleSelecting;
+@end
+
+// The controller a sheet, a picker or a share sheet has to be presented from:
+// the deepest one that is not already presenting something.
+static UIViewController *orca_ios_presenter(UIView *view)
+{
+    UIWindow *const window = view != nil ? view.window : nil;
+    UIViewController *vc = window != nil ? window.rootViewController : nil;
+    while (vc != nil && vc.presentedViewController != nil)
+        vc = vc.presentedViewController;
+    return vc;
+}
+
+@implementation OrcaGallery
+
+- (instancetype)initWithFrame:(CGRect)frame
+{
+    self = [super initWithFrame:frame];
+    if (self == nil)
+        return nil;
+
+    _items  = [[NSMutableArray alloc] init];
+    _picked = [[NSMutableSet alloc] init];
+
+    // The page behind this is a WKWebView with nothing left on it, so the
+    // gallery paints the background it stands on rather than letting the web
+    // page's white show through under a dark appearance.
+    self.backgroundColor = [UIColor systemBackgroundColor];
+
+    _heading           = [[UILabel alloc] initWithFrame:CGRectZero];
+    _heading.font      = [UIFont preferredFontForTextStyle:UIFontTextStyleTitle2];
+    _heading.textColor = [UIColor labelColor];
+    _heading.text      = orca_ios_tr("Recent projects");
+    _heading.translatesAutoresizingMaskIntoConstraints = NO;
+
+    _nothing               = [[UILabel alloc] initWithFrame:CGRectZero];
+    _nothing.font          = [UIFont preferredFontForTextStyle:UIFontTextStyleBody];
+    _nothing.textColor     = [UIColor secondaryLabelColor];
+    _nothing.textAlignment = NSTextAlignmentCenter;
+    _nothing.numberOfLines = 0;
+    _nothing.text          = orca_ios_tr("No projects yet. Use + to make one, or drop a model here.");
+    _nothing.hidden        = YES;
+    _nothing.translatesAutoresizingMaskIntoConstraints = NO;
+
+    _grid = [[UICollectionView alloc] initWithFrame:CGRectZero
+                               collectionViewLayout:[OrcaGallery layout]];
+    _grid.backgroundColor           = [UIColor clearColor];
+    _grid.dataSource                = self;
+    _grid.delegate                  = self;
+    _grid.alwaysBounceVertical      = YES;
+    _grid.allowsMultipleSelection   = NO;
+    [_grid registerClass:[OrcaProjectCell class] forCellWithReuseIdentifier:@"tile"];
+    _grid.translatesAutoresizingMaskIntoConstraints = NO;
+
+    [self addSubview:_heading];
+    [self addSubview:_grid];
+    [self addSubview:_nothing];
+
+    [NSLayoutConstraint activateConstraints:@[
+        [_heading.leadingAnchor constraintEqualToAnchor:self.leadingAnchor constant:kOrcaGalleryPad],
+        [_heading.topAnchor     constraintEqualToAnchor:self.topAnchor],
+
+        [_grid.leadingAnchor  constraintEqualToAnchor:self.leadingAnchor  constant:kOrcaGalleryPad],
+        [_grid.trailingAnchor constraintEqualToAnchor:self.trailingAnchor constant:-kOrcaGalleryPad],
+        [_grid.topAnchor      constraintEqualToAnchor:_heading.bottomAnchor constant:10],
+        [_grid.bottomAnchor   constraintEqualToAnchor:self.bottomAnchor],
+
+        [_nothing.centerXAnchor constraintEqualToAnchor:_grid.centerXAnchor],
+        [_nothing.centerYAnchor constraintEqualToAnchor:_grid.centerYAnchor],
+        [_nothing.widthAnchor   constraintLessThanOrEqualToAnchor:_grid.widthAnchor multiplier:0.7],
+    ]];
+
+    return self;
+}
+
+- (void)dealloc
+{
+    [_grid release];
+    [_items release];
+    [_picked release];
+    [_heading release];
+    [_nothing release];
+    [_bar release];
+    [super dealloc];
+}
+
+// As many columns as fit at kOrcaTileMin or wider, and the tile height follows
+// the width the columns worked out to - so the grid reflows on rotation and on
+// a split screen without anything here being told that it happened.
++ (UICollectionViewLayout *)layout
+{
+    return [[[UICollectionViewCompositionalLayout alloc] initWithSectionProvider:
+        ^NSCollectionLayoutSection *(NSInteger section, id<NSCollectionLayoutEnvironment> env) {
+            (void) section;
+            const CGFloat width = env.container.effectiveContentSize.width;
+            NSInteger cols = (NSInteger) floor((width + kOrcaTileGap) / (kOrcaTileMin + kOrcaTileGap));
+            if (cols < 2)
+                cols = 2;
+            const CGFloat tile   = (width - kOrcaTileGap * (cols - 1)) / cols;
+            const CGFloat height = floor(tile * 0.72) + 46;
+
+            NSCollectionLayoutItem *const item = [NSCollectionLayoutItem itemWithLayoutSize:
+                [NSCollectionLayoutSize sizeWithWidthDimension:[NSCollectionLayoutDimension fractionalWidthDimension:1.0]
+                                              heightDimension:[NSCollectionLayoutDimension fractionalHeightDimension:1.0]]];
+            NSCollectionLayoutGroup *const group = [NSCollectionLayoutGroup horizontalGroupWithLayoutSize:
+                [NSCollectionLayoutSize sizeWithWidthDimension:[NSCollectionLayoutDimension fractionalWidthDimension:1.0]
+                                              heightDimension:[NSCollectionLayoutDimension absoluteDimension:height]]
+                                                                                        repeatingSubitem:item
+                                                                                                   count:(int) cols];
+            group.interItemSpacing = [NSCollectionLayoutSpacing fixedSpacing:kOrcaTileGap];
+
+            NSCollectionLayoutSection *const sec = [NSCollectionLayoutSection sectionWithGroup:group];
+            sec.interGroupSpacing = kOrcaTileGap;
+            sec.contentInsets     = NSDirectionalEdgeInsetsMake(2, 0, 28, 0);
+            return sec;
+        }] autorelease];
+}
+
+- (void)setProjects:(NSArray<OrcaProject *> *)projects
+{
+    [self.items setArray:projects];
+
+    // Anything picked that is no longer listed stops being picked - a delete
+    // that took several rows would otherwise leave the count wrong.
+    NSMutableSet *const live = [NSMutableSet set];
+    for (OrcaProject *p in self.items)
+        [live addObject:p.path];
+    [self.picked intersectSet:live];
+
+    self.nothing.hidden = self.items.count > 0;
+    [self.grid reloadData];
+    [self syncBar];
+}
+
+- (OrcaProject *)projectAt:(NSIndexPath *)path
+{
+    const NSUInteger i = (NSUInteger) path.item;
+    return i < self.items.count ? self.items[i] : nil;
+}
+
+- (NSURL *)urlFor:(OrcaProject *)project
+{
+    return project != nil ? [NSURL fileURLWithPath:project.path] : nil;
+}
+
+// -- the data ---------------------------------------------------------------
+
+- (NSInteger)collectionView:(UICollectionView *)cv numberOfItemsInSection:(NSInteger)section
+{
+    (void) cv; (void) section;
+    return (NSInteger) self.items.count;
+}
+
+- (UICollectionViewCell *)collectionView:(UICollectionView *)cv
+                  cellForItemAtIndexPath:(NSIndexPath *)indexPath
+{
+    OrcaProjectCell *const cell =
+        (OrcaProjectCell *) [cv dequeueReusableCellWithReuseIdentifier:@"tile" forIndexPath:indexPath];
+    OrcaProject *const project = [self projectAt:indexPath];
+    [cell fillWith:project
+         selecting:self.selecting
+            picked:project != nil && [self.picked containsObject:project.path]];
+    return cell;
+}
+
+// -- a tap ------------------------------------------------------------------
+
+- (void)collectionView:(UICollectionView *)cv didSelectItemAtIndexPath:(NSIndexPath *)indexPath
+{
+    [cv deselectItemAtIndexPath:indexPath animated:NO];
+
+    OrcaProject *const project = [self projectAt:indexPath];
+    if (project == nil)
+        return;
+
+    if (self.selecting) {
+        if ([self.picked containsObject:project.path])
+            [self.picked removeObject:project.path];
+        else
+            [self.picked addObject:project.path];
+        [cv reloadItemsAtIndexPaths:@[ indexPath ]];
+        [self syncBar];
+        return;
+    }
+
+    [self open:project];
+}
+
+- (void)open:(OrcaProject *)project
+{
+    if (project == nil)
+        return;
+    Slic3r::GUI::orca_ios_gallery_open([project.path UTF8String]);
+    // And go and look at it. Opening a project and being left on the home page
+    // is the dead end the plus already avoids the same way.
+    dispatch_async(dispatch_get_main_queue(), ^{
+        Slic3r::GUI::orca_ios_select_prepare();
+    });
+}
+
+// -- the long press ---------------------------------------------------------
+//
+// A real UIContextMenuInteraction, which the collection view owns: the system
+// draws the menu, previews the tile behind it, handles the dismissal, the
+// pointer's secondary click and the keyboard, and gives the whole thing its
+// haptics. Nothing here paints a popup.
+
+- (UIContextMenuConfiguration *)collectionView:(UICollectionView *)cv
+    contextMenuConfigurationForItemsAtIndexPaths:(NSArray<NSIndexPath *> *)indexPaths
+                                           point:(CGPoint)point
+{
+    (void) point;
+    if (self.selecting || indexPaths.count != 1)
+        return nil;   // in selection mode the tap already means something else
+
+    OrcaProject *const project = [self projectAt:indexPaths.firstObject];
+    if (project == nil)
+        return nil;
+
+    UIView *const source = [cv cellForItemAtIndexPath:indexPaths.firstObject];
+
+    return [UIContextMenuConfiguration configurationWithIdentifier:nil
+                                                  previewProvider:nil
+                                                   actionProvider:^UIMenu *(NSArray<UIMenuElement *> *suggested) {
+        (void) suggested;
+        return [self menuFor:project from:source];
+    }];
+}
+
+- (UIMenu *)menuFor:(OrcaProject *)project from:(UIView *)source
+{
+    OrcaGallery *const me = self;
+
+    UIAction *const open = [UIAction actionWithTitle:orca_ios_tr("Open")
+                                               image:[UIImage systemImageNamed:@"folder"]
+                                          identifier:nil
+                                             handler:^(__kindof UIAction *a) {
+        (void) a;
+        [me open:project];
+    }];
+
+    UIAction *const share = [UIAction actionWithTitle:orca_ios_tr("Share…")
+                                                image:[UIImage systemImageNamed:@"square.and.arrow.up"]
+                                           identifier:nil
+                                              handler:^(__kindof UIAction *a) {
+        (void) a;
+        [me share:@[ project ] from:source];
+    }];
+
+    UIAction *const save = [UIAction actionWithTitle:orca_ios_tr("Export…")
+                                               image:[UIImage systemImageNamed:@"arrow.down.doc"]
+                                          identifier:nil
+                                             handler:^(__kindof UIAction *a) {
+        (void) a;
+        [me exportProjects:@[ project ]];
+    }];
+
+    UIAction *const copy = [UIAction actionWithTitle:orca_ios_tr("Duplicate")
+                                               image:[UIImage systemImageNamed:@"plus.square.on.square"]
+                                          identifier:nil
+                                             handler:^(__kindof UIAction *a) {
+        (void) a;
+        Slic3r::GUI::orca_ios_gallery_duplicate([project.path UTF8String]);
+    }];
+
+    UIAction *const rename = [UIAction actionWithTitle:orca_ios_tr("Rename…")
+                                                 image:[UIImage systemImageNamed:@"pencil"]
+                                            identifier:nil
+                                               handler:^(__kindof UIAction *a) {
+        (void) a;
+        [me rename:project];
+    }];
+
+    // Two different things, and the difference matters enough to say it in the
+    // titles: one takes the project off this page, the other takes it off the
+    // device. The web page's menu only ever had the first and called it
+    // "clear", which is why a file "deleted" from the home page kept coming
+    // back the next time it was opened.
+    UIAction *const forget = [UIAction actionWithTitle:orca_ios_tr("Remove from list")
+                                                 image:[UIImage systemImageNamed:@"eye.slash"]
+                                            identifier:nil
+                                               handler:^(__kindof UIAction *a) {
+        (void) a;
+        Slic3r::GUI::orca_ios_gallery_forget([project.path UTF8String]);
+    }];
+
+    UIAction *const erase = [UIAction actionWithTitle:orca_ios_tr("Delete")
+                                                image:[UIImage systemImageNamed:@"trash"]
+                                           identifier:nil
+                                              handler:^(__kindof UIAction *a) {
+        (void) a;
+        [me confirmDelete:@[ project ] from:source];
+    }];
+    erase.attributes = UIMenuElementAttributesDestructive;
+
+    UIMenu *const first  = [UIMenu menuWithTitle:@"" image:nil identifier:nil
+                                         options:UIMenuOptionsDisplayInline
+                                        children:@[ open, share, save ]];
+    UIMenu *const second = [UIMenu menuWithTitle:@"" image:nil identifier:nil
+                                         options:UIMenuOptionsDisplayInline
+                                        children:@[ copy, rename ]];
+    UIMenu *const third  = [UIMenu menuWithTitle:@"" image:nil identifier:nil
+                                         options:UIMenuOptionsDisplayInline
+                                        children:@[ forget, erase ]];
+
+    return [UIMenu menuWithTitle:project.name children:@[ first, second, third ]];
+}
+
+// -- what the menu and the selection bar do ---------------------------------
+
+- (void)share:(NSArray<OrcaProject *> *)projects from:(UIView *)source
+{
+    NSMutableArray *const urls = [NSMutableArray array];
+    for (OrcaProject *p in projects) {
+        NSURL *const url = [self urlFor:p];
+        if (url != nil)
+            [urls addObject:url];
+    }
+    if (urls.count == 0)
+        return;
+
+    UIViewController *const presenter = orca_ios_presenter(self);
+    if (presenter == nil)
+        return;
+
+    UIActivityViewController *const sheet =
+        [[[UIActivityViewController alloc] initWithActivityItems:urls
+                                          applicationActivities:nil] autorelease];
+    UIPopoverPresentationController *const popover = sheet.popoverPresentationController;
+    if (popover != nil) {
+        popover.sourceView = source != nil ? source : self;
+        popover.sourceRect = source != nil ? source.bounds
+                                           : CGRectMake(CGRectGetMidX(self.bounds),
+                                                        CGRectGetMidY(self.bounds), 1, 1);
+    }
+    [presenter presentViewController:sheet animated:YES completion:nil];
+}
+
+// Export is not share: it is "put a copy of this where I choose", which on
+// this platform is the document picker in its exporting mode. asCopy, because
+// the original has to stay where the recent list says it is.
+- (void)exportProjects:(NSArray<OrcaProject *> *)projects
+{
+    NSMutableArray *const urls = [NSMutableArray array];
+    for (OrcaProject *p in projects) {
+        NSURL *const url = [self urlFor:p];
+        if (url != nil)
+            [urls addObject:url];
+    }
+    if (urls.count == 0)
+        return;
+
+    UIViewController *const presenter = orca_ios_presenter(self);
+    if (presenter == nil)
+        return;
+
+    UIDocumentPickerViewController *const picker =
+        [[[UIDocumentPickerViewController alloc] initForExportingURLs:urls asCopy:YES] autorelease];
+    [presenter presentViewController:picker animated:YES completion:nil];
+}
+
+- (void)rename:(OrcaProject *)project
+{
+    UIViewController *const presenter = orca_ios_presenter(self);
+    if (presenter == nil || project == nil)
+        return;
+
+    UIAlertController *const ask =
+        [UIAlertController alertControllerWithTitle:orca_ios_tr("Rename project")
+                                            message:nil
+                                     preferredStyle:UIAlertControllerStyleAlert];
+    [ask addTextFieldWithConfigurationHandler:^(UITextField *field) {
+        field.text                   = project.name;
+        field.clearButtonMode        = UITextFieldViewModeWhileEditing;
+        field.autocorrectionType     = UITextAutocorrectionTypeNo;
+        field.autocapitalizationType = UITextAutocapitalizationTypeNone;
+    }];
+    [ask addAction:[UIAlertAction actionWithTitle:orca_ios_tr("Cancel")
+                                            style:UIAlertActionStyleCancel
+                                          handler:nil]];
+    [ask addAction:[UIAlertAction actionWithTitle:orca_ios_tr("Rename")
+                                            style:UIAlertActionStyleDefault
+                                          handler:^(UIAlertAction *a) {
+        (void) a;
+        NSString *const name = [ask.textFields.firstObject.text
+            stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+        if (name.length == 0 || [name containsString:@"/"])
+            return;
+        Slic3r::GUI::orca_ios_gallery_rename([project.path UTF8String], [name UTF8String]);
+    }]];
+    [presenter presentViewController:ask animated:YES completion:nil];
+}
+
+// Deleting a file is the one thing on this page that cannot be undone, so it
+// asks - once, for however many were picked.
+- (void)confirmDelete:(NSArray<OrcaProject *> *)projects from:(UIView *)source
+{
+    UIViewController *const presenter = orca_ios_presenter(self);
+    if (presenter == nil || projects.count == 0)
+        return;
+
+    NSString *const title = projects.count == 1
+        ? [NSString stringWithFormat:@"%@ “%@”?", orca_ios_tr("Delete"),
+                                     projects.firstObject.name]
+        : [NSString stringWithFormat:orca_ios_tr("Delete %lu projects?"),
+                                     (unsigned long) projects.count];
+
+    UIAlertController *const ask =
+        [UIAlertController alertControllerWithTitle:title
+                                            message:orca_ios_tr("This removes the file from this device.")
+                                     preferredStyle:UIAlertControllerStyleActionSheet];
+    [ask addAction:[UIAlertAction actionWithTitle:orca_ios_tr("Delete")
+                                            style:UIAlertActionStyleDestructive
+                                          handler:^(UIAlertAction *a) {
+        (void) a;
+        for (OrcaProject *p in projects)
+            Slic3r::GUI::orca_ios_gallery_delete([p.path UTF8String]);
+        [self.picked removeAllObjects];
+        [self syncBar];
+    }]];
+    [ask addAction:[UIAlertAction actionWithTitle:orca_ios_tr("Cancel")
+                                            style:UIAlertActionStyleCancel
+                                          handler:nil]];
+
+    UIPopoverPresentationController *const popover = ask.popoverPresentationController;
+    if (popover != nil) {
+        popover.sourceView = source != nil ? source : self;
+        popover.sourceRect = source != nil ? source.bounds
+                                           : CGRectMake(CGRectGetMidX(self.bounds),
+                                                        CGRectGetMaxY(self.bounds) - 40, 1, 1);
+    }
+    [presenter presentViewController:ask animated:YES completion:nil];
+}
+
+// -- selecting several ------------------------------------------------------
+//
+// Procreate's gallery, and every iOS gallery since Photos: a Select button in
+// the corner turns the tiles into checkboxes and puts what can be done to
+// several of them at once on a bar along the bottom.
+
+- (void)toggleSelecting
+{
+    self.selecting = !self.selecting;
+    if (!self.selecting)
+        [self.picked removeAllObjects];
+    [self.grid reloadData];
+    [self syncBar];
+}
+
+- (NSArray<OrcaProject *> *)pickedProjects
+{
+    NSMutableArray *const out = [NSMutableArray array];
+    for (OrcaProject *p in self.items) {
+        if ([self.picked containsObject:p.path])
+            [out addObject:p];
+    }
+    return out;
+}
+
+- (void)syncBar
+{
+    if (!self.selecting) {
+        [self.bar removeFromSuperview];
+        self.bar    = nil;
+        self.barRow = nil;
+        self.grid.contentInset = UIEdgeInsetsZero;
+        return;
+    }
+
+    if (self.bar == nil) {
+        UIVisualEffectView *const glass = [[UIVisualEffectView alloc] initWithEffect:
+            [UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemThickMaterial]];
+        glass.layer.cornerRadius  = 24;
+        glass.layer.cornerCurve   = kCACornerCurveContinuous;
+        glass.clipsToBounds       = YES;
+        glass.translatesAutoresizingMaskIntoConstraints = NO;
+
+        UIStackView *const row = [[[UIStackView alloc] initWithFrame:CGRectZero] autorelease];
+        row.axis         = UILayoutConstraintAxisHorizontal;
+        row.alignment    = UIStackViewAlignmentCenter;
+        row.distribution = UIStackViewDistributionFillEqually;
+        row.spacing      = 4;
+        row.translatesAutoresizingMaskIntoConstraints = NO;
+
+        [row addArrangedSubview:[self barButton:@"square.and.arrow.up"
+                                          title:orca_ios_tr("Share")
+                                            tag:1]];
+        [row addArrangedSubview:[self barButton:@"arrow.down.doc"
+                                          title:orca_ios_tr("Export")
+                                            tag:2]];
+        [row addArrangedSubview:[self barButton:@"plus.square.on.square"
+                                          title:orca_ios_tr("Duplicate")
+                                            tag:3]];
+        [row addArrangedSubview:[self barButton:@"checklist"
+                                          title:orca_ios_tr("Select all")
+                                            tag:4]];
+        [row addArrangedSubview:[self barButton:@"trash"
+                                          title:orca_ios_tr("Delete")
+                                            tag:5]];
+
+        [glass.contentView addSubview:row];
+        [self addSubview:glass];
+        [NSLayoutConstraint activateConstraints:@[
+            [glass.centerXAnchor constraintEqualToAnchor:self.centerXAnchor],
+            [glass.bottomAnchor  constraintEqualToAnchor:self.bottomAnchor constant:-18],
+            [glass.heightAnchor  constraintEqualToConstant:62],
+            [glass.widthAnchor   constraintLessThanOrEqualToAnchor:self.widthAnchor constant:-2 * kOrcaGalleryPad],
+            [row.leadingAnchor   constraintEqualToAnchor:glass.contentView.leadingAnchor constant:10],
+            [row.trailingAnchor  constraintEqualToAnchor:glass.contentView.trailingAnchor constant:-10],
+            [row.topAnchor       constraintEqualToAnchor:glass.contentView.topAnchor],
+            [row.bottomAnchor    constraintEqualToAnchor:glass.contentView.bottomAnchor],
+        ]];
+        self.bar    = glass;
+        self.barRow = row;
+        [glass release];   // self.bar holds it, and so does the view hierarchy
+        self.grid.contentInset = UIEdgeInsetsMake(0, 0, 92, 0);
+    }
+
+    // Nothing picked, nothing to do to it - except pick everything.
+    const BOOL any = self.picked.count > 0;
+    for (UIView *v in self.barRow.arrangedSubviews) {
+        if (![v isKindOfClass:[UIButton class]])
+            continue;
+        UIButton *const b = (UIButton *) v;
+        b.enabled = b.tag == 4 ? YES : any;
+    }
+    [self bringSubviewToFront:self.bar];
+}
+
+- (UIButton *)barButton:(NSString *)symbol title:(NSString *)title tag:(NSInteger)tag
+{
+    UIButtonConfiguration *cfg = [UIButtonConfiguration plainButtonConfiguration];
+    cfg.image      = [UIImage systemImageNamed:symbol];
+    cfg.title      = title;
+    cfg.imagePlacement       = NSDirectionalRectEdgeTop;
+    cfg.imagePadding         = 3;
+    cfg.titleTextAttributesTransformer =
+        ^NSDictionary<NSAttributedStringKey, id> *(NSDictionary<NSAttributedStringKey, id> *attrs) {
+            NSMutableDictionary *out = [[attrs mutableCopy] autorelease];
+            out[NSFontAttributeName] = [UIFont preferredFontForTextStyle:UIFontTextStyleCaption2];
+            return out;
+        };
+
+    UIButton *const b = [UIButton buttonWithConfiguration:cfg primaryAction:nil];
+    b.tag = tag;
+    b.tintColor = tag == 5 ? [UIColor systemRedColor] : orca_ios_accent();
+    b.pointerInteractionEnabled = YES;
+    [b addTarget:self action:@selector(barTapped:) forControlEvents:UIControlEventTouchUpInside];
+    return b;
+}
+
+- (void)barTapped:(UIButton *)sender
+{
+    NSArray<OrcaProject *> *const chosen = [self pickedProjects];
+    switch (sender.tag) {
+        case 1: [self share:chosen from:sender]; break;
+        case 2: [self exportProjects:chosen]; break;
+        case 3:
+            for (OrcaProject *p in chosen)
+                Slic3r::GUI::orca_ios_gallery_duplicate([p.path UTF8String]);
+            break;
+        case 4:
+            if (self.picked.count == self.items.count) {
+                [self.picked removeAllObjects];
+            } else {
+                for (OrcaProject *p in self.items)
+                    [self.picked addObject:p.path];
+            }
+            [self.grid reloadData];
+            [self syncBar];
+            break;
+        case 5: [self confirmDelete:chosen from:sender]; break;
+        default: break;
+    }
+}
+
