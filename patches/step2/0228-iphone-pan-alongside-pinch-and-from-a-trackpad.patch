+// The same gesture from a trackpad, delivered as a pan rather than as a wheel.
+//
+// The wheel path (WX_scrollGesture:) stays for a real mouse, where turning the
+// wheel to zoom is right. A trackpad is not a wheel: two fingers moving on it
+// mean "move the content", the way they do everywhere else on iPadOS. UIKit
+// tells the two apart by scroll type, so each recognizer takes the one it
+// should - discrete for the wheel, continuous for the trackpad.
+//
+// Indirect scrolls carry no touches, which is what the guard keeps out: this
+// recognizer has the default touch minimum and would otherwise fire for a
+// one-finger drag that belongs to the pointer. Sharing s_last above with the
+// touch pan is safe for the same reason - fingers are either on the screen or
+// on the trackpad, never driving both at once, and each run resets it on Began.
+void wxOSX_trackpadPanGesture(UIView* self, SEL _cmd, UIPanGestureRecognizer* gesture)
+{
+    if ( [gesture numberOfTouches] > 0 )
+        return;
+    wxOSX_panGesture(self, _cmd, gesture);
+}
