 #include <boost/log/trivial.hpp>
 
+// Give a numeric field the small number keypad.
+//
+// UIKeyboardTypeDecimalPad is the compact one - a 4x3 grid, a fraction of the
+// screen. The full-width NumbersAndPunctuation keyboard was tried first and is
+// simply too big on an iPad: entering a layer height should not cover half the
+// plate.
+//
+// The keypad has only digits and the decimal separator, so the three things
+// Orca's numeric fields need beyond that come from an accessory bar above it:
+//
+//   +/-   sign toggle, for positions and offsets
+//   %     for coFloatOrPercent ("40%")
+//   ,     for coPoints ("0.4,0.6"), and for the decimal separator in locales
+//         where the keypad offers a comma but the parser wants a point
+//   Done  because the decimal pad has NO return key, so without this there is
+//         no way to dismiss the keyboard at all
+//
+// Every one of those edits goes through UITextInput (-insertText: and
+// -replaceRange:withText:) rather than assigning .text, so the control's
+// editing-changed notification fires and wxTextCtrl sees the new value.
+@interface OrcaNumericAccessory : NSObject
+@property (nonatomic, assign) UITextField *field;
+// Declared, not just defined below: a selector used before its definition in
+// the @implementation is only a warning ("method not found, return type
+// defaults to id"), and a warning is not what you want standing between a
+// toolbar button and a text field.
+- (void)notifyChanged;
+- (void)toggleSign;
+- (void)insertPercent;
+- (void)insertComma;
+- (void)done;
+@end
+
+@implementation OrcaNumericAccessory
+
+- (void)notifyChanged
+{
+    [self.field sendActionsForControlEvents:UIControlEventEditingChanged];
+}
+
+- (void)toggleSign
+{
+    UITextField *f = self.field;
+    if (f == nil)
+        return;
+    NSString *text = f.text ?: @"";
+    NSString *flipped = [text hasPrefix:@"-"] ? [text substringFromIndex:1]
+                                              : [@"-" stringByAppendingString:text];
+    UITextRange *all = [f textRangeFromPosition:f.beginningOfDocument
+                                     toPosition:f.endOfDocument];
+    if (all != nil)
+        [f replaceRange:all withText:flipped];
+    [self notifyChanged];
+}
+
+- (void)insertPercent { [self.field insertText:@"%"]; [self notifyChanged]; }
+- (void)insertComma   { [self.field insertText:@","]; [self notifyChanged]; }
+- (void)done          { [self.field resignFirstResponder]; }
+
+@end
+
+static char orca_ios_accessory_key;
+
+static UITextField *orca_ios_find_text_field(UIView *view)
+{
+    if (view == nil)
+        return nil;
+    if ([view isKindOfClass:[UITextField class]])
+        return (UITextField *) view;
+    for (UIView *sub in view.subviews) {
+        UITextField *found = orca_ios_find_text_field(sub);
+        if (found != nil)
+            return found;
+    }
+    return nil;
+}
+
+
