+// The superclass implementation of _cmd - and never the one we are standing in.
+//
+// BUILD 199 DIED ON LAUNCH BECAUSE OF THIS. Every wx method installed here is
+// written the same way: look the inherited implementation up, call it, then do
+// wx's part. The lookup was
+//
+//     [[self superclass] instanceMethodForSelector:_cmd]
+//
+// and -instanceMethodForSelector: resolves *through inheritance*. So the moment
+// the view's class and one of its ancestors both carry the method - which is
+// what a class registered under another registered one gives, and what any
+// runtime-made subclass gives, KVO being the one that installs those behind
+// your back - the lookup answers with this very function. It then calls itself
+// with the same `self`, whose superclass has not changed, and does so until the
+// stack runs out: fifty-two identical frames inside
+// wxOSX_canBecomeFirstResponder, signal 11, before the main window existed.
+//
+// Walking up until the implementation differs is the same answer in every case
+// that already worked - the first step up is the last one - and an answer at
+// all in the case that did not.
+static IMP wxOSXIPhoneSuperImpl(id slf, SEL _cmd, IMP ours)
+{
+    for ( Class c = [slf superclass]; c != nil; c = [c superclass] )
+    {
+        IMP imp = [c instanceMethodForSelector:_cmd];
+        if ( imp != ours )
+            return imp;
+    }
+
+    return nullptr;
+}
