+// Apply, and say whether it applied.
+//
+// The first attempt at this silently did nothing on the device - the full
+// QWERTY keyboard still came up - and there was no way to tell from outside
+// whether the call never happened, the walk found no UITextField, or the field
+// was found and iOS ignored the setting. One line each way settles it. The
+// `where` string names the call site.
+static bool orca_ios_apply_numeric_keyboard(wxWindow *win, const char *where)
+{
+    if (win == nullptr)
+        return false;
+    UIView *root = (UIView *) win->GetHandle();
+    UITextField *field = orca_ios_find_text_field(root);
+    if (field == nil) {
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-keyboard: " << where << " no UITextField under "
+                                 << (root ? [NSStringFromClass([root class]) UTF8String] : "(null handle)")
+                                 << " (" << (root ? (int) root.subviews.count : -1) << " subviews)";
+        return false;
+    }
+
+    field.keyboardType           = UIKeyboardTypeDecimalPad;
+    field.autocorrectionType     = UITextAutocorrectionTypeNo;
+    field.autocapitalizationType = UITextAutocapitalizationTypeNone;
+    field.spellCheckingType      = UITextSpellCheckingTypeNo;
+    field.smartDashesType        = UITextSmartDashesTypeNo;
+    field.smartQuotesType        = UITextSmartQuotesTypeNo;
+    field.smartInsertDeleteType  = UITextSmartInsertDeleteTypeNo;
+
+    OrcaNumericAccessory *target = [[OrcaNumericAccessory alloc] init];
+    target.field = field;
+    // The toolbar holds only a weak reference to its target, so the accessory
+    // has to be owned by the field or the first tap goes to a freed object.
+    objc_setAssociatedObject(field, &orca_ios_accessory_key, target,
+                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    [target release];
+
+    UIToolbar *bar = [[UIToolbar alloc] initWithFrame:CGRectMake(0, 0, 320, 44)];
+    bar.barStyle = UIBarStyleDefault;
+    UIBarButtonItem *sign = [[UIBarButtonItem alloc] initWithTitle:@"+/-"
+        style:UIBarButtonItemStylePlain target:target action:@selector(toggleSign)];
+    UIBarButtonItem *pct = [[UIBarButtonItem alloc] initWithTitle:@"%"
+        style:UIBarButtonItemStylePlain target:target action:@selector(insertPercent)];
+    UIBarButtonItem *comma = [[UIBarButtonItem alloc] initWithTitle:@","
+        style:UIBarButtonItemStylePlain target:target action:@selector(insertComma)];
+    UIBarButtonItem *gap = [[UIBarButtonItem alloc]
+        initWithBarButtonSystemItem:UIBarButtonSystemItemFlexibleSpace target:nil action:nil];
+    UIBarButtonItem *done = [[UIBarButtonItem alloc]
+        initWithBarButtonSystemItem:UIBarButtonSystemItemDone target:target action:@selector(done)];
+    bar.items = @[ sign, pct, comma, gap, done ];
+    [bar sizeToFit];
+    field.inputAccessoryView = bar;
+    [sign release]; [pct release]; [comma release]; [gap release]; [done release];
+    [bar release];
+
+    BOOST_LOG_TRIVIAL(error) << "orca-ios-keyboard: " << where << " decimal pad set";
+    return true;
+}
+
+void orca_ios_set_numeric_keyboard(wxWindow *win)
+{
+    if (orca_ios_apply_numeric_keyboard(win, "build:"))
+        return;
+
+    // Try again once the event loop has turned. Some of Orca's composite
+    // widgets finish assembling their children after their constructor returns,
+    // and a UITextField that does not exist yet cannot be configured. Retrying
+    // costs one block; not retrying costs a device round trip to find out.
+    win->CallAfter([win] { orca_ios_apply_numeric_keyboard(win, "deferred:"); });
+}
+
 } // namespace GUI
 } // namespace Slic3r
