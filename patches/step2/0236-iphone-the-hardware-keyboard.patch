+// ---------------------------------------------------------------------------
+// Which wxMenuItem a menu element belongs to
+// ---------------------------------------------------------------------------
+//
+// The element used to capture the wxMenuItem* in its handler block and call
+// straight through it. UIKit keeps the UIMenu tree it was handed - the menu
+// bar is rebuilt from it, and a UIKeyCommand is dispatched through the
+// responder chain rather than through the menu - so an element outlives the
+// wxMenuItem it was built for whenever a menu is rebuilt, which this port does
+// every time the application's mode changes. The captured pointer is dangling
+// from that moment on and nothing says so.
+//
+// Items are registered under the identifier their element carries and removed
+// again when they are destroyed, so a callback that arrives for an item that
+// no longer exists finds nothing and does nothing.
+
+static std::map<std::string, wxMenuItem*>& wxOSXIPhoneLiveMenuItems()
+{
+    static std::map<std::string, wxMenuItem*> s_items;
+    return s_items;
+}
+
+// Formatting the pointer does not dereference it, so this is safe to call for
+// an item that may already be gone - which is the whole point of the lookup.
+static std::string wxOSXIPhoneMenuItemKey( wxMenuItem* item )
+{
+    return wxString::Format( wxT("%p"), item ).ToStdString();
+}
+
+static void wxOSXIPhoneRunMenuItem( wxMenuItem* item )
+{
+    wxMenu* const menu = item->GetMenu();
+    if ( menu == nullptr )
+        return;
+
+    // What a menu does on a desktop the moment it is opened, and what nothing
+    // here does: UIKit took its copy of the menu tree when it built the bar and
+    // never asks again, so an item's enabled state as UIKit knows it is the
+    // state it had at build time. Ask the application now instead - otherwise
+    // a key equivalent runs a command that has since been disabled, which for
+    // "Export plate sliced file" means exporting a plate that has not been
+    // sliced.
+    menu->UpdateUI();
+    if ( !item->IsEnabled() )
+        return;
+
+    menu->HandleCommandProcess(item);
+}
+
+void wxOSXIPhoneDispatchMenuItem( wxMenuItem* item )
+{
+    const std::map<std::string, wxMenuItem*>& items = wxOSXIPhoneLiveMenuItems();
+    if ( items.find(wxOSXIPhoneMenuItemKey(item)) == items.end() )
+        return;
+
+    wxOSXIPhoneRunMenuItem(item);
+}
+
+void wxOSXIPhoneDispatchMenuCommand( NSString* identifier )
+{
+    if ( identifier == nil )
+        return;
+
+    const std::map<std::string, wxMenuItem*>& items = wxOSXIPhoneLiveMenuItems();
+    const std::map<std::string, wxMenuItem*>::const_iterator i =
+        items.find( wxCFStringRef::AsString(identifier).ToStdString() );
+    if ( i == items.end() )
+        return;
+
+    wxOSXIPhoneRunMenuItem(i->second);
+}
+
+// ---------------------------------------------------------------------------
+// An accelerator, as a key equivalent UIKit will actually press
+// ---------------------------------------------------------------------------
+//
+// Returns nil when the accelerator must not become one, and there are three
+// reasons for that, all of them about not taking a key away from typing:
+//
+//   * no modifier, or Shift alone. A UIKeyCommand on a bare key captures it
+//     everywhere in the application, text fields included - a menu item on
+//     plain Del would stop Del from deleting a character. Those accelerators
+//     are left to the key events the focused window gets, which is where they
+//     belong.
+//   * a key with no input string UIKit understands.
+//   * Quit. wx rewrites any "Exit" item to "Quit\tCtrl+Q" in the wxMenuItem
+//     constructor, and on iOS an application does not quit: the item would
+//     tear the process down on a keystroke the user meant for something else,
+//     with the platform treating the result as a crash.
+static NSString* wxOSXIPhoneKeyCommandInput( int key )
+{
+    switch ( key )
+    {
+        case WXK_UP:            return UIKeyInputUpArrow;
+        case WXK_DOWN:          return UIKeyInputDownArrow;
+        case WXK_LEFT:          return UIKeyInputLeftArrow;
+        case WXK_RIGHT:         return UIKeyInputRightArrow;
+        case WXK_ESCAPE:        return UIKeyInputEscape;
+        case WXK_PAGEUP:        return UIKeyInputPageUp;
+        case WXK_PAGEDOWN:      return UIKeyInputPageDown;
+        case WXK_HOME:          return UIKeyInputHome;
+        case WXK_END:           return UIKeyInputEnd;
+        case WXK_DELETE:        return UIKeyInputDelete;
+        case WXK_RETURN:        return @"\r";
+        case WXK_NUMPAD_ENTER:  return @"\r";
+        case WXK_TAB:           return @"\t";
+        case WXK_SPACE:         return @" ";
+        case WXK_BACK:          return @"\b";
+
+        case WXK_F1:            return UIKeyInputF1;
+        case WXK_F2:            return UIKeyInputF2;
+        case WXK_F3:            return UIKeyInputF3;
+        case WXK_F4:            return UIKeyInputF4;
+        case WXK_F5:            return UIKeyInputF5;
+        case WXK_F6:            return UIKeyInputF6;
+        case WXK_F7:            return UIKeyInputF7;
+        case WXK_F8:            return UIKeyInputF8;
+        case WXK_F9:            return UIKeyInputF9;
+        case WXK_F10:           return UIKeyInputF10;
+        case WXK_F11:           return UIKeyInputF11;
+        case WXK_F12:           return UIKeyInputF12;
+
+        default:
+            break;
+    }
+
+    // An ordinary printable key. Lower case, with Shift carried in the
+    // modifier flags: that is the pairing UIKit matches against, and an upper
+    // case input with the Shift flag set matches nothing.
+    if ( key > ' ' && key < 127 )
+    {
+        const char c = (char) ((key >= 'A' && key <= 'Z') ? key - 'A' + 'a' : key);
+        return [NSString stringWithFormat:@"%c", c];
+    }
+
+    return nil;
+}
+
+static UIKeyCommand* wxOSXIPhoneKeyCommandFor( wxMenuItem* peer, wxAcceleratorEntry* entry, int menuid )
+{
+    if ( entry == nullptr )
+        return nil;
+
+    if ( menuid == wxID_EXIT || menuid == wxApp::s_macExitMenuItemId )
+        return nil;
+
+    const int flags = entry->GetFlags();
+
+    UIKeyModifierFlags modifiers = 0;
+    if ( flags & wxACCEL_CTRL )
+        modifiers |= UIKeyModifierCommand;
+    if ( flags & wxACCEL_RAW_CTRL )
+        modifiers |= UIKeyModifierControl;
+    if ( flags & wxACCEL_ALT )
+        modifiers |= UIKeyModifierAlternate;
+
+    // Shift on its own is not a shortcut modifier, it is how capital letters
+    // are typed, so it only counts once one of the three above is there too.
+    if ( modifiers == 0 )
+        return nil;
+
+    if ( flags & wxACCEL_SHIFT )
+        modifiers |= UIKeyModifierShift;
+
+    NSString* const input = wxOSXIPhoneKeyCommandInput( entry->GetKeyCode() );
+    if ( input == nil )
+        return nil;
+
+    UIKeyCommand* const command =
+        [UIKeyCommand keyCommandWithInput:input
+                            modifierFlags:modifiers
+                                   action:@selector(wxOSXMenuCommand:)];
+
+    // The identifier the item is registered under, so the delegate that
+    // receives the action can find the item without holding a pointer to it.
+    wxCFStringRef cfidentifier(wxString::Format( wxT("%p"), peer ));
+    command.propertyList = cfidentifier.AsNSString();
+
+    return command;
+}
