@@ -5,6 +5,139 @@ static bool gDarkMode = false;
 
 static bool operator<(wxColour const &l, wxColour const &r) { return l.GetRGBA() < r.GetRGBA(); }
 
+#if defined(__APPLE__) && !TARGET_OS_OSX
+// ===========================================================================
+// THE PALETTE OF THE INTERFACE, on this port.
+//
+// Orca's colours are written into the source as literal hex, forty-odd of
+// them, and the table below this one is how it turns each into something
+// darker when the appearance is dark. That table is a list of pairs with no
+// scale behind it: two greys a shade apart for no reason, a window background
+// unrelated to the panel on top of it, and nothing at all for light mode,
+// where every colour in the source is used exactly as written.
+//
+// This replaces it, for both appearances, with a scale: a page, surfaces that
+// sit on it, fills, borders and four weights of text - warm neutrals, the ORCA
+// turquoise as the one accent - and a mapping from each colour Orca asks for
+// onto the tone it means. Every colour the interface draws is one of these,
+// which is what makes the two appearances look like one design rather than a
+// theme and its inversion.
+//
+// Reading it:
+//   * the tones are the design. Change a tone and everything that means that
+//     tone follows, in both appearances.
+//   * the mapping says what each of Orca's colours means. The comments are
+//     Orca's own, from the table below.
+//   * status colours - the blue, the orange, the red - are not chrome and are
+//     not in the scale. They keep Orca's own values.
+//
+// The same scale is written out again in CSS for the web pages, which cannot
+// call this: resources/web/include/global.css and each page's body background.
+// ===========================================================================
+struct OrcaIosTone { char const *light; char const *dark; };
+
+// The page, and what sits on it.
+static const OrcaIosTone kPage      = {"#FAF9F5", "#262624"}; // window, 3D view, every page
+static const OrcaIosTone kSurface   = {"#FFFEFB", "#30302E"}; // cards, inputs, popups, headers
+static const OrcaIosTone kSunken    = {"#F2F0E9", "#1C1B1A"}; // side strips, top bar, deeper bands
+static const OrcaIosTone kFill      = {"#EDEAE0", "#3A3A37"}; // button faces, tracks, row highlight
+static const OrcaIosTone kFillHover = {"#E4E0D3", "#45443F"}; // and the same under the pointer
+static const OrcaIosTone kKnob      = {"#FFFDF7", "#C9C6BE"}; // the moving part of a switch
+// Lines.
+static const OrcaIosTone kBorder    = {"#E2DFD5", "#3E3E3B"}; // separators, title lines
+static const OrcaIosTone kBorderTop = {"#D2CEC1", "#514F4A"}; // input, combo and box outlines
+// Text, four weights.
+static const OrcaIosTone kText      = {"#1F1E1D", "#F5F4EF"}; // what you read
+static const OrcaIosTone kTextSoft  = {"#3F3E3A", "#E5E3DC"}; // headings and labels
+static const OrcaIosTone kTextMuted = {"#6F6E69", "#B4B2AA"}; // secondary, units, side text
+static const OrcaIosTone kTextDim   = {"#A3A099", "#7C7A74"}; // disabled
+// The accent: ORCA turquoise, and it is the only accent.
+static const OrcaIosTone kAccent     = {"#009688", "#2CA898"};
+static const OrcaIosTone kAccentHov  = {"#00897B", "#4DBFAF"};
+static const OrcaIosTone kAccentTint = {"#DCEFEC", "#1E3A36"}; // checked row behind the accent
+static const OrcaIosTone kAccentSoft = {"#EDF6F4", "#22322F"}; // focused field behind the accent
+
+// What each colour Orca writes into the source means. Comments are Orca's.
+static const struct { char const *orca; OrcaIosTone const *tone; } kOrcaIosPalette[] = {
+    {"#FFFFFF", &kPage},      // Window background
+    {"#F8F8F8", &kSurface},   // Sidebar > Titlebar > Gradient Top | monitor titlebar
+    {"#F4F4F4", &kSurface},   // panel surface
+    {"#FEFFFF", &kSurface},   // Side Tabbar bg
+    {"#F1F1F1", &kFill},      // Sidebar > Titlebar > Gradient Bottom | row highlight
+    {"#F0F0F1", &kFill},      // Disabled element background
+    {"#E8E8E8", &kFill},      // a fill
+    {"#DFDFDF", &kFill},      // Button Background color
+    {"#D9D9D9", &kFill},      // Sidebar > Toggle button track color
+    {"#D4D4D4", &kFillHover}, // Button Background color on Hover
+    {"#CECECE", &kSunken},    // Sidebar wxPanel bg
+    {"#3B4446", &kSunken},    // Top Bar / Main tab bar bg color
+    {"#FFFEFE", &kKnob},      // Sidebar > Toggle button thumb color
+    {"#EEEEEE", &kBorder},    // Separator Line | Title Line Color
+    {"#A6A9AA", &kBorder},    // Seperator color
+    {"#DBDBDB", &kBorderTop}, // Input/Combo Box Border Color
+    {"#000000", &kText},      // Mostly Text color wxBlack
+    {"#262E30", &kText},      // Button text color | Input Text Color
+    {"#2C2C2E", &kText},      // a text colour
+    {"#323A3D", &kTextSoft},  // Softer text color
+    {"#323A3C", &kTextSoft},  // Text color used on search list
+    {"#303A3C", &kTextSoft},  // Object Table > Column header | StaticBox Border Color
+    {"#363636", &kTextSoft},  // Sidebar > Parameter Label/Title | Sidebar tab text
+    {"#6B6A6A", &kTextMuted}, // Button Dimmed text
+    {"#6B6B6A", &kTextMuted}, // Input box side text
+    {"#2B3436", &kTextMuted}, // Leftover from BBS, main fill colour of icons
+    {"#6B6B6B", &kTextDim},   // Disabled Text
+    {"#ACACAC", &kTextDim},   // Disabled Text on boxes | Dimmed Elements
+    {"#9E9E9E", &kTextDim},   //
+    {"#ABABAB", &kTextDim},   //
+    {"#009688", &kAccent},    // ORCA color
