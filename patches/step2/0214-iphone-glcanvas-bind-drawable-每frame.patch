diff --git a/src/osx/iphone/glcanvas.mm b/src/osx/iphone/glcanvas.mm
index 1b263a3..c13f5ff 100644
--- a/src/osx/iphone/glcanvas.mm
+++ b/src/osx/iphone/glcanvas.mm
@@ -109,11 +109,54 @@ bool wxGLContext::SetCurrent(const wxGLCanvas& win) const
         return false;
 
     wxUICustomOpenGLView* v = (wxUICustomOpenGLView*) win.GetPeer()->GetWXWidget();
-    if ( v.context != m_glContext ) {
+    if ( v.context != m_glContext )
         [v setContext:m_glContext];
+
+    WXGLSetCurrentContext(m_glContext);
+
+    // -bindDrawable builds GLKView's framebuffer from the backing CAEAGLLayer,
+    // and it fails while that layer has no usable size - which is the state
+    // right after DoCreate, before any sizer has laid the canvas out. The
+    // original code bound only when the context pointer changed, so that first
+    // failure was permanent and every later frame drew into an incomplete
+    // framebuffer:
+    //
+    //   Failed to bind EAGLDrawable: <CAEAGLLayer: 0x...> to GL_RENDERBUFFER 1
+    //   Failed to make complete framebuffer object 8cd6   (INCOMPLETE_ATTACHMENT)
+    //
+    // Retrying while the drawable reports no size fixes the ordering problem
+    // but not a layer that can never back a renderbuffer, and on Orca the
+    // viewport stayed empty either way. Report what the view actually looks
+    // like at the moment of the failure, once, so the difference between "too
+    // early" and "wrong geometry" stops being a guess. wxLogTrace would be
+    // swallowed here - the app's own log sink is not up yet at this point, and
+    // NSLog is what the simulator console captures.
+    if ( v.drawableWidth == 0 || v.drawableHeight == 0 )
+    {
         [v bindDrawable];
+
+        if ( v.drawableWidth == 0 || v.drawableHeight == 0 )
+        {
+            static bool s_reported = false;
+            if ( !s_reported )
+            {
+                s_reported = true;
+                CGRect b = v.bounds;
+                CGRect f = v.frame;
+                NSLog(@"wxGLCanvas: drawable still 0 after bindDrawable. "
+                       "bounds=%.1fx%.1f frame=(%.1f,%.1f %.1fx%.1f) scale=%.2f "
+                       "window=%@ superview=%@ hidden=%d layer=%@ layerBounds=%.1fx%.1f",
+                      b.size.width, b.size.height,
+                      f.origin.x, f.origin.y, f.size.width, f.size.height,
+                      v.contentScaleFactor,
+                      v.window ? @"yes" : @"nil",
+                      v.superview ? NSStringFromClass([v.superview class]) : @"nil",
+                      (int) v.hidden,
+                      NSStringFromClass([v.layer class]),
+                      v.layer.bounds.size.width, v.layer.bounds.size.height);
+            }
+        }
     }
-    WXGLSetCurrentContext(m_glContext);
 
     return true;
 }
