diff --git a/src/slic3r/CMakeLists.txt b/src/slic3r/CMakeLists.txt
index 1365e54d..fd829a07 100644
--- a/src/slic3r/CMakeLists.txt
+++ b/src/slic3r/CMakeLists.txt
@@ -734,6 +734,26 @@ if (UNIX AND NOT APPLE)
     )
 endif ()
 
+# Native Bambu LAN backend (MQTT over TLS + FTPS), replacing the closed network
+# plugin that has no iOS build and could not be loaded there anyway. The sources
+# are shipped by this repo's orca-overlay/, so the guard keeps a plain upstream
+# checkout building unchanged.
+if (EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/Utils/BambuLanPrinterAgent.cpp")
+    list(APPEND SLIC3R_GUI_SOURCES
+            Utils/BambuLanMqtt.cpp
+            Utils/BambuLanMqtt.hpp
+            Utils/BambuLanFtps.cpp
+            Utils/BambuLanFtps.hpp
+            Utils/BambuLanDiscovery.cpp
+            Utils/BambuLanDiscovery.hpp
+            Utils/BambuLanPrintCommand.cpp
+            Utils/BambuLanPrintCommand.hpp
+            Utils/BambuLanPrinterAgent.cpp
+            Utils/BambuLanPrinterAgent.hpp
+        )
+    set(ORCA_BAMBU_LAN_AGENT ON)
+endif ()
+
 set(ORCA_UPDATER_SIG_KEY_B64 "${ORCA_UPDATER_SIG_KEY}")
 string(STRIP "${ORCA_UPDATER_SIG_KEY_B64}" ORCA_UPDATER_SIG_KEY_B64)
 string(REPLACE "\n" "" ORCA_UPDATER_SIG_KEY_B64 "${ORCA_UPDATER_SIG_KEY_B64}")
@@ -790,6 +810,12 @@ else ()
 endif ()
 target_link_libraries(libslic3r_gui libslic3r cereal::cereal imgui imguizmo minilzo libvgcode md4c-html glad ${_opengl_link_lib} hidapi mdns ${wxWidgets_LIBRARIES} ${_orca_glfw_link} libcurl OpenSSL::SSL OpenSSL::Crypto noise::noise)
 
+# Switches NetworkAgentFactory over to the native LAN agent. Set above, only
+# when the overlay sources are present.
+if (ORCA_BAMBU_LAN_AGENT)
+    target_compile_definitions(libslic3r_gui PRIVATE ORCA_BAMBU_LAN_AGENT)
+endif ()
+
 
 if (MSVC)
     target_link_libraries(libslic3r_gui Setupapi.lib)
