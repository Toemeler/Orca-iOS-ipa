+// Give a numeric field the number keyboard.
+//
+// iOS picks the keyboard per text field, and every field in this application
+// was getting the full QWERTY one - so entering a layer height meant a
+// full-size alphabetic keyboard covering half the screen, and hunting for the
+// digits row. UIKeyboardTypeNumbersAndPunctuation is the compact one, and it is
+// the right choice for Orca specifically rather than the pure number pad:
+//
+//   * it has a minus sign, which every position and offset field needs;
+//   * it has a decimal point AND a comma, so coPoints fields ("0.4,0.6") work;
+//   * it has a percent sign, for coFloatOrPercent;
+//   * it keeps a return key, so the keyboard can still be dismissed. The
+//     decimal pad has no return key at all, and adding one means an input
+//     accessory view on every field - a whole mechanism to avoid needing.
+//
+// The widget passed in is usually one of Orca's composites (::TextInput,
+// ::SpinInput, ::TempInput) rather than a bare wxTextCtrl, so this walks down
+// to the first UITextField rather than assuming the handle is one. That keeps
+// it working for all of them without knowing how any of them is built.
+static UITextField *orca_ios_find_text_field(UIView *view)
+{
+    if (view == nil)
+        return nil;
+    if ([view isKindOfClass:[UITextField class]])
+        return (UITextField *) view;
+    for (UIView *sub in view.subviews) {
+        UITextField *found = orca_ios_find_text_field(sub);
+        if (found != nil)
+            return found;
+    }
+    return nil;
+}
+
+void orca_ios_set_numeric_keyboard(wxWindow *win)
+{
+    if (win == nullptr)
+        return;
+    UITextField *field = orca_ios_find_text_field((UIView *) win->GetHandle());
+    if (field == nil)
+        return;
+
+    field.keyboardType            = UIKeyboardTypeNumbersAndPunctuation;
+    field.autocorrectionType      = UITextAutocorrectionTypeNo;
+    field.autocapitalizationType  = UITextAutocapitalizationTypeNone;
+    field.spellCheckingType       = UITextSpellCheckingTypeNo;
+    field.smartDashesType         = UITextSmartDashesTypeNo;
+    field.smartQuotesType         = UITextSmartQuotesTypeNo;
+    field.smartInsertDeleteType   = UITextSmartInsertDeleteTypeNo;
+}
+
 } // namespace GUI
 } // namespace Slic3r
