+    if (get("log_severity_level").empty()) {
+#if defined(__APPLE__) && !TARGET_OS_OSX
+        // "info" is not survivable on a tablet. A first launch writes 49 MB of
+        // log in 61 seconds - one 25 MB line for the setup wizard's profile
+        // JSON, and a line per filament of every one of 132 vendors - and the
+        // app spends that time doing I/O rather than finishing startup, which
+        // is what leaves the wizard sitting on "Loading......".
+        // "warning" keeps everything this port's own instrumentation emits: the
+        // window tree and the GL report log at error, and wx's own messages
+        // arrive at warning through wxBoostLog in GUI_App.cpp.
+        set("log_severity_level", "warning");
+#else
         set("log_severity_level", "info");
