+// -- what MainFrame describes ----------------------------------------------
+//
+// One entry at a time, so that nothing but const char* and a byte count has to
+// be agreed between this translation unit and MainFrame.cpp.
+
+void orca_ios_gallery_begin()
+{
+    [gs_orca_gallery_pending release];
+    gs_orca_gallery_pending = [[NSMutableArray alloc] init];
+}
+
+void orca_ios_gallery_add(const char *path, const char *name, const char *when,
+                          const void *png, size_t png_len)
+{
+    if (gs_orca_gallery_pending == nil || path == nullptr)
+        return;
+
+    OrcaProject *const project = [[[OrcaProject alloc] init] autorelease];
+    project.path = [NSString stringWithUTF8String:path];
+    project.name = [NSString stringWithUTF8String:name != nullptr ? name : ""];
+    project.when = [NSString stringWithUTF8String:when != nullptr ? when : ""];
+    // The bytes are the 3MF's own preview PNG, as bbs_3mf_get_thumbnail read
+    // them - copied here because the std::string they came from is a local in
+    // the caller and the tile outlives the call.
+    if (png != nullptr && png_len > 0) {
+        NSData *const data = [NSData dataWithBytes:png length:png_len];
+        project.thumb = [UIImage imageWithData:data];
+    }
+    [gs_orca_gallery_pending addObject:project];
+}
+
+void orca_ios_gallery_commit()
+{
+    if (gs_orca_gallery_pending == nil)
+        return;
+    [gs_orca_gallery_items release];
+    gs_orca_gallery_items   = gs_orca_gallery_pending;   // the +1 moves across
+    gs_orca_gallery_pending = nil;
+    [gs_orca_gallery setProjects:gs_orca_gallery_items];
