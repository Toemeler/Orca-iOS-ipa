+// What the native Slice / Print capsule should be showing. Read from the very
+// buttons Orca would have drawn in the strip, so a label that changes to "Slice
+// all", or a button that greys out while a slice runs, carries across on its
+// own. IsShown() is Orca's own decision about whether this pair belongs on the
+// current tab, and it is respected rather than second-guessed.
+void MainFrame::orca_ios_sync_side_tools()
+{
+    orca_ios_side_tools_begin();
+    if (m_slice_btn != nullptr && m_slice_btn->IsShown())
+        orca_ios_side_tools_add("slice", into_u8(m_slice_btn->GetLabel()).c_str(),
+                                m_slice_btn->IsEnabled(), true);
+    if (m_print_btn != nullptr && m_print_btn->IsShown())
+        orca_ios_side_tools_add("print", into_u8(m_print_btn->GetLabel()).c_str(),
+                                m_print_btn->IsEnabled(), false);
+    orca_ios_side_tools_commit();
+}
+
+// A tap. Posted to the button itself, so everything bound to it - and there is
+// a good deal, from exiting the gizmo to picking which plate - runs exactly as
+// it does on the desktop.
+void MainFrame::orca_ios_run_side_tool(const char *id)
+{
+    if (id == nullptr)
+        return;
+    const std::string item(id);
+    SideButton *const btn = item == "slice" ? m_slice_btn
+                          : item == "print" ? m_print_btn : nullptr;
+    if (btn == nullptr || !btn->IsEnabled())
+        return;
+    wxCommandEvent evt(wxEVT_BUTTON, btn->GetId());
+    evt.SetEventObject(btn);
+    btn->GetEventHandler()->ProcessEvent(evt);
+}
+
+// Called from the capsule, which knows nothing about MainFrame.
+void orca_ios_side_tool_action(const char *id)
+{
+    if (wxGetApp().mainframe != nullptr)
+        wxGetApp().mainframe->orca_ios_run_side_tool(id);
+}
