 namespace Slic3r {
 
+// boost::filesystem::absolute(p) is absolute(p, current_path()) - the default
+// second argument is evaluated unconditionally, even when p is already
+// absolute. current_path() is getcwd(), and an iOS app is not permitted to
+// call it: it fails with EPERM and boost throws
+//
+//   boost::filesystem::current_path: Operation not permitted [system:1]
+//
+// which escapes GUI_App::on_init_inner and aborts the process during startup.
+// Every dir_path reaching the call sites below is already absolute
+// (data_dir() + ...), so the cwd is never actually needed. Ask for it only
+// when it is.
+//
+// This is why the app died on a *first* launch and ran on the second: Orca
+// chdir()s to data_dir()/log during startup, which fails while that directory
+// does not exist yet, leaving the process on a cwd it cannot read.
+static boost::filesystem::path orca_absolute_no_cwd(const boost::filesystem::path &p)
+{
+    return p.is_absolute() ? p : boost::filesystem::absolute(p);
+}
+
 namespace {
 
