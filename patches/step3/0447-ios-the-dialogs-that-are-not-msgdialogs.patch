+bool orca_ios_alert_from_buttons(wxDialog *dlg, const wxString &title,
+                                 const wxString &message, int *result)
+{
+    if (dlg == nullptr)
+        return false;
+
+    // Direct children only, and in child order - which is creation order, and
+    // therefore the order the dialog's own sizer put them in.
+    std::vector<IOSAlertButton> rows;
+    for (wxWindow *const child : dlg->GetChildren()) {
+        ::Button *const btn = dynamic_cast<::Button *>(child);
+        if (btn == nullptr || !btn->IsShown())
+            continue;
+
+        IOSAlertButton row;
+        row.label       = btn->GetLabel();
+        row.id          = btn->GetId();
+        row.widget      = btn;
+        row.enabled     = btn->IsEnabled();
+        row.preferred   = row.id == wxID_OK || row.id == wxID_YES || row.id == wxID_APPLY;
+        row.cancel      = row.id == wxID_CANCEL || row.id == wxID_NO || row.id == wxID_CLOSE;
+        row.destructive = row.id == wxID_DELETE || row.id == wxID_REMOVE;
+        rows.push_back(row);
+    }
+
+    if (rows.empty())
+        return false;
+
+    // MOST OF THESE BUTTONS HAVE NO ID. They are built as `new Button(this,
+    // _L("Retry"))` and answer with EndModal(wxYES) from a handler, so the
+    // return code is right and the id is a generated negative number that says
+    // nothing about the role. What is reliable is the order: this family lays
+    // the affirmative out first and the way out after it, so when no id was
+    // recognised the first row is the one to draw bold.
+    bool named = false;
+    for (const IOSAlertButton &row : rows) {
+        if (row.preferred || row.cancel) {
+            named = true;
+            break;
+        }
+    }
+    if (!named)
+        rows.front().preferred = true;
+
+    // An empty message means "the text is in the dialog". It usually is: these
+    // dialogs build a Label in the constructor, hand it to a sizer and keep no
+    // pointer to it, so the only place the sentence exists afterwards is the
+    // control itself. Orca's Label derives from wxStaticText, so one walk finds
+    // both kinds.
+    wxString text = message;
+    if (text.IsEmpty()) {
+        for (wxWindow *const child : dlg->GetChildren()) {
+            const wxStaticText *const label = dynamic_cast<const wxStaticText *>(child);
+            if (label == nullptr)
+                continue;
+            const wxString line = label->GetLabel();
+            if (line.IsEmpty())
+                continue;
+            if (!text.IsEmpty())
+                text += "\n\n";
+            text += line;
+        }
+    }
+
+    int code = wxID_CANCEL;
+    if (!orca_ios_alert_run(dlg, title, text, rows, nullptr, &code))
+        return false;
+
+    if (result != nullptr)
+        *result = code;
+    return true;
+}
