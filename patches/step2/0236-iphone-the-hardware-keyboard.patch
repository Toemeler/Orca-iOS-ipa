+//     or a custom control handles its own keys in. Copy, paste, delete,
+//     select-all, the view keys: all of them are wxEVT_CHAR handlers.
+//
+// The order below - hook, then key down, then char if key down was skipped -
+// is wxWidgetCocoaImpl::DoHandleKeyEvent()'s, so an application behaves the
+// same here as it does on macOS.
+bool wxWidgetIPhoneImpl::DoHandleKeyEvent(UIPress* press, UIEvent* event)
+{
+    wxKeyEvent wxevent(wxEVT_KEY_DOWN);
+    SetupKeyEvent( wxevent, event, press );
+
+    if ( wxevent.GetEventType() != wxEVT_KEY_DOWN )
+        return GetWXPeer()->OSXHandleKeyEvent(wxevent);
+
+    wxKeyEvent eventHook(wxEVT_CHAR_HOOK, wxevent);
+    if ( GetWXPeer()->OSXHandleKeyEvent(eventHook) && !eventHook.IsNextEventAllowed() )
+    {
+        wxLogTrace(TRACE_KEYS, "Key down event handled by char hook");
+        return true;
+    }
+
+    if ( GetWXPeer()->OSXHandleKeyEvent(wxevent) )
+        return true;
+
+    wxKeyEvent eventChar(wxEVT_CHAR, wxevent);
+    SetupKeyEvent( eventChar, event, press );
+    return GetWXPeer()->OSXHandleKeyEvent(eventChar);
+}
