+// -- the home gallery ------------------------------------------------------
+//
+// WHAT THIS REPLACES.
+//
+// The home page draws the recent projects as `<div class="FileItem">` rows in
+// a WKWebView (resources/web/homepage/js/home.js, ShowRecentFileList) and hangs
+// a hand-drawn `#recnet_context_menu` off a jQuery contextmenu handler. On a
+// tablet none of that is reachable: there is no right click to open the menu,
+// no pointer hover state a web page can draw the way the platform draws one,
+// and no way to pick several files at once. The list is hidden
+// (css/orca-ios.css) and this is what stands in its place - a
+// UICollectionView, so the long press, the hover, the multiple selection, the
+// drag and the share sheet are all the system's own and behave the way they do
+// in every other application on the device.
+//
+// It is fed from MainFrame::orca_ios_push_gallery(), which is called from
+// WebViewPanel::SendRecentList - the one function every path that changes the
+// recent list already ends in. Nothing here polls.
+//
+// WHERE IT LIVES. In the tab bar controller's view, beside the plus, and for
+// the same reason (see orca_ios_plus_host): wx hangs gesture recognisers off
+// every view it wraps, and a UIKit control buried under those does not get a
+// clean touch. That also means it is not inside the home page, so its
+// visibility has to follow the notebook - orca_ios_gallery_update() does that
+// from the tab bar's sync, exactly as the plus does.
+
+// src/slic3r/GUI/MainFrame.cpp - what a row does when it is chosen, in the
+// words the application already has for them. Everything here is deferred on
+// that side, because these are called from inside UIKit actions.
+namespace Slic3r { namespace GUI {
+void orca_ios_gallery_open(const char *path);
+void orca_ios_gallery_forget(const char *path);
+void orca_ios_gallery_delete(const char *path);
+void orca_ios_gallery_duplicate(const char *path);
+void orca_ios_gallery_rename(const char *path, const char *new_stem);
+void orca_ios_gallery_new_project();
+void orca_ios_gallery_import();
+void orca_ios_gallery_refresh();
+// src/slic3r/GUI/MainFrame.cpp - the tab to land on once a project is open.
+void orca_ios_select_prepare();
+} }
+
+static const CGFloat kOrcaTileMin    = 176;  // the narrowest a tile may get
+static const CGFloat kOrcaTileGap    = 16;
+static const CGFloat kOrcaTileCorner = 14;
+static const CGFloat kOrcaGalleryPad = 20;
+
+// One project, as the C++ side describes it.
+@interface OrcaProject : NSObject
+@property (nonatomic, copy)   NSString *path;
+@property (nonatomic, copy)   NSString *name;
+@property (nonatomic, copy)   NSString *when;
+@property (nonatomic, retain) UIImage  *thumb;
+@end
+
+@implementation OrcaProject
+- (void)dealloc
+{
+    [_path release];
+    [_name release];
+    [_when release];
+    [_thumb release];
+    [super dealloc];
+}
+@end
+
+// -- a tile -----------------------------------------------------------------
+
+@interface OrcaProjectCell : UICollectionViewCell
+@property (nonatomic, retain) UIView      *card;
+@property (nonatomic, retain) UIImageView *shot;
+@property (nonatomic, retain) UILabel     *title;
+@property (nonatomic, retain) UILabel     *subtitle;
+@property (nonatomic, retain) UIImageView *tick;
+- (void)fillWith:(OrcaProject *)project selecting:(BOOL)selecting picked:(BOOL)picked;
+@end
+
+@implementation OrcaProjectCell
+
+- (instancetype)initWithFrame:(CGRect)frame
+{
+    self = [super initWithFrame:frame];
+    if (self == nil)
+        return nil;
+
+    _card                  = [[UIView alloc] initWithFrame:CGRectZero];
+    _card.backgroundColor  = [UIColor secondarySystemBackgroundColor];
+    _card.layer.cornerRadius  = kOrcaTileCorner;
+    _card.layer.cornerCurve   = kCACornerCurveContinuous;
+    _card.layer.borderWidth   = 1.0 / [UIScreen mainScreen].scale;
+    _card.layer.borderColor   = [UIColor separatorColor].CGColor;
+    _card.clipsToBounds       = YES;
+    _card.translatesAutoresizingMaskIntoConstraints = NO;
+
+    _shot             = [[UIImageView alloc] initWithFrame:CGRectZero];
+    _shot.contentMode = UIViewContentModeScaleAspectFit;
+    _shot.translatesAutoresizingMaskIntoConstraints = NO;
+
+    _title                  = [[UILabel alloc] initWithFrame:CGRectZero];
+    _title.font             = [UIFont preferredFontForTextStyle:UIFontTextStyleSubheadline];
+    _title.textColor        = [UIColor labelColor];
+    _title.lineBreakMode    = NSLineBreakByTruncatingMiddle;
+    _title.translatesAutoresizingMaskIntoConstraints = NO;
+
+    _subtitle               = [[UILabel alloc] initWithFrame:CGRectZero];
+    _subtitle.font          = [UIFont preferredFontForTextStyle:UIFontTextStyleCaption1];
+    _subtitle.textColor     = [UIColor secondaryLabelColor];
+    _subtitle.translatesAutoresizingMaskIntoConstraints = NO;
+
+    _tick                   = [[UIImageView alloc] initWithFrame:CGRectZero];
+    _tick.tintColor         = [UIColor whiteColor];
+    _tick.hidden            = YES;
+    _tick.translatesAutoresizingMaskIntoConstraints = NO;
+
+    [self.contentView addSubview:_card];
+    [_card addSubview:_shot];
+    [self.contentView addSubview:_title];
+    [self.contentView addSubview:_subtitle];
+    [self.contentView addSubview:_tick];
+
+    UIView *const content = self.contentView;
+    [NSLayoutConstraint activateConstraints:@[
+        [_card.leadingAnchor  constraintEqualToAnchor:content.leadingAnchor],
+        [_card.trailingAnchor constraintEqualToAnchor:content.trailingAnchor],
+        [_card.topAnchor      constraintEqualToAnchor:content.topAnchor],
+        [_card.heightAnchor   constraintEqualToAnchor:_card.widthAnchor multiplier:0.72],
+
+        [_shot.leadingAnchor  constraintEqualToAnchor:_card.leadingAnchor  constant:6],
+        [_shot.trailingAnchor constraintEqualToAnchor:_card.trailingAnchor constant:-6],
+        [_shot.topAnchor      constraintEqualToAnchor:_card.topAnchor      constant:6],
+        [_shot.bottomAnchor   constraintEqualToAnchor:_card.bottomAnchor   constant:-6],
+
+        [_title.leadingAnchor  constraintEqualToAnchor:content.leadingAnchor constant:2],
+        [_title.trailingAnchor constraintEqualToAnchor:content.trailingAnchor constant:-2],
+        [_title.topAnchor      constraintEqualToAnchor:_card.bottomAnchor constant:7],
+
+        [_subtitle.leadingAnchor  constraintEqualToAnchor:_title.leadingAnchor],
+        [_subtitle.trailingAnchor constraintEqualToAnchor:_title.trailingAnchor],
+        [_subtitle.topAnchor      constraintEqualToAnchor:_title.bottomAnchor constant:1],
+
+        [_tick.trailingAnchor constraintEqualToAnchor:_card.trailingAnchor constant:-8],
+        [_tick.bottomAnchor   constraintEqualToAnchor:_card.bottomAnchor   constant:-8],
+        [_tick.widthAnchor    constraintEqualToConstant:26],
+        [_tick.heightAnchor   constraintEqualToConstant:26],
+    ]];
+
+    // THE HOVER, and it is the platform's rather than ours. A trackpad, a
+    // mouse or an Apple Pencil hovering over a tile lifts it the way the
+    // pointer lifts an icon on the Home Screen; nothing here has to track the
+    // pointer, draw a highlight or undo one. Off the card rather than the
+    // whole cell so the label underneath does not lift with it.
+    self.hoverStyle = [UIHoverStyle styleWithEffect:[UIHoverLiftEffect effect]
+                                              shape:[UIShape rectShapeWithCornerRadius:kOrcaTileCorner]];
+    return self;
+}
+
+- (void)dealloc
+{
+    [_card release];
+    [_shot release];
+    [_title release];
+    [_subtitle release];
+    [_tick release];
+    [super dealloc];
+}
+
+- (void)fillWith:(OrcaProject *)project selecting:(BOOL)selecting picked:(BOOL)picked
+{
+    self.title.text    = project.name;
+    self.subtitle.text = project.when;
+    self.shot.image    = project.thumb;
+
+    // A project with no thumbnail is a project whose 3MF could not be read -
+    // it is missing, or it was written by something that did not put a preview
+    // in it. Say which of those with the glyph rather than leaving a grey box.
+    if (project.thumb == nil) {
+        UIImageSymbolConfiguration *const cfg =
+            [UIImageSymbolConfiguration configurationWithPointSize:34
+                                                            weight:UIImageSymbolWeightRegular];
+        self.shot.image     = [UIImage systemImageNamed:@"cube.transparent" withConfiguration:cfg];
+        self.shot.tintColor = [UIColor tertiaryLabelColor];
+    }
+
+    self.tick.hidden = !selecting;
+    if (selecting) {
+        UIImageSymbolConfiguration *const cfg =
+            [UIImageSymbolConfiguration configurationWithPointSize:24
+                                                            weight:UIImageSymbolWeightSemibold];
+        self.tick.image = [UIImage systemImageNamed:picked ? @"checkmark.circle.fill" : @"circle"
+                                  withConfiguration:cfg];
+        self.tick.tintColor = picked ? orca_ios_accent() : [UIColor secondaryLabelColor];
+    }
+    self.card.layer.borderColor = (selecting && picked ? orca_ios_accent()
+                                                       : [UIColor separatorColor]).CGColor;
+    self.card.layer.borderWidth = (selecting && picked ? 2.0
+                                                       : 1.0 / [UIScreen mainScreen].scale);
+}
+
+@end
