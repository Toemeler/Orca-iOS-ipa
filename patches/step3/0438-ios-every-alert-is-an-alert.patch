+void MsgDialog::orca_ios_note_content(wxWindow *window, const wxString &text,
+                                      const wxString &link_text,
+                                      std::function<void(const wxString &)> link_callback)
+{
+    if (window != nullptr)
+        m_ios_content.push_back(window);
+
+    // Appended rather than assigned: DownloadDialog::SetExtendedMessage() adds
+    // a second block of content to a dialog that already has one, and both
+    // belong in the alert.
+    if (!text.IsEmpty()) {
+        if (!m_ios_text.IsEmpty())
+            m_ios_text += "\n\n";
+        m_ios_text += text;
+    }
+
+    if (!link_text.IsEmpty() && link_callback) {
+        m_ios_link_text     = link_text;
+        m_ios_link_callback = link_callback;
+    }
+}
