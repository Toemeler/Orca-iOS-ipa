+// The device switched between light and dark.
+//
+// Nothing is cached - dark_mode() is a live read of the system - but a live
+// read is not enough on its own, because three things downstream of it are
+// copies that only change when they are told to. 0414 asked for the repaint
+// and not for those, so the switch did almost nothing until the app was
+// restarted:
+//
+//   * init_label_colours() is the only place StateColor::SetDarkMode() is
+//     called, and StateColor is what every widget Orca draws itself asks for
+//     its colours. Without this the whole interface keeps the old appearance;
+//   * Update_dark_mode_flag() sets m_is_dark_mode, which is the flag
+//     UpdateDarkUI() branches on - so without it the walk below repaints
+//     every plain wx window in the mode we have just left;
+//   * EVT_GLCANVAS_COLOR_MODE_CHANGED is what carries the change into the 3D
+//     view, the bed, the toolpath viewer, the sliders, the notifications and
+//     ImGui. Its handler reads "dark_color_mode" out of the config, which is
+//     why that is set first.
+//
+// This is MainFrame::on_sys_color_changed()'s sequence, in its order, without
+// the parts that need a menu bar or a Windows title bar. The web pages carry
+// light/dark in their user agent, so they are reloaded the way that function
+// reloads them.
 void orca_ios_appearance_changed()
 {
-    GUI_App &app = wxGetApp();
-    app.app_config->set("dark_color_mode", app.dark_mode() ? "1" : "0");
+    GUI_App   &app  = wxGetApp();
+    const bool dark = app.dark_mode();
+
+    // Once per switch. UIKit reports trait changes for more than the
+    // appearance - size class and dynamic type come through the same
+    // callbacks - and this is reached from two of them.
+    //
+    // Seeded from the appearance the application was started in rather than
+    // from nothing, because the first call arrives during launch, when the
+    // view first gets a trait collection. There is nothing to re-ask then:
+    // every window is being built and is asking already.
+    static int applied = -1;
+    if (applied < 0)
+        applied = (app.app_config != nullptr &&
+                   app.app_config->get("dark_color_mode") == "1") ? 1 : 0;
+    if (applied == (dark ? 1 : 0))
+        return;
+    applied = dark ? 1 : 0;
+
+    if (app.app_config != nullptr)
+        app.app_config->set("dark_color_mode", dark ? "1" : "0");
+    app.init_label_colours();
+    app.Update_dark_mode_flag();
+
+    // Nothing below this exists until the frame does, and nothing below it is
+    // needed then either: every window built afterwards asks for its colours
+    // as it is built.
+    if (app.mainframe == nullptr)
+        return;
+
     app.force_colors_update();
     app.update_ui_from_settings();
-    if (app.mainframe != nullptr)
-        app.mainframe->Refresh();
+    if (app.plater() != nullptr) {
+        SimpleEvent evt(EVT_GLCANVAS_COLOR_MODE_CHANGED);
+        wxPostEvent(app.plater(), evt);
+    }
+    WebView::RecreateAll();
+    app.mainframe->Refresh();
 }
 #endif
 
