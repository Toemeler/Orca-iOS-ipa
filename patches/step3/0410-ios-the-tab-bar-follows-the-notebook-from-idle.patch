+// Notebook.hpp calls this whenever a page is added, removed, or selected.
+void orca_ios_notebook_sync(wxBookCtrlBase *book)
+{
+    orca_ios_notebook_sync_impl(book, true);
+}
+
+// GLCanvas3D::on_idle calls this every turn, from ABOVE its m_initialized
+// guard.
+//
+// Two reasons for it to be there rather than beside the toolbar sync.
+//
+// The bar has to follow the notebook however the page was changed, and the
+// page-changed event does not always reach here - after a new project the bar
+// stayed on Home while Prepare was on screen. An idle that re-reads the
+// selection cannot miss one.
+//
+// And it must not be downstream of m_initialized. A canvas that has never
+// rendered is not initialised, and a blank Prepare page is exactly that canvas,
+// so anything placed under that guard stops working precisely when the page is
+// in the state that most needs fixing. The retry budget stays with the event
+// path; this one retries every turn and must not spend it.
+void orca_ios_native_tick()
+{
+    if (gs_orca_notebook != nullptr)
+        orca_ios_notebook_sync_impl(gs_orca_notebook, false);
+}
