+#ifdef __WXOSX_IPHONE__
+// -- the native home gallery ------------------------------------------------
+//
+// The home page's file list is hidden on this port (css/orca-ios.css) and a
+// UICollectionView stands in its place. It needs the same three fields the
+// page was given, plus the thumbnail as PNG bytes rather than as a base64
+// data: URL, and it needs them from the same event - so this is called from
+// WebViewPanel::SendRecentList and from nowhere else.
+//
+// The filtering and the healing are get_recent_projects()'s, for the reason
+// given there: an entry from before the last install names a container
+// directory that no longer exists, and a MakerWorld staging copy is not a
+// project. Duplicated rather than shared because the two differ in what they
+// do with a missing file - the page prints "File is missing" into the date and
+// keeps the row, and so does this, so a project that is only temporarily out
+// of reach does not silently vanish from the grid.
+void MainFrame::orca_ios_push_gallery()
+{
+    orca_ios_gallery_begin();
+    for (size_t i = 0; i < m_recent_projects.GetCount(); ++i) {
+        std::string proj = into_u8(m_recent_projects.GetHistoryFile(i));
+        if (orca_ios_is_downloaded_copy(proj))
+            continue;
+        proj = orca_ios_repair_container_path(proj);
+
+        boost::system::error_code ec;
+        const std::time_t t = boost::filesystem::last_write_time(proj, ec);
+        const std::string when = ec ? into_u8(_L("File is missing"))
+                                    : into_u8(wxDateTime(t).FormatISOCombined(' '));
+        const std::string name = boost::filesystem::path(proj).stem().string();
+        const std::string &png = m_recent_projects.GetThumbnailPng(i);
+
+        orca_ios_gallery_add(proj.c_str(), name.c_str(), when.c_str(),
+                             png.empty() ? nullptr : png.data(), png.size());
+    }
+    orca_ios_gallery_commit();
+}
+
+// What the gallery's context menu and its selection bar do, in the words the
+// rest of the application already has for them. Everything here is deferred:
+// each one is called from inside a UIKit action, several of them open a modal
+// window, and 0230 covers what a modal loop does to the view it was opened
+// from.
+void orca_ios_gallery_open(const char *path)
+{
+    if (path == nullptr)
+        return;
+    const std::string p(path);
+    wxGetApp().CallAfter([p] { wxGetApp().request_open_project(p); });
+}
+
+// Out of the list, leaving the file where it is.
+void orca_ios_gallery_forget(const char *path)
+{
+    if (path == nullptr)
+        return;
+    const std::string p(path);
+    wxGetApp().CallAfter([p] { wxGetApp().request_remove_project(p); });
+}
+
+// Out of the list AND off the disk. Two steps, in that order: the entry has to
+// go first, because remove_recent_project() writes the whole list back to the
+// app config and an entry pointing at a file that has just been unlinked would
+// be written out with it.
+void orca_ios_gallery_delete(const char *path)
+{
+    if (path == nullptr)
+        return;
+    const std::string p(path);
+    wxGetApp().CallAfter([p] {
+        wxGetApp().request_remove_project(p);
+        boost::system::error_code ec;
+        boost::filesystem::remove(p, ec);
+        if (ec)
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-gallery: could not delete " << p
+                                     << ": " << ec.message();
+        else
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-gallery: deleted " << p;
+    });
+}
+
+// A copy beside the original, named the way the Files app names one, and put
+// on the home page straight away - a duplicate that cannot be seen until the
+// next launch is a duplicate nobody believes happened.
+void orca_ios_gallery_duplicate(const char *path)
+{
+    if (path == nullptr)
+        return;
+    const std::string p(path);
+    wxGetApp().CallAfter([p] {
+        const boost::filesystem::path src(p);
+        boost::system::error_code ec;
+        boost::filesystem::path dest;
+        for (int n = 2; n < 1000; ++n) {
+            const std::string suffix = n == 2 ? " copy" : " copy " + std::to_string(n - 1);
+            dest = src.parent_path() / (src.stem().string() + suffix + src.extension().string());
+            if (!boost::filesystem::exists(dest, ec))
+                break;
+        }
+        boost::filesystem::copy_file(src, dest, ec);
+        if (ec) {
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-gallery: could not duplicate " << p
+                                     << ": " << ec.message();
+            return;
+        }
+        if (wxGetApp().mainframe != nullptr)
+            wxGetApp().mainframe->add_to_recent_projects(from_u8(dest.string()));
+    });
+}
+
+// The new name is a stem: the extension is this application's business, and a
+// project that stops being a .3mf stops being openable.
+void orca_ios_gallery_rename(const char *path, const char *new_stem)
+{
+    if (path == nullptr || new_stem == nullptr || *new_stem == '\0')
+        return;
+    const std::string p(path), stem(new_stem);
+    wxGetApp().CallAfter([p, stem] {
+        const boost::filesystem::path src(p);
+        const boost::filesystem::path dest = src.parent_path() /
+                                             (stem + src.extension().string());
+        if (dest == src)
+            return;
+        boost::system::error_code ec;
+        if (boost::filesystem::exists(dest, ec)) {
+            show_error(nullptr, _L("A project with that name is already there."));
+            return;
+        }
+        boost::filesystem::rename(src, dest, ec);
+        if (ec) {
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-gallery: could not rename " << p
+                                     << ": " << ec.message();
+            return;
+        }
+        if (wxGetApp().mainframe != nullptr) {
+            wxGetApp().mainframe->remove_from_recent_projects(from_u8(p));
+            wxGetApp().mainframe->add_to_recent_projects(from_u8(dest.string()));
+        }
+    });
+}
+
+void orca_ios_gallery_new_project()
+{
+    wxGetApp().CallAfter([] { wxGetApp().request_open_project("<new>"); });
+}
+
+void orca_ios_gallery_import()
+{
+    wxGetApp().CallAfter([] { wxGetApp().request_open_project({}); });
+}
+
+// The grid asking to be filled - on install, and after anything it did itself
+// that changes the list.
+void orca_ios_gallery_refresh()
+{
+    if (wxGetApp().mainframe != nullptr)
+        wxGetApp().mainframe->orca_ios_push_gallery();
+}
