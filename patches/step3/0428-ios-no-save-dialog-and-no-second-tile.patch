+void MainFrame::remove_from_recent_projects(const wxString& filename)
+{
+    const size_t file_id = m_recent_projects.FindFileInHistory(filename);
+    if (file_id == size_t(-1))
+        return;
+
+    m_recent_projects.RemoveFileFromHistory(file_id);
+    std::vector<std::string> recent_projects;
+    const size_t count = m_recent_projects.GetCount();
+    for (size_t i = 0; i < count; ++i)
+        recent_projects.push_back(into_u8(m_recent_projects.GetHistoryFile(i)));
+    wxGetApp().app_config->set_recent_projects(recent_projects);
+    if (m_webview != nullptr)
+        m_webview->SendRecentList(0);
+    BOOST_LOG_TRIVIAL(error) << "orca-ios-recent: removed " << into_u8(filename);
+}
