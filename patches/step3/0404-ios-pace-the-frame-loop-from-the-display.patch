@@ -39,6 +39,49 @@
 #include <cstdlib>
 #include <boost/filesystem.hpp>
 #include <boost/log/trivial.hpp>
+#include <atomic>
+
+// A CADisplayLink, so that frames are paced by the display instead of by luck.
+//
+// Rendering is driven by wxIdle, and wx processes idle from a run-loop observer
+// on kCFRunLoopBeforeWaiting (src/osx/core/evtloop_cf.cpp): once per run-loop
+// iteration, just before it would sleep. GLCanvas3D::on_idle renders and calls
+// evt.RequestMore(), which makes ProcessIdle() return true, which calls WakeUp()
+// to stop the loop sleeping, which produces another iteration. That is the whole
+// frame loop, and it turns only for as long as the previous frame remembered to
+// ask for another one. Under UIApplicationMain nothing reliably does - patch
+// 0364's complaint - and it is why Prepare delivers 40 frames a second out of
+// 16 ms of work: 62 fps of rendering arriving at 40, the difference being the
+// iterations that never happened.
+//
+// What is deliberately NOT here is any rendering. The callback does nothing but
+// count, and it does not need to do more: a CADisplayLink is a run-loop source,
+// so the display waking the loop *is* an iteration, and every iteration ends in
+// the BeforeWaiting observer that runs idle. Firing at the refresh rate hands wx
+// one idle pass per displayed frame through the path that already exists - no
+// second render path to keep in step with the first, and nothing to re-enter.
+// The frame loop stops depending on whether the last frame asked for another.
+//
+// preferredFrameRateRange asks for 120 and will settle for 60. It is a request
+// in both directions: the system drops the rate for thermals, and Low Power Mode
+// pins ProMotion to 60 for every app on the device, which no app can opt out of.
+// Info.plist carries CADisableMinimumFrameDuration, without which UIKit holds
+// every app to a 16.67 ms minimum frame duration and 60 is the ceiling however
+// often this fires.
+namespace Slic3r { namespace GUI { std::atomic<unsigned> orca_ios_display_link_ticks{0}; } }
+
+@interface OrcaDisplayLinkTarget : NSObject
+- (void)tick:(CADisplayLink *)link;
+@end
+
+@implementation OrcaDisplayLinkTarget
+- (void)tick:(CADisplayLink *)link
+{
+    (void) link;
+    ++Slic3r::GUI::orca_ios_display_link_ticks;
+}
+@end
+
 
 
 // A small number keypad, in Liquid Glass, floating directly under the field
