 void wxWebViewWebKit::LoadURL(const wxString& url)
 {
-    [m_webView loadRequest:[NSURLRequest requestWithURL:
-            [NSURL URLWithString:wxCFStringRef(url).AsNSString()]]];
+    NSURL* nsurl = [NSURL URLWithString:wxCFStringRef(url).AsNSString()];
+
+#if defined(__WXOSX_IPHONE__)
+    // -loadRequest: with a file: URL gives the page read access to its own
+    // directory and nothing else, so a navigation to a sibling directory is
+    // refused - silently, with no JavaScript error and no navigation event.
+    //
+    // OrcaSlicer's setup wizard is exactly that. resources/web/guide/0/
+    // index.html is nothing but a "Loading......" block, and load.js finishes
+    // with window.open('../' + TargetPage + '/index.html', '_self') to reach
+    // guide/1/. In the simulator, where WebKit's file: policy is laxer, that
+    // hop works and the welcome page appears; on a device it does not, and the
+    // wizard sits on "Loading......" for ever.
+    //
+    // -loadFileURL:allowingReadAccessToURL: is the iOS API for this. It keeps
+    // the query string (the page reads ?target=N from it, so losing it would
+    // break the jump just as thoroughly), and it takes a directory to grant.
+    if ( [nsurl isFileURL] )
+    {
+        // Symlinks, not just . and .. : an iOS bundle is reached through both
+        // /var/containers/... and /private/var/containers/..., /var being a
+        // symlink to /private/var. -URLByStandardizingPath does not resolve
+        // that, so comparing standardized paths can miss and quietly fall back
+        // to the one-directory grant this exists to avoid.
+        NSURL* bundleURL = [[[NSBundle mainBundle] bundleURL]
+                                URLByResolvingSymlinksInPath];
+        NSString* bundlePath = [bundleURL path];
+        NSString* filePath = [[nsurl URLByResolvingSymlinksInPath] path];
+
+        NSURL* readAccess;
+        if ( bundlePath != nil && filePath != nil &&
+             [filePath hasPrefix:bundlePath] )
+        {
+            // Where a packaged app's web resources live.
+            readAccess = bundleURL;
+        }
+        else
+        {
+            // Outside the bundle: grant the parent of the containing
+            // directory, which still allows the ../sibling/ hops these pages
+            // are built from, rather than the containing directory alone.
+            readAccess = [[nsurl URLByDeletingLastPathComponent]
+                              URLByDeletingLastPathComponent];
+        }
+
+        wxLogMessage("wx-ios webview: loadFileURL %s (read access %s)",
+                     wxCFStringRef::AsString([nsurl absoluteString]),
+                     wxCFStringRef::AsString([readAccess path]));
+
+        [m_webView loadFileURL:nsurl allowingReadAccessToURL:readAccess];
+        return;
+    }
+#endif
+
+    [m_webView loadRequest:[NSURLRequest requestWithURL:nsurl]];
 }
 
