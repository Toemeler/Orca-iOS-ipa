-- (void) swapBuffers {
-    [self.context presentRenderbuffer:GL_RENDERBUFFER_OES];
+- (BOOL) swapBuffers {
+    // -presentRenderbuffer: presents whatever is bound to GL_RENDERBUFFER right
+    // now, and by the end of a frame that is very often not this view's colour
+    // buffer any more. Any pass that generates a renderbuffer, renders through
+    // it and deletes it - offscreen thumbnails, picking targets, anything with
+    // its own depth attachment - leaves the binding at zero, because deleting a
+    // bound renderbuffer reverts the binding to zero. The present after that
+    // silently does nothing at all: the view keeps showing the last frame it
+    // did manage to present, for ever, while the application carries on
+    // rendering into a framebuffer that is never shown. That is a viewport
+    // frozen for good, and a second canvas which has never presented anything
+    // is simply black - which is exactly the pair of symptoms OrcaSlicer showed
+    // the moment its first autosave rendered a plate thumbnail.
+    //
+    // GLKit's own -display binds the drawable immediately before presenting for
+    // this very reason. Drawing from outside -drawRect: - which is what a wx
+    // application does, because it draws when wx tells it to and not when GLKit
+    // asks - has to do the same thing for itself.
+    [self bindDrawable];
+    return [self.context presentRenderbuffer:GL_RENDERBUFFER_OES];
 }
 
 @end
