+    // fine once and unusable per frame. This is a uniform, so the detail level
+    // can follow the camera.
+    //
+    void set_detail_budget(uint32_t max_instances);
+    uint32_t get_detail_budget() const;
+    //
+    // What the last toolpath draw actually used: 1 at full detail, n when it
+    // drew every n-th segment.
+    //
+    uint32_t get_last_segments_stride() const;
+    //
+    // Counts the detail budget is measured against.
+    //
+    size_t get_enabled_segments_count() const;
+    size_t get_enabled_options_count() const;
+    //
     // Return the vertex pointed by the max value of the view visible range
     //
     const PathVertex& get_current_vertex() const;
