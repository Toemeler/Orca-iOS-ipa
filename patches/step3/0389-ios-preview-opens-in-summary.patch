--- a/src/libslic3r/AppConfig.cpp
+++ b/src/libslic3r/AppConfig.cpp
@@ -307,7 +307,28 @@
         set("drc_bits", DRC_BITS_DEFAULT_STR);
 
     if (get("show_gcode_window").empty())
+#if defined(__APPLE__) && !TARGET_OS_OSX
+        // The G-code text window covers a quarter of the preview on a tablet
+        // and its content is the kind of thing you read next to a keyboard.
+        // Off unless asked for; the toggle itself is unchanged.
+        set_bool("show_gcode_window", false);
+#else
         set_bool("show_gcode_window", true);
+#endif
+
+#if defined(__APPLE__) && !TARGET_OS_OSX
+    // One-time correction for configs that already answered the question.
+    //
+    // set_defaults() only fills in keys that are *missing*, and it runs after
+    // an existing config has been loaded - so changing the default above does
+    // nothing on any device the app has already run on, which is all of them.
+    // Apply it once, remembered under its own key, so that a user who turns the
+    // window back on afterwards keeps it turned on.
+    if (get("ios_preview_defaults").empty()) {
+        set_bool("show_gcode_window", false);
+        set("ios_preview_defaults", "1");
+    }
+#endif
 
     if (get("show_3d_navigator").empty())
         set_bool("show_3d_navigator", true);
