     m_check_list->SetSelections(sel_array);
 }
 
+#ifdef __WXOSX_IPHONE__
+int MultiChoiceDialog::ShowModal()
+{
+    if (m_check_list == nullptr || m_ios_choices.IsEmpty())
+        return DPIDialog::ShowModal();
+
+    std::vector<IOSPickerItem> rows;
+    rows.reserve(m_ios_choices.GetCount());
+    for (size_t i = 0; i < m_ios_choices.GetCount(); ++i) {
+        IOSPickerItem row;
+        row.text  = m_ios_choices[i];
+        row.index = int(i);
+        rows.push_back(row);
+    }
+
+    std::vector<int> ticked;
+    const wxArrayInt current = m_check_list->GetSelections();
+    ticked.reserve(current.GetCount());
+    for (size_t i = 0; i < current.GetCount(); ++i)
+        ticked.push_back(current[i]);
+
+    // The wait, for the same reason SingleChoiceDialog has one: every caller
+    // reads GetSelections() on the line after ShowModal().
+    std::vector<int> chosen;
+    bool             confirmed = false;
+    bool             done      = false;
+
+    wxModalEventLoop loop(this);
+    const bool presented = orca_ios_multi_picker_present(
+        this, GetTitle(), rows, ticked,
+        [&chosen, &confirmed, &done, &loop](const std::vector<int> &picked) {
+            chosen    = picked;
+            confirmed = true;
+            done      = true;
+            if (loop.IsRunning())
+                loop.Exit(wxID_OK);
+        },
+        [&done, &loop]() {
+            done = true;
+            if (loop.IsRunning())
+                loop.Exit(wxID_CANCEL);
+        });
+
+    if (!presented)
+        return DPIDialog::ShowModal();
+
+    if (!done)
+        loop.Run();
+
+    if (!confirmed) {
+        SetReturnCode(wxID_CANCEL);
+        return wxID_CANCEL;
+    }
+
+    // Back into the CheckList, because that is what GetSelections() reads and
+    // what every caller asks after this returns.
+    wxArrayInt selections;
+    for (const int index : chosen)
+        selections.Add(index);
+    m_check_list->SetSelections(selections);
+
+    SetReturnCode(wxID_OK);
+    return wxID_OK;
+}
+#endif // __WXOSX_IPHONE__
+
 MultiChoiceDialog::~MultiChoiceDialog() {}
 
 void MultiChoiceDialog::on_dpi_changed(const wxRect &suggested_rect) {}
