+// src/osx/iphone/msgdlg.mm
+extern bool wxOSXIPhoneTextEntryAlert(const wxString& title,
+                                      const wxString& message,
+                                      wxString* value,
+                                      bool password);
+
+int wxTextEntryDialog::ShowModal()
+{
+    WX_HOOK_MODAL_DIALOG();
+
+    // A multi-line entry is not a job for an alert's single-line field - the
+    // custom G-code editors ask for one - so that keeps the window it has.
+    if ( (m_dialogStyle & wxTE_MULTILINE) != 0 )
+        return wxDialog::ShowModal();
+
+    wxString value = m_value;
+    const bool password = (m_dialogStyle & wxTE_PASSWORD) != 0;
+
+    if ( !wxOSXIPhoneTextEntryAlert(GetTitle(), m_iosMessage, &value, password) )
+    {
+        // Cancelled, or never presented. The two are told apart by the value:
+        // the helper leaves it alone unless the user confirmed, so there is
+        // nothing to undo either way, and a cancel is the safe reading.
+        SetReturnCode(wxID_CANCEL);
+        return wxID_CANCEL;
+    }
+
+    // Straight into both, because the caller reads GetValue() and the control
+    // is what TransferDataFromWindow() would have read it out of.
+    m_value = value;
+    if ( m_textctrl != nullptr )
+        m_textctrl->SetValue(value);
+
+    SetReturnCode(wxID_OK);
+    return wxID_OK;
+}
