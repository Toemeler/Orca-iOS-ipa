+// AND THE WALK WAS NOT ENOUGH. Build 200 shipped it and came back with exactly
+// the same stack: fifty-two frames of wxOSX_canBecomeFirstResponder, only at
+// the offsets the new code put them at. The walk ran, skipped nothing, and
+// handed back this function again - which means that in this binary the
+// implementation pointer we install is not the pointer the runtime hands back,
+// and no test against it can be trusted, however it is written.
+//
+// So the cycle is cut where it cannot be argued with: a count of how deep we
+// already are in this particular method. The inherited implementation is called
+// on the way in and not on the way back through, which bounds the whole thing
+// at two frames whatever the class graph is doing.
+//
+// The cost is one skipped super call in a case that should never arise, and
+// the wx answer below it is unaffected. wxOSXIPhoneReportSuperLoop() names the
+// class the one time it happens, so the next report explains what the pointer
+// test could not see.
+namespace
+{
+struct wxOSXSuperGuard
+{
+    int  &m_slot;
+    bool  m_first;
+
+    explicit wxOSXSuperGuard(int &slot) : m_slot(slot), m_first(slot == 0) { ++m_slot; }
+    ~wxOSXSuperGuard() { --m_slot; }
+
+    bool CanCallSuper() const { return m_first; }
+};
+} // namespace
+
+static void wxOSXIPhoneReportSuperLoop(id slf, SEL _cmd, IMP ours)
+{
+    static bool reported = false;
+    if ( reported )
+        return;
+    reported = true;
+
+    Class cls = object_getClass(slf);
+    Class sup = cls != nil ? class_getSuperclass(cls) : nil;
+
+    char buf[512];
+    snprintf(buf, sizeof(buf),
+             "orca-ios-superloop: %s (super %s) re-entered %s - ours %p, class %p, super %p",
+             cls != nil ? class_getName(cls) : "(nil)",
+             sup != nil ? class_getName(sup) : "(nil)",
+             sel_getName(_cmd),
+             (void *) ours,
+             (void *) (cls != nil ? class_getMethodImplementation(cls, _cmd) : nullptr),
+             (void *) (sup != nil ? class_getMethodImplementation(sup, _cmd) : nullptr));
+
+    wxLogWarning("%s", wxString::FromUTF8(buf));
+}
