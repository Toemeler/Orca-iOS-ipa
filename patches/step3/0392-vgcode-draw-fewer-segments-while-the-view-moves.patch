+// Level of detail, applied by the draw call rather than by the data.
+//
+// The toolpath is one glDrawArraysInstanced of 24 vertices per segment, so a
+// 2.4 million segment preview submits 57.6 million vertices every frame. That
+// is past what a tile-based GPU will take in one pass: the parameter buffer
+// overruns, the driver splits the frame into partial renders of a 4 megapixel
+// target, and the draw call itself blocks for seconds waiting for memory.
+//
+// Rather than rebuild a smaller data set - which is the O(vertices) walk that
+// already made dragging unusable - instance i reads enabled segment
+// i * instance_stride. Drawing count/stride instances then samples the whole
+// model uniformly at any density, for the cost of one uniform and no memory.
+// width_scale fattens what is left by sqrt(stride) so the path keeps its
+// visual mass instead of thinning into a dotted line.
+"uniform int instance_stride;\n"
+"uniform float width_scale;\n"
 "in float vertex_id_float;\n"
 "out vec3 color;\n"
 "vec3 decode_color(float color) {\n"
@@ -82,7 +98,12 @@ static const char* Segments_Vertex_Shader_ES =
 "}\n"
 "void main() {\n"
 "  int vertex_id = int(vertex_id_float);\n"
-"  int id_a = int(texelFetch(segment_index_tex, tex_coord_u(segment_index_tex, gl_InstanceID), 0).r);\n"
+// Clamped, so that a uniform which never got set reads as full detail rather
+// than as stride 0 - which would put every instance on segment 0 and draw the
+// whole toolpath as a single smear.
+"  int stride = max(instance_stride, 1);\n"
+"  float wscale = max(width_scale, 1.0);\n"
+"  int id_a = int(texelFetch(segment_index_tex, tex_coord_u(segment_index_tex, gl_InstanceID * stride), 0).r);\n"
 "  int id_b = id_a + 1;\n"
 "  vec3 pos_a = texelFetch(position_tex, tex_coord(position_tex, id_a), 0).xyz;\n"
 "  vec3 pos_b = texelFetch(position_tex, tex_coord(position_tex, id_b), 0).xyz;\n"
@@ -126,6 +147,10 @@ static const char* Segments_Vertex_Shader_ES =
 "  int id = vertex_id < 4 ? id_a : id_b;\n"
 "  vec3 endpoint_pos = vertex_id < 4 ? pos_a : pos_b;\n"
