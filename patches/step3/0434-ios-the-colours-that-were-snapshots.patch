+#if defined(__APPLE__) && !TARGET_OS_OSX
+// THE BAR ASKS FOR ITS COLOURS WHEN IT DRAWS THEM.
+//
+// The three colours this widget paints with are plain members, written once,
+// and one of them - the track, #E9E9E9 - was in no table at all. So in dark
+// mode the bar behind the progress stayed the light grey it is written as: a
+// white bar across the printing box with a dark page around it, which is not
+// something any later repair could have fixed either.
+//
+// Asking here is a live read, so the bar is right the first time it is drawn
+// and follows the device afterwards without anything having to walk the window
+// tree. The lookup is idempotent - every colour the palette can produce is
+// also a key of it - so re-asking with whatever the widget is holding always
+// gives the answer for the appearance in force now.
+static wxColour tone(wxColour const &c) { return StateColor::darkModeColorFor(c); }
+#else
+static wxColour tone(wxColour const &c) { return c; }
+#endif
 
 
