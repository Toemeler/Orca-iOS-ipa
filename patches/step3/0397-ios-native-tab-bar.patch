+// A real UITabBarController, in place of Orca's own tab strip.
+//
+// Orca draws its Home / Prepare / Preview / Device / Project row itself, with
+// ButtonsListCtrl (Notebook.hpp): a wxControl that paints bitmaps and text into
+// a 30px band across the top of the window. It is desktop title bar furniture -
+// hit targets built for a mouse, a hover state nothing on a touch screen can
+// reach - and none of it belongs on an iPad. The strip is hidden on this port
+// (Notebook::Create) and the pages are driven from the system tab bar instead,
+// which on iPadOS renders as the floating Liquid Glass capsule centred at the
+// top of the window, and brings the pointer effects, the keyboard shortcuts,
+// Dynamic Type and VoiceOver with it. The custom strip had none of those.
+//
+// WHY THE WX CONTROLLER BECOMES A CHILD OF THE TAB BAR CONTROLLER.
+//
+// wx gives a top level window a UIWindow whose rootViewController is a
+// wxUIContentViewController owning every wx view in the application
+// (src/osx/iphone/nonownedwnd.mm). A tab bar is not a view that can simply be
+// added on top: the floating bar, its glass, its morph on scroll and its
+// sidebar all belong to UITabBarController, and it only does any of that when
+// it is the controller running the window. So it takes the window, and wx's
+// controller is re-parented underneath it, full bleed, below the bar.
+//
+// That leaves the tabs themselves with nothing to show - wx's view is behind
+// all of them, not inside any one of them - so each tab gets a transparent
+// OrcaPassthroughView that hit-tests to nil and drops every touch through to
+// the wx view underneath. Selecting a tab moves nothing in UIKit: it tells the
+// notebook to change page, and wx swaps its pages exactly as it did before.
+//
+// Everything below runs on the main thread, which is also wx's GUI thread:
+// UIKit calls in on it, and the notebook is only ever touched from there.
+
+// All of this is iOS 18 and 26 API, and that is not a compromise: iOS 27's
+// UIKit is a very small release, and nothing drawn here arrived in it. The
+// floating glass capsule is what iPadOS 26 already makes of a
+// UITabBarController with UITab items, and UIGlassEffect is 26 - the guard
+// patch 0381 installs covers everything this file needs. What 27 adds anywhere
+// near this is performBatchUpdates:, prominentTabIdentifier and a sidebar
+// placement pair, none of which change what appears on screen. Staying on 26
+// keeps the ccache as well, so it costs nothing.
+
+// Pages that are built, paged and working, but that get no tab. Named from
+// MainFrame::init_tabpanel, where the identity of each page is known - matching
+// on the label would mean matching translated text, and "Project" is only
+// called Project in English. Take the orca_ios_hide_tab() call out of
+// init_tabpanel to give a page its tab back; nothing else has to change.
+static std::vector<wxWindow *> gs_orca_untabbed;
+
+// The one page that wants room at the top for the floating bar. Named from
+// MainFrame::init_tabpanel, by identity, like the untabbed pages above.
+static wxWindow *gs_orca_inset_page = nullptr;
+
+static bool orca_ios_tab_is_hidden(wxWindow *page)
+{
+    if (page == nullptr)
+        return false;
+    return std::find(gs_orca_untabbed.begin(), gs_orca_untabbed.end(), page) !=
+           gs_orca_untabbed.end();
+}
+
+// src/slic3r/GUI/ios_webview_support.mm and MainFrame.cpp / GLCanvas3D.cpp,
+// all further down or in another translation unit.
+namespace Slic3r { namespace GUI {
+void orca_ios_home_plus_update(wxBookCtrlBase *book);
+void orca_ios_select_prepare();
+void orca_ios_wake_canvas();
+} }
+
+@class OrcaTabBarController;
+
+// The content area of a tab, and a hole through to wx. -hitTest: returning nil
+// for the view itself is what makes the hole: UIKit then keeps looking at the
+// views behind it in the tab bar controller, and finds wx's. A subview would
+// still be found first, and there are none, but the check states the intent.
+@interface OrcaPassthroughView : UIView
+@end
+
+@implementation OrcaPassthroughView
+- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event
+{
+    UIView *const hit = [super hitTest:point withEvent:event];
+    return hit == self ? nil : hit;
+}
+@end
+
+// One per tab, carrying the page index it stands for. It reports in when UIKit
+// brings it on screen, which is the single signal that catches every way a tab
+// can be chosen: a tap, a pointer click, a keyboard shortcut, the sidebar.
+@interface OrcaTabPage : UIViewController
+@property (nonatomic, assign) OrcaTabBarController *owner;   // owns this, not owned by it
+@property (nonatomic, assign) NSUInteger            page;    // notebook page, not tab position
+@end
+
+// How much of the top of the window the floating bar covers, for the one page
+// that asks for it. wx knows nothing about the bar and laid the Device page's
+// own header - Camera / Control / Printer Parts - out underneath it.
+//
+// ONE PAGE, not all of them. Insetting wx's view for every page moved
+// everything on the 3D pages down with it, and the toolbar is centred
+// vertically in the canvas, so it went off the bottom and the column vanished
+// from Prepare entirely. The plate does not need the room anyway: the bar
+// floating over empty space above it is exactly what a floating bar is for.
+static const CGFloat kOrcaTabBarInset = 56;
+
+@interface OrcaTabBarController : UITabBarController
+@property (nonatomic, assign) UIView *wxView;   // not retained: the hierarchy holds it
+- (instancetype)initWithBook:(wxBookCtrlBase *)book;
+- (void)syncTabs;
+- (void)pageDidAppear:(NSUInteger)page;
+@end
+
+@implementation OrcaTabPage
+
+- (void)loadView
+{
+    OrcaPassthroughView *const v =
+        [[[OrcaPassthroughView alloc] initWithFrame:CGRectZero] autorelease];
+    v.backgroundColor = [UIColor clearColor];
+    v.opaque          = NO;
+    self.view         = v;
+}
+
+- (void)viewWillAppear:(BOOL)animated
+{
+    [super viewWillAppear:animated];
+    [self.owner pageDidAppear:self.page];
+    [self stepOutOfTheWay];
+}
+
+- (void)viewDidLayoutSubviews
+{
+    [super viewDidLayoutSubviews];
+    [self stepOutOfTheWay];   // UIKit rebuilds these wrappers across a switch
+}
+
+// -hitTest: returning nil from this controller's own view is not enough.
+//
+// UITabBarController does not put a tab's view straight into its own view - it
+// wraps it, and the wrapper is UIKit's, not ours. A wrapper whose subviews all
+// decline a touch answers for it itself, so the wrapper took every touch over
+// the whole content area and the canvas underneath got none. The counters said
+// so plainly: "mouse +0" in every five second window, while the plate was on
+// screen and rendering.
+//
+// A view with userInteractionEnabled = NO is not hit-tested at all, and neither
+// is anything inside it, so switching it off from this view up to - but not
+// including - the tab bar controller's own view takes the whole wrapper chain
+// out of the path. The floating bar is a sibling of that chain rather than
+// inside it, so it keeps its touches.
+- (void)stepOutOfTheWay
+{
+    UIView *const stop = (self.owner != nil && self.owner.isViewLoaded) ? self.owner.view : nil;
+    for (UIView *v = self.view; v != nil && v != stop; v = v.superview)
+        v.userInteractionEnabled = NO;
+}
+
+@end
+
+@implementation OrcaTabBarController {
+    wxBookCtrlBase             *_book;     // outlives this controller; owned by wx
+    NSMutableArray<NSString *> *_titles;   // what the tabs read right now
+    NSMutableArray<NSNumber *> *_pages;    // the notebook page behind each tab
+    BOOL                        _in_sync;
+}
+
+- (instancetype)initWithBook:(wxBookCtrlBase *)book
+{
+    self = [super initWithNibName:nil bundle:nil];
+    if (self == nil)
+        return nil;
+    _book   = book;
+    _titles = [[NSMutableArray alloc] init];
+    _pages  = [[NSMutableArray alloc] init];
+    return self;
+}
+
+- (void)dealloc
+{
+    [_titles release];
+    [_pages release];
+    [super dealloc];
+}
+
+// Re-applied rather than set once: the window's bounds change on rotation, and
+// wx sets this view's frame itself whenever the frame resizes, so the inset has
+// to be put back afterwards.
+- (void)viewDidLayoutSubviews
+{
+    [super viewDidLayoutSubviews];
+    if (self.wxView == nil)
+        return;
+
+    CGRect r = self.view.bounds;
+    if (_book != nullptr && gs_orca_inset_page != nullptr) {
+        const int sel = _book->GetSelection();
+        if (sel >= 0 && (size_t) sel < _book->GetPageCount() &&
+            _book->GetPage((size_t) sel) == gs_orca_inset_page) {
+            r.origin.y    += kOrcaTabBarInset;
+            r.size.height -= kOrcaTabBarInset;
+        }
+    }
+    if (!CGRectEqualToRect(self.wxView.frame, r))
+        self.wxView.frame = r;
+}
+
+// The tabs the bar should be showing: every notebook page except the ones held
+// back, in notebook order, with the page each one stands for alongside.
+- (void)collectTitles:(NSMutableArray<NSString *> *)titles
+                pages:(NSMutableArray<NSNumber *> *)pages
+{
+    const size_t count = _book->GetPageCount();
+    for (size_t i = 0; i < count; ++i) {
+        if (orca_ios_tab_is_hidden(_book->GetPage(i)))
+            continue;
+        wxString label = _book->GetPageText(i);
+        // Orca adds the home page with an empty label and an icon
+        // (MainFrame::init_tabpanel). A tab bar item is its text here, so the
+        // one page that has none has to be named.
+        if (label.IsEmpty())
+            label = wxString("Home");
+        [titles addObject:wxCFStringRef(label).AsNSString()];
+        [pages addObject:[NSNumber numberWithUnsignedLong:(unsigned long) i]];
+    }
+}
+
+- (void)syncTabs
+{
+    if (_book == nullptr || _in_sync)
+        return;
+    _in_sync = YES;
+
+    NSMutableArray<NSString *> *const titles = [NSMutableArray array];
+    NSMutableArray<NSNumber *> *const pages  = [NSMutableArray array];
+    [self collectTitles:titles pages:pages];
+
+    // The pages matter as well as the labels: inserting Prepare in front of
+    // Preview moves every page behind it without changing a single title.
+    if (![titles isEqualToArray:_titles] || ![pages isEqualToArray:_pages]) {
+        NSMutableArray<UITab *> *const tabs = [NSMutableArray arrayWithCapacity:titles.count];
+        for (NSUInteger i = 0; i < titles.count; ++i) {
+            OrcaTabPage *const page = [[[OrcaTabPage alloc] initWithNibName:nil
+                                                                     bundle:nil] autorelease];
+            page.owner = self;
+            page.page  = (NSUInteger) [[pages objectAtIndex:i] unsignedLongValue];
+            // The provider block is copied by UITab, and a copied block retains
+            // what it captures - which is the only reference the page needs.
+            UITab *const tab = [[[UITab alloc]
+                initWithTitle:[titles objectAtIndex:i]
+                        image:nil
+                   identifier:[NSString stringWithFormat:@"orca.tab.%lu", (unsigned long) i]
+       viewControllerProvider:^UIViewController *(UITab *t) {
+                                   (void) t;
+                                   return page;
+                               }] autorelease];
+            [tabs addObject:tab];
+        }
+        // The tabs and the selection change together in every case that
+        // reaches here: Prepare and Preview are inserted and removed as a pair
+        // with the plater, Device comes and goes with the printer. iOS 27's
+        // -performBatchUpdates: would put the two into a single animation, and
+        // the end state is identical either way.
+        self.tabs = tabs;
+        [_titles setArray:titles];
+        [_pages setArray:pages];
+    }
+
+    const int sel = _book->GetSelection();
+    if (sel >= 0) {
+        const NSUInteger tab =
+            [_pages indexOfObject:[NSNumber numberWithUnsignedLong:(unsigned long) sel]];
+        // A page that was held back has no tab to move to, so the bar keeps
+        // showing the last one that did. That is the right answer rather than a
+        // gap: reaching Project from a link should not blank the tab bar.
+        if (tab != NSNotFound && tab < self.tabs.count) {
+            UITab *const want = [self.tabs objectAtIndex:tab];
+            if (self.selectedTab != want)
+                self.selectedTab = want;
+        }
+    }
+
+    // The inset depends on which page is showing, so the layout has to run
+    // again after a selection change.
+    [self.view setNeedsLayout];
+
+    _in_sync = NO;
+}
+
+- (void)pageDidAppear:(NSUInteger)page
+{
+    if (_book == nullptr || _in_sync)
+        return;
+    if (page >= _book->GetPageCount())
+        return;
+
+    // Whatever else happens, the page on screen has just changed, so the two
+    // things that depend on which page that is have to be told. The plus
+    // belongs to the home page alone, and the 3D canvas can sit there shown and
+    // undrawn until something asks it for a frame.
+    struct OrcaAfterSwitch {
+        wxBookCtrlBase *book;
+        ~OrcaAfterSwitch() {
+            Slic3r::GUI::orca_ios_home_plus_update(book);
+            Slic3r::GUI::orca_ios_wake_canvas();
+        }
+    } after_switch{ _book };
+    // The tab UIKit is showing is already the notebook's page whenever we were
+    // the ones who asked for it, so this is how a selection we made is told
+    // apart from one the user made - no flag, and correct even though the
+    // appearance callback lands a turn of the run loop after the request.
+    if ((int) page == _book->GetSelection())
+        return;
+    _book->SetSelection(page);
+}
+
+@end
+
+// The tab bar controller, once it is running the window. Not owned by anything
+// else that can be reached from here, so the +1 from -alloc is this reference.
+static OrcaTabBarController *gs_orca_tab_bar = nil;
+
