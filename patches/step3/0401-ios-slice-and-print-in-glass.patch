+// -- slice and print -------------------------------------------------------
+
+static OrcaSideTools                  *gs_orca_side_tools   = nil;
+static NSMutableArray<NSDictionary *> *gs_orca_side_pending = nil;
+static bool                            gs_orca_side_failed  = false;
+
+// MainFrame describes the pair it has, one at a time, the same way the canvas
+// describes the toolbar.
+void orca_ios_side_tools_begin()
+{
+    [gs_orca_side_pending release];
+    gs_orca_side_pending = [[NSMutableArray alloc] init];
+}
+
+void orca_ios_side_tools_add(const char *id, const char *title, bool enabled, bool primary)
+{
+    if (gs_orca_side_pending == nil || id == nullptr || title == nullptr || *title == '\0')
+        return;
+    [gs_orca_side_pending addObject:@{
+        @"id"      : [NSString stringWithUTF8String:id],
+        @"title"   : [NSString stringWithUTF8String:title],
+        @"enabled" : [NSNumber numberWithBool:enabled ? YES : NO],
+        @"primary" : [NSNumber numberWithBool:primary ? YES : NO],
+    }];
+}
+
+void orca_ios_side_tools_commit()
+{
+    if (gs_orca_side_failed || gs_orca_side_pending == nil)
+        return;
+
+    // Same host as the plus, and for the same reason: outside wx's view tree,
+    // and following whoever owns the window.
+    UIWindow *window = nil;
+    if (gs_orca_home_panel != nullptr) {
+        UIView *const v = (UIView *) gs_orca_home_panel->GetHandle();
+        window = v.window;
+    }
+    if (window == nil)
+        return;
+    UIView *const host = orca_ios_plus_host(window);
+
+    @try {
+        if (gs_orca_side_tools == nil) {
+            gs_orca_side_tools = [[OrcaSideTools alloc] initWithFrame:CGRectZero];
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-side: slice and print created";
+        }
+        if (gs_orca_side_tools.superview != host) {
+            [gs_orca_side_tools removeFromSuperview];
+            [host addSubview:gs_orca_side_tools];
+        }
+        [host bringSubviewToFront:gs_orca_side_tools];
+        [gs_orca_side_tools setItems:gs_orca_side_pending];
+        [gs_orca_side_tools reposition];
+    }
+    @catch (NSException *e) {
+        gs_orca_side_failed = true;
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-side: THREW " << [[e name] UTF8String]
+                                 << ": " << [[e reason] UTF8String];
+    }
+}
+
