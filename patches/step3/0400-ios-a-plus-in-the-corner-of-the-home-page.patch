+// The plus, top right of the home page.
+//
+// Orca's home page offers "new project" and "open project" as two tiles in the
+// body of the page, above the recent files. That is a web page laying out a
+// desktop dialog: two large targets competing with the content for the top of
+// the screen, in a place iPadOS puts nothing. The tiles are hidden
+// (css/orca-ios.css) and this replaces them with the one control the platform
+// uses for exactly this - a plus in the top trailing corner, opening a menu.
+//
+// The menu is a real UIMenu, so the system draws it, in its own material, with
+// its own dismissal, its own keyboard and pointer handling and its own
+// accessibility. Nothing here paints a popup.
+//
+// Both entries end in the page's own handlers, the same two the tiles called:
+// OnClickNewProject() and OnClickOpenProject(). Whatever those do keeps
+// working, and this file does not need to know what that is.
+//
+// IT LIVES IN THE WINDOW, NOT IN THE PAGE.
+//
+// It was a subview of the WebViewPanel's wx view for three builds, and for
+// three builds it drew correctly and received nothing - no press, and no
+// pointer hover either, which together mean it was never hit-tested rather
+// than that its action was wrong. The evidence for where to put it instead was
+// already in this repository: the numeric keypad in 0381 is the one native
+// control here that has always worked, and 0381 puts it in the window on
+// purpose. wx hangs a pan and a hover gesture recogniser off every view it
+// wraps (step2/0209), and a UIKit control buried under those does not get a
+// clean touch. In the window it is a sibling of everything wx owns rather than
+// a guest inside it.
+//
+// The cost of living in the window is that the window is not the home page, so
+// visibility has to follow the notebook: orca_ios_home_plus_update() is called
+// from the tab bar's sync and shows the chip only while the home page is the
+// selected one.
+
+static const CGFloat  kOrcaPlusSize   = 44;
+static const CGFloat  kOrcaPlusMargin = 14;
+
+// The chip, once it is in the window. Retained: the window holds it too, but
+// this reference outlives any reordering wx does underneath.
+static UIView   *gs_orca_home_plus  = nil;
+// The page it belongs to, and the web view its menu talks to. Both assigned,
+// never retained - wx owns them.
+static wxWindow *gs_orca_home_panel = nullptr;
+static WKWebView *gs_orca_home_web  = nil;
+// Held from the call in init_tabpanel until there is a window to install into.
+static std::string gs_orca_home_new_title;
+static std::string gs_orca_home_open_title;
+
+static WKWebView *orca_ios_find_web_view(UIView *view)
+{
+    if (view == nil)
+        return nil;
+    if ([view isKindOfClass:[WKWebView class]])
+        return (WKWebView *) view;
+    for (UIView *sub in view.subviews) {
+        WKWebView *const found = orca_ios_find_web_view(sub);
+        if (found != nil)
+            return found;
+    }
+    return nil;
+}
+
+static void orca_ios_home_run(NSString *script)
+{
+    if (gs_orca_home_web == nil || script == nil) {
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-home: no web view to run "
+                                 << (script != nil ? [script UTF8String] : "(null)");
+        return;
+    }
+    BOOST_LOG_TRIVIAL(error) << "orca-ios-home: running " << [script UTF8String];
+    [gs_orca_home_web evaluateJavaScript:script completionHandler:^(id result, NSError *error) {
+        (void) result;
+        if (error != nil)
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-home: " << [script UTF8String] << " failed: "
+                                     << [[error localizedDescription] UTF8String];
+    }];
+}
