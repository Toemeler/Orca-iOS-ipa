+// Long press -> the right-click context menu.
+//
+// A tablet has no second mouse button, and the object menu is where deleting,
+// duplicating, "fill bed with copies" and per-object settings all live, so
+// without this a large part of the application is unreachable by finger.
+//
+// Synthesised into on_mouse() rather than reimplemented: everything that
+// decides whether a menu opens, and which one, already lives there and depends
+// on the hover state. That state is correct by the time this fires - the finger
+// has been resting on the same point for half a second, so the pointer path has
+// already reported it and several picking passes have run.
+//
+// The press recognizer cancels the touch when it recognises, which the port
+// turns into a LEFT_UP, so the tap that was already in progress completes and
+// selects whatever is under the finger - the same order a desktop right click
+// happens in - and no stray release arrives when the finger lifts.
+void GLCanvas3D::on_long_press(wxLongPressEvent& evt)
+{
+    if (!evt.IsGestureStart())
+        return;
+
+    const wxPoint pos = evt.GetPosition();
+    const wxEventType types[] = { wxEVT_RIGHT_DOWN, wxEVT_RIGHT_UP };
+    for (const wxEventType type : types) {
+        wxMouseEvent synth(type);
+        synth.SetPosition(pos);
+        synth.SetEventObject(m_canvas);
+        synth.SetId(m_canvas->GetId());
+        synth.SetRightDown(type == wxEVT_RIGHT_DOWN);
+        on_mouse(synth);
+    }
+}
