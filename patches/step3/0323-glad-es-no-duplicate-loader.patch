diff --git a/src/glad/CMakeLists.txt b/src/glad/CMakeLists.txt
index 347d03db5..c24d5b356 100644
--- a/src/glad/CMakeLists.txt
+++ b/src/glad/CMakeLists.txt
@@ -1,3 +1,15 @@
-add_library(glad STATIC src/gl.c)
-target_include_directories(glad PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
-target_link_libraries(glad PRIVATE ${CMAKE_DL_LIBS})
+if (SLIC3R_OPENGL_ES)
+    # src/libvgcode compiles its own glad for GLES2 under this flag, so building
+    # src/gl.c as well defines every glad_gl* symbol twice (260 duplicate symbols
+    # at link, step-4 run 4). Drop the desktop loader and expose a header shim
+    # redirecting <glad/gl.h> to <glad/gles2.h>, letting libvgcode own the
+    # implementation that is actually linked.
+    add_library(glad INTERFACE)
+    target_include_directories(glad INTERFACE
+        ${CMAKE_CURRENT_SOURCE_DIR}/include-es
+        ${CMAKE_CURRENT_SOURCE_DIR}/../libvgcode/glad/include)
+else ()
+    add_library(glad STATIC src/gl.c)
+    target_include_directories(glad PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
+    target_link_libraries(glad PRIVATE ${CMAKE_DL_LIBS})
+endif ()
