+// Merge runs of consecutive segments that are collinear and identical.
+//
+// This model slices to 2.4 million segments, and the reason is on screen the
+// moment it loads: "Processing model with more than 1M triangles". A mesh that
+// dense produces a perimeter polygon with a vertex wherever a triangle edge
+// crosses the layer plane, so the toolpath is carved into hundreds of thousands
+// of micro-moves that are *already* straight - adjacent triangles on a smooth
+// surface differ in direction by a fraction of a degree. The slicer has no
+// reason to simplify them and the viewer draws every one.
+//
+// Nothing about that is a level of detail decision. Twenty collinear segments
+// with the same width, colour and speed draw exactly the same pixels as one
+// segment spanning the same distance, because the shader builds a box from the
+// two endpoints and lights it - and the endpoints, widths, angles and colours
+// of the merged segment are the originals. The intermediate vertices contribute
+// nothing but vertex shader invocations.
+//
+// So they are dropped, under a bound rather than a guess: a vertex is only
+// swallowed if it lies within COLLINEAR_EPS_MM of the run's anchor line, which
+// keeps the drawn path within that distance of the real one. At 0.01 mm that is
+// a fortieth of a 0.4 mm extrusion - smaller than the line it is drawn with,
+// and far below one screen pixel at any zoom the bed fits on.
+//
+// The run is also cut whenever anything that changes the *appearance* changes:
+// role, move type, extruder, colour id, layer, width, height, and every scalar
+// any view type colours by. Two segments only merge if they would have been
+// drawn identically.
+static constexpr float COLLINEAR_EPS_MM = 0.01f;
+// Bounds the anchor-line drift and keeps merged indices local.
+static constexpr size_t MAX_RUN_SEGMENTS = 64;
+
+static bool same_appearance(const PathVertex& a, const PathVertex& b)
+{
+    return a.role == b.role && a.type == b.type &&
+           a.extruder_id == b.extruder_id && a.color_id == b.color_id &&
+           a.layer_id == b.layer_id &&
+           a.height == b.height && a.width == b.width &&
+           a.feedrate == b.feedrate && a.actual_feedrate == b.actual_feedrate &&
+           a.mm3_per_mm == b.mm3_per_mm && a.fan_speed == b.fan_speed &&
+           a.temperature == b.temperature && a.layer_duration == b.layer_duration &&
+           a.pressure_advance == b.pressure_advance && a.acceleration == b.acceleration &&
+           a.jerk == b.jerk;
+}
+
+// Where p sits relative to the infinite line through anchor with unit direction
+// dir: how far along it (first) and how far off it (second).
+static std::pair<float, float> project_on_line(const Vec3& p, const Vec3& anchor, const Vec3& dir)
+{
+    const Vec3 d = { p[0] - anchor[0], p[1] - anchor[1], p[2] - anchor[2] };
+    const float t = d[0] * dir[0] + d[1] * dir[1] + d[2] * dir[2];
+    const Vec3 perp = { d[0] - t * dir[0], d[1] - t * dir[1], d[2] - t * dir[2] };
+    return { t, std::sqrt(perp[0] * perp[0] + perp[1] * perp[1] + perp[2] * perp[2]) };
+}
+
+std::vector<uint32_t> ViewerImpl::coalesce_collinear_runs(const std::vector<uint32_t>& enabled_segments) const
+{
+    // Pairs: two entries per drawn segment, its first and last vertex. Where
+    // nothing merges this is the old list with each entry's successor spelled
+    // out, which is what the shader used to assume.
+    std::vector<uint32_t> ret;
+    ret.reserve(enabled_segments.size() * 2);
+
+    size_t i = 0;
+    while (i < enabled_segments.size()) {
+        const uint32_t first = enabled_segments[i];
+        size_t j = i;
+
+        // The anchor line is the run's own first segment. Every vertex the run
+        // swallows has to stay within COLLINEAR_EPS_MM of it, so the merged
+        // chord cannot drift away from the real path however long the run gets.
+        const Vec3& anchor = m_vertices[first].position;
+        const Vec3& next   = m_vertices[first + 1].position;
+        Vec3 dir = { next[0] - anchor[0], next[1] - anchor[1], next[2] - anchor[2] };
+        const float len = std::sqrt(dir[0] * dir[0] + dir[1] * dir[1] + dir[2] * dir[2]);
+        if (len > 1e-6f) {
+            dir = { dir[0] / len, dir[1] / len, dir[2] / len };
+            float last_t = len;
+            while (j + 1 < enabled_segments.size() &&
+                   j - i + 1 < MAX_RUN_SEGMENTS &&
+                   enabled_segments[j + 1] == enabled_segments[j] + 1 &&
+                   same_appearance(m_vertices[first], m_vertices[enabled_segments[j + 1]]) &&
+                   same_appearance(m_vertices[first], m_vertices[enabled_segments[j + 1] + 1])) {
+                // The vertex to test is the one the chord would newly reach, not
+                // the one it would swallow: the swallowed one is the anchor
+                // line's own second point on the first extension and sits
+                // exactly on it, so testing that would merge every run by at
+                // least two segments whatever the geometry.
+                const auto [t, off] = project_on_line(m_vertices[enabled_segments[j + 1] + 1].position, anchor, dir);
+                // Off the line, or not past where the chord already reaches. The
+                // second test is what stops a path that runs out and comes
+                // straight back from collapsing: every one of its vertices is on
+                // the anchor line, at distance zero, and merging them would
+                // delete the excursion entirely.
+                if (off >= COLLINEAR_EPS_MM || t <= last_t)
+                    break;
+                last_t = t;
+                ++j;
+            }
+        }
+
+        ret.push_back(first);
+        ret.push_back(enabled_segments[j] + 1);
+        i = j + 1;
+    }
+
+    return ret;
+}
