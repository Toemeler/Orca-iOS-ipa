+// Where the autosave belongs for the project as it stands.
+//
+// A project that has a file of its own is written *to that file*. This is the
+// correction to 0424, which always wrote a separate copy under
+// Documents/Autosave and only stopped listing it on the home page once the
+// project had a path. Not listing a second file is not the same as not having
+// one: the project the user opens in the Files app was still the stale one,
+// and the fresh work was in a directory they never chose. On a platform whose
+// whole document model is "the file is always current", the autosave has to be
+// the file.
+//
+// Only for a project inside our own Documents tree, which since 0382 is every
+// project the application can open - anything picked from elsewhere is copied
+// into Documents/Projects on the way in. A path outside it is a grant this
+// process may no longer hold, and a failed write there would be worse than a
+// copy that is merely somewhere else.
+//
+// A project with no path yet has nowhere to be written except
+// Documents/Autosave, which is what that directory is for.
+static boost::filesystem::path orca_ios_autosave_target(Plater *plater, const char *home,
+                                                        bool &to_own_file)
+{
+    to_own_file = false;
+
+    const std::string documents = std::string(home) + "/Documents/";
+    const std::string own = into_u8(plater->get_project_filename(".3mf"));
+    if (!own.empty() && own.compare(0, documents.size(), documents) == 0) {
+        to_own_file = true;
+        return boost::filesystem::path(own);
+    }
+
+    // The project name reaches this from the imported file's name, so it can
+    // contain anything - and a "/" in it would quietly write outside dir.
+    std::string stem = into_u8(plater->get_project_name());
+    if (stem.size() > 4 && stem.compare(stem.size() - 4, 4, ".3mf") == 0)
+        stem.erase(stem.size() - 4);
+    for (char &c : stem)
+        if (c == '/' || c == '\\' || c == ':')
+            c = '_';
+    if (stem.empty())
+        stem = "Untitled";
+
+    return boost::filesystem::path(documents) / "Autosave" / (stem + ".3mf");
+}
+
+// Retire the shadow copy of a project that now has a file of its own.
+//
+// Reported from the device: close a project, answer Yes, and it is on the home
+// page twice. Both tiles say the same name because they are the same project -
+// Documents/Autosave/X.3mf, written and listed while the project had no path,
+// and Documents/X.3mf, which the save has just created. wxFileHistory compares
+// paths and these are two, so nothing upstream can collapse them.
+//
+// The copy has done its job the moment the project has a real file: from here
+// on the autosave writes that file directly. Deleting it is not pruning the
+// user's documents - it is removing this application's own scratch copy of a
+// file that now exists, under the name the application chose, at the moment it
+// became redundant.
+void orca_ios_retire_autosave_copy(const wxString &project_path)
+{
+    const char *const home = ::getenv("HOME");
+    if (home == nullptr || project_path.IsEmpty())
+        return;
+
+    const boost::filesystem::path own(into_u8(project_path));
+    const boost::filesystem::path copy =
+        boost::filesystem::path(std::string(home) + "/Documents") / "Autosave" / own.filename();
+    if (copy == own)
+        return;   // the project *is* the autosave - restored from one, most likely
+
+    if (MainFrame *const frame = wxGetApp().mainframe)
+        frame->remove_from_recent_projects(from_path(copy));
+
+    boost::system::error_code ec;
+    if (boost::filesystem::exists(copy, ec)) {
+        boost::filesystem::remove(copy, ec);
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-autosave: retired the copy " << copy.string()
+                                 << (ec ? " FAILED: " + ec.message() : std::string(" ok"));
+    }
+}
