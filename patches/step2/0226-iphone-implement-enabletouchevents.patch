+// The recognizers this call installed, so a second call replaces rather than
+// stacks them. Associated with the view because the peer can outlive none of
+// it and UIKit owns the view's recognizer array.
+static char wxOSXTouchGesturesKey;
+
+bool wxWidgetIPhoneImpl::EnableTouchEvents(int eventsMask)
+{
+    UIView* const view = m_osxView;
+    if ( view == nil )
+        return false;
+
+    NSMutableArray* installed = objc_getAssociatedObject(view, &wxOSXTouchGesturesKey);
+    for ( UIGestureRecognizer* g in installed )
+        [view removeGestureRecognizer:g];
+    objc_setAssociatedObject(view, &wxOSXTouchGesturesKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+
+    if ( eventsMask == wxTOUCH_NONE )
+        return true;
+
+    // Same reason as the scroll and hover recognizers below: the selector has
+    // to exist on the view's own class or UIKit's target dispatch aborts the
+    // process with "unrecognized selector sent to instance". wx's own view
+    // classes get these from wxOSXIPhoneClassAddWXMethods; a GLKView subclass
+    // or a WKWebView does not.
+    Class viewClass = object_getClass(view);
+    struct { SEL sel; IMP imp; } methods[] = {
+        { @selector(WX_panGesture:),       (IMP) wxOSX_panGesture },
+        { @selector(WX_zoomGesture:),      (IMP) wxOSX_zoomGesture },
+        { @selector(WX_rotateGesture:),    (IMP) wxOSX_rotateGesture },
+        { @selector(WX_longPressGesture:), (IMP) wxOSX_longPressGesture },
+    };
+    for ( size_t i = 0; i < WXSIZEOF(methods); ++i )
+    {
+        if ( ![view respondsToSelector:methods[i].sel] )
+            class_addMethod(viewClass, methods[i].sel, methods[i].imp, "v@:@");
+    }
+
+    installed = [NSMutableArray array];
+
+    if ( eventsMask & (wxTOUCH_VERTICAL_PAN_GESTURE | wxTOUCH_HORIZONTAL_PAN_GESTURE) )
+    {
+        UIPanGestureRecognizer* pan =
+            [[UIPanGestureRecognizer alloc] initWithTarget:view action:@selector(WX_panGesture:)];
+        // Two fingers exactly. One finger stays the pointer.
+        pan.minimumNumberOfTouches = 2;
+        pan.maximumNumberOfTouches = 2;
+        [view addGestureRecognizer:pan];
+        [installed addObject:pan];
+        [pan release];
+    }
+
+    if ( eventsMask & wxTOUCH_ZOOM_GESTURE )
+    {
+        UIPinchGestureRecognizer* pinch =
+            [[UIPinchGestureRecognizer alloc] initWithTarget:view action:@selector(WX_zoomGesture:)];
+        [view addGestureRecognizer:pinch];
+        [installed addObject:pinch];
+        [pinch release];
+    }
+
+    if ( eventsMask & wxTOUCH_ROTATE_GESTURE )
+    {
+        UIRotationGestureRecognizer* rotate =
+            [[UIRotationGestureRecognizer alloc] initWithTarget:view action:@selector(WX_rotateGesture:)];
+        [view addGestureRecognizer:rotate];
+        [installed addObject:rotate];
+        [rotate release];
+    }
+
+    if ( eventsMask & wxTOUCH_PRESS_GESTURES )
+    {
+        UILongPressGestureRecognizer* press =
+            [[UILongPressGestureRecognizer alloc] initWithTarget:view action:@selector(WX_longPressGesture:)];
+        // Cancel the touch when the press is recognised, which is what makes
+        // the flow come out right. The cancelled-touch handler turns it into a
+        // LEFT_UP, so the tap the finger already started completes - selecting
+        // whatever is under it, exactly as a desktop right click does before it
+        // opens a menu - and no second LEFT_UP arrives when the finger finally
+        // lifts. A press that fails because the finger moved cancels nothing,
+        // so dragging still orbits the view.
+        press.cancelsTouchesInView = YES;
+        [view addGestureRecognizer:press];
+        [installed addObject:press];
+        [press release];
+    }
+
+    objc_setAssociatedObject(view, &wxOSXTouchGesturesKey, installed,
+                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    return true;
+}
