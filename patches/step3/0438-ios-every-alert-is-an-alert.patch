+bool MsgDialog::orca_ios_is_plain() const
+{
+    // Everything MsgDialog itself puts in the dialog is known by name. Anything
+    // else is a subclass's, and an alert has nowhere to put it.
+    for (wxWindow *const child : GetChildren()) {
+        if (child == nullptr)
+            continue;
+        if (child == logo || child == m_checkbox_dsa || child == m_ios_dsa_label)
+            continue;
+        if (std::find(m_ios_content.begin(), m_ios_content.end(), child) != m_ios_content.end())
+            continue;
+
+        bool is_button = false;
+        for (auto &entry : m_buttons) {
+            if (entry.second != nullptr && entry.second->buttondata != nullptr &&
+                entry.second->buttondata->button == child) {
+                is_button = true;
+                break;
+            }
+        }
+        if (is_button)
+            continue;
+
+        // wxString and not the wxChar* straight out of GetClassName(): that is
+        // wchar_t* in a Unicode build, and streaming one into a narrow
+        // std::ostream is a deleted overload rather than a conversion.
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-alert: [" << GetTitle().utf8_string()
+                                 << "] keeps its window - it holds a "
+                                 << wxString(child->GetClassInfo()->GetClassName()).utf8_string();
+        return false;
+    }
+
+    return true;
+}
+
+// The buttons, in the order they were added.
+//
+// m_buttons is a hash and hands them back in no order at all, but the key each
+// one was stored under is its index as a decimal string (add_button below), so
+// the order is recoverable and it is the order the dialog itself lays them out
+// in. That matters: the first row of an iOS alert is the one the eye lands on,
+// and apply_style() adds the affirmative button first.
+static std::vector<Button *> orca_ios_buttons_in_order(const MsgButtonsHash &buttons)
+{
+    std::vector<Button *> out;
+    for (size_t i = 0; i < buttons.size(); ++i) {
+        const auto it = buttons.find(wxString::Format("%d", (int) i));
+        if (it == buttons.end() || it->second == nullptr || it->second->buttondata == nullptr)
+            continue;
+        if (Button *const btn = it->second->buttondata->button)
+            out.push_back(btn);
+    }
+    return out;
+}
+
+// The message, without the markup some of the callers put in it.
+//
+// Orca hands add_msg_content() plain text most of the time, but not always:
+// the Device page's error strings arrive with <br> in them, several dialogs
+// build a small table, and is_marked_msg messages carry <Error> spans. A
+// UIAlertController message is a plain string, so a tag reaches the user as a
+// tag. Only strings that actually look like markup are touched - a tolerance
+// that matters, because "layer height < 0.4" is a sentence, not an element.
+static wxString orca_ios_plain_text(const wxString &in)
+{
+    // Both, because an entity does not need a tag to go with it: a message
+    // that is otherwise plain but says "A &amp; B" would come out of an
+    // early return with the entity still in it.
+    if (in.find('<') == wxString::npos && in.find('&') == wxString::npos)
+        return in;
+
+    wxString out;
+    out.reserve(in.length());
+
+    for (size_t i = 0; i < in.length();) {
+        if (in[i] == '<') {
+            // A tag is '<', optionally '/', then a letter. Anything else is a
+            // less-than sign in a sentence and stays where it is.
+            size_t j = i + 1;
+            if (j < in.length() && in[j] == '/')
+                ++j;
+            // Deliberately not wxIsalpha(): that takes a wxUniChar through a
+            // locale, and "is this a tag" is an ASCII question.
+            const bool letter = j < in.length() &&
+                                ((in[j] >= 'a' && in[j] <= 'z') || (in[j] >= 'A' && in[j] <= 'Z'));
+            if (!letter) {
+                out += in[i++];
+                continue;
+            }
+            const size_t close = in.find('>', i);
+            if (close == wxString::npos) {
+                out += in[i++];
+                continue;
+            }
+            const wxString tag = in.Mid(i + 1, close - i - 1).Lower();
+            // The tags that are a line break in disguise. Everything else -
+            // <b>, <font>, <span>, <a>, <code> - is styling the alert applies
+            // for itself, so it simply goes away.
+            if (tag.StartsWith("br") || tag.StartsWith("/p") || tag.StartsWith("/tr") ||
+                tag.StartsWith("/div") || tag.StartsWith("/li"))
+                out += "\n";
+            else if (tag.StartsWith("li"))
+                out += wxString::FromUTF8("\n\xE2\x80\xA2 ");   // a bullet
+            i = close + 1;
+            continue;
+        }
+
+        if (in[i] == '&') {
+            const size_t semi = in.find(';', i);
+            if (semi != wxString::npos && semi - i <= 6) {
+                const wxString entity = in.Mid(i + 1, semi - i - 1).Lower();
+                if      (entity == "amp")  { out += "&";  i = semi + 1; continue; }
+                else if (entity == "lt")   { out += "<";  i = semi + 1; continue; }
+                else if (entity == "gt")   { out += ">";  i = semi + 1; continue; }
+                else if (entity == "quot") { out += "\""; i = semi + 1; continue; }
+                else if (entity == "nbsp") { out += " ";  i = semi + 1; continue; }
+            }
+        }
+
+        out += in[i++];
+    }
+
+    // Three blank lines where a table used to be is not a paragraph break.
+    while (out.Replace("\n\n\n", "\n\n") > 0)
+        ;
+    out.Trim(true);
+    out.Trim(false);
+    return out;
 }
 
+int MsgDialog::ShowModal()
+{
+    if (!orca_ios_is_plain())
+        return DPIDialog::ShowModal();
+
+    // WHICH STRING IS THE TITLE.
+    //
+    // MsgDialog carries two of them and which one is the sentence depends on
+    // the subclass. ErrorDialog's window title is "OrcaSlicer error" and its
+    // headline is "OrcaSlicer has encountered an error", with the actual error
+    // in the content; InfoDialog puts the real heading in the headline;
+    // MessageDialog has no headline at all and its caption is the title. An
+    // iOS alert has exactly one bold line, so the rule is: the most specific
+    // string available becomes it, and the other one is dropped rather than
+    // stacked - "OrcaSlicer information" above "OrcaSlicer information" is
+    // what stacking them gives.
+    wxString title = m_ios_headline;
+    wxString text  = orca_ios_plain_text(m_ios_text);
+    if (title.IsEmpty()) {
+        title = GetTitle();
+    } else if (text.IsEmpty()) {
+        text  = title;
+        title = GetTitle();
+    }
+
+    std::vector<IOSAlertButton> rows;
+    IOSAlertButton             *affirmative = nullptr;
+
+    for (Button *const btn : orca_ios_buttons_in_order(m_buttons)) {
+        if (!btn->IsShown())
+            continue;
+
+        IOSAlertButton row;
+        row.label   = btn->GetLabel();
+        row.id      = btn->GetId();
+        row.widget  = btn;
+        row.enabled = btn->IsEnabled();
+        // A row with no title is not a row UIKit will take, and a button whose
+        // label was never set - add_button() allows it - would silently vanish
+        // from the alert while still existing in the dialog. wx knows what OK,
+        // Cancel, Yes, No, Apply and Close are called in this language.
+        // wxIsStockID() first: wxGetStockLabel() asserts on an id it does not
+        // know, and Orca hands out custom ones.
+        if (row.label.IsEmpty() && wxIsStockID(row.id))
+            row.label = wxGetStockLabel(row.id, wxSTOCK_NOFLAGS);
+        if (row.label.IsEmpty())
+            row.label = wxString::Format("#%d", row.id);
+        // apply_style() gives every dialog in this family its buttons from the
+        // same six ids, so the roles are read off the id rather than guessed
+        // at from the label - which is translated, and which several callers
+        // replace outright through SetButtonLabel().
+        row.preferred   = row.id == wxID_OK || row.id == wxID_YES || row.id == wxFORWARD;
+        row.cancel      = row.id == wxID_CANCEL || row.id == wxID_NO;
+        row.destructive = row.id == wxID_DELETE || row.id == wxID_REMOVE;
+        rows.push_back(row);
+    }
+
+    if (rows.empty())
+        return DPIDialog::ShowModal();
+
+    for (IOSAlertButton &row : rows) {
+        if (row.preferred) {
+            affirmative = &row;
+            break;
+        }
+    }
+    if (affirmative == nullptr)
+        affirmative = &rows.front();
+
+    // The link, as a row. add_msg_content() puts it inside the running text as
+    // an <a href>, which an alert has no way to draw; the callers that use one
+    // - the network error notice, the update prompts - are all "here is more
+    // about this", so a row that opens it and closes the alert is the same
+    // offer in the shape this platform makes it.
+    if (!m_ios_link_text.IsEmpty() && m_ios_link_callback) {
+        IOSAlertButton row;
+        row.label  = m_ios_link_text;
+        row.id     = affirmative->id;
+        row.widget = affirmative->widget;
+        auto cb    = m_ios_link_callback;
+        row.before = [cb]() { cb(wxString("#")); };
+        rows.insert(rows.begin(), row);
+        affirmative = nullptr;   // the vector has moved; nothing reads it again
+    }
+
+    // And the "don't show again" checkbox, as the row it has to be.
+    if (m_checkbox_dsa != nullptr && !m_ios_dsa_title.IsEmpty()) {
+        // Recomputed rather than kept: the insert above can have moved it.
+        IOSAlertButton *target = nullptr;
+        for (IOSAlertButton &row : rows) {
+            if (row.preferred) {
+                target = &row;
+                break;
+            }
+        }
+        if (target == nullptr)
+            target = &rows.front();
+
+        IOSAlertButton row;
+        row.label  = m_ios_dsa_title;
+        row.id     = target->id;
+        row.widget = target->widget;
+        CheckBox *const box = m_checkbox_dsa;
+        row.before = [box]() {
+            // Exactly what a tick does, event and all: show_dsa_button() binds
+            // wxEVT_TOGGLEBUTTON and several callers listen for the change
+            // rather than reading get_checkbox_state() at the end.
+            box->SetValue(true);
+            wxCommandEvent ev(wxEVT_TOGGLEBUTTON, box->GetId());
+            ev.SetEventObject(box);
+            ev.SetInt(1);
+            box->GetEventHandler()->ProcessEvent(ev);
+        };
+        // After the affirmative row and before the cancel one: it is a way of
+        // saying yes, not a third answer.
+        size_t at = rows.size();
+        for (size_t i = 0; i < rows.size(); ++i) {
+            if (rows[i].cancel) {
+                at = i;
+                break;
+            }
+        }
+        rows.insert(rows.begin() + at, row);
+    }
+
+    int result = wxID_CANCEL;
+    if (!orca_ios_alert_run(this, title, text, rows, nullptr, &result))
+        return DPIDialog::ShowModal();
+
+    return result;
+}
+
+int DeleteConfirmDialog::ShowModal()
+{
+    if (m_del_btn == nullptr || m_cancel_btn == nullptr)
+        return DPIDialog::ShowModal();
+
+    std::vector<IOSAlertButton> rows;
+
+    IOSAlertButton del;
+    del.label       = m_del_btn->GetLabel();
+    del.id          = wxID_OK;
+    del.widget      = m_del_btn;
+    del.destructive = true;
+    rows.push_back(del);
+
+    IOSAlertButton cancel;
+    cancel.label  = m_cancel_btn->GetLabel();
+    cancel.id     = wxID_CANCEL;
+    cancel.widget = m_cancel_btn;
+    cancel.cancel = true;
+    rows.push_back(cancel);
+
+    int result = wxID_CANCEL;
+    // Off the label and not off `msg`: the constructor's parameter shadows the
+    // member of the same name and the member is never assigned, so the member
+    // is empty in every DeleteConfirmDialog ever built.
+    const wxString text = m_msg_text != nullptr ? m_msg_text->GetLabel() : wxString();
+    if (!orca_ios_alert_run(this, GetTitle(), orca_ios_plain_text(text), rows, nullptr, &result))
+        return DPIDialog::ShowModal();
+
+    return result;
+}
+
