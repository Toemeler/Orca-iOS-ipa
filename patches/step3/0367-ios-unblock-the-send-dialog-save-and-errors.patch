+#if defined(__APPLE__) && !TARGET_OS_OSX
+            // Onto the main thread. These two are the only Ctl methods that
+            // touch the progress indicator directly from the worker thread -
+            // update_status goes through m_output_queue and is drained on the
+            // main thread, as it should be. BBLStatusBarSend::clear_percent
+            // calls m_cancelbutton->Hide(), so this ends in -[UIView
+            // setHidden:] off the main thread, and UIKit is not thread-safe.
+            //
+            // That is where the send dialog stops. The printer takes the file
+            // and answers "result":"success", but the agent's very next call
+            // is the Finished notification that lands here, and it never
+            // returns - so PrintJob never reports success and the dialog sits
+            // at 75% for ever. The instrumented build made it exact: "command
+            // published, reporting Finished" is the last line in the log.
+            auto pri = m_progress;
+            wxTheApp->CallAfter([pri] { pri->clear_percent(); });
+#else
             m_progress->clear_percent();
+#endif
         }
     }
 
     void show_error_info(const std::string &msg, int code, const std::string &description, const std::string &extra) override
     {
         if (m_progress) {
+#if defined(__APPLE__) && !TARGET_OS_OSX
+            auto pri = m_progress;
+            const wxString m = from_u8(msg), d = from_u8(description), e = from_u8(extra);
+            wxTheApp->CallAfter([pri, m, code, d, e] { pri->show_error_info(m, code, d, e); });
+#else
             m_progress->show_error_info(from_u8(msg), code, from_u8(description), from_u8(extra));
+#endif
         }
     }
 
