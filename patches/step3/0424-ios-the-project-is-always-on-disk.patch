+// -- the application is going away -----------------------------------------
+//
+// There is no quit on this platform, and that is the whole problem.
+//
+// On a desktop the application is closed by the user, gets asked whether it
+// wants to save first, and runs whatever it likes on the way out. iOS does none
+// of that. When the user swipes up to the home screen the process is left
+// running for a moment and then *suspended*: it is frozen mid-instruction, and
+// the system reclaims it later - minutes or days - without running another line
+// of its code. Nothing is delivered when that happens. wx implements
+// applicationWillTerminate:, but UIKit only sends it to an application that is
+// still running when it is killed, which a suspended one by definition is not,
+// so it is not the hook this needs.
+//
+// UIApplicationWillResignActiveNotification is. It arrives while the
+// application is still frontmost and fully alive - the user has just started
+// the gesture, or pulled down a banner, or taken a call - and it precedes every
+// route to suspension there is. That is the last moment at which the work can
+// be written, so that is where it is written.
+//
+// THE THREE NOTIFICATIONS ARE NOT THE SAME, and the `full` argument is where
+// the difference lands - see orca_ios_save_everything_now.
+//
+//   willResignActive       Still foreground, still allowed to render, nothing
+//                          is wrong with the process. Write everything.
+//   didEnterBackground     GL is now grounds for termination by the OS, so the
+//                          copy with the thumbnails in it is out. A backstop
+//                          for whatever changed between the two, and the point
+//                          at which the config has to be on disk.
+//   didReceiveMemoryWarning
+//                          Still foreground, but this may be the only notice
+//                          before jetsam takes the process - which on an iPad
+//                          slicing a large model is a real way to die. Not
+//                          full, for a different reason than the background
+//                          one: rendering four thumbnails per plate is exactly
+//                          the allocation the warning is about.
+//
+// Registered once, from MainFrame's constructor: before that there is no
+// project to save, and the notification would have nothing to do.
+
+// src/slic3r/GUI/MainFrame.cpp
+namespace Slic3r { namespace GUI {
+void orca_ios_save_everything_now(const char *why, bool full);
+} }
+
+@interface OrcaLifecycleObserver : NSObject
+@end
+
+@implementation OrcaLifecycleObserver
+
+- (void)willResignActive:(NSNotification *)n
+{
+    (void) n;
+    Slic3r::GUI::orca_ios_save_everything_now("willResignActive", true);
+}
+
+- (void)didEnterBackground:(NSNotification *)n
+{
+    (void) n;
+    Slic3r::GUI::orca_ios_save_everything_now("didEnterBackground", false);
+}
+
+- (void)didReceiveMemoryWarning:(NSNotification *)n
+{
+    (void) n;
+    Slic3r::GUI::orca_ios_save_everything_now("memoryWarning", false);
+}
+
+@end
+
+static OrcaLifecycleObserver *gs_orca_lifecycle = nil;
+
+
 namespace Slic3r {
 namespace GUI {
 
+void orca_ios_install_lifecycle_hooks()
+{
+    if (gs_orca_lifecycle != nil)
+        return;
+
+    @try {
+        gs_orca_lifecycle = [[OrcaLifecycleObserver alloc] init];
+        NSNotificationCenter *const nc = [NSNotificationCenter defaultCenter];
+        [nc addObserver:gs_orca_lifecycle
+               selector:@selector(willResignActive:)
+                   name:UIApplicationWillResignActiveNotification
+                 object:nil];
+        [nc addObserver:gs_orca_lifecycle
+               selector:@selector(didEnterBackground:)
+                   name:UIApplicationDidEnterBackgroundNotification
+                 object:nil];
+        [nc addObserver:gs_orca_lifecycle
+               selector:@selector(didReceiveMemoryWarning:)
+                   name:UIApplicationDidReceiveMemoryWarningNotification
+                 object:nil];
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-save: lifecycle hooks installed";
+    }
+    @catch (NSException *e) {
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-save: lifecycle hooks THREW "
+                                 << [[e name] UTF8String] << ": " << [[e reason] UTF8String];
+        gs_orca_lifecycle = nil;
+    }
+}
