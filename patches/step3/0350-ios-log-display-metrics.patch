+// Display metrics, logged once, because the layout is wrong in a way that only
+// the numbers can explain. wx reports the top-level window as 1600x1200 points
+// (patch 0326 sets it from wxDisplay, whose iOS implementation is
+// [[UIScreen mainScreen] bounds]), while an iPad16,5 is documented as 1376x1032
+// points at 2x. 2752/1600 and 2064/1200 are both exactly 1.72, so the app is
+// being handed a non-native logical canvas and everything it draws is rescaled
+// by a non-integer factor - which is what "the text is stretched" looks like.
+//
+// The Info.plist already has UILaunchScreen, UIRequiresFullScreen and
+// UIDeviceFamily=2, so the usual causes are ruled out and guessing further is
+// not worth an hour of CI. Print what UIKit actually says instead.
+void orca_ios_log_display_metrics(const char *when)
+{
+    UIScreen *const screen = [UIScreen mainScreen];
+    const CGRect    b      = screen.bounds;
+    const CGRect    nb     = screen.nativeBounds;
+
+    CGRect wb = CGRectZero;
+    for (UIWindow *w in [UIApplication sharedApplication].windows) {
+        if (w.isKeyWindow) { wb = w.bounds; break; }
+    }
+
+    BOOST_LOG_TRIVIAL(error) << "orca-ios-display (" << (when ? when : "?") << "): "
+        << "UIScreen.bounds " << b.size.width << "x" << b.size.height
+        << ", nativeBounds " << nb.size.width << "x" << nb.size.height
+        << ", scale " << screen.scale << ", nativeScale " << screen.nativeScale
+        << ", keyWindow " << wb.size.width << "x" << wb.size.height;
+}
+
 } // namespace GUI
 } // namespace Slic3r
