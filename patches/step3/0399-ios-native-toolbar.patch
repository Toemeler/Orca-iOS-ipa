+// -- the plater toolbar ----------------------------------------------------
+//
+// The same nanosvg GLTexture uses to build the toolbar atlas, so the buttons
+// below are rasterised from the identical files at the identical geometry.
+#include "nanosvg/nanosvg.h"
+#include "nanosvg/nanosvgrast.h"
+
+static const CGFloat kOrcaToolSize   = 44;   // Apple's minimum touch target
+static const CGFloat kOrcaToolGap    = 4;
+static const CGFloat kOrcaToolInset  = 8;
+static const CGFloat kOrcaToolCorner = 11;
+static const CGFloat kOrcaToolMargin = 12;   // off the edge of the canvas
+
+// src/slic3r/GUI/GLCanvas3D.cpp - runs the item's own callback, which is what a
+// click on the GL toolbar ran.
+namespace Slic3r { namespace GUI { void orca_ios_toolbar_action(void *canvas, const char *id); } }
+
+static void orca_ios_free_bitmap(void *info, const void *data, size_t size)
+{
+    (void) info;
+    (void) size;
+    free((void *) data);
+}
+
+// One of Orca's toolbar SVGs, rasterised at the size and scale this screen
+// wants. nanosvg writes straight (non-premultiplied) RGBA, which is why this
+// goes through CGImageCreate and a data provider rather than a bitmap context -
+// a CGBitmapContext cannot be told to hold unpremultiplied alpha, and asking it
+// to would darken every antialiased edge on the icons.
+static UIImage *orca_ios_svg_image(const std::string &path, CGFloat points, CGFloat screen_scale)
+{
+    NSVGimage *svg = nsvgParseFromFile(path.c_str(), "px", 96.0f);
+    if (svg == nullptr || svg->width <= 0.0f || svg->height <= 0.0f) {
+        if (svg != nullptr)
+            nsvgDelete(svg);
+        return nil;
+    }
+
+    const int px = (int) (points * screen_scale + 0.5f);
+    if (px <= 0) {
+        nsvgDelete(svg);
+        return nil;
+    }
+
+    // Uniform, and centred: the toolbar icons are square, but nothing here has
+    // to assume it.
+    const float scale = (float) std::min((double) px / svg->width, (double) px / svg->height);
+    const float tx    = 0.5f * ((float) px - svg->width  * scale);
+    const float ty    = 0.5f * ((float) px - svg->height * scale);
+
+    unsigned char *const rgba = (unsigned char *) calloc((size_t) px * px * 4, 1);
+    if (rgba == nullptr) {
+        nsvgDelete(svg);
+        return nil;
+    }
+
+    NSVGrasterizer *const rast = nsvgCreateRasterizer();
+    if (rast == nullptr) {
+        free(rgba);
+        nsvgDelete(svg);
+        return nil;
+    }
+    nsvgRasterize(rast, svg, tx, ty, scale, rgba, px, px, px * 4);
+    nsvgDeleteRasterizer(rast);
+    nsvgDelete(svg);
+
+    CGColorSpaceRef  const cs   = CGColorSpaceCreateDeviceRGB();
+    CGDataProviderRef const prov = CGDataProviderCreateWithData(NULL, rgba,
+                                                               (size_t) px * px * 4,
+                                                               orca_ios_free_bitmap);
+    CGImageRef const cg = CGImageCreate(px, px, 8, 32, (size_t) px * 4, cs,
+                                        (CGBitmapInfo) (kCGBitmapByteOrderDefault | kCGImageAlphaLast),
+                                        prov, NULL, false, kCGRenderingIntentDefault);
+    CGDataProviderRelease(prov);
+    CGColorSpaceRelease(cs);
+    if (cg == NULL)
+        return nil;
+
+    // Original, not template: these icons carry their own colours, and Orca
+    // already hands over the light or the dark file to match its theme.
+    UIImage *const img = [[UIImage imageWithCGImage:cg scale:screen_scale
+                                        orientation:UIImageOrientationUp]
+                          imageWithRenderingMode:UIImageRenderingModeAlwaysOriginal];
+    CGImageRelease(cg);
+    return img;
+}
+
+// Rasterising twenty-five SVGs is not something to do on every idle, and the
+// idle handler is exactly where the toolbar is kept in step, so they are kept.
+static NSMutableDictionary<NSString *, UIImage *> *gs_orca_tool_icons = nil;
+
+static UIImage *orca_ios_tool_icon(const char *icon)
+{
+    if (icon == nullptr || *icon == '\0')
+        return nil;
+
+    const CGFloat scale = [UIScreen mainScreen].scale;
+    NSString *const key  = [NSString stringWithFormat:@"%s@%.0f", icon, (double) scale];
+    if (gs_orca_tool_icons == nil)
+        gs_orca_tool_icons = [[NSMutableDictionary alloc] init];
+    UIImage *cached = [gs_orca_tool_icons objectForKey:key];
+    if (cached != nil)
+        return cached;
+
+    const std::string path = Slic3r::resources_dir() + "/images/" + icon;
+    UIImage *const img = orca_ios_svg_image(path, kOrcaToolSize - 2 * 6, scale);
+    if (img == nil) {
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-toolbar: could not rasterise " << path;
+        return nil;
+    }
+    [gs_orca_tool_icons setObject:img forKey:key];
+    return img;
+}
+
+// The plater toolbar, on the trailing edge, in glass.
+//
+// Orca draws its toolbar *inside the GL canvas*: GLToolbar composes the icons
+// into a texture atlas and renders them as quads across the top of the 3D view,
+// and the gizmo bar beside it does the same from GLGizmosManager. Nothing about
+// that is a control - there is no view, no hit target, no accessibility, and at
+// iPad scale a 42px row of 24px glyphs is a line of dots along the top edge.
+//
+// The row is replaced here by a column of real UIButtons on a real
+// UIGlassEffect panel, down the right hand side of the canvas. Same icons: the
+// button images are rasterised from the very same resources/images/*.svg files
+// GLToolbar feeds to its atlas, named by the C++ side so the light and dark
+// variants keep following Orca's own theme. Same actions, too - a tap ends in
+// GLToolbarItem::do_left_action() or GLGizmosManager::open_gizmo(), which is
+// exactly what a click on the GL toolbar ended in.
+//
+// COLLAPSED AND OPEN. The full set is 25 items, which is a column taller than
+// an iPad. Collapsed - the default - shows the nine that get used while placing
+// a model: add, add plate, auto orient, arrange, variable layer height, and the
+// move / rotate / scale / lay on face gizmos. The chevron at the foot of the
+// panel opens the rest in place. Which items are in the collapsed set is
+// decided on the C++ side, in orca_ios_collect_toolbar(), where the names are.
+//
+// The GL toolbars are not merely hidden behind this: _render_main_toolbar() and
+// _render_gizmos_overlay() return early, and both of their mouse handlers are
+// skipped, so there is no invisible strip left along the top of the canvas
+// quietly eating touches.
+
+@interface OrcaToolbarButton : UIButton
+@property (nonatomic, copy) NSString *itemId;
+@end
+
+@implementation OrcaToolbarButton
+- (void)dealloc
+{
+    [_itemId release];
+    [super dealloc];
+}
+@end
+
+@interface OrcaToolbar : UIView
+@property (nonatomic, assign) void *canvas;          // GLCanvas3D *, owned by wx
+- (void)setItems:(NSArray<NSDictionary *> *)items;
+- (void)reposition;
+@end
+
+@implementation OrcaToolbar {
+    UIVisualEffectView *_glass;
+    UIButton           *_chevron;
+    NSMutableArray<OrcaToolbarButton *> *_buttons;
+    NSArray<NSDictionary *>             *_items;
+    BOOL                                 _open;
+}
+
+- (instancetype)initWithFrame:(CGRect)frame
+{
+    self = [super initWithFrame:frame];
+    if (self == nil)
+        return nil;
+
+    self.backgroundColor     = [UIColor clearColor];
+    self.clipsToBounds       = NO;
+    self.layer.shadowColor   = [UIColor blackColor].CGColor;
+    self.layer.shadowOpacity = 0.20f;
+    self.layer.shadowRadius  = 14;
+    self.layer.shadowOffset  = CGSizeMake(0, 4);
+
+    UIGlassEffect *const glass = [[[UIGlassEffect alloc] init] autorelease];
+    glass.interactive = YES;
+
+    _glass = [[UIVisualEffectView alloc] initWithEffect:glass];
+    _glass.layer.cornerCurve  = kCACornerCurveContinuous;
+    _glass.clipsToBounds      = YES;
+    [self addSubview:_glass];
+
+    _buttons = [[NSMutableArray alloc] init];
+
+    _chevron = [[UIButton buttonWithType:UIButtonTypeSystem] retain];
+    [_chevron addTarget:self action:@selector(toggle:)
+       forControlEvents:UIControlEventTouchUpInside];
+    [_glass.contentView addSubview:_chevron];
+    [self updateChevron];
+
+    return self;
+}
+
+- (void)dealloc
+{
+    [_buttons release];
+    [_items release];
+    [_chevron release];
+    [_glass release];
+    [super dealloc];
+}
+
+- (void)updateChevron
+{
+    // Down to open, up to close: the extra items appear below the ones already
+    // there, so the chevron points the way the column is about to grow.
+    UIImage *const img = [UIImage systemImageNamed:(_open ? @"chevron.up" : @"chevron.down")];
+    [_chevron setImage:img forState:UIControlStateNormal];
+    _chevron.tintColor = [UIColor secondaryLabelColor];
+    _chevron.accessibilityLabel = _open ? @"Fewer tools" : @"More tools";
+}
+
+- (void)toggle:(id)sender
+{
+    (void) sender;
+    _open = !_open;
+    [self updateChevron];
+    [self rebuild];
+    [UIView animateWithDuration:0.22 delay:0
+         usingSpringWithDamping:0.88f initialSpringVelocity:0
+                        options:UIViewAnimationOptionCurveEaseOut
+                     animations:^{ [self reposition]; }
+                     completion:nil];
+}
+
+// The items this column is showing: all of them when open, the ones the C++
+// side marked for the collapsed set when not.
+- (NSArray<NSDictionary *> *)visibleItems
+{
+    if (_open)
+        return _items;
+    NSMutableArray<NSDictionary *> *const out = [NSMutableArray array];
+    for (NSDictionary *item in _items) {
+        if ([[item objectForKey:@"collapsed"] boolValue])
+            [out addObject:item];
+    }
+    return out;
+}
+
+- (void)setItems:(NSArray<NSDictionary *> *)items
+{
+    if ([items isEqualToArray:_items])
+        return;
+    [_items release];
+    _items = [items copy];
+    [self rebuild];
+    [self reposition];
+}
+
+- (void)rebuild
+{
+    for (OrcaToolbarButton *b in _buttons)
+        [b removeFromSuperview];
+    [_buttons removeAllObjects];
+
+    for (NSDictionary *item in [self visibleItems]) {
+        OrcaToolbarButton *const b = [OrcaToolbarButton buttonWithType:UIButtonTypeSystem];
+        b.itemId = [item objectForKey:@"id"];
+        [b setImage:[item objectForKey:@"image"] forState:UIControlStateNormal];
+        b.enabled            = [[item objectForKey:@"enabled"] boolValue];
+        b.accessibilityLabel = [item objectForKey:@"tooltip"];
+        b.layer.cornerRadius = kOrcaToolCorner;
+        b.layer.cornerCurve  = kCACornerCurveContinuous;
+        // Glass is the panel, not the keys - the same rule the keypad in 0381
+        // follows. A selected gizmo gets the tint instead, which is how the GL
+        // toolbar showed the same thing.
+        b.backgroundColor = [[item objectForKey:@"selected"] boolValue]
+                          ? [[UIColor systemBlueColor] colorWithAlphaComponent:0.22f]
+                          : [UIColor clearColor];
+        [b addTarget:self action:@selector(tapped:)
+            forControlEvents:UIControlEventTouchUpInside];
+        [_glass.contentView addSubview:b];
+        [_buttons addObject:b];
+    }
+    [self setNeedsLayout];
+}
+
+- (void)tapped:(OrcaToolbarButton *)sender
+{
+    if (self.canvas == nullptr || sender.itemId == nil)
+        return;
+    Slic3r::GUI::orca_ios_toolbar_action(self.canvas, [sender.itemId UTF8String]);
+}
+
+// Trailing edge, vertically centred, inside the safe area.
+- (void)reposition
+{
+    UIView *const host = self.superview;
+    if (host == nil)
+        return;
+
+    const CGRect hb         = host.bounds;
+    const UIEdgeInsets safe = host.safeAreaInsets;
+    const NSUInteger rows   = _buttons.count + 1;   // + the chevron
+    const CGFloat w = kOrcaToolSize + 2 * kOrcaToolInset;
+    CGFloat h = rows * kOrcaToolSize + (rows - 1) * kOrcaToolGap + 2 * kOrcaToolInset;
+
+    // Never taller than the canvas: an open column on a small iPad in landscape
+    // can ask for more room than there is, and a panel running off both ends is
+    // worse than a shorter one.
+    const CGFloat room = hb.size.height - safe.top - safe.bottom - 2 * kOrcaToolMargin;
+    if (h > room)
+        h = room;
+
+    const CGFloat x = hb.size.width - safe.right - kOrcaToolMargin - w;
+    const CGFloat y = safe.top + (hb.size.height - safe.top - safe.bottom - h) * 0.5f;
+    self.frame = CGRectMake(x, y, w, h);
+    [self layoutIfNeeded];
+}
+
+- (void)layoutSubviews
+{
+    [super layoutSubviews];
+
+    const CGFloat radius = MIN(kOrcaToolCorner + kOrcaToolInset, self.bounds.size.width * 0.5f);
+    _glass.frame              = self.bounds;
+    _glass.layer.cornerRadius = radius;
+    self.layer.shadowPath     = [UIBezierPath bezierPathWithRoundedRect:self.bounds
+                                                          cornerRadius:radius].CGPath;
+
+    const NSUInteger rows = _buttons.count + 1;
+    if (rows == 0)
+        return;
+    const CGFloat side = kOrcaToolSize;
+    CGFloat step = side + kOrcaToolGap;
+    const CGFloat span = self.bounds.size.height - 2 * kOrcaToolInset;
+    if (rows > 1 && rows * side + (rows - 1) * kOrcaToolGap > span)
+        step = (span - side) / (CGFloat)(rows - 1);   // squeeze rather than overflow
+
+    CGFloat y = kOrcaToolInset;
+    for (OrcaToolbarButton *b in _buttons) {
+        b.frame = CGRectMake(kOrcaToolInset, y, side, side);
+        y += step;
+    }
+    _chevron.frame = CGRectMake(kOrcaToolInset, y, side, side);
+}
+
+@end
