 }
 
+// Takes the window from wx and gives it to a UITabBarController, with wx's own
+// controller re-parented under it. Returns false while there is no window yet -
+// the notebook is built before the frame is shown, so the first few calls are
+// expected to come to nothing.
+//
+// EVERY UIKit CALL HERE IS BREADCRUMBED AND THE WHOLE THING IS CAUGHT.
+// Run 131 died in exactly this function: SIGABRT out of
+// wxEvtHandler::WXConsumeException, which is wx aborting on an exception that
+// escaped an event handler - and CallAfter below runs inside
+// ProcessPendingEvents, which is that handler. Neither the success line at the
+// bottom nor the failure line above was in the log, so the throw was in here,
+// somewhere among the four containment calls, and nothing recorded which. It
+// will not be a mystery twice: each step says what it is about to do, and an
+// NSException is caught, named and survived rather than taken up through wx.
+// Losing the native tab bar is a bad outcome; taking the application down with
+// it is a worse one.
+static bool gs_orca_tab_bar_failed = false;
+
+static void orca_ios_sync_tabs_guarded();
+// src/slic3r/GUI/ios_webview_support.mm, further down this file.
+void orca_ios_home_plus_update(wxBookCtrlBase *book);
+
+
+static bool orca_ios_install_tab_bar(wxBookCtrlBase *book)
+{
+    if (gs_orca_tab_bar != nil)
+        return true;
+    if (gs_orca_tab_bar_failed)
+        return false;      // it threw once; do not keep throwing
+
+    UIView *const content = (UIView *) book->GetHandle();
+    UIWindow *const window = content.window;
+    if (window == nil) {
+        // Logged, because run 131 could not tell whether this path had been
+        // taken ten times or none.
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-tabbar: no window yet, deferring";
+        return false;
+    }
+
+    UIViewController *const wx_vc = window.rootViewController;
+    if (wx_vc == nil) {
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-tabbar: the window has no root view controller";
+        return false;
+    }
+
+    @try {
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-tabbar: step 1, allocating over "
+                                 << [NSStringFromClass([wx_vc class]) UTF8String];
+        OrcaTabBarController *const bar = [[OrcaTabBarController alloc] initWithBook:book];
+
+        // Tabs FIRST, before this controller is anywhere near the window.
+        // Run 131 made it the window's root while it still had none, and a tab
+        // bar controller with an empty `tabs` is not a state worth being in
+        // when its view loads.
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-tabbar: step 2, building tabs";
+        [bar syncTabs];
+
+        // THE WINDOW GOES FIRST, AND WE HOLD wx's CONTROLLER OURSELVES.
+        //
+        // The other order does not work, and run 134 said so in as many words:
+        //
+        //   UIViewControllerHierarchyInconsistency: adding a root view
+        //   controller <wxUIContentViewController> as a child of view
+        //   controller: <OrcaTabBarController>
+        //
+        // A view controller has to stop being a window's root before it can
+        // become anybody's child. The reason the wrong order was there at all
+        // is real - the window holds the only strong reference to wx's
+        // controller, so clearing the root would deallocate the object that
+        // owns every wx view in the application - but the answer to that is a
+        // retain of our own, not an adoption UIKit refuses.
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-tabbar: step 3, taking the window";
+        [wx_vc retain];
+        UIView *const wx_view = [[wx_vc.view retain] autorelease];
+        window.rootViewController = bar;
+
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-tabbar: step 4, adopting the wx controller";
+        [bar addChildViewController:wx_vc];
+
+        // Underneath everything UITabBarController puts in its own view: the
+        // tab's content container, and the floating bar above that.
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-tabbar: step 5, putting wx back under the bar";
+        // Inset from the top, so the floating bar sits above the page rather
+        // than on it - see kOrcaTabBarInset. -viewDidLayoutSubviews puts it
+        // back after rotation and after wx resizes the frame itself.
+        bar.wxView               = wx_view;
+        wx_view.autoresizingMask = UIViewAutoresizingFlexibleWidth |
+                                   UIViewAutoresizingFlexibleHeight;
+        [bar.view insertSubview:wx_view atIndex:0];
+        [bar.view setNeedsLayout];
+        [wx_vc didMoveToParentViewController:bar];
+
+        // -addChildViewController: holds it now, so the retain above is spent.
+        [wx_vc release];
+
+
+        gs_orca_tab_bar = bar;
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-tabbar: installed";
+        return true;
+    }
+    @catch (NSException *e) {
+        gs_orca_tab_bar_failed = true;
+        gs_orca_tab_bar        = nil;
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-tabbar: THREW " << [[e name] UTF8String]
+                                 << ": " << [[e reason] UTF8String];
+
+        // Put wx back. Surviving the exception is not enough on its own: a
+        // throw at step 4 or 5 leaves wx's controller adopted by a bar that
+        // never took the window, which is every view in the application
+        // hanging off a parent nobody is showing. Undo it, hand the window
+        // back, and the app comes up as it did before any of this - Orca's own
+        // tab strip hidden and no native bar, ugly but entirely usable, with
+        // the line above saying what to fix.
+        @try {
+            if (wx_vc.parentViewController != nil) {
+                [wx_vc willMoveToParentViewController:nil];
+                [wx_vc.view removeFromSuperview];
+                [wx_vc removeFromParentViewController];
+            }
+            if (window.rootViewController != wx_vc)
+                window.rootViewController = wx_vc;
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-tabbar: wx has its window back";
+        }
+        @catch (NSException *inner) {
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-tabbar: could not undo: "
+                                     << [[inner name] UTF8String];
+        }
+        return false;
+    }
+}
+
+// -syncTabs rebuilds UITab objects and assigns them, which is the other place
+// UIKit could object to something. Same treatment: named, survived, latched.
+static void orca_ios_sync_tabs_guarded()
+{
+    if (gs_orca_tab_bar == nil)
+        return;
+    @try {
+        [gs_orca_tab_bar syncTabs];
+    }
+    @catch (NSException *e) {
+        gs_orca_tab_bar_failed = true;
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-tabbar: syncTabs THREW " << [[e name] UTF8String]
+                                 << ": " << [[e reason] UTF8String];
+    }
+}
+
+// MainFrame::init_tabpanel names the page that wants room at the top for the
+// floating bar. Exactly one page does - see kOrcaTabBarInset.
+void orca_ios_inset_tab(wxWindow *page)
+{
+    gs_orca_inset_page = page;
+}
+
+// MainFrame::init_tabpanel calls this for each page that should keep working
+// but should not appear in the tab bar.
+void orca_ios_hide_tab(wxWindow *page)
+{
+    if (page != nullptr && !orca_ios_tab_is_hidden(page))
+        gs_orca_untabbed.push_back(page);
+    orca_ios_sync_tabs_guarded();
+}
+
+// Notebook.hpp calls this whenever a page is added, removed, or selected.
+void orca_ios_notebook_sync(wxBookCtrlBase *book)
+{
+    if (book == nullptr)
+        return;
+
+    if (!gs_orca_tab_bar_failed && orca_ios_install_tab_bar(book))
+        orca_ios_sync_tabs_guarded();
+
+    // The plus AFTER the tab bar, and unconditionally.
+    //
+    // After, because taking the window replaces its subviews, so a chip
+    // installed first is thrown away by the install that follows it - which is
+    // exactly what the log showed, 28 microseconds apart. Doing it second means
+    // that on the turn the bar arrives, the chip is built against the bar's
+    // view instead and there is no window left to lose.
+    //
+    // Unconditionally, because the plus must not stop working because the tab
+    // bar failed; it is not inside the tab bar's early return for that reason.
+    orca_ios_home_plus_update(book);
+
+    // ONE RETRY LOOP FOR BOTH, RE-ENTERING THIS FUNCTION.
+    //
+    // The previous version queued a CallAfter that installed the tab bar and
+    // nothing else - and that CallAfter is the only thing here that runs after
+    // the window exists, because page changes are all over by then. So the tab
+    // bar installed, the plus never did, and it vanished entirely. Whatever
+    // lands after the window has to retry everything, not the one thing that
+    // was being debugged when it was written.
+    const bool bar_pending  = gs_orca_tab_bar == nil && !gs_orca_tab_bar_failed;
+    const bool plus_pending = gs_orca_home_plus == nil;
+    if (!bar_pending && !plus_pending)
+        return;
+
+    // Bounded, so a thing that can never install cannot spin the event loop
+    // for the life of the process. Sixty turns is far more than the handful it
+    // takes for the frame to be shown, and it is over in a blink if it is not
+    // needed.
+    static bool retry_queued  = false;
+    static int  retries_left  = 60;
+    if (retry_queued || retries_left <= 0)
+        return;
+    retry_queued = true;
+    --retries_left;
+    book->CallAfter([book] {
+        retry_queued = false;
+        orca_ios_notebook_sync(book);
+    });
+}
