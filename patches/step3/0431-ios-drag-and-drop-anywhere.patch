+// -- a drop, anywhere in the window -----------------------------------------
+//
+// On the desktop Orca takes files through PlaterDropTarget, a wxFileDropTarget
+// on the 3D canvas. Two things about that do not carry over.
+//
+// It is on ONE view. A drag on iPadOS comes out of the Files app, out of
+// Safari, out of another application's share sheet, and it is let go of
+// wherever the finger happens to be - which on a five-page application is
+// usually not the plate. So the interaction goes on the window's top view,
+// the one the tab bar controller owns, and every page can be dropped on.
+//
+// And wx cannot see it at all. The iPhone port has no drag and drop plumbing:
+// wxDropTarget is not implemented, so a file dragged onto this application
+// bounced back to where it came from with no indication that anything was
+// wrong. This is UIDropInteraction, which is what the platform actually
+// offers, and it hands the paths to MainFrame.cpp - which decides what the
+// drop means from the page it landed on. See orca_ios_drop_commit().
+
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+
+// src/slic3r/GUI/MainFrame.cpp
+namespace Slic3r { namespace GUI {
+void orca_ios_drop_begin();
+void orca_ios_drop_add(const char *path);
+void orca_ios_drop_commit();
+} }
+
+// What this application can do something with. Deliberately the same set as
+// Plater::load_files' own regex, plus the G-code pair it keeps separately -
+// accepting a file the loader will silently drop is worse than refusing the
+// drag, because the refusal is the only feedback a drag gives.
+static BOOL orca_ios_droppable_name(NSString *name)
+{
+    static NSSet<NSString *> *kinds = nil;
+    if (kinds == nil) {
+        kinds = [[NSSet alloc] initWithArray:@[
+            @"3mf", @"stl", @"step", @"stp", @"obj", @"amf", @"oltp",
+            @"svg", @"zip", @"drc", @"ply", @"gcode", @"g",
+        ]];
+    }
+    NSString *const ext = name.pathExtension.lowercaseString;
+    return ext.length > 0 && [kinds containsObject:ext];
+}
+
+// Where a dropped file is put. The drag hands over a URL that is valid for the
+// length of the callback and no longer - it is in a staging area the system
+// takes back - so the bytes have to be copied before anything is done with
+// them, and copied somewhere that survives, because a project remembers its
+// path (0382).
+//
+// A 3MF is a project and goes where projects go. Everything else is a model
+// being imported into one, and gets its own directory so that Documents does
+// not fill up with parts that were never projects.
+static NSString *orca_ios_drop_destination(NSString *name)
+{
+    NSString *const home = NSHomeDirectory();
+    NSString *const kind = [name.pathExtension.lowercaseString isEqualToString:@"3mf"]
+                         ? @"Projects" : @"Imports";
+    NSString *const dir  = [[home stringByAppendingPathComponent:@"Documents"]
+                                  stringByAppendingPathComponent:kind];
+    [[NSFileManager defaultManager] createDirectoryAtPath:dir
+                              withIntermediateDirectories:YES
+                                               attributes:nil
+                                                    error:nil];
+
+    NSString *path = [dir stringByAppendingPathComponent:name];
+    // Dropping the same file twice must not overwrite the copy that is open,
+    // and must not silently become a second tile with the same name either -
+    // so the second one is numbered, the way every file dialogue numbers one.
+    NSFileManager *const fm = [NSFileManager defaultManager];
+    for (int n = 2; n < 1000 && [fm fileExistsAtPath:path]; ++n) {
+        NSString *const stem = [NSString stringWithFormat:@"%@ %d",
+                                name.stringByDeletingPathExtension, n];
+        path = [dir stringByAppendingPathComponent:
+                [stem stringByAppendingPathExtension:name.pathExtension]];
+    }
+    return path;
+}
+
+@interface OrcaDropTarget : NSObject <UIDropInteractionDelegate>
+@end
+
+@implementation OrcaDropTarget
+
+- (BOOL)dropInteraction:(UIDropInteraction *)interaction canHandleSession:(id<UIDropSession>)session
+{
+    (void) interaction;
+    if (![session hasItemsConformingToTypeIdentifiers:@[ UTTypeItem.identifier ]])
+        return NO;
+    for (UIDragItem *item in session.items) {
+        NSString *const name = item.itemProvider.suggestedName;
+        // No name to judge by is not a reason to refuse: the provider is
+        // allowed to have none, and the extension is checked again on the way
+        // out, where the real file name is known.
+        if (name == nil || orca_ios_droppable_name(name))
+            return YES;
+    }
+    return NO;
+}
+
+- (UIDropProposal *)dropInteraction:(UIDropInteraction *)interaction
+                   sessionDidUpdate:(id<UIDropSession>)session
+{
+    (void) interaction; (void) session;
+    // Copy, not move: the file in the other application stays where it is.
+    return [[[UIDropProposal alloc] initWithDropOperation:UIDropOperationCopy] autorelease];
+}
+
+- (void)dropInteraction:(UIDropInteraction *)interaction performDrop:(id<UIDropSession>)session
+{
+    (void) interaction;
+
+    // Several files can arrive in one drag, each loaded asynchronously, and
+    // the application has to be told about all of them at once - a drop of
+    // three parts is one action, not three. The group is what waits for them.
+    dispatch_group_t const group = dispatch_group_create();
+    NSMutableArray<NSString *> *const landed = [NSMutableArray array];
+
+    for (UIDragItem *item in session.items) {
+        NSItemProvider *const provider = item.itemProvider;
+        if (provider == nil)
+            continue;
+
+        dispatch_group_enter(group);
+        [provider loadFileRepresentationForTypeIdentifier:UTTypeItem.identifier
+                                       completionHandler:^(NSURL *url, NSError *error) {
+            // THE COPY HAPPENS HERE, inside the handler, on whatever thread
+            // the system called it on. The URL is gone the moment this block
+            // returns.
+            if (url != nil && error == nil) {
+                NSString *const name = url.lastPathComponent.length > 0
+                                     ? url.lastPathComponent
+                                     : (provider.suggestedName ?: @"model");
+                if (orca_ios_droppable_name(name)) {
+                    NSString *const dest = orca_ios_drop_destination(name);
+                    NSError *copyError = nil;
+                    if ([[NSFileManager defaultManager] copyItemAtURL:url
+                                                                toURL:[NSURL fileURLWithPath:dest]
+                                                                error:&copyError]) {
+                        @synchronized (landed) { [landed addObject:dest]; }
+                    } else {
+                        BOOST_LOG_TRIVIAL(error) << "orca-ios-drop: could not copy "
+                            << [name UTF8String] << ": "
+                            << [[copyError localizedDescription] UTF8String];
+                    }
+                } else {
+                    BOOST_LOG_TRIVIAL(error) << "orca-ios-drop: ignoring "
+                                             << [name UTF8String];
+                }
+            } else if (error != nil) {
+                BOOST_LOG_TRIVIAL(error) << "orca-ios-drop: the drag gave nothing: "
+                                         << [[error localizedDescription] UTF8String];
+            }
+            dispatch_group_leave(group);
+        }];
+    }
+
+    dispatch_group_notify(group, dispatch_get_main_queue(), ^{
+        if (landed.count == 0)
+            return;
+        // Sorted, so that dropping a folder's worth of parts loads them in the
+        // order the Files app showed them rather than in whatever order the
+        // copies happened to finish.
+        NSArray<NSString *> *const files =
+            [landed sortedArrayUsingSelector:@selector(localizedStandardCompare:)];
+        Slic3r::GUI::orca_ios_drop_begin();
+        for (NSString *path in files)
+            Slic3r::GUI::orca_ios_drop_add([path UTF8String]);
+        Slic3r::GUI::orca_ios_drop_commit();
+    });
+}
+
+@end
+
 // -- the home gallery ------------------------------------------------------
 //
 // WHAT THIS REPLACES.
@@ -3574,11 +3748,50 @@ static bool orca_ios_install_gallery(UIView *host)
 // Called from the tab bar's sync, which runs on every page change and every
 // notebook rebuild - so this is both the install's retry and its visibility.
 // The chip is in the window, and the window is not the home page.
+// The window takes drops, not any one page. Installed once, on the view the
+// tab bar controller owns - the same host the plus and the gallery are in,
+// which is the topmost thing in the window and spans all of it.
+static OrcaDropTarget    *gs_orca_drop_target = nil;
+static UIDropInteraction *gs_orca_drop         = nil;
+// The view it is on. Not retained - the hierarchy holds it - and compared
+// rather than remembered as a flag, because the tab bar controller replaces
+// the window's views when it takes the window and an interaction left on the
+// old one stops hearing about anything.
+static UIView            *gs_orca_drop_host    = nil;
+
+static void orca_ios_install_drop(UIView *host)
+{
+    if (host == nil || host == gs_orca_drop_host)
+        return;
+    @try {
+        if (gs_orca_drop != nil) {
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-drop: the host changed, moving the interaction";
+            [gs_orca_drop_host removeInteraction:gs_orca_drop];
+            [gs_orca_drop release];
+            gs_orca_drop = nil;
+        }
+        if (gs_orca_drop_target == nil)
+            gs_orca_drop_target = [[OrcaDropTarget alloc] init];
+        gs_orca_drop = [[UIDropInteraction alloc] initWithDelegate:gs_orca_drop_target];
+        [host addInteraction:gs_orca_drop];
+        gs_orca_drop_host = host;
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-drop: listening on "
+                                 << [NSStringFromClass([host class]) UTF8String];
+    }
+    @catch (NSException *e) {
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-drop: THREW " << [[e name] UTF8String]
+                                 << ": " << [[e reason] UTF8String];
+        gs_orca_drop      = nil;
+        gs_orca_drop_host = nil;
+    }
+}
