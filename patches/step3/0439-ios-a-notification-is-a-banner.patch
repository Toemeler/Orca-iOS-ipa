 NotificationManager::NotificationManager(wxEvtHandler* evt_handler) :
 	m_evt_handler(evt_handler)
 {
+#ifdef __WXOSX_IPHONE__
+	// The heartbeat. See the member's declaration for why a notification
+	// system on this port needs one at all; the short version is that
+	// everything upstream uses to move a notification along hangs off the 3D
+	// canvas' render loop, and the banners are not in the canvas any more.
+	//
+	// Four times a second: fast enough that a progress bar looks live, slow
+	// enough to be free. It does nothing whatsoever while there is nothing to
+	// show, which is almost all of the time.
+	m_ios_timer = new wxTimer();
+	m_ios_timer->Bind(wxEVT_TIMER, [this](wxTimerEvent &) { this->orca_ios_tick(); });
+	m_ios_timer->Start(250);
+#endif
+}
+
+#ifdef __WXOSX_IPHONE__
+
+NotificationManager::~NotificationManager()
+{
+	if (m_ios_timer != nullptr) {
+		m_ios_timer->Stop();
+		delete m_ios_timer;
+		m_ios_timer = nullptr;
+	}
+	// The banners live in the window and would otherwise outlive the
+	// notifications they are showing.
+	orca_ios_notices_clear();
+}
+
+// One tick: run the state machine, then hand the result over.
+//
+// update_notifications() is upstream's, and it is called here as well as from
+// the canvas rather than instead of it: it is time-based and idempotent - a
+// second call in the same millisecond changes nothing - and calling it from
+// both places is what makes a notification behave the same way whether or not
+// a 3D view happens to be on screen.
+void NotificationManager::orca_ios_tick()
+{
+	if (!m_initialized)
+		return;
+
+	// Cheap exit for the case that is almost always the case.
+	if (m_pop_notifications.empty() && m_waiting_notifications.empty()) {
+		if (m_ios_last_count != 0) {
+			m_ios_last_count = 0;
+			orca_ios_notices_clear();
+		}
+		return;
+	}
+
+	Plater *const plater = wxGetApp().plater();
+	if (plater == nullptr)
+		return;
+	if (GLCanvas3D *const canvas = plater->get_current_canvas3D())
+		update_notifications(*canvas);
+
+	orca_ios_sync_native();
+}
+
+void NotificationManager::orca_ios_sync_native()
+{
+	std::vector<IOSNotice> notices;
+	notices.reserve(m_pop_notifications.size());
+
+	for (const std::unique_ptr<PopNotification> &notification : m_pop_notifications) {
+		const PopNotification::EState state = notification->get_state();
+		// Hidden is a notification that exists and is deliberately not being
+		// shown - the slicing progress bar between slices lives there - and
+		// the other two are on their way out. Unknown is NOT skipped: it is a
+		// notification that has been pushed and not yet initialised, and
+		// dropping it would mean a banner that only appears on the next tick.
+		if (state == PopNotification::EState::Hidden ||
+		    state == PopNotification::EState::Finished ||
+		    state == PopNotification::EState::ClosePending)
+			continue;
+
+		const NotificationData &data = notification->get_data();
+
+		IOSNotice notice;
+		notice.key = reinterpret_cast<uintptr_t>(notification.get());
+
+		// m_text1 rather than data.text1: append() and update() rewrite the
+		// first and leave the second alone, so a warning that has had a second
+		// object's name appended to it reads correctly only from m_text1.
+		const std::string text = notification->get_text1();
+		notice.text = wxString::FromUTF8(text.empty() ? data.text1 : text);
+
+		switch (data.level) {
+		case NotificationLevel::ErrorNotificationLevel:
+		case NotificationLevel::SeriousWarningNotificationLevel:
+			notice.kind = IOSNoticeKind::Error;
+			break;
+		case NotificationLevel::WarningNotificationLevel:
+			notice.kind = IOSNoticeKind::Warning;
+			break;
+		case NotificationLevel::ProgressBarNotificationLevel:
+			notice.kind = IOSNoticeKind::Progress;
+			break;
+		default:
+			notice.kind = IOSNoticeKind::Info;
+			break;
+		}
+
+		// An export that finished is not "information", it is the one piece of
+		// good news this application has to deliver, and the platform has a
+		// green tick for exactly that.
+		if (data.type == NotificationType::ExportFinished ||
+		    data.type == NotificationType::PresetUpdateFinished)
+			notice.kind = IOSNoticeKind::Success;
+
+		notice.action_label = wxString::FromUTF8(notification->orca_ios_hypertext());
+		notice.duration     = notification->orca_ios_duration();
+
+		// An error or a warning does not go away on its own upstream either
+		// (get_duration() returns 0 for them), and it must not here: a slicing
+		// error that faded out unread is the whole reason this port logs every
+		// dialog it shows.
+		if (notice.kind == IOSNoticeKind::Error)
+			notice.duration = 0;
+
+		// Progress, and the two ways a notification carries it.
+		if (SlicingProgressNotification *const slicing =
+		        dynamic_cast<SlicingProgressNotification *>(notification.get())) {
+			if (slicing->orca_ios_in_progress()) {
+				notice.progress = slicing->orca_ios_percentage();
+				notice.kind     = IOSNoticeKind::Progress;
+			} else if (slicing->orca_ios_completed()) {
+				notice.kind = IOSNoticeKind::Success;
+			}
+			// CLOSING A SLICE IN PROGRESS IS CANCELLING IT. The ImGui version
+			// draws a separate cancel button; a banner has one close control
+			// and the meaning of pressing it while a slice is running is not
+			// in doubt.
+			notice.closable = slicing->orca_ios_can_cancel() || !slicing->orca_ios_in_progress();
+		} else if (ProgressBarNotification *const bar =
+		               dynamic_cast<ProgressBarNotification *>(notification.get())) {
+			notice.progress = bar->get_percentage();
+			notice.kind     = IOSNoticeKind::Progress;
+		}
+
+		const uintptr_t key = notice.key;
+		if (!notice.action_label.IsEmpty()) {
+			notice.on_action = [key]() {
+				if (Plater *const p = wxGetApp().plater())
+					if (NotificationManager *const nm = p->get_notification_manager())
+						nm->orca_ios_notice_action(key);
+			};
+		}
+		notice.on_close = [key]() {
+			if (Plater *const p = wxGetApp().plater())
+				if (NotificationManager *const nm = p->get_notification_manager())
+					nm->orca_ios_notice_close(key);
+		};
+
+		notices.push_back(std::move(notice));
+	}
+
+	m_ios_last_count = notices.size();
+	orca_ios_notices_sync(notices);
+}
+
+// The three callbacks, and the one rule they all follow: LOOK THE
+// NOTIFICATION UP, DO NOT HOLD IT.
+//
+// A banner outlives the render pass that made it, and a notification that
+// faded out in between has been erased from the deque and freed. The key is
+// the address it had, which is enough to find it again and is never
+// dereferenced when it is not found.
+//
+// A member and not a free function because PopNotification is a private nested
+// class: outside NotificationManager the type cannot even be named.
+NotificationManager::PopNotification *NotificationManager::orca_ios_find_notice(uintptr_t key)
+{
+	for (const std::unique_ptr<PopNotification> &n : m_pop_notifications) {
+		if (reinterpret_cast<uintptr_t>(n.get()) == key)
+			return n.get();
+	}
+	return nullptr;
+}
+
+void NotificationManager::orca_ios_notice_action(uintptr_t key)
+{
+	PopNotification *const notification = orca_ios_find_notice(key);
+	if (notification == nullptr)
+		return;
+
+	// on_text_click() is what the ImGui hypertext runs, overridden by half a
+	// dozen notifications - ExportFinished opens the folder, the shared-profile
+	// one opens a browser, the rest post an event - and it says whether the
+	// notification should close afterwards.
+	if (notification->orca_ios_text_click())
+		notification->close();
+
+	orca_ios_sync_native();
 }
 
+void NotificationManager::orca_ios_notice_close(uintptr_t key)
+{
+	PopNotification *const notification = orca_ios_find_notice(key);
+	if (notification == nullptr)
+		return;
+
+	// A slice that is running is cancelled rather than closed - see the
+	// comment on `closable` above.
+	if (SlicingProgressNotification *const slicing =
+	        dynamic_cast<SlicingProgressNotification *>(notification)) {
+		if (slicing->orca_ios_can_cancel()) {
+			slicing->orca_ios_cancel();
+			orca_ios_sync_native();
+			return;
+		}
+	}
+
+	notification->close();
+	orca_ios_sync_native();
+}
+
+void NotificationManager::orca_ios_notice_cancel(uintptr_t key)
+{
+	PopNotification *const notification = orca_ios_find_notice(key);
+	if (notification == nullptr)
+		return;
+	if (SlicingProgressNotification *const slicing =
+	        dynamic_cast<SlicingProgressNotification *>(notification))
+		slicing->orca_ios_cancel();
+	orca_ios_sync_native();
+}
+
