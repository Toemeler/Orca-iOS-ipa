+bool DropDown::orca_ios_popup()
+{
+    // EVERY ITEM, IN SECTIONS. The wx list shows only the first item of each
+    // group and opens a second window for the rest (see hoverIndex()); a
+    // grouped table has sections and needs no second level, so the whole list
+    // is offered at once and a group becomes a header.
+    std::vector<Slic3r::GUI::IOSPickerItem> rows;
+    rows.reserve(items.size());
+
+    for (size_t i = 0; i < items.size(); ++i) {
+        const Item &item = items[i];
+        // A separator has no value to choose; it is a heading in the wx list
+        // and it is a section header here, so it is not offered as a row.
+        if (item.style & DD_ITEM_STYLE_SPLIT_ITEM)
+            continue;
+        Slic3r::GUI::IOSPickerItem row;
+        row.text    = item.text;
+        row.group   = item.group_label.IsEmpty() ? item.group_key : item.group_label;
+        row.index   = int(i);
+        row.enabled = (item.style & DD_ITEM_STYLE_DISABLED) == 0;
+        rows.push_back(row);
+    }
+
+    if (rows.empty())
+        return false;
+
+    // The control the list belongs to, which is the ComboBox or the TextInput
+    // this drop-down was created against - never the drop-down itself, which
+    // is a window of its own and is not on screen.
+    wxWindow *const anchor = GetParent();
+
+    DropDown *const self = this;
+    return Slic3r::GUI::orca_ios_picker_present(
+        this, anchor, wxString(), rows, selection,
+        [self](int index) { self->orca_ios_choose(index); },
+        [self]() { self->orca_ios_dismissed(); });
+}
+
+void DropDown::orca_ios_choose(int index)
+{
+    if (index < 0 || size_t(index) >= items.size())
+        return;
+    if (items[index].style & DD_ITEM_STYLE_DISABLED)
+        return;
+
+    // The same event sendDropDownEvent() sends, with the same payload: the
+    // index into `items` and its text. ComboBox reads GetInt() straight back
+    // as the selection, so nothing above this has to know where it came from.
+    wxCommandEvent event(wxEVT_COMBOBOX, GetId());
+    event.SetEventObject(this);
+    event.SetInt(index);
+    event.SetString(items[index].text);
+    GetEventHandler()->ProcessEvent(event);
+
+    orca_ios_dismissed();
+}
+
+void DropDown::orca_ios_dismissed()
+{
+    // What OnDismiss() does for a wx popup that has closed. The timestamp
+    // matters: ComboBox asks HasDismissLongTime() before opening the list, so
+    // that the tap which closed one does not immediately open it again.
+    dismissTime = boost::posix_time::microsec_clock::universal_time();
+    hover_item  = -1;
+    wxCommandEvent e(EVT_DISMISS);
+    GetEventHandler()->ProcessEvent(e);
+}
+
+#endif // __WXOSX_IPHONE__
+
