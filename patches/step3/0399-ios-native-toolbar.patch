+// What the native toolbar shows, and in what order: the main toolbar's items
+// first, then the gizmos, which is the order the two GL bars were drawn in from
+// left to right. The item ids are "main:<name>" and "gizmo:<EType>", and they
+// come straight back to orca_ios_run_toolbar_action below.
+//
+// THE COLLAPSED SET is the flag on each call: add, add plate, auto orient,
+// arrange, variable layer height, and the move / rotate / scale / lay on face
+// gizmos. Those nine are what a plate is laid out with; everything else -
+// instances, splitting, cut, the paint tools, text, measure, assemble - is
+// behind the chevron. To move an item between the two sets, change its flag
+// here and nowhere else.
+void GLCanvas3D::orca_ios_sync_toolbar()
+{
+    if (m_canvas == nullptr)
+        return;
+
+    orca_ios_toolbar_begin();
+
+    for (const GLToolbarItem *item : m_main_toolbar.get_items()) {
+        if (item == nullptr || item->is_separator() || !item->is_visible())
+            continue;
+        const std::string &name = item->get_name();
+        const bool collapsed = name == "add"    || name == "addplate" ||
+                               name == "orient" || name == "arrange"  ||
+                               name == "layersediting";
+        orca_ios_toolbar_add(("main:" + name).c_str(),
+                             item->get_icon_filename().c_str(),
+                             item->get_tooltip().c_str(),
+                             item->is_enabled(),
+                             item->is_pressed(),
+                             collapsed);
+    }
+
+    // The sidebar toggle, which used to float over the top left corner of the
+    // plate on its own. Same GLToolbar type as the main one, so it collects the
+    // same way; in the collapsed set because hiding the sidebar is the first
+    // thing anyone wants on a screen this size.
+    for (const GLToolbarItem *item : wxGetApp().plater()->get_collapse_toolbar().get_items()) {
+        if (item == nullptr || item->is_separator() || !item->is_visible())
+            continue;
+        orca_ios_toolbar_add(("collapse:" + item->get_name()).c_str(),
+                             item->get_icon_filename().c_str(),
+                             item->get_tooltip().c_str(),
+                             item->is_enabled(),
+                             item->is_pressed(),
+                             true);
+    }
+
+    const GLGizmosManager::EType current = m_gizmos.get_current_type();
+    for (unsigned char t = 0; t < (unsigned char) GLGizmosManager::Undefined; ++t) {
+        const GLGizmosManager::EType type = (GLGizmosManager::EType) t;
+        const GLGizmoBase *const gizmo = m_gizmos.get_gizmo(type);
+        if (gizmo == nullptr || !gizmo->is_selectable())
+            continue;
+        const bool collapsed = type == GLGizmosManager::Move   ||
+                               type == GLGizmosManager::Rotate ||
+                               type == GLGizmosManager::Scale  ||
+                               type == GLGizmosManager::Flatten;
+        orca_ios_toolbar_add(("gizmo:" + std::to_string((int) t)).c_str(),
+                             gizmo->get_icon_filename().c_str(),
+                             "",
+                             gizmo->is_activable(),
+                             type == current,
+                             collapsed);
+    }
+
+    orca_ios_toolbar_commit(this, (void *) m_canvas->GetHandle());
+}
+
+// A tap. Both branches end in the very call the GL toolbars made on a click, so
+// nothing downstream can tell the difference.
+void GLCanvas3D::orca_ios_run_toolbar_action(const char *id)
+{
+    if (id == nullptr)
+        return;
+    const std::string item(id);
+
+    if (item.rfind("main:", 0) == 0) {
+        GLToolbarItem *const found = m_main_toolbar.get_item(item.substr(5));
+        if (found != nullptr && found->is_enabled())
+            found->do_left_action();
+        return;
+    }
+    if (item.rfind("collapse:", 0) == 0) {
+        GLToolbar &collapse = wxGetApp().plater()->get_collapse_toolbar();
+        GLToolbarItem *const found = collapse.get_item(item.substr(9));
+        if (found != nullptr && found->is_enabled())
+            found->do_left_action();
+        return;
+    }
+    if (item.rfind("gizmo:", 0) == 0) {
+        const int t = std::atoi(item.substr(6).c_str());
+        if (t < 0 || t >= (int) GLGizmosManager::Undefined)
+            return;
+        const GLGizmosManager::EType type = (GLGizmosManager::EType) t;
+        // Tapping the gizmo that is already open closes it, the way clicking
+        // its icon on the GL bar did.
+        m_gizmos.open_gizmo(m_gizmos.get_current_type() == type
+                            ? GLGizmosManager::Undefined : type);
+        m_dirty = true;
+    }
+}
+
+// Called from the toolbar view, which knows the canvas only as a void *.
+void orca_ios_toolbar_action(void *canvas, const char *id)
+{
+    if (canvas != nullptr)
+        ((GLCanvas3D *) canvas)->orca_ios_run_toolbar_action(id);
+}
