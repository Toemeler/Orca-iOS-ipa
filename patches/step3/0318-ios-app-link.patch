diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index e3361ef..20b3e0e 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -141,7 +141,59 @@ endif ()
 
 target_link_libraries(OrcaSlicer libslic3r cereal::cereal)
 # target_include_directories(OrcaSlicer PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/slic3r)
-if (APPLE)
+if (APPLE AND CMAKE_SYSTEM_NAME STREQUAL "iOS")
+    # iOS: mirror the (proven) step-2 wx iOS link set. No IOKit/AVFoundation/
+    # AVKit/VideoToolbox (camera video is step 5; wxMediaCtrl2 is inert), no
+    # desktop OpenGL. UIKit/OpenGLES/GLKit come from here + libslic3r_gui.
+    target_link_libraries(OrcaSlicer
+        "-liconv" "-lc++"
+        "-framework UIKit" "-framework OpenGLES" "-framework GLKit" "-framework QuartzCore"
+        "-framework CoreGraphics" "-framework CoreText" "-framework CoreFoundation"
+        "-framework Foundation" "-framework Security" "-framework AudioToolbox"
+        "-framework CFNetwork" "-framework MobileCoreServices"
+        # UniformTypeIdentifiers: the wx iOS wxFileDialog/wxDirDialog shims use
+        # UTTypeItem / UTTypeFolder (UIDocumentPicker). WxSmoke in step 2 never
+        # opened a dialog so these symbols were not pulled then; the full app does.
+        "-framework UniformTypeIdentifiers"
+        "-lz" "-lexpat" "-llzma")
+    # -Wl,-ObjC is what makes the app start at all.
+    #
+    # wx's UIApplication delegate is named only as a string -
+    # UIApplicationMain(1, "app", @"UIApplication", @"wxAppDelegate") - so no
+    # undefined symbol points at it and ld never loads the archive member that
+    # defines it. Measured on the wx probe: without this flag nm finds no
+    # _OBJC_CLASS_$_wxAppDelegate in the binary. UIApplicationMain then gets nil
+    # for its delegate class, no launch callback is ever delivered, and because
+    # wxApp::CallOnInit is a bare "return true" on the iPhone port, OnInit is
+    # unreachable by any other route. The app brings up a UIKit scene and exits
+    # in well under a second.
+    #
+    # -u names the single symbol to resolve, so ld loads exactly the archive
+    # member defining it. -Wl,-ObjC also works but is far too broad: it
+    # force-loads every ObjC-bearing object in every wx archive, which on the
+    # probe pulled in webview_webkit.mm.o and a wall of undefined WKWebView
+    # symbols. Bare -ObjC is wrong outright - that is the clang driver's
+    # language selector, not an ld flag.
+    #
+    # The symbol name contains a '$', and a '$' does not survive the trip to ld
+    # as an ordinary link flag. CMake writes the flag into build.ninja without
+    # escaping it, Ninja reads "$_wxAppDelegate" as one of its own variable
+    # references and expands it to nothing, and ld is handed "-u _OBJC_CLASS_"
+    # - an initial undefine that nothing in the link defines. That is exactly
+    # how step-4 run 25 failed:
+    #     Undefined symbols for architecture arm64:
+    #       "_OBJC_CLASS_", referenced from:
+    #           <initial-undefines>
+    # (and /bin/sh would eat the '$' too, if Ninja ever stopped doing so).
+    # So hand the flag to the clang driver in a response file: the driver reads
+    # the file itself, so its contents pass through neither Ninja nor the shell
+    # and the '$' arrives at ld intact.
+    set(ORCA_IOS_FORCE_DELEGATE_RSP
+        "${CMAKE_CURRENT_BINARY_DIR}/ios-force-app-delegate.rsp")
+    file(WRITE "${ORCA_IOS_FORCE_DELEGATE_RSP}"
+        "-Wl,-u,_OBJC_CLASS_$_wxAppDelegate\n")
+    target_link_options(OrcaSlicer PRIVATE "@${ORCA_IOS_FORCE_DELEGATE_RSP}")
+elseif (APPLE)
 #    add_compile_options(-stdlib=libc++)
 #    add_definitions(-DBOOST_THREAD_DONT_USE_CHRONO -DBOOST_NO_CXX11_RVALUE_REFERENCES -DBOOST_THREAD_USES_MOVE)
     # -liconv: boost links to libiconv by default
@@ -164,6 +216,9 @@ target_link_libraries(OrcaSlicer libslic3r_gui)
         target_link_libraries(OrcaSlicer ws2_32.lib user32.lib Setupapi.lib)
     elseif (MINGW)
         target_link_libraries(OrcaSlicer ws2_32 uxtheme setupapi)
+    elseif (APPLE AND CMAKE_SYSTEM_NAME STREQUAL "iOS")
+        # OpenGLES/GLKit are already linked above and via libslic3r_gui; iOS has
+        # no desktop OpenGL framework.
     elseif (APPLE)
         target_link_libraries(OrcaSlicer "-framework OpenGL")
     else ()
