             m_initialShowSent = true;
         }
-        //[m_macWindow orderFront: self];
-        [m_macWindow makeKeyWindow];
+        // -makeKeyAndVisible, not -makeKeyWindow: the latter only moves key
+        // status and leaves a window that was never made visible where it was.
+        [m_macWindow makeKeyAndVisible];
+    }
+    else if ( m_macWindow != gs_mainWindow && gs_mainWindow != nil )
+    {
+        // Hand key status back, or the main frame takes no keyboard input for
+        // the rest of the session once any dialog has been opened.
+        [gs_mainWindow makeKeyWindow];
     }
+
+    // Report every top level window that appears or disappears. A dialog that
+    // is created but ends up off screen, sized 0x0, behind the main frame, or
+    // never asked to show at all look identical from the outside - they are all
+    // just "the dialog did not come up" - and each of those four has actually
+    // happened on this port. The class name says which dialog it was, the frame
+    // and level say whether it could possibly have been seen.
+    {
