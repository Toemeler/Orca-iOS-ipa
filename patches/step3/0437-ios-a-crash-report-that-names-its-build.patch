+	// by the log line even on a device where Documents cannot be written.
+	ios_read_build_identifier();
+
 	const char *const ios_home = ::getenv("HOME");
 	if (ios_home == nullptr || *ios_home == '\0')
 		return;
@@ -599,6 +643,15 @@ void set_log_path_and_level(const std::string& file, unsigned int level)
 
 	set_logging_level(level);
 
+#if defined(TARGET_OS_IPHONE) && TARGET_OS_IPHONE
+	// The first line of every device log, so a log and a crash report can be
+	// put against the same build without asking which one was installed. At
+	// `error` because everything this port wants to survive the default level
+	// is logged at error - see the diagnostics the sessions above added.
+	BOOST_LOG_TRIVIAL(error) << "orca-ios-build: CFBundleVersion " << ios_build_identifier()
+	                         << " (the CI run number)";
+#endif
+
 	return;
 }
 
