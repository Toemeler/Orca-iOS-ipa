+        # (step-3 run 60, step-4 run 17: zero undefined and zero duplicate
+        # symbols, binary produced, then `ln: .../Contents/Resources: No such
+        # file or directory`).
+        #
+        # Flat layout it is, which is also where patch 0320 points resources_dir.
+        set(BIN_RESOURCES_DIR "${CMAKE_CURRENT_BINARY_DIR}/OrcaSlicer.app/resources")
+    elseif (CMAKE_MACOSX_BUNDLE)
         if (CMAKE_CONFIGURATION_TYPES)
             set(BIN_RESOURCES_DIR "${CMAKE_CURRENT_BINARY_DIR}/$<CONFIG>/OrcaSlicer.app/Contents/Resources")
         else()
