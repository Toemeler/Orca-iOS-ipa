+// ---------------------------------------------------------------------------
+// A SHEET OUTLIVES THE CALL THAT RAISED IT, AND THE MENU MAY NOT.
+//
+// This is the one thing about the presentation above that no caller expects.
+// PopupMenu() blocks on every other platform: it runs its own event loop and
+// returns after the user has chosen, so a menu built on the stack of the
+// function that shows it is alive for exactly as long as it is on screen, and
+// wxWidgets applications are written that way. Here PopupMenu() returns as soon
+// as the sheet has been asked for. The menu can be - and in code written for a
+// blocking PopupMenu(), routinely is - destroyed before the user's finger comes
+// down, and every raw pointer the action handlers captured is then a pointer
+// into freed memory. It does not crash while the developer is testing, because
+// the menu that a stack frame freed is usually still readable; it crashes
+// later, on someone else's iPad.
+//
+// So nothing here holds a raw pointer to anything that belongs to wx. The menu
+// and the invoking window are held as wxWeakRef, which wxEvtHandler supports
+// (it derives from wxTrackable) and which becomes null the moment either is
+// destroyed. The item is not tracked at all - it is looked up again by id in
+// the menu that is still alive, so an item removed from a menu that survived is
+// caught by the same test.
+//
+// And a menu that dies while its sheet is up takes the sheet with it: a menu
+// nobody can act on has no business staying on screen.
+// ---------------------------------------------------------------------------
+
 static void wxOSXIPhonePresentMenu(wxMenu* menu, wxWindow* win, UIView* view, CGPoint pt);
 
+// Retained: the sheet has to be dismissable after the menu behind it is gone,
+// which is the moment UIKit would otherwise be the only owner left.
+static UIAlertController* gs_presentedSheet = nil;
+// Compared, never dereferenced.
+static wxMenu* gs_presentedMenu = nullptr;
+
+static void wxOSXIPhoneForgetSheet()
+{
+    [gs_presentedSheet release];
+    gs_presentedSheet = nil;
+    gs_presentedMenu = nullptr;
+}
+
+// Called from ~wxMenuIPhoneImpl(), which is to say from ~wxMenu().
+static void wxOSXIPhoneMenuDestroyed(wxMenu* menu)
+{
+    if ( menu == nullptr || menu != gs_presentedMenu )
+        return;
+
+    UIAlertController* const sheet = gs_presentedSheet;
+    gs_presentedSheet = nil;
+    gs_presentedMenu = nullptr;
+
+    if ( sheet.presentingViewController != nil )
+        [sheet dismissViewControllerAnimated:YES completion:nil];
+    [sheet release];
+}
+
