+        const CGFloat scale = host.contentScaleFactor > 0 ? host.contentScaleFactor
+                                                          : [UIScreen mainScreen].scale;
+        gs_orca_toolbar.rightInset = right_inset_px > 0 ? right_inset_px / scale : 0;
