+// Everything MsgDialog itself puts in the dialog, known by name. Split out
+// because two things ask the question: whether the dialog can be an alert at
+// all, and what a subclass added to it that has to be said in one.
+bool MsgDialog::orca_ios_known_child(const wxWindow *child) const
+{
+    if (child == nullptr)
+        return true;
+    if (child == logo || child == m_checkbox_dsa || child == m_ios_dsa_label)
+        return true;
+    if (std::find(m_ios_content.begin(), m_ios_content.end(), child) != m_ios_content.end())
+        return true;
+
+    for (auto &entry : m_buttons) {
+        if (entry.second != nullptr && entry.second->buttondata != nullptr &&
+            entry.second->buttondata->button == child)
+            return true;
+    }
+
+    return false;
+}
