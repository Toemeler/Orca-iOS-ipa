+// Where a project has to live to still be there tomorrow.
+//
+// A file handed to the app by UIDocumentPickerViewController or by the Files
+// app arrives as a *copy* in tmp/<bundle-id>-Inbox/, and the recent-projects
+// list then records that path. The device log has one verbatim:
+//
+//   load_project filename is: /private/var/mobile/Containers/Data/Application/
+//   A5B282A3-.../tmp/org.orca-ios.orcaslicer.9YHLT3UZJ6-Inbox/1204 TOKA Base.3mf
+//
+// Two things are wrong with keeping that. iOS empties tmp whenever it likes, so
+// the entry is dead by the next session - the home page then says "The project
+// is no longer available". And every pick of the same file gets its own Inbox
+// directory, so opening one project three times puts three entries on the home
+// page, all with the same name.
+//
+// Moving the copy into Documents/Projects fixes both: the path survives, and it
+// is the same path every time, so wxFileHistory recognises the repeat and keeps
+// one entry.
+static boost::filesystem::path orca_ios_projects_dir()
+{
+    const char *home = ::getenv("HOME");
+    boost::filesystem::path dir =
+        boost::filesystem::path(home != nullptr ? home : "/tmp") / "Documents" / "Projects";
+    boost::system::error_code ec;
+    boost::filesystem::create_directories(dir, ec);
+    return dir;
+}
+
+std::string orca_ios_stable_project_path(const std::string &path)
+{
+    boost::system::error_code ec;
+    if (path.empty() || !boost::filesystem::exists(path, ec))
+        return path;
+    // Anything already inside our own Documents tree is where it should be: an
+    // autosave, a MakerWorld download, something an earlier pick moved here.
+    // Everything else - tmp/<id>-Inbox, a security-scoped URL in some other
+    // app's storage - is a loan, and gets copied.
+    const char *home = ::getenv("HOME");
+    const std::string documents = std::string(home != nullptr ? home : "") + "/Documents/";
+    if (home != nullptr && path.compare(0, documents.size(), documents) == 0)
+        return path;
+
+    const boost::filesystem::path dest = orca_ios_projects_dir() /
+                                         boost::filesystem::path(path).filename();
+    boost::filesystem::remove(dest, ec);
+    ec.clear();
+    boost::filesystem::rename(path, dest, ec);
+    if (ec) {
+        // Different filesystems, or a source the sandbox will not let go of.
+        ec.clear();
+        boost::filesystem::copy_file(path, dest,
+                                     boost::filesystem::copy_option::overwrite_if_exists, ec);
+        if (ec) {
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-project: could not move " << path
+                                     << " to " << dest.string() << ": " << ec.message();
+            return path;
+        }
+        boost::system::error_code ec2;
+        boost::filesystem::remove(path, ec2);
+    }
+    BOOST_LOG_TRIVIAL(error) << "orca-ios-project: " << path << " -> " << dest.string();
+    return dest.string();
+}
+
+// Repair a path recorded by an earlier install.
+//
+// Every absolute path inside this app contains the data container's UUID:
+//
+//   /private/var/mobile/Containers/Data/Application/<UUID>/Documents/...
+//
+// and iOS hands out a new UUID when the container is re-created - which, for a
+// sideloaded build being replaced every few hours, is constantly. The device
+// logs show three different UUIDs across one evening. Every recent-projects
+// entry written before the last install therefore points at a directory that no
+// longer exists, and the home page is a list of files that cannot be opened
+// even though they are all still on disk.
+//
+// Splice the current container in front of the recorded suffix, and if that
+// fails - the file was in tmp, which does not survive - go looking for it by
+// name in the three directories this app keeps projects in.
+std::string orca_ios_repair_container_path(const std::string &path)
+{
+    boost::system::error_code ec;
+    if (path.empty() || boost::filesystem::exists(path, ec))
+        return path;
+
+    const char *home = ::getenv("HOME");
+    if (home == nullptr)
+        return path;
+
+    static const std::string marker = "/Containers/Data/Application/";
+    const size_t at = path.find(marker);
+    if (at != std::string::npos) {
+        const size_t slash = path.find('/', at + marker.size());
+        if (slash != std::string::npos) {
+            const std::string candidate = std::string(home) + path.substr(slash);
+            if (boost::filesystem::exists(candidate, ec)) {
+                BOOST_LOG_TRIVIAL(error) << "orca-ios-project: healed " << path
+                                         << " -> " << candidate;
+                return candidate;
+            }
+        }
+    }
+
+    const std::string name = boost::filesystem::path(path).filename().string();
+    static const char *dirs[] = { "Documents/Projects", "Documents/Downloads",
+                                  "Documents/Autosave" };
+    for (const char *d : dirs) {
+        const boost::filesystem::path candidate = boost::filesystem::path(home) / d / name;
+        if (boost::filesystem::exists(candidate, ec)) {
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-project: found " << name
+                                     << " at " << candidate.string();
+            return candidate.string();
+        }
+    }
+    BOOST_LOG_TRIVIAL(error) << "orca-ios-project: no trace of " << path;
+    return path;
+}
+
