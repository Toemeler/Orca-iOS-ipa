@@ -9,6 +9,9 @@
 #include "format.hpp"
 #include "libslic3r_version.h"
 #include "Downloader.hpp"
+#ifdef __APPLE__
+#include <TargetConditionals.h>
+#endif
 #include <boost/chrono/duration.hpp>
 #include <boost/log/detail/native_typeof.hpp>
 #include <libslic3r/Config.hpp>
@@ -3349,7 +3352,17 @@ void GUI_App::copy_network_if_available()
 
 bool GUI_App::on_init_network(bool try_backup)
 {
+#if defined(__APPLE__) && !TARGET_OS_OSX
+    // iOS: Bambu's network plugin is a dylib downloaded at runtime. There is no
+    // iOS build of it, and iOS will not load a downloaded dylib regardless, so
+    // the load attempt can only fail and the "install the network plug-in"
+    // dialogs can only nag about something unobtainable. Bambu printers are
+    // reached by the native LAN agent instead (patch 0335); leaving this false
+    // keeps every plugin code path - and every prompt - switched off.
+    auto should_load_networking_plugin = false;
+#else
     auto should_load_networking_plugin = app_config->get_bool("installed_networking");
+#endif
 
     std::string config_version = app_config->get_network_plugin_version();
 
