+#include <boost/log/trivial.hpp>
+// Breadcrumbs through the part of startup that runs before anything else
+// logs.
+//
+// A launch SIGSEGV here produces a crash report whose unwinder cannot get past
+// GUI_Run - it prints "GUI_Run + 136" twice and stops - so the backtrace names
+// the caller and never the callee. The last line in the device log is then the
+// only evidence of how far the process got, and between GUI_App's constructor
+// and the first font registration there are several hundred lines of startup
+// that say nothing at all. These cost one log line each and turn "somewhere in
+// startup" into a specific call.
+#define ORCA_IOS_BOOT(what) BOOST_LOG_TRIVIAL(error) << "orca-ios-boot: " << what
+#else
+#define ORCA_IOS_BOOT(what) do {} while (0)
+#endif
