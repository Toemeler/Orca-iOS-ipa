+// ---------------------------------------------------------------------------
+// The last resort: a press no wx view was offered
+// ---------------------------------------------------------------------------
+//
+// UIKit sends a key press to the first responder and nowhere else, and there
+// are two ordinary states in which the first responder is not a wx view:
+//
+//   * the application has just launched and the user has not touched anything
+//     yet, so there is no first responder at all;
+//   * the focus is on a plain UIKit view the application put in the window
+//     itself, which is something this port does in several places.
+//
+// In both, an unhandled press travels up the responder chain to UIApplication
+// and then to the application delegate, which is the last responder there is.
+// wxAppDelegate hands it here (src/osx/iphone/utils.mm), and it goes to the
+// window wx believes is focused - or, when wx believes nothing is, to the top
+// level window UIKit is calling key. That last part is what makes the
+// application's global shortcuts work before the user has tapped anything.
+//
+// Presses are marked as they are offered to wx, so a press that a wx view has
+// already refused - and that therefore travelled up the chain and arrived here
+// - is not delivered a second time.
+
+static const char wxOSXIPhonePressSeenKey = 0;
+
+void wxOSXIPhoneNotePressSeen(UIPress* press)
+{
+    objc_setAssociatedObject(press, &wxOSXIPhonePressSeenKey, press,
+                             OBJC_ASSOCIATION_ASSIGN);
+}
+
+static bool wxOSXIPhonePressWasSeen(UIPress* press)
+{
+    return objc_getAssociatedObject(press, &wxOSXIPhonePressSeenKey) != nil;
+}
+
+static wxWindow* wxOSXIPhoneKeyEventTarget()
+{
+    wxWindow* const focus = wxWindow::FindFocus();
+    if ( focus != nullptr )
+        return focus;
+
+    UIWindow* keyWindow = nil;
+    for ( UIScene* scene in [UIApplication sharedApplication].connectedScenes )
+    {
+        if ( ![scene isKindOfClass:[UIWindowScene class]] )
+            continue;
+
+        for ( UIWindow* w in ((UIWindowScene*) scene).windows )
+        {
+            if ( [w isKeyWindow] )
+            {
+                keyWindow = w;
+                break;
+            }
+        }
+
+        if ( keyWindow != nil )
+            break;
+    }
+
+    if ( keyWindow != nil )
+    {
+        for ( wxWindowList::compatibility_iterator node = wxTopLevelWindows.GetFirst();
+              node;
+              node = node->GetNext() )
+        {
+            wxNonOwnedWindow* const now = dynamic_cast<wxNonOwnedWindow*>(node->GetData());
+            if ( now != nullptr && now->GetWXWindow() == keyWindow )
+                return now;
+        }
+    }
+
+    return wxTheApp != nullptr ? wxTheApp->GetTopWindow() : nullptr;
+}
+
+bool wxOSXIPhoneRouteUnhandledPresses(NSSet* presses, UIEvent* event)
+{
+    bool handled = false;
+
+    for ( UIPress* press in (NSSet<UIPress *> *) presses )
+    {
+        if ( press.key == nil || press.phase == UIPressPhaseChanged )
+            continue;
+
+        if ( wxOSXIPhonePressWasSeen(press) )
+            continue;
+
+        wxOSXIPhoneNotePressSeen(press);
+
+        wxWindow* const target = wxOSXIPhoneKeyEventTarget();
+        if ( target == nullptr )
+            continue;
+
+        wxWidgetIPhoneImpl* const impl =
+            dynamic_cast<wxWidgetIPhoneImpl*>(target->GetPeer());
+        if ( impl == nullptr )
+            continue;
+
+        wxLogTrace(TRACE_KEYS, "Routing an unclaimed press to %s",
+                   wxDumpWindow(target));
+
+        if ( impl->DoHandleKeyEvent(press, event) )
+            handled = true;
+    }
+
+    return handled;
+}
