+#if defined(TARGET_OS_IPHONE) && TARGET_OS_IPHONE
+// A sideloaded iOS build cannot find a Bambu printer by itself.
+//
+// Discovery is SSDP: the printer announces itself to the multicast group
+// 239.255.255.250, and iOS has refused multicast to apps without the
+// com.apple.developer.networking.multicast entitlement since iOS 14. Apple
+// grants that entitlement on request, to a paid developer account, for a named
+// App ID - there is no form of it a sideloaded build can carry.
+// BambuLanDiscovery already joins the group best-effort and says as much in a
+// comment; this is what to do when the best effort fails.
+//
+// Nothing downstream of discovery is blocked. The connection itself is an
+// ordinary unicast TLS MQTT session to the printer's own address and needs no
+// entitlement. All that is missing is the three facts SSDP would have carried,
+// so they are built in below, and the record SSDP would have produced is handed
+// to DeviceManager directly. From there it is Orca's ordinary LAN path:
+// MachineObject takes the access code out of AppConfig, and the Device page has
+// a printer to show instead of the MONITOR_NO_PRINTER blank it shows otherwise.
+//
+// The values are the owner's own A1, built in at their explicit request so the
+// app works on their iPad with no setup step. Note what that means: this
+// repository is public, so the access code is public with it. It is a LAN
+// credential - it is worth something only to someone already on the same
+// network as the printer - and it can be regenerated on the printer's own
+// screen, which is what to do if it should stop being valid.
+//
+// Anything here can be overridden per-device, without a rebuild, by
+//
+//   <app>/Documents/orca-printer.json
+//   { "dev_id": "...", "dev_ip": "192.168.0.171", "access_code": "...",
+//     "dev_name": "A1", "dev_type": "3DPrinter-N2S-01" }
+//
+// which is the escape hatch for the field most likely to change: a DHCP lease
+// moving the printer to another address.
+static void ios_announce_preconfigured_printer(AppConfig *app_config, Slic3r::DeviceManager *device_manager, bool select_it)
+{
+    if (device_manager == nullptr)
+        return;
+
+    std::string dev_id      = "03919D552413839";
+    std::string dev_ip      = "192.168.0.171";
+    std::string access_code = "8c715b4c";
+    std::string dev_name    = "Bambu Lab A1";
+    std::string dev_type    = "3DPrinter-N2S-01"; // N2S is the A1
+
+    if (const char *const ios_home = ::getenv("HOME")) {
+        const boost::filesystem::path cfg_path = boost::filesystem::path(ios_home) / "Documents" / "orca-printer.json";
+        boost::system::error_code     ec;
+        if (boost::filesystem::exists(cfg_path, ec) && !ec) {
+            try {
+                boost::nowide::ifstream in(cfg_path.string().c_str());
+                json                    j;
+                in >> j;
+                // Each key is optional; whatever the file does not say keeps the
+                // built-in value, so overriding just the IP is one short file.
+                dev_id      = j.value("dev_id", dev_id);
+                dev_ip      = j.value("dev_ip", dev_ip);
+                access_code = j.value("access_code", access_code);
+                dev_name    = j.value("dev_name", dev_name);
+                dev_type    = j.value("dev_type", dev_type);
+                BOOST_LOG_TRIVIAL(error) << "orca-ios-printer: overridden by " << cfg_path.string();
+            } catch (const std::exception &ex) {
+                // Keep the built-in printer rather than none at all.
+                BOOST_LOG_TRIVIAL(error) << "orca-ios-printer: " << cfg_path.string()
+                                         << " is not valid JSON, ignoring it: " << ex.what();
+            }
+        }
+    }
+
+    if (dev_id.empty() || dev_ip.empty()) {
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-printer: need both dev_id and dev_ip, not announcing";
+        return;
+    }
+    if (dev_name.empty())
+        dev_name = dev_id;
+
+    // This is where MachineObject reads it when on_machine_alive() builds the
+    // object, so it has to be in place before the announcement below.
+    if (! access_code.empty() && app_config != nullptr)
+        app_config->set_str("access_code", dev_id, access_code);
+
+    json alive;
+    alive["dev_name"]     = dev_name;
+    alive["dev_id"]       = dev_id;
+    alive["dev_ip"]       = dev_ip;
+    alive["dev_type"]     = dev_type;
+    alive["dev_signal"]   = "-40dBm";
+    alive["connect_type"] = "lan";
+    alive["bind_state"]   = "free";
+    alive["sec_link"]     = "secure";
+    device_manager->on_machine_alive(alive.dump());
+
+    // Selecting is what dials the printer, and re-selecting a LAN machine tears
+    // the session down and dials again - so it happens once, not on every
+    // beacon. The beacon exists because Orca ages out machines that stop
+    // announcing themselves.
+    if (select_it) {
+        device_manager->set_selected_machine(dev_id);
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-printer: selected " << dev_name << " (" << dev_id << ") at " << dev_ip
+                                 << ", access code " << (access_code.empty() ? "MISSING - it will not connect" : "set");
+    }
+}
+#endif // TARGET_OS_IPHONE
