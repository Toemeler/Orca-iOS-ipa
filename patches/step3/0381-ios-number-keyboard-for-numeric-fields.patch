+static bool orca_ios_apply_numeric_keyboard(wxWindow *win, const char *where)
+{
+    if (win == nullptr)
+        return false;
+    UIView *root = (UIView *) win->GetHandle();
+    UITextField *field = orca_ios_find_text_field(root);
+    if (field == nil) {
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-keyboard: " << where << " no UITextField under "
+                                 << (root ? [NSStringFromClass([root class]) UTF8String] : "(null handle)");
+        return false;
+    }
+
+    // Still set, because it costs nothing and it is what a hardware keyboard
+    // reads. The empty inputView below is what stops the on-screen one.
+    field.keyboardType           = UIKeyboardTypeDecimalPad;
+    field.autocorrectionType     = UITextAutocorrectionTypeNo;
+    field.autocapitalizationType = UITextAutocapitalizationTypeNone;
+    field.spellCheckingType      = UITextSpellCheckingTypeNo;
+    field.smartDashesType        = UITextSmartDashesTypeNo;
+    field.smartQuotesType        = UITextSmartQuotesTypeNo;
+    field.smartInsertDeleteType  = UITextSmartInsertDeleteTypeNo;
+
+    // An empty inputView is the supported way to say "no on-screen keyboard,
+    // but still a first responder with a caret". Zero height, so nothing is
+    // docked at the bottom of the screen; the shortcuts bar that iPadOS would
+    // otherwise float above it is emptied out as well.
+    field.inputView          = [[[UIView alloc] initWithFrame:CGRectZero] autorelease];
+    field.inputAccessoryView = nil;
+    field.inputAssistantItem.leadingBarButtonGroups  = @[];
+    field.inputAssistantItem.trailingBarButtonGroups = @[];
+
+    OrcaNumericKeypad *pad = [[OrcaNumericKeypad alloc] initWithField:field];
+    // The field owns the pad; the pad only ever points back at the field.
+    objc_setAssociatedObject(field, &orca_ios_keypad_key, pad,
+                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    // The begin-editing notification has already been and gone if the field was
+    // focused before we got here, which the deferred pass can hit.
+    if ([field isFirstResponder])
+        [pad showUnderField];
+    [pad release];
+    return true;
+}
+
+void orca_ios_set_numeric_keyboard(wxWindow *win)
+{
+    if (orca_ios_apply_numeric_keyboard(win, "build:"))
+        return;
+
+    // Try again once the event loop has turned: some of Orca's composite widgets
+    // finish assembling their children after their constructor returns.
+    win->CallAfter([win] { orca_ios_apply_numeric_keyboard(win, "deferred:"); });
+}
+
 } // namespace GUI
