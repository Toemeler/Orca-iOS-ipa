+            // Nothing is lost by not asking: Http::priv sets
+            // CURLOPT_SSL_VERIFYPEER to 0 on every request, so the certificate
+            // store this dialog is about is never consulted.
+            BOOST_LOG_TRIVIAL(warning) << "iOS: skipping the TLS certificate store dialog: " << msg;
+            app_config->set("tls_cert_store_accepted", "yes");
