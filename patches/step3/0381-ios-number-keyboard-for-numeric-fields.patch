 #import <WebKit/WebKit.h>
 #import <UIKit/UIKit.h>
+// objc_setAssociatedObject, used to give a text field ownership of its keyboard
+// accessory target. This file is built WITHOUT ARC (no -fobjc-arc anywhere in
+// the CMake), so the retain/release below is required, not optional.
+#import <objc/runtime.h>
 #import <CoreText/CoreText.h>
 
 #include "libslic3r/libslic3r.h"
 #include "libslic3r/Utils.hpp"
 #include "slic3r/Utils/MacDarkMode.hpp"
 #include <wx/osx/core/cfstring.h>
