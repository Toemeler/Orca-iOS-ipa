+// The first top level window shown is the application's main frame. Everything
+// after it - a dialog, a preferences panel, a wizard, a combo box drop-down -
+// is meant to appear *over* it, and on this port none of them did.
+//
+// Each wxTopLevelWindow becomes its own UIWindow here. A wxDialog carries
+// wxCAPTION, which lands in an empty branch in Create() and leaves the level at
+// UIWindowLevelNormal, the same as the main frame. UIKit gives no defined
+// z-order between windows at equal level, and -makeKeyWindow moves key status
+// rather than order, so a dialog was created, told to show, and never seen.
+static UIWindow* gs_mainWindow = nil;
+
 bool wxNonOwnedWindowIPhoneImpl::Show(bool show)
 {
+    wxNonOwnedWindow* const now = dynamic_cast<wxNonOwnedWindow*> (GetWXPeer());
+    const long style = now != NULL ? now->GetWindowStyle() : 0;
+
+    // A drop-down, a menu or a tooltip is positioned by the code that opens it,
+    // relative to the control it belongs to. Only a dialog wants centring.
+    const bool isPopup = (style & wxPOPUP_WINDOW) != 0 ||
+                         (style & wxFRAME_TOOL_WINDOW) != 0;
+
+    if ( show )
+    {
+        if ( gs_mainWindow == nil )
+        {
+            // The main frame. Left exactly as it was.
+            gs_mainWindow = m_macWindow;
+        }
+        else if ( m_macWindow != gs_mainWindow )
+        {
+            if ( !isPopup )
+            {
+                // Centre a dialog, and keep it inside the screen: a desktop
+                // layout is routinely wider than an iPad.
+                const CGRect screen = [[UIScreen mainScreen] bounds];
+                CGRect r = [m_macWindow frame];
+
+                if ( r.size.width <= 1 || r.size.width > screen.size.width )
+                    r.size.width = screen.size.width;
+                if ( r.size.height <= 1 || r.size.height > screen.size.height )
+                    r.size.height = screen.size.height;
+
+                r.origin.x = (screen.size.width - r.size.width) / 2;
+                r.origin.y = (screen.size.height - r.size.height) / 2;
+                [m_macWindow setFrame:r];
+            }
+
+            // Everything secondary goes above the main frame - a popup that
+            // stays at UIWindowLevelNormal is just as invisible as a dialog.
+            // Its geometry is left alone: a drop-down that has not been sized
+            // yet would otherwise be blown up to fill the screen by the clamp
+            // above, and an opaque full-screen popup sits on top of the 3D
+            // viewport and looks exactly like a canvas that stopped rendering.
+            [m_macWindow setWindowLevel:UIWindowLevelAlert + 1];
+        }
+    }
+
     [m_macWindow setHidden:(show ? NO : YES)];
+
     if ( show )
     {
         if ( !m_initialShowSent )
         {
-            wxNonOwnedWindow* now = dynamic_cast<wxNonOwnedWindow*> (GetWXPeer());
             wxShowEvent eventShow(now->GetId(), true);
