+#ifdef __WXOSX_IPHONE__
+int TipsDialog::ShowModal()
+{
+    // The buttons are not kept anywhere - add_button() creates them, binds
+    // them and returns them to a sizer - so they are read back off the child
+    // list, which is in creation order and therefore in the order they were
+    // added: OK, Yes, No, Cancel.
+    std::vector<IOSAlertButton> rows;
+    ::CheckBox                 *tick = nullptr;
+
+    for (wxWindow *const child : GetChildren()) {
+        if (tick == nullptr)
+            tick = dynamic_cast<::CheckBox *>(child);
+
+        Button *const btn = dynamic_cast<Button *>(child);
+        if (btn == nullptr || !btn->IsShown())
+            continue;
+
+        IOSAlertButton row;
+        row.label     = btn->GetLabel();
+        row.id        = btn->GetId();
+        row.widget    = btn;
+        row.enabled   = btn->IsEnabled();
+        row.preferred = row.id == wxID_OK || row.id == wxID_YES;
+        row.cancel    = row.id == wxID_CANCEL || row.id == wxID_NO;
+        rows.push_back(row);
+    }
+
+    // No buttons found means the dialog is not the shape this expects, and a
+    // UIAlertController with no rows cannot be dismissed at all.
+    if (rows.empty())
+        return DPIDialog::ShowModal();
+
+    // "Don't show again" as a row, the way MsgDialog does it: a way of saying
+    // yes rather than a third answer, so it goes after the affirmative and
+    // before the cancel.
+    //
+    // Only when the tick is not already set. create_item_checkbox() binds a
+    // handler that *flips* m_show_again rather than reading the box, so one
+    // event is what a tap is - and if the box starts ticked, the plain
+    // affirmative already carries the behaviour and a second row saying so
+    // would be a row that does nothing.
+    if (tick != nullptr && !tick->GetValue()) {
+        IOSAlertButton *target = nullptr;
+        for (IOSAlertButton &row : rows) {
+            if (row.preferred) {
+                target = &row;
+                break;
+            }
+        }
+        if (target == nullptr)
+            target = &rows.front();
+
+        IOSAlertButton row;
+        row.label  = _L("Don't show again");
+        row.id     = target->id;
+        row.widget = target->widget;
+        row.before = [tick]() {
+            tick->SetValue(true);
+            wxCommandEvent ev(wxEVT_TOGGLEBUTTON, tick->GetId());
+            ev.SetEventObject(tick);
+            ev.SetInt(1);
+            tick->GetEventHandler()->ProcessEvent(ev);
+        };
+
+        size_t at = rows.size();
+        for (size_t i = 0; i < rows.size(); ++i) {
+            if (rows[i].cancel) {
+                at = i;
+                break;
+            }
+        }
+        rows.insert(rows.begin() + at, row);
+    }
+
+    int result = wxID_CANCEL;
+    if (!orca_ios_alert_run(this, GetTitle(),
+                            m_msg != nullptr ? m_msg->GetLabel() : wxString(),
+                            rows, nullptr, &result))
+        return DPIDialog::ShowModal();
+
+    return result;
+}
+#endif // __WXOSX_IPHONE__
