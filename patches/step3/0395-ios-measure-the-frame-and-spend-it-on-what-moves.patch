+// the bed, the shells, ImGui and the overlays measured about 11 ms per frame on
+// their own, and they have to come down too. Half the frame is what the draw
+// gets to aim at.
+constexpr uint64_t ORCA_IOS_MOVING_BUDGET_US = 4000;
+// And once it has stopped. A still frame is drawn once and then held, so it can
+// afford far more detail - but not unbounded detail. The main thread is inside
+// the draw for its whole duration, which means a 2.4 second frame is 2.4
+// seconds in which the first touch of the next drag is not being read. That is
+// the difference between a heavy app and a broken one, so the still frame gets
+// a ceiling too: high enough to look finished, low enough to stay answerable.
+constexpr uint64_t ORCA_IOS_SETTLED_BUDGET_US = 50000;
+// Where the controller starts before it has measured anything: low enough that
+// the first frame of the first drag is already cheap, and it climbs from there
+// rather than hitching once and then correcting.
+constexpr uint32_t ORCA_IOS_INITIAL_INSTANCES = 100000;
+constexpr uint32_t ORCA_IOS_MIN_INSTANCES     = 20000;
+constexpr uint32_t ORCA_IOS_MAX_INSTANCES     = 8000000;
