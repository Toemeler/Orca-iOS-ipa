+//
+// Three functions, all of them empty:
+//
+//   FindFocus()  had its entire body commented out and returned nil, so
+//                wxWindow::FindFocus() answered "nothing has the focus" for
+//                the life of the process.
+//   SetFocus()   was "// TODO" and a `return false`, so wxWindow::SetFocus()
+//                moved nothing. On iOS focus *is* first responder status, and
+//                nothing was ever made first responder.
+//   canBecomeFirstResponder was never implemented, and UIView's default is NO,
+//                so even a view UIKit was asked about could not have taken it.
+//
+// UIKit delivers key presses to the first responder and to nothing else. With
+// no first responder inside wx, -pressesBegan: was never called on a wx view,
+// so wxWidgetIPhoneImpl::keyEvent() - which does exist, and is correct as far
+// as it goes - has never once run on a device. Every keyboard shortcut in
+// every application built on this port is dead, and silently: there is no
+// error, no warning and no log line, because from wx's point of view no key
+// was pressed.
+//
+// WHY THE FOCUSED VIEW IS TRACKED HERE RATHER THAN ASKED FOR.
+//
+// UIKit has no public API that answers "which responder is first" - AppKit's
+// -[NSWindow firstResponder] has no counterpart, and the commented-out body
+// above was the AppKit one. wx already thunks -becomeFirstResponder and
+// -resignFirstResponder onto every class it builds, though, so the answer can
+// simply be recorded as it changes. What is recorded is validated against
+// -isFirstResponder before it is handed out, so a non-wx view taking the focus
+// (this port has several: the gallery, a UITextField in a cell) corrects the
+// record rather than leaving a stale one behind.
+
+static UIView* gs_focusedView = nil;
+
+// The focus wx asked for while the view was not yet in a window. -becomeFirst-
+// Responder is refused outright in that state, and SetFocus() is routinely
+// called from a control's own creation path, so the request is held and re-run
+// from -didMoveToWindow.
+static UIView* gs_pendingFocusView = nil;
+
+void wxOSXIPhoneNoteFocusedView(UIView* view)
+{
+    gs_focusedView = view;
+    if ( view != nil && view == gs_pendingFocusView )
+        gs_pendingFocusView = nil;
+}
+
+void wxOSXIPhoneNoteUnfocusedView(UIView* view)
+{
+    if ( gs_focusedView == view )
+        gs_focusedView = nil;
+    if ( gs_pendingFocusView == view )
+        gs_pendingFocusView = nil;
+}
 
