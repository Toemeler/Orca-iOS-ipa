 void wxOSXIPhoneClassAddWXMethods(Class c)
 {
+    class_addMethod(c, @selector(WX_scrollGesture:), (IMP) wxOSX_scrollGesture, "v@:@");
+    class_addMethod(c, @selector(WX_hoverGesture:), (IMP) wxOSX_hoverGesture, "v@:@");
+
     class_addMethod(c, @selector(touchesBegan:withEvent:), (IMP) wxOSX_touchEvent, "v@:@@");
     class_addMethod(c, @selector(touchesMoved:withEvent:), (IMP) wxOSX_touchEvent, "v@:@@");
     class_addMethod(c, @selector(touchesEnded:withEvent:), (IMP) wxOSX_touchEvent, "v@:@@");
@@ -804,6 +951,29 @@ void wxWidgetIPhoneImpl::InstallEventHandler( WXWidget control )
         [cc addTarget:cc action:@selector(WX_touchUpInsideAction:event:) forControlEvents:UIControlEventTouchUpInside];
         [cc addTarget:cc action:@selector(WX_valueChangedAction:event:) forControlEvents:UIControlEventValueChanged];
     }
+
+    // Desktop pointer behaviour has to be opted into per view: scroll only
+    // arrives through a pan recognizer with allowedScrollTypesMask set, and
+    // hover only through a hover recognizer.
+    if ( [c isKindOfClass:[UIView class]] )
+    {
+        UIView* view = (UIView*) c;
+
+        UIPanGestureRecognizer* scroll =
+            [[UIPanGestureRecognizer alloc] initWithTarget:view action:@selector(WX_scrollGesture:)];
+        scroll.allowedScrollTypesMask = UIScrollTypeMaskAll;
+        // Let touch drags fall through to touchesMoved: rather than being
+        // swallowed here; the handler also ignores any pan carrying touches.
+        scroll.cancelsTouchesInView = NO;
+        [view addGestureRecognizer:scroll];
+        [scroll release];
+
+        UIHoverGestureRecognizer* hover =
+            [[UIHoverGestureRecognizer alloc] initWithTarget:view action:@selector(WX_hoverGesture:)];
+        hover.cancelsTouchesInView = NO;
+        [view addGestureRecognizer:hover];
+        [hover release];
+    }
 }
 
