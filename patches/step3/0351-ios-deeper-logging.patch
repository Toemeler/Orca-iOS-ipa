diff --git a/src/slic3r/GUI/3DScene.hpp b/src/slic3r/GUI/3DScene.hpp
index 76d10620d..90a7bd16a 100644
--- a/src/slic3r/GUI/3DScene.hpp
+++ b/src/slic3r/GUI/3DScene.hpp
@@ -23,6 +23,22 @@
 #define HAS_GLSAFE
 #endif // NDEBUG
 
+#ifdef __APPLE__
+#include <TargetConditionals.h>
+#endif
+#if defined(__APPLE__) && !TARGET_OS_OSX && !defined(HAS_GLSAFE)
+// iOS ships as a release build, so NDEBUG is set and glsafe(cmd) degrades to a
+// bare cmd - throwing every OpenGL error away on the one platform where the GL
+// path is new, unproven and impossible to attach a debugger to. A null
+// glDrawArraysInstanced went undiagnosed for three rounds partly because of
+// this. Turn it back on: glAssertRecentCallImpl() in 3DScene.cpp already
+// returns immediately unless get_logging_level() >= 5, so at the normal level
+// this costs one predictable branch per GL call, and putting "trace" in
+// Documents/orca-log-level.txt reports every failing call with its file, line
+// and function.
+#define HAS_GLSAFE
+#endif
+
 #ifdef HAS_GLSAFE
     extern void glAssertRecentCallImpl(const char *file_name, unsigned int line, const char *function_name);
     inline void glAssertRecentCall() { glAssertRecentCallImpl(__FILE__, __LINE__, __FUNCTION__); }
