+// ---------------------------------------------------------------------------
+// Multi-touch gestures.
+//
+// wxWindow::EnableTouchEvents() is how an application asks for these, and on
+// this port it was a one-line stub in include/wx/osx/iphone/private.h:
+//
+//     bool EnableTouchEvents(int WXUNUSED(eventsMask)) { return false; }
+//
+// So every wxEVT_GESTURE_* handler in every application built against the
+// iPhone port has been dead code. OrcaSlicer binds all three and implements
+// pinch-zoom, two-finger rotate and pan against its camera in
+// GLCanvas3D::on_gesture; none of it has ever run on an iPad.
+//
+// The single-finger drag path is left exactly as it was - it is the pointer,
+// and it is what rotates the view and drags gizmos. These recognizers keep
+// cancelsTouchesInView at its default YES on purpose: when a second finger
+// lands and a gesture takes over, UIKit cancels the touches, which the
+// cancelled-touch handler above turns into a clean LEFT_UP. So a rotate in
+// progress ends properly instead of continuing underneath the pinch. That
+// interaction is the whole reason the two work together rather than fighting.
+
+static void wxOSXSendGestureEvent(UIView* self, wxGestureEvent& wxevent,
+                                  UIGestureRecognizer* gesture)
+{
+    wxWidgetIPhoneImpl* impl = (wxWidgetIPhoneImpl* ) wxWidgetImpl::FindFromWXWidget( self );
+    if ( impl == nullptr )
+        return;
+    wxWindowMac* peer = impl->GetWXPeer();
+    if ( peer == nullptr )
+        return;
+
+    const CGPoint where = [gesture locationInView:self];
+    wxevent.SetPosition(wxPoint((int) where.x, (int) where.y));
+    wxevent.SetGestureStart([gesture state] == UIGestureRecognizerStateBegan);
+    wxevent.SetGestureEnd([gesture state] == UIGestureRecognizerStateEnded ||
+                          [gesture state] == UIGestureRecognizerStateCancelled);
+    wxevent.SetEventObject(peer);
+    wxevent.SetId(peer->GetId());
+    peer->HandleWindowEvent(wxevent);
+}
+
+// Only these four states carry a usable value; Possible and Failed do not.
+static bool wxOSXGestureStateIsLive(UIGestureRecognizer* gesture)
+{
+    const UIGestureRecognizerState state = [gesture state];
+    return state == UIGestureRecognizerStateBegan ||
+           state == UIGestureRecognizerStateChanged ||
+           state == UIGestureRecognizerStateEnded ||
+           state == UIGestureRecognizerStateCancelled;
+}
+
+// Two fingers, deliberately. One finger is the pointer and must keep rotating
+// the view the way a left drag does on the desktop; requiring two here is what
+// makes "one finger orbits, two fingers slide the plate" the flow, which is
+// what every other 3D application on this hardware does.
+void wxOSX_panGesture(UIView* self, SEL _cmd, UIPanGestureRecognizer* gesture)
+{
+    if ( !wxOSXGestureStateIsLive(gesture) )
+        return;
+
+    // wx wants the delta since the last event, UIKit reports it cumulatively.
+    static CGPoint s_last = { 0, 0 };
+    const CGPoint translation = [gesture translationInView:self];
+    if ( [gesture state] == UIGestureRecognizerStateBegan )
+        s_last = CGPointZero;
+    const CGPoint delta = CGPointMake(translation.x - s_last.x, translation.y - s_last.y);
+    s_last = translation;
+
+    wxPanGestureEvent wxevent;
+    wxevent.SetDelta(wxPoint((int) delta.x, (int) delta.y));
+    wxOSXSendGestureEvent(self, wxevent, gesture);
+}
+
+void wxOSX_zoomGesture(UIView* self, SEL _cmd, UIPinchGestureRecognizer* gesture)
+{
+    if ( !wxOSXGestureStateIsLive(gesture) )
+        return;
+
+    // Cumulative scale since the gesture began, which is what wx documents and
+    // what applications expect: they latch their own starting value on
+    // IsGestureStart() and multiply by this.
+    wxZoomGestureEvent wxevent;
+    wxevent.SetZoomFactor([gesture scale]);
+    wxOSXSendGestureEvent(self, wxevent, gesture);
+}
+
+void wxOSX_rotateGesture(UIView* self, SEL _cmd, UIRotationGestureRecognizer* gesture)
+{
+    if ( !wxOSXGestureStateIsLive(gesture) )
+        return;
+
+    // Cumulative angle in radians, same convention as the zoom factor above.
+    wxRotateGestureEvent wxevent;
+    wxevent.SetRotationAngle([gesture rotation]);
+    wxOSXSendGestureEvent(self, wxevent, gesture);
+}
+
+// A press that stays put. UILongPressGestureRecognizer fails the moment the
+// finger travels more than allowableMovement, so a slow drag still orbits the
+// view rather than raising a menu under the user's hand.
+void wxOSX_longPressGesture(UIView* self, SEL _cmd, UILongPressGestureRecognizer* gesture)
+{
+    if ( !wxOSXGestureStateIsLive(gesture) )
+        return;
+
+    wxLongPressEvent wxevent;
+    wxOSXSendGestureEvent(self, wxevent, gesture);
+}
