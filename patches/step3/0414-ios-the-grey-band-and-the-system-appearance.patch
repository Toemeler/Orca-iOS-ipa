 bool GUI_App::dark_mode()
 {
+#if defined(__APPLE__) && !TARGET_OS_OSX
+    // Orca compiles its dark mode out: SUPPORT_DARK_MODE is defined nowhere, so
+    // the body below reduces to "return false" and the application is light
+    // whatever the device is set to. iPadOS has a system-wide appearance and
+    // every colour in Orca is chosen through this one function, so answering it
+    // honestly is the whole of the change.
+    return orca_ios_system_is_dark();
+#endif
 #ifdef SUPPORT_DARK_MODE
 #if __APPLE__
     // The check for dark mode returns false positive on 10.12 and 10.13,
@@ -4805,6 +4818,21 @@ void GUI_App::force_menu_update()
 #endif //_MSW_DARK_MODE
 #endif //__WINDOWS__
 
+#if defined(__APPLE__) && !TARGET_OS_OSX
+// The device switched between light and dark. Everything is re-asked rather
+// than tracked: dark_mode() is a live read of the system, so the colours only
+// need to be recomputed and the windows told to repaint.
+void orca_ios_appearance_changed()
+{
+    GUI_App &app = wxGetApp();
+    app.app_config->set("dark_color_mode", app.dark_mode() ? "1" : "0");
+    app.force_colors_update();
+    app.update_ui_from_settings();
+    if (app.mainframe != nullptr)
+        app.mainframe->Refresh();
+}
+#endif
