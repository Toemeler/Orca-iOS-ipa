+// Slice and Print, in glass.
+//
+// Orca puts these two in `side_tools` (MainFrame::create_side_tools) and hands
+// that sizer to ButtonsListCtrl - the tab strip. Hiding the strip for the
+// native tab bar therefore hid the slice and print buttons with it, which is
+// how the most important control in the application went missing. They come
+// back here as their own glass capsule, and they are still the same buttons
+// underneath: the label and the enabled state are read from m_slice_btn and
+// m_print_btn every idle, and a tap posts wxEVT_BUTTON to them, so "Slice
+// plate" becoming "Slice all" and going grey while a slice runs all still work
+// without this file knowing any of it.
+//
+// In the window's own controller, not in wx's view tree - the same reason the
+// plus is there.
+
+static const CGFloat kOrcaSideH      = 40;
+static const CGFloat kOrcaSideGap    = 8;
+static const CGFloat kOrcaSideInsetX = 14;
+static const CGFloat kOrcaSideMargin = 14;
+
+@interface OrcaSideButton : UIButton
+@property (nonatomic, copy) NSString *itemId;
+@end
+
+@implementation OrcaSideButton
+- (void)dealloc { [_itemId release]; [super dealloc]; }
+@end
+
+@interface OrcaSideTools : UIView
+- (void)setItems:(NSArray<NSDictionary *> *)items;
+- (void)reposition;
+@end
+
+@implementation OrcaSideTools {
+    UIVisualEffectView *_glass;
+    NSMutableArray<OrcaSideButton *> *_buttons;
+    NSArray<NSDictionary *>          *_items;
+}
+
+- (instancetype)initWithFrame:(CGRect)frame
+{
+    self = [super initWithFrame:frame];
+    if (self == nil)
+        return nil;
+
+    self.backgroundColor     = [UIColor clearColor];
+    self.layer.shadowColor   = [UIColor blackColor].CGColor;
+    self.layer.shadowOpacity = 0.18f;
+    self.layer.shadowRadius  = 12;
+    self.layer.shadowOffset  = CGSizeMake(0, 3);
+
+    UIGlassEffect *const glass = [[[UIGlassEffect alloc] init] autorelease];
+    glass.interactive = YES;
+    _glass = [[UIVisualEffectView alloc] initWithEffect:glass];
+    _glass.layer.cornerCurve = kCACornerCurveContinuous;
+    _glass.clipsToBounds     = YES;
+    [self addSubview:_glass];
+
+    _buttons = [[NSMutableArray alloc] init];
+    return self;
+}
+
+- (void)dealloc
+{
+    [_buttons release];
+    [_items release];
+    [_glass release];
+    [super dealloc];
+}
+
+- (void)setItems:(NSArray<NSDictionary *> *)items
+{
+    if ([items isEqualToArray:_items])
+        return;
+    [_items release];
+    _items = [items copy];
+
+    for (OrcaSideButton *b in _buttons)
+        [b removeFromSuperview];
+    [_buttons removeAllObjects];
+
+    for (NSDictionary *item in _items) {
+        OrcaSideButton *const b = [OrcaSideButton buttonWithType:UIButtonTypeSystem];
+        b.itemId = [item objectForKey:@"id"];
+        [b setTitle:[item objectForKey:@"title"] forState:UIControlStateNormal];
+        b.titleLabel.font = [UIFont systemFontOfSize:16 weight:UIFontWeightSemibold];
+        b.enabled         = [[item objectForKey:@"enabled"] boolValue];
+        // The primary one carries the tint, the way Orca's own pair does.
+        const BOOL primary = [[item objectForKey:@"primary"] boolValue];
+        [b setTitleColor:(primary ? [UIColor whiteColor] : [UIColor labelColor])
+                forState:UIControlStateNormal];
+        b.backgroundColor    = primary ? [UIColor systemBlueColor]
+                                       : [UIColor colorWithWhite:0.5 alpha:0.14];
+        b.layer.cornerRadius = (kOrcaSideH - 12) * 0.5f;
+        b.layer.cornerCurve  = kCACornerCurveContinuous;
+        b.pointerInteractionEnabled = YES;
+        [b addTarget:self action:@selector(tapped:)
+            forControlEvents:UIControlEventTouchUpInside];
+        [_glass.contentView addSubview:b];
+        [_buttons addObject:b];
+    }
+    [self reposition];
+}
+
+- (void)tapped:(OrcaSideButton *)sender
+{
+    if (sender.itemId != nil)
+        Slic3r::GUI::orca_ios_side_tool_action([sender.itemId UTF8String]);
+}
+
+- (void)reposition
+{
+    UIView *const host = self.superview;
+    if (host == nil)
+        return;
+    if (_buttons.count == 0) {
+        self.hidden = YES;
+        return;
+    }
+    self.hidden = NO;
+
+    CGFloat w = kOrcaSideInsetX;
+    for (OrcaSideButton *b in _buttons) {
+        const CGSize s = [b sizeThatFits:CGSizeMake(CGFLOAT_MAX, kOrcaSideH - 12)];
+        w += MAX(s.width + 28, 96) + kOrcaSideGap;
+    }
+    w = w - kOrcaSideGap + kOrcaSideInsetX;
+
+    const UIEdgeInsets safe = host.safeAreaInsets;
+    const CGRect hb = host.bounds;
+    self.frame = CGRectMake(hb.size.width - safe.right - kOrcaSideMargin - w,
+                            safe.top + kOrcaSideMargin,
+                            w, kOrcaSideH);
+    [self setNeedsLayout];
+    [self layoutIfNeeded];
+}
+
+- (void)layoutSubviews
+{
+    [super layoutSubviews];
+    const CGFloat radius = self.bounds.size.height * 0.5f;
+    _glass.frame              = self.bounds;
+    _glass.layer.cornerRadius = radius;
+    self.layer.shadowPath     = [UIBezierPath bezierPathWithRoundedRect:self.bounds
+                                                          cornerRadius:radius].CGPath;
+
+    CGFloat x = kOrcaSideInsetX;
+    for (OrcaSideButton *b in _buttons) {
+        const CGSize s = [b sizeThatFits:CGSizeMake(CGFLOAT_MAX, kOrcaSideH - 12)];
+        const CGFloat bw = MAX(s.width + 28, 96);
+        b.frame = CGRectMake(x, 6, bw, kOrcaSideH - 12);
+        x += bw + kOrcaSideGap;
+    }
+}
+
+@end
+
