+// Scroll wheel and trackpad two-finger scroll. UIKit does not deliver these as
+// touches at all -- they only reach an app through a pan recognizer that opts
+// in via allowedScrollTypesMask, and they arrive with no touches attached,
+// which is what separates them from a pointer drag.
+void wxOSX_scrollGesture(UIView* self, SEL _cmd, UIPanGestureRecognizer* gesture)
+{
+    wxWidgetIPhoneImpl* impl = (wxWidgetIPhoneImpl* ) wxWidgetImpl::FindFromWXWidget( self );
+    if ( impl == nullptr )
+        return;
+    wxWindowMac* peer = impl->GetWXPeer();
+    if ( peer == nullptr )
+        return;
+    if ( [gesture numberOfTouches] > 0 )
+        return;     // a real drag, already handled as touches
+
+    static CGPoint s_lastTranslation = { 0, 0 };
+    const CGPoint translation = [gesture translationInView:self];
+
+    if ( [gesture state] == UIGestureRecognizerStateBegan )
+        s_lastTranslation = CGPointZero;
+
+    const CGFloat dx = translation.x - s_lastTranslation.x;
+    const CGFloat dy = translation.y - s_lastTranslation.y;
+    s_lastTranslation = translation;
+
+    if ( dx == 0 && dy == 0 )
+        return;
+
+    const bool horizontal = fabs(dx) > fabs(dy);
+    const CGFloat delta = horizontal ? dx : dy;
+
+    wxMouseEvent wxevent(wxEVT_MOUSEWHEEL);
+    const CGPoint where = [gesture locationInView:self];
+    wxevent.m_x = where.x;
+    wxevent.m_y = where.y;
+
+    UIKeyModifierFlags modifiers = 0;
+    if ( @available(iOS 13.4, *) )
+        modifiers = [gesture modifierFlags];
+    wxevent.m_shiftDown      = (modifiers & UIKeyModifierShift) != 0;
+    wxevent.m_rawControlDown = (modifiers & UIKeyModifierControl) != 0;
+    wxevent.m_altDown        = (modifiers & UIKeyModifierAlternate) != 0;
+    wxevent.m_controlDown    = (modifiers & UIKeyModifierCommand) != 0;
+
+    wxevent.m_wheelAxis = horizontal ? wxMOUSE_WHEEL_HORIZONTAL : wxMOUSE_WHEEL_VERTICAL;
+    wxevent.m_wheelDelta = 120;
+    wxevent.m_linesPerAction = 3;
+    // Pan translation grows downwards; a scroll-wheel notch away from the user
+    // is positive in wx. Scale so an ordinary scroll gesture produces a few
+    // notches rather than hundreds.
+    wxevent.m_wheelRotation = (int) lround( -delta * (120.0 / 40.0) );
+    if ( wxevent.m_wheelRotation == 0 )
+        return;
+
+    wxevent.SetEventObject(peer);
+    wxevent.SetId(peer->GetId());
+    peer->HandleWindowEvent(wxevent);
+}
+
+// Pointer movement with no button held. Without this wxEVT_MOTION only fires
+// during a drag, so nothing in the application hover-highlights: no toolbar
+// feedback, no gizmo hover state, no tooltips.
+void wxOSX_hoverGesture(UIView* self, SEL _cmd, UIHoverGestureRecognizer* gesture)
+{
+    wxWidgetIPhoneImpl* impl = (wxWidgetIPhoneImpl* ) wxWidgetImpl::FindFromWXWidget( self );
+    if ( impl == nullptr )
+        return;
+    wxWindowMac* peer = impl->GetWXPeer();
+    if ( peer == nullptr )
+        return;
+
+    const UIGestureRecognizerState state = [gesture state];
+    if ( state != UIGestureRecognizerStateBegan &&
+         state != UIGestureRecognizerStateChanged &&
+         state != UIGestureRecognizerStateEnded )
+        return;
+
+    wxMouseEvent wxevent(state == UIGestureRecognizerStateEnded ? wxEVT_LEAVE_WINDOW
+                                                               : wxEVT_MOTION);
+    const CGPoint where = [gesture locationInView:self];
+    wxevent.m_x = where.x;
+    wxevent.m_y = where.y;
+
+    UIKeyModifierFlags modifiers = 0;
+    if ( @available(iOS 13.4, *) )
+        modifiers = [gesture modifierFlags];
+    wxevent.m_shiftDown      = (modifiers & UIKeyModifierShift) != 0;
+    wxevent.m_rawControlDown = (modifiers & UIKeyModifierControl) != 0;
+    wxevent.m_altDown        = (modifiers & UIKeyModifierAlternate) != 0;
+    wxevent.m_controlDown    = (modifiers & UIKeyModifierCommand) != 0;
+
+    wxevent.SetEventObject(peer);
+    wxevent.SetId(peer->GetId());
+    peer->HandleWindowEvent(wxevent);
+}
