+// A control for the one-shot benchmark: the same draw call, the same instance
+// count, the same vertex count per instance - and no texture fetches, no
+// lighting, no matrices. Whatever this costs is what the *shape* of the draw
+// costs, before any work the shader does.
+//
+// It answers the only question left. benchquarter proved the frame is bound by
+// the vertex stage rather than by fragments or tiles, but not what inside that
+// stage: 623307 instances of 8 vertices at 18.2M vertices/sec is either a
+// shader whose dependent fetches cannot be hidden, or an instanced draw shape
+// that Apple's tiler will not parallelise. If this control is also slow it is
+// the shape, and instancing has to go - a flat gl_VertexID draw, same pixels.
+// If it is fast, the fetches are the cost and the shader is where to work.
+//
+// Real triangles rather than degenerate ones, so nothing is culled before it is
+// counted; positioned from gl_InstanceID alone so no memory is touched.
+static const char* Segments_Bench_Vertex_Shader_ES =
+"#version 300 es\n"
+"precision highp float;\n"
+"in float vertex_id_float;\n"
+"out mediump vec3 color;\n"
+"void main() {\n"
+"  int vertex_id = int(vertex_id_float);\n"
+"  float x = float(gl_InstanceID & 255) * (2.0 / 255.0) - 1.0;\n"
+"  float y = float((gl_InstanceID >> 8) & 255) * (2.0 / 255.0) - 1.0;\n"
+"  vec2 corner = vec2(float(vertex_id & 1), float((vertex_id >> 1) & 1)) * 0.01;\n"
+"  color = vec3(0.5);\n"
+"  gl_Position = vec4(x + corner.x, y + corner.y, 0.0, 1.0);\n"
+"}\n";
+
 static const char* Segments_Fragment_Shader_ES =
 "#version 300 es\n"
 "precision highp float;\n"
