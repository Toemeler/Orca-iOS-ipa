+// -- the toolbar, from the canvas ------------------------------------------
+
+static OrcaToolbar             *gs_orca_toolbar      = nil;
+static bool                     gs_orca_toolbar_failed = false;
+static NSMutableArray<NSDictionary *> *gs_orca_tool_pending = nil;
+
+// GLCanvas3D::on_idle describes the toolbar it wants, one item at a time, and
+// commits it. Only const char* crosses, so nothing has to be agreed between
+// that translation unit and this one beyond the names of these three calls.
+void orca_ios_toolbar_begin()
+{
+    [gs_orca_tool_pending release];
+    gs_orca_tool_pending = [[NSMutableArray alloc] init];
+}
+
+void orca_ios_toolbar_add(const char *id, const char *icon, const char *tooltip,
+                          bool enabled, bool selected, bool collapsed)
+{
+    if (gs_orca_tool_pending == nil || id == nullptr)
+        return;
+    UIImage *const image = orca_ios_tool_icon(icon);
+    if (image == nil)
+        return;
+    [gs_orca_tool_pending addObject:@{
+        @"id"        : [NSString stringWithUTF8String:id],
+        @"image"     : image,
+        @"tooltip"   : [NSString stringWithUTF8String:tooltip != nullptr ? tooltip : ""],
+        @"enabled"   : [NSNumber numberWithBool:enabled ? YES : NO],
+        @"selected"  : [NSNumber numberWithBool:selected ? YES : NO],
+        @"collapsed" : [NSNumber numberWithBool:collapsed ? YES : NO],
+    }];
+}
+
+void orca_ios_toolbar_commit(void *canvas, void *host_view)
+{
+    UIView *const host = (UIView *) host_view;
+    if (host == nil || gs_orca_tool_pending == nil || gs_orca_toolbar_failed)
+        return;
+
+    // Caught for the reason the tab bar is: this runs from on_idle, inside
+    // wx's event dispatch, and an NSException coming up through wx is an
+    // abort() rather than a bug report. See run 131.
+    @try {
+        if (gs_orca_toolbar == nil) {
+            gs_orca_toolbar = [[OrcaToolbar alloc] initWithFrame:CGRectZero];
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-toolbar: created with "
+                                     << (unsigned long) gs_orca_tool_pending.count << " items";
+        }
+        gs_orca_toolbar.canvas = canvas;
+
+        if (gs_orca_toolbar.superview != host)
+            [host addSubview:gs_orca_toolbar];
+        [host bringSubviewToFront:gs_orca_toolbar];
+
+        // -setItems: does nothing when nothing changed, which is the ordinary
+        // case on an idle; the reposition is unconditional because the canvas
+        // changes size on rotation without the items changing at all.
+        [gs_orca_toolbar setItems:gs_orca_tool_pending];
+        [gs_orca_toolbar reposition];
+    }
+    @catch (NSException *e) {
+        gs_orca_toolbar_failed = true;
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-toolbar: THREW " << [[e name] UTF8String]
+                                 << ": " << [[e reason] UTF8String];
+    }
+}
