+// ----------------------------------------------------------------------------
+// Where the pointer last was.
+//
+// wxGetMousePosition() and wxGetMouseState() were stubs returning (0,0) and a
+// default-constructed state, and nothing in an application can tell that apart
+// from a pointer resting in the top left corner of the screen. What that costs
+// is not obvious until it is looked for:
+//
+//   - wxWindowMac::DoPopupMenu() substitutes this position whenever PopupMenu()
+//     is called without one, which is how most context menus are raised. Every
+//     one of them came up in the corner of the screen instead of under the
+//     finger.
+//   - Controls that hit-test against it decide the pointer is nowhere near
+//     themselves and do nothing at all. OrcaSlicer's object list is one:
+//     ObjectList::list_manipulation() starts with
+//     `if (mouse_pos.x < 0) return;`, and mouse_pos is
+//     wxGetMousePosition() - GetScreenPosition(), so the list's context menu
+//     could not open even from a mouse with a real right button.
+//
+// There is no cursor on this platform to ask, so the last place a finger, a
+// pencil or a pointer was seen is recorded as it passes through - in screen
+// coordinates, which is what both functions are documented to return - and
+// both answer from here. Written in src/osx/iphone/window.mm.
+// ----------------------------------------------------------------------------
+
+struct wxOSXIPhonePointerState
+{
+    wxPoint pos;
+    bool leftDown = false;
+    bool middleDown = false;
+    bool rightDown = false;
+    bool shiftDown = false;
+    bool controlDown = false;       // the physical Control key
+    bool altDown = false;
+    bool cmdDown = false;
+};
+
+extern WXDLLIMPEXP_DATA_CORE(wxOSXIPhonePointerState) g_wxOSXIPhonePointer;
+
+// Record a position given in the coordinates of `view`, which is where every
