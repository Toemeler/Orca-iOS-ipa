@@ -1046,6 +1053,28 @@
         // 30 s ticks on a device: dumps at 30, 60 and 150 seconds.
         timer->Start(driving ? 10000 : 30000, wxTIMER_CONTINUOUS);
     }
+
+    // Report whether the 3D canvas is being asked to draw.
+    //
+    // Deliberately a wxTimer and not an idle handler: a run-loop timer keeps
+    // firing even if idle events have stopped, and "have idle events stopped"
+    // is precisely the question. Three counters, so the three ways a viewport
+    // can freeze are distinguishable - no idle events reaching the canvas, no
+    // paint events either, or both arriving and render() still not running.
+    {
+        wxTimer *counters = new wxTimer(this);
+        this->Bind(wxEVT_TIMER, [counters](wxTimerEvent &) {
+            static unsigned last_i = 0, last_p = 0, last_r = 0;
+            const unsigned i = orca_ios_canvas_idles.load();
+            const unsigned p = orca_ios_canvas_paints.load();
+            const unsigned r = orca_ios_canvas_renders.load();
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-canvas: last 5s idle +" << (i - last_i)
+                << " paint +" << (p - last_p) << " render +" << (r - last_r)
+                << " (totals " << i << "/" << p << "/" << r << ")";
+            last_i = i; last_p = p; last_r = r;
+        }, counters->GetId());
+        counters->Start(5000, wxTIMER_CONTINUOUS);
+    }
 #endif // __WXOSX_IPHONE__
 }
 
