 void WebViewPanel::SendLoginInfo()
 {
     if (wxGetApp().getAgent()) {
+        // Empty when the agent has no session - and "window.postMessage()" with
+        // no argument is a TypeError, not a no-op. See GUI_App::get_login_info().
         std::string login_info = wxGetApp().getAgent()->build_login_info();
-        wxString strJS = wxString::Format("window.postMessage(%s)", login_info);
-        RunScript(strJS);
+        if (! login_info.empty()) {
+            wxString strJS = wxString::Format("window.postMessage(%s)", login_info);
+            RunScript(strJS);
+        }
     }
 }
 
