+// only when Command is held as well, which keeps Cmd+Ctrl+<key> a distinct
+// combination. The two are deliberately not set at once for a lone Control:
+// wxAcceleratorTable::GetCommand() matches every modifier exactly, so an event
+// claiming both would stop matching Ctrl accelerators rather than start.
+void wxOSXIPhoneSetModifiers( wxKeyboardState& state, UIKeyModifierFlags modifiers )
