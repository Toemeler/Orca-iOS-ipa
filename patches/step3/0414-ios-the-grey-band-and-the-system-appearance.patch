+// What the device is set to. Read on demand rather than cached: this is what
+// GUI_App::dark_mode() returns, and it is asked for every colour Orca draws.
+bool orca_ios_system_is_dark()
+{
+    return [UITraitCollection currentTraitCollection].userInterfaceStyle ==
+           UIUserInterfaceStyleDark;
+}
