 namespace libvgcode {
 
+#if defined(__APPLE__) && defined(ENABLE_OPENGL_ES)
+// Time spent rebuilding, in microseconds, read by the iOS canvas report.
+//
+// render() below runs three O(vertices) rebuilds behind dirty flags, and each
+// one walks every vertex and re-uploads several megabytes:
+//
+//   update_view_full_range()  update_enabled_entities()  update_colors()
+//
+// They are inside the frame, so anything that sets a flag makes the *next*
+// frame pay for it. A preview frame measured 35 ms at rest and 1180 ms while
+// being touched, all of it inside _render_gcode() and none of it in the swap,
+// which is the signature of a rebuild running per frame rather than of drawing
+// being slow. These three numbers say which flag is being set, and how often.
+std::atomic<uint64_t> orca_ios_vg_full_range_us{0};
+std::atomic<uint64_t> orca_ios_vg_enabled_us{0};
+std::atomic<uint64_t> orca_ios_vg_colors_us{0};
+
+namespace {
+struct OrcaIosVgTimer
+{
+    std::atomic<uint64_t> &total;
+    std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+    explicit OrcaIosVgTimer(std::atomic<uint64_t> &t) : total(t) {}
+    ~OrcaIosVgTimer()
+    {
+        total += (uint64_t) std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now() - t0).count();
+    }
+};
+} // namespace
+#endif
+
 template<class T, class O = T>
 using IntegerOnly = std::enable_if_t<std::is_integral<T>::value, O>;
 
