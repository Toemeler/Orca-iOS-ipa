+// src/osx/iphone/msgdlg.mm. Returns the index, -1 for cancelled, -2 for "could
+// not be presented" - which is not the same answer and must not be reported as
+// one.
+extern int wxOSXIPhoneChoiceAlert(const wxString& title,
+                                  const wxString& message,
+                                  const wxArrayString& choices,
+                                  int selected);
+
+int wxSingleChoiceDialog::ShowModal()
+{
+    WX_HOOK_MODAL_DIALOG();
+
+    if ( m_listbox == nullptr )
+        return wxDialog::ShowModal();
+
+    wxArrayString choices;
+    const unsigned count = m_listbox->GetCount();
+    choices.Alloc(count);
+    for ( unsigned i = 0; i < count; ++i )
+        choices.Add(m_listbox->GetString(i));
+
+    const int chosen = wxOSXIPhoneChoiceAlert(GetTitle(), m_iosMessage, choices, m_selection);
+    if ( chosen == -2 )
+        return wxDialog::ShowModal();       // nothing was shown; show the window
+    if ( chosen < 0 || (unsigned) chosen >= count )
+    {
+        SetReturnCode(wxID_CANCEL);
+        return wxID_CANCEL;
+    }
+
+    // SetSelection() moves the listbox as well as m_selection, and DoChoice()
+    // is what reads the string and the client data back out of it - the same
+    // two steps the OK button takes, so a caller asking for GetStringSelection()
+    // or GetSelectionData() afterwards gets what it always did.
+    SetSelection(chosen);
+    DoChoice();
+    return wxID_OK;
+}
+
+#endif // __WXOSX_IPHONE__
