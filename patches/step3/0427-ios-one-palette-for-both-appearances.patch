 inline wxColour darkModeColorFor2(wxColour const &color)
 {
+#if defined(__APPLE__) && !TARGET_OS_OSX
+    // Both appearances go through the palette, which is the whole point of it:
+    // light mode is a design here rather than "the colours as written".
+    auto const &palette = gDarkMode ? gIosDark : gIosLight;
+    auto        iter    = palette.find(color);
+    if (iter != palette.end()) return iter->second;
+    return color;
+#else
     if (!gDarkMode)
         return color;
     auto iter = gDarkColors.find(color);
     if (iter != gDarkColors.end()) return iter->second;
     return color;
+#endif
 }
 
 std::map<wxColour, wxColour> revert(std::map<wxColour, wxColour> const & map)
@@ -205,10 +346,20 @@ std::map<wxColour, wxColour> revert(std::map<wxColour, wxColour> const & map)
 
 wxColour StateColor::lightModeColorFor(wxColour const &color)
 {
+#if defined(__APPLE__) && !TARGET_OS_OSX
+    // The light half of the same palette, rather than upstream's reverted
+    // table: this is the function UpdateDarkUI() puts a window's dark
+    // background through on the way back, and the palette already knows what
+    // each of its own dark colours means.
+    auto iter = gIosLight.find(color);
+    if (iter != gIosLight.end()) return iter->second;
+    return color;
+#else
     static std::map<wxColour, wxColour> gLightColors = revert(gDarkColors);
     auto iter = gLightColors.find(color);
     if (iter != gLightColors.end()) return iter->second;
     return color;
+#endif
 }
 
 wxColour StateColor::darkModeColorFor(wxColour const &color) { return darkModeColorFor2(color); }
