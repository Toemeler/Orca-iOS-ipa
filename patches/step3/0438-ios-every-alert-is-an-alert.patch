+bool SecondaryCheckDialog::orca_ios_show_native()
+{
+    // The buttons in the order the window lays them out, which is the order
+    // the sizer was filled in: Resume, Retry, Done, Confirm, Cancel. Only the
+    // shown ones - update_title_style() hides the rest, and which are shown is
+    // the whole of what VisibleButtons means.
+    Button *const ordered[] = { m_button_ok, m_button_resume, m_button_retry,
+                                m_button_fn, m_button_cancel };
+
+    std::vector<Slic3r::GUI::IOSAlertButton> rows;
+    Slic3r::GUI::IOSAlertButton *affirmative = nullptr;
+
+    for (Button *const btn : ordered) {
+        if (btn == nullptr || !btn->IsShown())
+            continue;
+        Slic3r::GUI::IOSAlertButton row;
+        row.label     = btn->GetLabel();
+        row.widget    = btn;
+        row.enabled   = btn->IsEnabled();
+        row.preferred = btn == m_button_ok;
+        row.cancel    = btn == m_button_cancel;
+        rows.push_back(row);
+    }
+
+    if (rows.empty())
+        return false;
+
+    for (Slic3r::GUI::IOSAlertButton &row : rows) {
+        if (row.preferred) {
+            affirmative = &row;
+            break;
+        }
+    }
+    if (affirmative == nullptr)
+        affirmative = &rows.front();
+
+    // "Don't show again", which is a wxCheckBox in the window and has to be a
+    // row here for the same reason MsgDialog's is: an iOS alert holds text
+    // fields and rows and nothing else.
+    if (m_show_again_checkbox != nullptr && m_show_again_checkbox->IsShown()) {
+        Slic3r::GUI::IOSAlertButton row;
+        row.label  = m_show_again_checkbox->GetLabel();
+        row.widget = affirmative->widget;
+        wxCheckBox *const box = m_show_again_checkbox;
+        row.before = [this, box]() {
+            box->SetValue(true);
+            this->not_show_again = true;
+        };
+        size_t at = rows.size();
+        for (size_t i = 0; i < rows.size(); ++i) {
+            if (rows[i].cancel) {
+                at = i;
+                break;
+            }
+        }
+        rows.insert(rows.begin() + at, row);
+    }
+
+    // GetLabelText() and not GetLabel(): update_text() writes it with
+    // SetLabelText(), which escapes any ampersand into a mnemonic, and the
+    // alert wants the sentence back the way it went in.
+    const wxString text = m_staticText_release_note != nullptr
+                              ? m_staticText_release_note->GetLabelText()
+                              : wxString();
+
+    if (!Slic3r::GUI::orca_ios_alert_post(this, GetTitle(), text, rows))
+        return false;
+
+    // The window is not shown, but everything else on_hide() does still has to
+    // happen when it is hidden, so nothing here bypasses it: the rows post the
+    // same events, and whoever handles them calls on_hide() as before.
+    return true;
+}
+#endif
+
