+
+// A genuinely small number keypad for numeric fields.
+//
+// THE THING TO KNOW: on iPad, UIKeyboardTypeDecimalPad is NOT the compact 4x3
+// pad it is on iPhone - iPadOS renders it as a full-width keyboard. The device
+// log settled this: 65 fields reported "decimal pad set", not one failure, and
+// the full keyboard came up anyway. Setting keyboardType cannot produce a small
+// keypad on this hardware. The only way is to supply the keyboard yourself as
+// an inputView, which is what this is.
+//
+// Sixteen keys, covering everything an Orca numeric field can hold:
+//
+//     7 8 9 <-     backspace
+//     4 5 6  -     minus, for positions and offsets
+//     1 2 3  .     decimal point
+//     0 , % OK     comma for coPoints, percent for coFloatOrPercent
+//
+// OK lives on the pad, so no input accessory view is needed - the system
+// decimal pad having no return key was the only reason for one.
+@interface OrcaNumericKeypad : UIView
+@property (nonatomic, assign) UITextField *field;
+- (instancetype)initWithField:(UITextField *)field;
+- (void)keyTapped:(UIButton *)sender;
+@end
+
+static NSArray<NSString *> *orca_ios_keypad_titles(void)
+{
+    return @[ @"7", @"8", @"9", @"⌫",
+              @"4", @"5", @"6", @"-",
+              @"1", @"2", @"3", @".",
+              @"0", @",", @"%", @"OK" ];
+}
+
+@implementation OrcaNumericKeypad {
+    NSMutableArray<UIButton *> *_keys;
+}
+
+- (instancetype)initWithField:(UITextField *)field
+{
+    // Four rows of roughly 48pt. About half the height of the alphabetic
+    // keyboard this replaces, which was the whole complaint.
+    self = [super initWithFrame:CGRectMake(0, 0, 320, 216)];
+    if (self == nil)
+        return nil;
+    _field = field;
+    _keys = [[NSMutableArray alloc] init];
+    self.backgroundColor = [UIColor colorWithWhite:0.82 alpha:1.0];
+
+    NSArray<NSString *> *titles = orca_ios_keypad_titles();
+    for (NSUInteger i = 0; i < titles.count; ++i) {
+        UIButton *b = [UIButton buttonWithType:UIButtonTypeSystem];
+        [b setTitle:titles[i] forState:UIControlStateNormal];
+        b.titleLabel.font = [UIFont systemFontOfSize:22];
+        b.backgroundColor = [UIColor whiteColor];
+        b.layer.cornerRadius = 5;
+        b.tag = (NSInteger) i;
+        [b addTarget:self action:@selector(keyTapped:)
+            forControlEvents:UIControlEventTouchUpInside];
+        [self addSubview:b];
+        [_keys addObject:b];
+    }
+    return self;
+}
+
+- (void)dealloc
+{
+    [_keys release];
+    [super dealloc];
+}
+
+- (void)layoutSubviews
+{
+    [super layoutSubviews];
+    // Centred, and no wider than it needs to be: an inputView spans the screen,
+    // but the keys themselves should not.
+    const CGFloat pad = 6, cols = 4, rows = 4;
+    const CGFloat gridW = MIN(self.bounds.size.width, (CGFloat) 420);
+    const CGFloat originX = (self.bounds.size.width - gridW) / 2;
+    const CGFloat kw = (gridW - pad * (cols + 1)) / cols;
+    const CGFloat kh = (self.bounds.size.height - pad * (rows + 1)) / rows;
+    for (NSUInteger i = 0; i < _keys.count; ++i) {
+        const NSUInteger r = i / 4, c = i % 4;
+        [_keys objectAtIndex:i].frame =
+            CGRectMake(originX + pad + c * (kw + pad), pad + r * (kh + pad), kw, kh);
+    }
+}
+
+- (void)keyTapped:(UIButton *)sender
+{
+    UITextField *f = self.field;
+    if (f == nil)
+        return;
+    NSString *title = [orca_ios_keypad_titles() objectAtIndex:(NSUInteger) sender.tag];
+
+    if ([title isEqualToString:@"OK"]) {
+        [f resignFirstResponder];
+        return;
+    }
+    if ([title isEqualToString:@"⌫"])
+        [f deleteBackward];
+    else
+        [f insertText:title];
+
+    // wxTextCtrl listens for the control event, and a programmatic edit does not
+    // raise it on its own.
+    [f sendActionsForControlEvents:UIControlEventEditingChanged];
+}
+
+@end
+
+static char orca_ios_keypad_key;
+
+// Orca's numeric fields are composites (::TextInput, ::SpinInput, ::TempInput),
+// so walk down rather than assuming the handle is the field itself.
+static UITextField *orca_ios_find_text_field(UIView *view)
+{
+    if (view == nil)
+        return nil;
+    if ([view isKindOfClass:[UITextField class]])
+        return (UITextField *) view;
+    for (UIView *sub in view.subviews) {
+        UITextField *found = orca_ios_find_text_field(sub);
+        if (found != nil)
+            return found;
+    }
+    return nil;
+}
+
