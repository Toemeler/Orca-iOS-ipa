 // The recognizers this call installed, so a second call replaces rather than
 // stacks them. Associated with the view because the peer can outlive none of
 // it and UIKit owns the view's recognizer array.
+// Why two-finger pan never fired.
+//
+// UIKit arbitrates: without a delegate saying otherwise, only ONE recognizer on
+// a view may recognize at a time, and the others are made to fail. Pinch and
+// rotation both begin the instant a second finger lands, so a two-finger drag
+// was always claimed by one of them and the pan recognizer never got to send
+// anything. Orca's on_gesture() has handled wxEVT_GESTURE_PAN correctly the
+// whole time; the event simply never arrived.
+//
+// A 3D viewport wants all three at once - drag to pan, spread to zoom, twist to
+// rotate, in one continuous motion - which is what every iPad app with a camera
+// in it does, so the answer is to allow simultaneous recognition rather than to
+// pick a winner.
+@interface wxOSXGestureDelegate : NSObject <UIGestureRecognizerDelegate>
+@end
+
+@implementation wxOSXGestureDelegate
+- (BOOL)gestureRecognizer:(UIGestureRecognizer *)a
+        shouldRecognizeSimultaneouslyWithGestureRecognizer:(UIGestureRecognizer *)b
+{
+    (void) a; (void) b;
+    return YES;
+}
+@end
+
+// One delegate for every recognizer in the process: it holds no state, and a
+// recognizer does not retain its delegate, so it has to outlive them all.
+static id wxOSXSharedGestureDelegate()
+{
+    static wxOSXGestureDelegate* delegate = nil;
+    if ( delegate == nil )
+        delegate = [[wxOSXGestureDelegate alloc] init];
+    return delegate;
+}
