     BOOST_LOG_TRIVIAL(info) << boost::format("render_thumbnail: finished");
 }
 
+#if defined(__APPLE__) && !TARGET_OS_OSX
+// Save and restore the framebuffer that was actually bound.
+//
+// The iOS shim translates glBindFramebuffer(target, 0) into "the drawable",
+// using a name sampled once per frame at the top of render(). That holds for
+// offscreen passes inside a frame, and not at all for these: thumbnails are
+// rendered from export_3mf, outside any frame, and there are two canvases -
+// Prepare and Preview - sharing one remembered name. So the restore below binds
+// whatever was sampled last, which can be the other canvas's drawable or one
+// GLKit has since recreated. Every later draw then lands somewhere invisible:
+// the viewport freezes on its last good frame and the other one goes black.
+//
+// The log caught it exactly - "render_thumbnail prepare: GL_FRAMEBUFFER not
+// complete" during an autosave, and the render counter never moving again.
+//
+// Asking GL what is bound and putting that back needs no remembered state and
+// is correct on every platform, so it is not conditional on the failure path
+// either - the incomplete-framebuffer case took the same broken restore.
+struct OrcaIosFramebufferGuard
+{
+    GLint prev = 0;
+    OrcaIosFramebufferGuard() { ::glGetIntegerv(GL_FRAMEBUFFER_BINDING, &prev); }
+    ~OrcaIosFramebufferGuard() { ::glBindFramebuffer(GL_FRAMEBUFFER, static_cast<GLuint>(prev)); }
+};
+#endif
