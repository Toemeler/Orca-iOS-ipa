+#if defined(TARGET_OS_IPHONE) && TARGET_OS_IPHONE
+    // What the fonts came out as, in the terms the layout code uses.
+    //
+    // Registering the files is not the same as getting the metrics right: the
+    // sizes in Label::sysFont are passed through unscaled on Apple, wxFont
+    // never reports a bad face name, and the widths in the window tree suggest
+    // several different fonts are in play at once. Measuring one fixed string
+    // with each of them settles it in a single line each - and if two sizes
+    // measure the same, that alone says SetFont is not reaching the peer.
+    {
+        wxBitmap probe(8, 8);
+        if (probe.IsOk()) {
+            wxMemoryDC dc(probe);
+            const std::pair<const char *, const wxFont *> fonts[] = {
+                {"Body_10", &::Label::Body_10}, {"Body_12", &::Label::Body_12},
+                {"Body_14", &::Label::Body_14}, {"Head_14", &::Label::Head_14},
+            };
+            for (auto const &f : fonts) {
+                dc.SetFont(*f.second);
+                const wxSize ext = dc.GetTextExtent("Stainless Steel");
+                BOOST_LOG_TRIVIAL(error) << "orca-ios-font: " << f.first << " "
+                    << f.second->GetPointSize() << "pt '"
+                    << f.second->GetFaceName().utf8_string() << "'"
+                    << (f.second->IsOk() ? "" : " NOT OK")
+                    << " extent(\"Stainless Steel\") " << ext.x << "x" << ext.y;
+            }
+        }
+    }
+#endif
 
