+// ---------------------------------------------------------------------------
+// The end of the responder chain, which is where a key press ends up when
+// nothing in the window claimed it
+// ---------------------------------------------------------------------------
+//
+// UIKit delivers a key press to the first responder, and an application spends
+// a good deal of its life with no first responder at all - every application
+// starts that way, and stays that way until the user touches something that
+// takes the keyboard. In that state -pressesBegan: is sent to the window, then
+// to UIApplication, then here; on this port that used to be the end of it, and
+// the press was dropped.
+//
+// The application delegate is a UIResponder and it is the last one there is,
+// so this is the only place that sees every press whatever has the focus.
+// wxOSXIPhoneRouteUnhandledPresses() delivers what arrives here to the window
+// wx considers focused, or - when wx considers none of them focused - to the
+// top level window UIKit is calling key, which is what makes an application's
+// global shortcuts work before anything has been touched.
+//
+// Presses a wx view was already offered are marked as such and skipped, so
+// letting an unhandled one travel up the chain does not deliver it twice.
+
+#if wxUSE_GUI
+
+- (void)pressesBegan:(NSSet<UIPress *> *)presses withEvent:(UIPressesEvent *)event
+{
+    if ( !wxOSXIPhoneRouteUnhandledPresses(presses, event) )
+        [super pressesBegan:presses withEvent:event];
+}
+
+- (void)pressesEnded:(NSSet<UIPress *> *)presses withEvent:(UIPressesEvent *)event
+{
+    if ( !wxOSXIPhoneRouteUnhandledPresses(presses, event) )
+        [super pressesEnded:presses withEvent:event];
+}
+
+- (void)pressesCancelled:(NSSet<UIPress *> *)presses withEvent:(UIPressesEvent *)event
+{
+    if ( !wxOSXIPhoneRouteUnhandledPresses(presses, event) )
+        [super pressesCancelled:presses withEvent:event];
+}
+
+#endif // wxUSE_GUI
+
 - (void)dealloc
 {
     [super dealloc];
@@ -159,6 +203,29 @@ static void wxOSXQueueOrDeliverOpenURL(NSURL* url)
 }
 #endif
 
+#if wxUSE_MENUS
+// The action every menu item that has a key equivalent carries.
+//
+// A UIKeyCommand cannot take a handler block the way a UIAction does - it
+// names a selector, and UIKit sends it along the responder chain until it
+// finds a responder that implements it. The application delegate is the last
+// link in that chain, so putting it here means the shortcut works whatever
+// holds the focus, which is the point of a menu shortcut.
+//
+// The item is looked up from the identifier the command carries rather than
+// captured, because UIKit keeps the menu elements it was handed for longer
+// than wx keeps the items they were built from.
+- (void)wxOSXMenuCommand:(id)sender
+{
+    if ( ![sender isKindOfClass:UICommand.class] )
+        return;
+
+    id plist = ((UICommand*) sender).propertyList;
+    if ( [plist isKindOfClass:NSString.class] )
+        wxOSXIPhoneDispatchMenuCommand((NSString*) plist);
+}
+#endif
+
 @end
 
