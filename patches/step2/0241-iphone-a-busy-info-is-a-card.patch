+
+// src/osx/iphone/msgdlg.mm. Returns null - having shown nothing - when there
+// is no window to put the overlay in, which is the one case that still needs
+// the frame built below.
+extern void* wxOSXIPhoneBusyInfoShow(const wxString& title, const wxString& text);
+extern void  wxOSXIPhoneBusyInfoUpdate(void* handle, const wxString& text);
+extern void  wxOSXIPhoneBusyInfoHide(void* handle);
+
+// The title and the text may both carry markup, which the overlay has no way
+// of drawing: it is a UILabel, and UILabel has one font. Stripping is what the
+// ports without markup support do with it, and it loses nothing but emphasis.
+static wxString wxBusyInfoIOSPlain(const wxString& s)
+{
+#if wxUSE_MARKUP
+    if ( s.find('<') != wxString::npos || s.find('&') != wxString::npos )
+        return wxMarkupParser::Strip(s);
+#endif // wxUSE_MARKUP
+    return s;
+}
+
+#endif // __WXOSX_IPHONE__
+
 void wxBusyInfo::Init(const wxBusyInfoFlags& flags)
 {
+#ifdef __WXOSX_IPHONE__
+    // Every top level window is a UIWindow on this port, so the frame below is
+    // a second one floating at normal level - underneath every dialog, in a
+    // style belonging to no platform. What goes up instead is the card iOS puts
+    // up while it is working, in the frontmost window rather than beside it.
+    m_iosHUD = wxOSXIPhoneBusyInfoShow(
+                   wxBusyInfoIOSPlain(flags.m_title),
+                   wxBusyInfoIOSPlain(flags.m_text.empty() ? flags.m_label
+                                                           : flags.m_text));
+    if ( m_iosHUD != nullptr )
+    {
+        m_InfoFrame = nullptr;
+        m_text      = nullptr;
+        return;
+    }
+    // Nothing was shown. Fall through and build the window: a busy info in the
+    // wrong style is still better than an operation that appears to hang.
+#endif // __WXOSX_IPHONE__
+
     m_InfoFrame = new wxFrame(flags.m_parent, wxID_ANY, wxString(),
                               wxDefaultPosition, wxDefaultSize,
                               wxSIMPLE_BORDER |
@@ -141,6 +187,14 @@ void wxBusyInfo::Init(const wxBusyInfoFlags& flags)
 
 void wxBusyInfo::UpdateText(const wxString& str)
 {
+#ifdef __WXOSX_IPHONE__
+    if ( m_iosHUD != nullptr )
+    {
+        wxOSXIPhoneBusyInfoUpdate(m_iosHUD, wxBusyInfoIOSPlain(str));
+        return;
+    }
+#endif // __WXOSX_IPHONE__
+
 #if wxUSE_MARKUP
     m_text->SetLabelMarkup(str);
 #else // !wxUSE_MARKUP
@@ -150,11 +204,28 @@ void wxBusyInfo::UpdateText(const wxString& str)
 
 void wxBusyInfo::UpdateLabel(const wxString& str)
 {
+#ifdef __WXOSX_IPHONE__
+    if ( m_iosHUD != nullptr )
+    {
+        wxOSXIPhoneBusyInfoUpdate(m_iosHUD, str);
+        return;
+    }
+#endif // __WXOSX_IPHONE__
+
     m_text->SetLabelText(str);
 }
 
 wxBusyInfo::~wxBusyInfo()
 {
+#ifdef __WXOSX_IPHONE__
+    if ( m_iosHUD != nullptr )
+    {
+        wxOSXIPhoneBusyInfoHide(m_iosHUD);
+        m_iosHUD = nullptr;
+        return;
+    }
+#endif // __WXOSX_IPHONE__
+
     m_InfoFrame->Show(false);
     m_InfoFrame->Close();
 }
