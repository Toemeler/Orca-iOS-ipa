diff --git a/src/slic3r/GUI/ios_webview_support.mm b/src/slic3r/GUI/ios_webview_support.mm
new file mode 100644
index 00000000..f8431bb2
--- /dev/null
+++ b/src/slic3r/GUI/ios_webview_support.mm
@@ -0,0 +1,78 @@
+///|/ Copyright (c) 2026 Orca-iOS-ipa contributors
+///|/
+///|/ Orca-iOS-ipa is released under the terms of the AGPLv3 or higher
+///|/
+// iOS implementations of the two WKWebView helpers Orca calls directly.
+//
+// On macOS these live in Utils/MacDarkMode.mm, which is excluded from the iOS
+// build (patch 0302), so patch 0316 stubbed them out as no-ops while wxWebView
+// had no backend at all. Now that the WKWebView backend is compiled for the
+// iPhone port (patch step2/0210) they need to do the real thing, otherwise the
+// web panels load but nothing can be pushed into them: Orca drives the embedded
+// pages almost entirely through evaluateJavaScript.
+
+#import <WebKit/WebKit.h>
+#import <UIKit/UIKit.h>
+
+#include "libslic3r/libslic3r.h"
+#include "slic3r/Utils/MacDarkMode.hpp"
+#include <wx/osx/core/cfstring.h>
+#include <boost/log/trivial.hpp>
+
+namespace Slic3r {
+namespace GUI {
+
+void WKWebView_evaluateJavaScript(void *web, wxString const &script,
+                                  void (*callback)(wxString const &))
+{
+    if (web == nullptr)
+        return;
+
+    // Orca drives its embedded pages entirely through this call and passes a
+    // null callback at every site, so before this the completion handler threw
+    // every JavaScript error away. That is the one place a failure could hide:
+    // the setup wizard's page sits on "Loading......" for ever if the
+    // HandleStudio() call that hands it the profile list never runs, and
+    // nothing anywhere would say so. Log the script and the outcome.
+    const wxString head = script.Left(100);
+    BOOST_LOG_TRIVIAL(error) << "orca-ios-webview: evaluateJavaScript: "
+                             << head.ToUTF8().data()
+                             << (script.length() > 100 ? " ..." : "");
+
+    // Identical API to the macOS implementation this mirrors.
+    [(WKWebView *) web evaluateJavaScript:wxCFStringRef(script).AsNSString()
+                       completionHandler:^(id result, NSError *error) {
+        if (error != nil) {
+            const wxString desc = wxCFStringRef(
+                [error localizedDescription]).AsString();
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-webview: FAILED: "
+                                     << desc.ToUTF8().data();
+        }
+        if (callback && error != nil) {
+            wxString err = wxCFStringRef(error.localizedFailureReason).AsString();
+            callback(err);
+        }
+    }];
+}
+
+void WKWebView_setTransparentBackground(void *web)
+{
+    if (web == nullptr)
+        return;
+
+    WKWebView *webView = (WKWebView *) web;
+
+    // The macOS version clears the backing layer and registers for dragged
+    // file types. There is no NSFilenamesPboardType here -- dropping files onto
+    // a view is a UIDropInteraction, which is separate work -- so this does the
+    // transparency only. On iOS a web view also has to be made non-opaque and
+    // its scroll view cleared, or the white page background shows through
+    // whatever Orca draws behind it.
+    webView.opaque = NO;
+    webView.backgroundColor = [UIColor clearColor];
+    webView.scrollView.backgroundColor = [UIColor clearColor];
+    webView.layer.backgroundColor = [UIColor clearColor].CGColor;
+}
+
+} // namespace GUI
+} // namespace Slic3r
