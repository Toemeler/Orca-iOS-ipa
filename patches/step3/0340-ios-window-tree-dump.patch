+#ifdef __WXOSX_IPHONE__
+    // 20 s: the sidebar's presets, the parameter tabs and the object list are
+    // all filled in from idle handlers and background loads, so a dump taken at
+    // the end of this constructor would show an empty shell and prove nothing.
+    // The timer owns itself and fires once; the frame outlives it.
+    {
+        wxTimer *dump_timer = new wxTimer(this);
+        this->Bind(wxEVT_TIMER, [dump_timer](wxTimerEvent &) {
+            orca_ios_dump_all_windows("20s after MainFrame");
+            dump_timer->Stop();
+        }, dump_timer->GetId());
+        dump_timer->StartOnce(20000);
+    }
+#endif // __WXOSX_IPHONE__
