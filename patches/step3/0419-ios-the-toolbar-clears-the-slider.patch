-void orca_ios_toolbar_commit(void *canvas, void *host_view)
+// Is this view actually on screen? A hidden notebook page is still a view with
+// a superview and a window, so "has a window" is not the question.
+static BOOL orca_ios_view_on_screen(UIView *view)
+{
+    if (view == nil || view.window == nil)
+        return NO;
+    for (UIView *v = view; v != nil; v = v.superview) {
+        if (v.hidden || v.alpha < 0.01)
+            return NO;
+    }
+    return YES;
+}
+
+void orca_ios_toolbar_commit(void *canvas, void *host_view, float right_inset_px)
 {
     UIView *const host = (UIView *) host_view;
     if (host == nil || gs_orca_tool_pending == nil || gs_orca_toolbar_failed)
         return;
 
+    // ONE COLUMN, MOVED TO WHICHEVER CANVAS IS SHOWING.
+    //
+    // Every GLCanvas3D syncs from its own idle - Prepare's, Preview's and the
+    // assemble view's - and they all commit into this one view, so the last
+    // one to run took it away from the others. Prepare and Preview were
+    // therefore trading the toolbar back and forth every idle, and Preview's
+    // set of items (the sidebar toggle; its main toolbar and gizmos are not
+    // enabled) was overwriting Prepare's twenty-five. A canvas that is not on
+    // screen has nothing to say about a bar the user can see.
+    if (!orca_ios_view_on_screen(host))
+        return;
+
     // Caught for the reason the tab bar is: this runs from on_idle, inside
     // wx's event dispatch, and an NSException coming up through wx is an
     // abort() rather than a bug report. See run 131.
@@ -2223,6 +2262,12 @@
