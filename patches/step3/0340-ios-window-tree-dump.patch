+#ifdef __WXOSX_IPHONE__
+// A control that was never created, one that was created 0 pixels wide, one
+// that sits outside its parent's client area and one that is simply hidden all
+// look exactly the same on an iPad: a gap in the sidebar. Nobody can tell them
+// apart from a screenshot, and asking someone to describe it does not either.
+//
+// So write the window tree down. Every wxWindow under every top level window,
+// with its class, label, position, size, shown and enabled state, indented by
+// depth. At error level because Orca's release log level starts there.
+static void orca_ios_dump_window_tree(wxWindow *w, int depth)
+{
+    if (w == nullptr)
+        return;
+
+    const wxPoint pos  = w->GetPosition();
+    const wxSize  size = w->GetSize();
+    const wxSize  best = w->GetEffectiveMinSize();
+
+    BOOST_LOG_TRIVIAL(error)
+        << "orca-ios-ui: " << std::string(depth * 2, ' ')
+        << w->GetClassInfo()->GetClassName()
+        << " \"" << w->GetLabel().ToUTF8().data() << "\""
+        << " id=" << w->GetId()
+        << " at=" << pos.x << "," << pos.y
+        << " size=" << size.x << "x" << size.y
+        << " best=" << best.x << "x" << best.y
+        << (w->IsShown() ? " shown" : " HIDDEN")
+        << (w->IsEnabled() ? "" : " disabled")
+        << (w->IsShownOnScreen() ? "" : " OFFSCREEN");
+
+    const wxWindowList &children = w->GetChildren();
+    for (wxWindowList::const_iterator it = children.begin(); it != children.end(); ++it)
+        orca_ios_dump_window_tree(*it, depth + 1);
+}
+
+static void orca_ios_dump_all_windows(const char *why)
+{
+    BOOST_LOG_TRIVIAL(error) << "orca-ios-ui: ===== window tree (" << why << ") =====";
+    for (wxWindowList::const_iterator it = wxTopLevelWindows.begin();
+         it != wxTopLevelWindows.end(); ++it) {
+        wxWindow *tlw = *it;
+        BOOST_LOG_TRIVIAL(error)
+            << "orca-ios-ui: --- top level window: "
+            << tlw->GetClassInfo()->GetClassName()
+            << " \"" << tlw->GetLabel().ToUTF8().data() << "\""
+            << (tlw->IsShown() ? " shown" : " HIDDEN");
+        orca_ios_dump_window_tree(tlw, 1);
+    }
+    BOOST_LOG_TRIVIAL(error) << "orca-ios-ui: ===== end window tree =====";
+}
+
+// ---------------------------------------------------------------------------
+// The driver.
+//
+// idb is the only supported way to synthesise a tap into a simulator without an
+// XCUITest target, and on this runner it does not work: brew has no
+// idb-companion for it, so every idb call dies on a missing
+// /usr/local/bin/idb_companion. Four rounds of trying is enough. The
+// application can press its own buttons instead - wx event handlers do not care
+// whether a wxMouseEvent came from UIKit or from here - and that is the only
+// thing that makes a simulator run answer a question rather than just prove the
+// process is alive.
+//
+// Only runs when ORCA_IOS_DRIVE is set in the environment, which the simulator
+// harness passes as SIMCTL_CHILD_ORCA_IOS_DRIVE=1. A device build never sees it.
+static void orca_ios_click(wxWindow *w, const char *what)
+{
+    if (w == nullptr) {
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-drive: " << what << ": NOT FOUND";
+        return;
+    }
+
+    const wxSize size = w->GetSize();
+    const wxPoint at(size.x / 2, size.y / 2);
+
+    BOOST_LOG_TRIVIAL(error)
+        << "orca-ios-drive: clicking " << what << " ("
+        << w->GetClassInfo()->GetClassName()
+        << " \"" << w->GetLabel().ToUTF8().data() << "\""
+        << " size=" << size.x << "x" << size.y << ")";
+
+    // Orca's own widgets are custom-drawn wxWindows that work off raw mouse
+    // events; wxButton and friends want the command event. Send both, in the
+    // order UIKit would.
+    wxMouseEvent down(wxEVT_LEFT_DOWN);
+    down.SetPosition(at);
+    down.SetEventObject(w);
+    w->GetEventHandler()->ProcessEvent(down);
+
+    wxMouseEvent up(wxEVT_LEFT_UP);
+    up.SetPosition(at);
+    up.SetEventObject(w);
+    w->GetEventHandler()->ProcessEvent(up);
+
+    wxCommandEvent cmd(wxEVT_BUTTON, w->GetId());
+    cmd.SetEventObject(w);
+    w->GetEventHandler()->ProcessEvent(cmd);
+}
+
+// Depth-first search for a shown window whose label matches, optionally
+// restricted to a class name.
+static wxWindow *orca_ios_find_by_label(wxWindow *root, const wxString &label,
+                                        const char *className)
+{
+    if (root == nullptr)
+        return nullptr;
+
+    if (root->IsShown() && root->GetLabel() == label &&
+        (className == nullptr ||
+         wxString(root->GetClassInfo()->GetClassName()) == wxString(className)))
+        return root;
+
+    const wxWindowList &children = root->GetChildren();
+    for (wxWindowList::const_iterator it = children.begin(); it != children.end(); ++it) {
+        if (wxWindow *found = orca_ios_find_by_label(*it, label, className))
+            return found;
+    }
+    return nullptr;
+}
+
+// Orca's drop-down control is Widgets/ComboBox.cpp: a custom wxWindow holding a
+// wxTextCtrl and owning a DropDown, which is a wxPopupTransientWindow. Neither
+// has its own wxRTTI, so the tree shows both as plain wxWindow - but a window
+// that owns a wxPopupTransientWindow child is a combo box and nothing else is.
+static wxWindow *orca_ios_find_combo(wxWindow *root)
+{
+    if (root == nullptr)
+        return nullptr;
+
+    const wxWindowList &children = root->GetChildren();
+    for (wxWindowList::const_iterator it = children.begin(); it != children.end(); ++it) {
+        if (wxDynamicCast(*it, wxPopupTransientWindow) != nullptr && root->IsShown())
+            return root;
+    }
+    for (wxWindowList::const_iterator it = children.begin(); it != children.end(); ++it) {
+        if (wxWindow *found = orca_ios_find_combo(*it))
+            return found;
+    }
+    return nullptr;
+}
+
+static wxWindow *orca_ios_topmost_shown()
+{
+    wxWindow *best = nullptr;
+    for (wxWindowList::const_iterator it = wxTopLevelWindows.begin();
+         it != wxTopLevelWindows.end(); ++it) {
+        if ((*it)->IsShown())
+            best = *it;
+    }
+    return best;
+}
+
+static void orca_ios_drive_step(int step)
+{
+    switch (step) {
+    case 0:
+        orca_ios_dump_all_windows("startup");
+        break;
+
+    case 1:
+        // The first-launch configuration wizard. Its Get Started button is what
+        // a user would press, and everything after it - printer, filament,
+        // process - is behind it.
+        orca_ios_click(orca_ios_find_by_label(orca_ios_topmost_shown(),
+                                              _L("Get Started"), nullptr),
+                       "wizard Get Started");
+        break;
+
+    case 2:
+        orca_ios_dump_all_windows("after wizard Get Started");
+        break;
+
+    case 3:
+        // Does a drop-down open? This is the one question a screenshot of a
+        // static app cannot answer.
+        orca_ios_click(orca_ios_find_combo(orca_ios_topmost_shown()), "first combo box");
+        break;
+
+    case 4:
+        orca_ios_dump_all_windows("after combo box click");
+        break;
+
+    default:
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-drive: walk finished";
+        break;
+    }
+}
+#endif // __WXOSX_IPHONE__
