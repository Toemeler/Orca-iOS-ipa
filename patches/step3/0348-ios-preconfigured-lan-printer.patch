+        this->Bind(wxEVT_TIMER, [this](wxTimerEvent &) {
+            ios_announce_preconfigured_printer(app_config, m_device_manager, false);
+        }, beacon->GetId());
+        beacon->Start(5000, wxTIMER_CONTINUOUS);
+    }
+#endif
