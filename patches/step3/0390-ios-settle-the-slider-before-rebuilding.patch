+#ifdef __WXOSX_IPHONE__
+// Has the slider stopped moving?
+//
+// Handing a new range to the G-code viewer is not a cheap redraw: libvgcode
+// walks every vertex to rebuild its enabled-segment, colour and
+// height/width/angle arrays and re-uploads them. At 1.6 million vertices that
+// measured at about 775 ms, and it was being done once per drag step, from
+// inside _render_gcode() - which is inside render(). The numbers were
+// unambiguous about where the time went:
+//
+//   render +6  render_ms 4672  gcode_ms 4657  swap_ms 0  worst_ms 793
+//
+// gcode_ms is the whole frame and swap_ms is nothing, so the GPU was taking
+// frames instantly and the cost was CPU work inside the viewer. Throttling
+// cannot fix a 775 ms unit of work - even one per second leaves the app
+// unusable - so the rebuild has to not happen until the value stops changing.
+//
+// Which is what this does: report settled once the range has held still for
+// 250 ms. During a drag the slider still moves and still draws, at the ~39 ms
+// per frame the scene costs on its own; the toolpaths catch up a quarter of a
+// second after the user lets go. Two independent slots because the layer and
+// moves sliders settle separately.
+static bool orca_ios_slider_settled(int slot, double low, double high)
+{
+    struct Slot {
+        double low  = std::numeric_limits<double>::quiet_NaN();
+        double high = std::numeric_limits<double>::quiet_NaN();
+        std::chrono::steady_clock::time_point since;
+        bool applied = false;
+    };
+    static Slot slots[2];
+    Slot &s = slots[slot == 0 ? 0 : 1];
+
+    const auto now = std::chrono::steady_clock::now();
+    if (!(low == s.low) || !(high == s.high)) {
+        s.low     = low;
+        s.high    = high;
+        s.since   = now;
+        s.applied = false;
+        return false;
+    }
+    if (s.applied)
+        return true;   // unchanged and already applied: nothing to defer
+    if (now - s.since < std::chrono::milliseconds(250))
+        return false;
+    s.applied = true;
+    return true;
+}
+#endif // __WXOSX_IPHONE__
