 // Re-applied rather than set once: the window's bounds change on rotation, and
 // wx sets this view's frame itself whenever the frame resizes, so the inset has
 // to be put back afterwards.
+// Light and dark. Orca reads the system on demand through GUI_App::dark_mode(),
+// so nothing has to be stored here - the windows just have to be told to ask
+// again and repaint.
+- (void)traitCollectionDidChange:(UITraitCollection *)previous
+{
+    [super traitCollectionDidChange:previous];
+    if (previous != nil &&
+        previous.userInterfaceStyle == self.traitCollection.userInterfaceStyle)
+        return;
+    Slic3r::GUI::orca_ios_appearance_changed();
+}
