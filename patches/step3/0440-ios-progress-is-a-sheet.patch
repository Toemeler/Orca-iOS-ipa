+#ifdef __WXOSX_IPHONE__
+void ProgressDialog::orca_ios_cancel()
+{
+    // Deliberately the body of OnCancel(wxCommandEvent&) and not a call to it:
+    // that overload takes an event it would have to invent, and its Finished
+    // branch skips the event on to the default handler, which is the one thing
+    // a sheet's button has no way to do.
+    if (m_state == Finished)
+        return;
+
+    m_state = Canceled;
+    DisableAbort();
+    DisableSkip();
+    OnCancel();
+
+    m_timeStop = wxGetCurrentTime();
+}
