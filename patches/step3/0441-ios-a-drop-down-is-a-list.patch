diff --git a/src/slic3r/GUI/ios_native_picker.mm b/src/slic3r/GUI/ios_native_picker.mm
new file mode 100644
index 000000000..b694d30c2
--- /dev/null
+++ b/src/slic3r/GUI/ios_native_picker.mm
@@ -0,0 +1,747 @@
+///|/ Copyright (c) 2026 Orca-iOS-ipa contributors
+///|/
+///|/ Orca-iOS-ipa is released under the terms of the AGPLv3 or higher
+///|/
+// Every drop-down in this application, as the list this platform draws.
+//
+// WHAT A DROP-DOWN IS IN ORCA.
+//
+// Widgets/DropDown.cpp is a wxPopupTransientWindow that paints its own rows
+// with a wxDC: a bitmap, a label, a check mark on the selected one, a hover
+// highlight, and a hand-rolled scroll. Every preset selector in the sidebar is
+// one, as is every choice field in the parameter pages, the filament pickers,
+// the printer list and the machine settings. It is a good desktop control and
+// none of it survives contact with a tablet:
+//
+//  * THE HOVER STATE IS THE ONLY FEEDBACK IT HAS. A finger has no hover, so
+//    rows highlighted nothing and the list read as inert.
+//  * IT IS A TRANSIENT POPUP. wxPopupTransientWindow dismisses itself when it
+//    loses "focus", a notion iOS does not have, and its rows are 22 px high
+//    against a 44 pt minimum target.
+//  * A FILAMENT LIST IS TWO HUNDRED ROWS LONG and there is no way to search it.
+//
+// WHAT IT IS HERE.
+//
+// A UITableView in a popover, anchored to the control that opened it - which
+// is what a picker looks like on iPadOS - with the groups as sections, the
+// current value check-marked, and a search field as soon as the list is long
+// enough to need one. On a narrow window UIKit adapts the popover into a sheet
+// by itself, and the whole thing is one presentation either way.
+//
+// The DropDown remains the model. This file shows what it has, and reports the
+// chosen row back as exactly the wxEVT_COMBOBOX the wx path would have sent -
+// so ComboBox, and everything bound to ComboBox, is untouched.
+
+#import <UIKit/UIKit.h>
+
+#include "libslic3r/libslic3r.h"
+
+#include <wx/osx/core/cfstring.h>
+#include <wx/thread.h>
+#include <wx/translation.h>
+#include <wx/window.h>
+
+#include <boost/log/trivial.hpp>
+
+#include <vector>
+
+#include "ios_native_ui.hpp"
+
+namespace Slic3r {
+namespace GUI {
+// ios_native_ui.mm
+UIViewController *orca_ios_top_presenter();
+} // namespace GUI
+} // namespace Slic3r
+
+// One row as UIKit sees it: the label, whether it can be chosen, and the index
+// in the DropDown's own vector - which is what the wx event carries and is not
+// the row number, because the sections reorder nothing but the search filters.
+@interface OrcaPickerRow : NSObject
+@property (nonatomic, copy)   NSString *text;
+@property (nonatomic, copy)   NSString *group;
+@property (nonatomic, assign) NSInteger index;
+@property (nonatomic, assign) BOOL      enabled;
+@end
+
+@implementation OrcaPickerRow
+- (void)dealloc
+{
+    [_text release];
+    [_group release];
+    [super dealloc];
+}
+@end
+
+@interface OrcaPickerController : UITableViewController <UISearchResultsUpdating,
+                                                         UIPopoverPresentationControllerDelegate,
+                                                         UIAdaptivePresentationControllerDelegate>
+@property (nonatomic, retain) NSArray<OrcaPickerRow *>    *rows;       // everything
+@property (nonatomic, retain) NSArray<NSString *>         *sections;   // titles, in order
+@property (nonatomic, retain) NSArray<NSArray<OrcaPickerRow *> *> *visible;  // after filtering
+@property (nonatomic, assign) NSInteger                    selectedIndex;
+@property (nonatomic, copy)   void (^onPick)(NSInteger);
+@property (nonatomic, copy)   void (^onDismiss)(void);
+@property (nonatomic, assign) BOOL                         picked;
+// Multiple choice: a checkmark per row rather than one, a Select All in the
+// toolbar and a Done that hands back the whole set. Same table either way, so
+// a long list is searchable in both.
+@property (nonatomic, assign) BOOL                         multi;
+@property (nonatomic, retain) NSMutableSet<NSNumber *>    *chosen;
+@property (nonatomic, copy)   void (^onDone)(NSArray<NSNumber *> *);
+// EXACTLY ONE of onPick/onDismiss runs, ever. A caller is entitled to wait on
+// this list - SingleChoiceDialog runs a nested modal loop around it - and a
+// list that went away having called neither would be a hang.
+@property (nonatomic, assign) BOOL                         notified;
+- (void)rebuildSections:(NSString *)filter;
+- (void)notifyPicked:(NSInteger)index;
+- (void)notifyDone;
+- (void)notifyDismissed;
+@end
+
+@implementation OrcaPickerController
+
+- (instancetype)init
+{
+    // Inset grouped is the modern list, and it is what a picker anchored in a
+    // popover looks like everywhere else on the system.
+    self = [super initWithStyle:UITableViewStyleInsetGrouped];
+    return self;
+}
+
+- (void)dealloc
+{
+    [_rows release];
+    [_sections release];
+    [_visible release];
+    [_onPick release];
+    [_onDone release];
+    [_onDismiss release];
+    [_chosen release];
+    [super dealloc];
+}
+
+- (void)viewDidLoad
+{
+    [super viewDidLoad];
+    self.tableView.rowHeight = UITableViewAutomaticDimension;
+    self.tableView.estimatedRowHeight = 46;
+    self.tableView.keyboardDismissMode = UIScrollViewKeyboardDismissModeOnDrag;
+}
+
+- (void)viewDidAppear:(BOOL)animated
+{
+    [super viewDidAppear:animated];
+
+    // Straight to the current value. A two hundred row filament list that opens
+    // at the top is a list the user has to find their own filament in.
+    for (NSUInteger s = 0; s < self.visible.count; ++s) {
+        NSArray<OrcaPickerRow *> *const section = [self.visible objectAtIndex:s];
+        for (NSUInteger r = 0; r < section.count; ++r) {
+            if ([section objectAtIndex:r].index != self.selectedIndex)
+                continue;
+            [self.tableView
+                scrollToRowAtIndexPath:[NSIndexPath indexPathForRow:(NSInteger) r
+                                                          inSection:(NSInteger) s]
+                      atScrollPosition:UITableViewScrollPositionMiddle
+                              animated:NO];
+            return;
+        }
+    }
+}
+
+// The sections, filtered. Groups keep the order the DropDown had them in -
+// they are meaningful (vendor, then material) and sorting them would be this
+// file deciding something it has no business deciding.
+- (void)rebuildSections:(NSString *)filter
+{
+    // Untyped on purpose: the property is NSArray<NSArray<…> *> and these are
+    // mutable, and clang's lightweight generics treat NSMutableArray<X> and
+    // NSArray<X> as unrelated parameters rather than as one being the other's
+    // subclass.
+    NSMutableArray *const titles = [NSMutableArray array];
+    NSMutableArray *const groups = [NSMutableArray array];
+
+    for (OrcaPickerRow *const row in self.rows) {
+        if (filter.length > 0 &&
+            [row.text rangeOfString:filter
+                            options:NSCaseInsensitiveSearch | NSDiacriticInsensitiveSearch]
+                    .location == NSNotFound)
+            continue;
+
+        NSString *const title = row.group != nil ? row.group : @"";
+        NSUInteger at = [titles indexOfObject:title];
+        if (at == NSNotFound) {
+            [titles addObject:title];
+            [groups addObject:[NSMutableArray array]];
+            at = titles.count - 1;
+        }
+        NSMutableArray *const bucket = [groups objectAtIndex:at];
+        [bucket addObject:row];
+    }
+
+    self.sections = titles;
+    self.visible  = groups;
+    [self.tableView reloadData];
+}
+
+- (NSInteger)numberOfSectionsInTableView:(UITableView *)tableView
+{
+    (void) tableView;
+    return (NSInteger) self.visible.count;
+}
+
+- (NSInteger)tableView:(UITableView *)tableView numberOfRowsInSection:(NSInteger)section
+{
+    (void) tableView;
+    return (NSInteger) [self.visible objectAtIndex:(NSUInteger) section].count;
+}
+
+- (NSString *)tableView:(UITableView *)tableView titleForHeaderInSection:(NSInteger)section
+{
+    (void) tableView;
+    NSString *const title = [self.sections objectAtIndex:(NSUInteger) section];
+    return title.length > 0 ? title : nil;
+}
+
+- (UITableViewCell *)tableView:(UITableView *)tableView
+         cellForRowAtIndexPath:(NSIndexPath *)indexPath
+{
+    static NSString *const kReuse = @"orca.picker.row";
+    UITableViewCell *cell = [tableView dequeueReusableCellWithIdentifier:kReuse];
+    if (cell == nil)
+        cell = [[[UITableViewCell alloc] initWithStyle:UITableViewCellStyleDefault
+                                       reuseIdentifier:kReuse] autorelease];
+
+    OrcaPickerRow *const row =
+        [[self.visible objectAtIndex:(NSUInteger) indexPath.section]
+            objectAtIndex:(NSUInteger) indexPath.row];
+
+    UIListContentConfiguration *content = [cell defaultContentConfiguration];
+    content.text = row.text;
+    content.textProperties.numberOfLines = 2;
+    content.textProperties.color = row.enabled ? [UIColor labelColor]
+                                               : [UIColor tertiaryLabelColor];
+    cell.contentConfiguration = content;
+
+    const BOOL ticked = self.multi
+                            ? [self.chosen containsObject:[NSNumber numberWithInteger:row.index]]
+                            : row.index == self.selectedIndex;
+    cell.accessoryType = ticked ? UITableViewCellAccessoryCheckmark
+                                : UITableViewCellAccessoryNone;
+    cell.selectionStyle = row.enabled ? UITableViewCellSelectionStyleDefault
+                                      : UITableViewCellSelectionStyleNone;
+    cell.userInteractionEnabled = row.enabled;
+    return cell;
+}
+
+- (void)tableView:(UITableView *)tableView didSelectRowAtIndexPath:(NSIndexPath *)indexPath
+{
+    [tableView deselectRowAtIndexPath:indexPath animated:YES];
+
+    OrcaPickerRow *const row =
+        [[self.visible objectAtIndex:(NSUInteger) indexPath.section]
+            objectAtIndex:(NSUInteger) indexPath.row];
+    if (!row.enabled || self.picked)
+        return;
+
+    // A multiple choice toggles and stays: the list is only over when Done is
+    // pressed, which is what makes it a multiple choice at all.
+    if (self.multi) {
+        NSNumber *const key = [NSNumber numberWithInteger:row.index];
+        if ([self.chosen containsObject:key])
+            [self.chosen removeObject:key];
+        else
+            [self.chosen addObject:key];
+        [tableView reloadRowsAtIndexPaths:@[ indexPath ]
+                         withRowAnimation:UITableViewRowAnimationNone];
+        return;
+    }
+
+    self.picked = YES;
+    const NSInteger chosen = row.index;
+
+    // The row is delivered after the dismissal, for the reason every other
+    // presentation in this port defers its handler: choosing a preset can put
+    // a dialog up ("keep the modified settings?"), and presenting one from a
+    // controller in mid-dismissal is the "already presenting" exception.
+    [self dismissViewControllerAnimated:YES completion:^{
+        [self notifyPicked:chosen];
+    }];
+}
+
+- (void)updateSearchResultsForSearchController:(UISearchController *)searchController
+{
+    [self rebuildSections:searchController.searchBar.text];
+}
+
+// A popover that adapts to a sheet on a narrow window is still this picker;
+// without this UIKit would take it full screen with no way back.
+- (UIModalPresentationStyle)adaptivePresentationStyleForPresentationController:
+    (UIPresentationController *)controller
+                                                              traitCollection:
+    (UITraitCollection *)traitCollection
+{
+    (void) controller;
+    (void) traitCollection;
+    return UIModalPresentationNone;
+}
+
+// THE BLOCKS ARE DROPPED HERE, AND THIS IS THE ONLY PLACE THEY ARE.
+//
+// Both of them name the navigation controller, which owns this controller as
+// its root - so a copied block held in a property of this object is a retain
+// cycle, and one drop-down's worth of controllers would be leaked every time a
+// list was opened. Clearing them once the list has ended breaks it, and
+// `notified` is what makes that happen exactly once however the list ended.
+- (void)notifyPicked:(NSInteger)index
+{
+    if (self.notified)
+        return;
+    self.notified = YES;
+
+    void (^pick)(NSInteger) = [[self.onPick copy] autorelease];
+    self.onPick    = nil;
+    self.onDismiss = nil;
+
+    if (pick != nil)
+        pick(index);
+}
+
+// Done, in multiple choice. The set is sorted because the caller writes it
+// straight into a config list, and an order that changed with every tap would
+// make an unchanged selection look like an edit.
+- (void)notifyDone
+{
+    if (self.notified)
+        return;
+    self.notified = YES;
+
+    void (^done)(NSArray<NSNumber *> *) = [[self.onDone copy] autorelease];
+    self.onPick    = nil;
+    self.onDone    = nil;
+    self.onDismiss = nil;
+
+    if (done != nil) {
+        NSArray<NSNumber *> *const sorted =
+            [[self.chosen allObjects] sortedArrayUsingSelector:@selector(compare:)];
+        done(sorted);
+    }
+}
+
+- (void)notifyDismissed
+{
+    if (self.notified)
+        return;
+    self.notified = YES;
+
+    void (^dismissed)(void) = [[self.onDismiss copy] autorelease];
+    self.onPick    = nil;
+    self.onDone    = nil;
+    self.onDismiss = nil;
+
+    if (dismissed != nil)
+        dismissed();
+}
+
+- (void)presentationControllerDidDismiss:(UIPresentationController *)presentationController
+{
+    (void) presentationController;
+    // Dismissed by tapping outside it: nothing was chosen, and the caller
+    // still has to be told - the ComboBox closes its own state on EVT_DISMISS,
+    // and SingleChoiceDialog is asleep in a modal loop waiting for this.
+    if (self.picked)
+        return;
+    [self notifyDismissed];
+}
+
+- (void)doneTapped:(id)sender
+{
+    (void) sender;
+    const BOOL multi = self.multi;
+    [self dismissViewControllerAnimated:YES completion:^{
+        // Done confirms a multiple choice and merely closes a single one -
+        // there the row itself was the answer, and Done is only the way out.
+        if (multi)
+            [self notifyDone];
+        else
+            [self notifyDismissed];
+    }];
+}
+
+- (void)cancelTapped:(id)sender
+{
+    (void) sender;
+    [self dismissViewControllerAnimated:YES completion:^{
+        [self notifyDismissed];
+    }];
+}
+
+// Everything the search is currently showing, which is what Select All means
+// in a filtered list - CheckList::SelectVisible() takes the same view.
+- (void)selectAllTapped:(id)sender
+{
+    (void) sender;
+
+    NSMutableArray<NSNumber *> *const shown = [NSMutableArray array];
+    for (NSArray<OrcaPickerRow *> *const section in self.visible) {
+        for (OrcaPickerRow *const row in section) {
+            if (row.enabled)
+                [shown addObject:[NSNumber numberWithInteger:row.index]];
+        }
+    }
+
+    // Off if everything shown is already on, otherwise on: one button, and it
+    // does whichever of the two is not already true.
+    BOOL all_on = shown.count > 0;
+    for (NSNumber *const key in shown) {
+        if (![self.chosen containsObject:key]) {
+            all_on = NO;
+            break;
+        }
+    }
+
+    for (NSNumber *const key in shown) {
+        if (all_on)
+            [self.chosen removeObject:key];
+        else
+            [self.chosen addObject:key];
+    }
+    [self.tableView reloadData];
+}
+
+@end
+
+namespace Slic3r {
+namespace GUI {
+
+// The picker that is up, and the control it belongs to. One at a time: a
+// drop-down is a modal choice, and two of them on screen would be two answers
+// to a question that has one.
+static UIViewController *gs_picker       = nil;   // retained
+static wxWindow         *gs_picker_owner = nullptr;
+
+// Defined below; the watchdog calls it when the list has gone without saying so.
+static void orca_ios_picker_drop(UIViewController *nav);
+
+// The watchdog. See where it is armed, at the end of the presenter, for why.
+static void orca_ios_picker_watch(UIViewController *nav, OrcaPickerController *picker,
+                                  int misses)
+{
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t) (0.75 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+        if (picker.notified)
+            return;
+        const bool gone = nav.presentingViewController == nil;
+        if (gone && misses >= 1) {
+            BOOST_LOG_TRIVIAL(error) << "orca-ios-picker: gone with no row chosen; "
+                                        "reporting it as a dismissal";
+            orca_ios_picker_drop(nav);
+            [picker notifyDismissed];
+            return;
+        }
+        orca_ios_picker_watch(nav, picker, gone ? misses + 1 : 0);
+    });
+}
+
+// Long enough to need a search field. Twelve is about a screen of rows on the
+// shortest window this application runs in, so anything longer is a list the
+// user would otherwise have to scroll blind.
+static const size_t kOrcaPickerSearchFrom = 12;
+
+// The one that is up, if it is this one. Everything that ends a list goes
+// through here, and the identity check is what stops a list ending late - a
+// watchdog for one the user has already left, a callback dispatched a turn ago
+// - from taking down the list that has since replaced it.
+static void orca_ios_picker_drop(UIViewController *nav)
+{
+    if (gs_picker == nil)
+        return;
+    if (nav != nil && gs_picker != nav)
+        return;
+
+    UIViewController *const vc = gs_picker;
+    gs_picker       = nil;
+    gs_picker_owner = nullptr;
+
+    if (vc.presentingViewController != nil)
+        [vc dismissViewControllerAnimated:YES completion:nil];
+    [vc release];
+}
+
+void orca_ios_picker_dismiss(wxWindow *owner)
+{
+    if (!wxThread::IsMain())
+        return;
+    if (gs_picker == nil)
+        return;
+    // A named owner only takes down its own list; a null one takes down
+    // whatever is up, which is what a new presentation wants.
+    if (owner != nullptr && gs_picker_owner != owner)
+        return;
+
+    orca_ios_picker_drop(nil);
+}
+
+bool orca_ios_picker_present(wxWindow                         *owner,
+                             wxWindow                         *anchor,
+                             const wxString                   &title,
+                             const std::vector<IOSPickerItem> &items,
+                             int                               selected,
+                             std::function<void(int)>          on_pick,
+                             std::function<void()>             on_dismiss)
+{
+    if (!wxThread::IsMain() || items.empty())
+        return false;
+
+    UIViewController *const presenter = orca_ios_top_presenter();
+    if (presenter == nil || presenter.view.window == nil) {
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-picker: no controller to present from";
+        return false;
+    }
+
+    UIView *anchor_view = anchor != nullptr ? (UIView *) anchor->GetHandle() : nil;
+    // An anchor in another window is not an anchor: UIKit wants the source
+    // view to be inside the presenting hierarchy, and a wx control that has
+    // not been realised has no view at all.
+    if (anchor_view != nil && anchor_view.window != presenter.view.window)
+        anchor_view = nil;
+
+    // Anything already up belongs to a question that has been abandoned.
+    orca_ios_picker_dismiss(nullptr);
+
+    OrcaPickerController *const picker = [[OrcaPickerController alloc] init];
+
+    NSMutableArray<OrcaPickerRow *> *const rows =
+        [NSMutableArray arrayWithCapacity:items.size()];
+    for (size_t i = 0; i < items.size(); ++i) {
+        const IOSPickerItem &item = items[i];
+        OrcaPickerRow *const row  = [[[OrcaPickerRow alloc] init] autorelease];
+        row.text    = wxCFStringRef(item.text).AsNSString();
+        row.group   = item.group.IsEmpty() ? nil : wxCFStringRef(item.group).AsNSString();
+        row.index   = (NSInteger) item.index;
+        row.enabled = item.enabled ? YES : NO;
+        [rows addObject:row];
+    }
+
+    picker.rows          = rows;
+    picker.selectedIndex = selected;
+    picker.title         = title.IsEmpty() ? nil : wxCFStringRef(title).AsNSString();
+
+    [picker rebuildSections:nil];
+
+    UINavigationController *const nav =
+        [[[UINavigationController alloc] initWithRootViewController:picker] autorelease];
+
+    // THE CALLBACKS ARE SET AFTER THE NAVIGATION CONTROLLER EXISTS, because
+    // they name it: each one takes the list down only if the list still up is
+    // this one. A callback dispatched a turn ago, or a watchdog for a list the
+    // user has already left, must not dismiss whatever has since replaced it.
+    std::function<void(int)> pick_cb    = on_pick;
+    std::function<void()>    dismiss_cb = on_dismiss;
+
+    picker.onPick = ^(NSInteger index) {
+        // The list is off screen by the time this runs; drop the reference
+        // before the callback, which is entitled to open another one.
+        orca_ios_picker_drop(nav);
+        if (pick_cb)
+            pick_cb((int) index);
+    };
+    picker.onDismiss = ^{
+        orca_ios_picker_drop(nav);
+        if (dismiss_cb)
+            dismiss_cb();
+    };
+
+    picker.navigationItem.rightBarButtonItem =
+        [[[UIBarButtonItem alloc] initWithBarButtonSystemItem:UIBarButtonSystemItemDone
+                                                       target:picker
+                                                       action:@selector(doneTapped:)] autorelease];
+
+    if (items.size() >= kOrcaPickerSearchFrom) {
+        UISearchController *const search =
+            [[[UISearchController alloc] initWithSearchResultsController:nil] autorelease];
+        search.searchResultsUpdater             = picker;
+        search.obscuresBackgroundDuringPresentation = NO;
+        search.searchBar.placeholder            = wxCFStringRef(wxGetTranslation("Search")).AsNSString();
+        picker.navigationItem.searchController  = search;
+        picker.navigationItem.hidesSearchBarWhenScrolling = NO;
+        picker.definesPresentationContext       = YES;
+    }
+
+    // Tall enough to be worth scrolling, short enough to stay a popover.
+    const CGFloat rows_high = MIN((CGFloat) items.size(), 9.0) * 46 + 56;
+    nav.preferredContentSize = CGSizeMake(360, MAX(200.0, rows_high));
+
+    nav.modalPresentationStyle = anchor_view != nil ? UIModalPresentationPopover
+                                                    : UIModalPresentationFormSheet;
+    nav.presentationController.delegate = picker;
+    if (UIPopoverPresentationController *const pop = nav.popoverPresentationController) {
+        pop.sourceView             = anchor_view;
+        pop.sourceRect             = anchor_view.bounds;
+        pop.permittedArrowDirections = UIPopoverArrowDirectionAny;
+        pop.delegate               = picker;
+    }
+
+    @try {
+        [presenter presentViewController:nav animated:YES completion:nil];
+    }
+    @catch (NSException *e) {
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-picker: presentation THREW "
+                                 << [[e name] UTF8String] << ": " << [[e reason] UTF8String];
+        [picker release];
+        return false;
+    }
+
+    // The navigation controller owns the picker now; this reference is the
+    // one orca_ios_picker_dismiss() spends.
+    gs_picker       = [nav retain];
+    gs_picker_owner = owner;
+
+    // THE WATCHDOG, and the reason a list needs one.
+    //
+    // Three of the four ways this can end tell the caller themselves: a row,
+    // the Done button, a tap outside. The fourth is the presenting controller
+    // being torn down underneath it - the window changing, the application
+    // being taken down - and nothing reports that. A caller waiting in a
+    // nested modal loop would then wait for ever, which is the whole
+    // application stopped. Two consecutive misses, so that the gap between
+    // -present… and the presentation taking effect is not read as one.
+    orca_ios_picker_watch(nav, picker, 0);
+
+    [picker release];
+
+    BOOST_LOG_TRIVIAL(error) << "orca-ios-picker: " << items.size() << " row(s), "
+                             << (anchor_view != nil ? "popover" : "sheet");
+    return true;
+}
+
+bool orca_ios_multi_picker_present(wxWindow                         *owner,
+                                   const wxString                   &title,
+                                   const std::vector<IOSPickerItem> &items,
+                                   const std::vector<int>           &selected,
+                                   std::function<void(const std::vector<int> &)> on_done,
+                                   std::function<void()>             on_cancel)
+{
+    if (!wxThread::IsMain() || items.empty())
+        return false;
+
+    UIViewController *const presenter = orca_ios_top_presenter();
+    if (presenter == nil || presenter.view.window == nil) {
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-picker: no controller to present a multiple "
+                                    "choice from";
+        return false;
+    }
+
+    orca_ios_picker_dismiss(nullptr);
+
+    OrcaPickerController *const picker = [[OrcaPickerController alloc] init];
+    picker.multi  = YES;
+    picker.chosen = [NSMutableSet set];
+    for (const int index : selected)
+        [picker.chosen addObject:[NSNumber numberWithInteger:(NSInteger) index]];
+
+    NSMutableArray<OrcaPickerRow *> *const rows =
+        [NSMutableArray arrayWithCapacity:items.size()];
+    for (size_t i = 0; i < items.size(); ++i) {
+        const IOSPickerItem &item = items[i];
+        OrcaPickerRow *const row  = [[[OrcaPickerRow alloc] init] autorelease];
+        row.text    = wxCFStringRef(item.text).AsNSString();
+        row.group   = item.group.IsEmpty() ? nil : wxCFStringRef(item.group).AsNSString();
+        row.index   = (NSInteger) item.index;
+        row.enabled = item.enabled ? YES : NO;
+        [rows addObject:row];
+    }
+
+    picker.rows          = rows;
+    picker.selectedIndex = -1;      // no single selection to scroll to
+    picker.title         = title.IsEmpty() ? nil : wxCFStringRef(title).AsNSString();
+
+    [picker rebuildSections:nil];
+
+    UINavigationController *const nav =
+        [[[UINavigationController alloc] initWithRootViewController:picker] autorelease];
+
+    std::function<void(const std::vector<int> &)> done_cb   = on_done;
+    std::function<void()>                         cancel_cb = on_cancel;
+
+    picker.onDone = ^(NSArray<NSNumber *> *chosen) {
+        orca_ios_picker_drop(nav);
+        if (done_cb) {
+            std::vector<int> out;
+            out.reserve((size_t) chosen.count);
+            for (NSNumber *const n in chosen)
+                out.push_back((int) [n integerValue]);
+            done_cb(out);
+        }
+    };
+    picker.onDismiss = ^{
+        orca_ios_picker_drop(nav);
+        if (cancel_cb)
+            cancel_cb();
+    };
+
+    picker.navigationItem.leftBarButtonItem =
+        [[[UIBarButtonItem alloc] initWithBarButtonSystemItem:UIBarButtonSystemItemCancel
+                                                       target:picker
+                                                       action:@selector(cancelTapped:)] autorelease];
+    picker.navigationItem.rightBarButtonItem =
+        [[[UIBarButtonItem alloc] initWithBarButtonSystemItem:UIBarButtonSystemItemDone
+                                                       target:picker
+                                                       action:@selector(doneTapped:)] autorelease];
+
+    // Select All in a bottom toolbar, which is where Photos and Files put it
+    // and therefore where a hand already expects to find it.
+    UIBarButtonItem *const flex =
+        [[[UIBarButtonItem alloc] initWithBarButtonSystemItem:UIBarButtonSystemItemFlexibleSpace
+                                                       target:nil
+                                                       action:nil] autorelease];
+    UIBarButtonItem *const select_all =
+        [[[UIBarButtonItem alloc]
+             initWithTitle:wxCFStringRef(wxGetTranslation("Select all")).AsNSString()
+                     style:UIBarButtonItemStylePlain
+                    target:picker
+                    action:@selector(selectAllTapped:)] autorelease];
+    picker.toolbarItems = @[ flex, select_all, flex ];
+    nav.toolbarHidden   = NO;
+
+    if (items.size() >= kOrcaPickerSearchFrom) {
+        UISearchController *const search =
+            [[[UISearchController alloc] initWithSearchResultsController:nil] autorelease];
+        search.searchResultsUpdater                 = picker;
+        search.obscuresBackgroundDuringPresentation = NO;
+        search.searchBar.placeholder = wxCFStringRef(wxGetTranslation("Search")).AsNSString();
+        picker.navigationItem.searchController            = search;
+        picker.navigationItem.hidesSearchBarWhenScrolling = NO;
+        picker.definesPresentationContext                 = YES;
+    }
+
+    // A sheet rather than a popover: a multiple choice is a task the user
+    // stays in for a while, and it has no one control it belongs to.
+    nav.modalPresentationStyle          = UIModalPresentationFormSheet;
+    nav.modalInPresentation             = YES;   // Cancel or Done, not a swipe
+    nav.presentationController.delegate = picker;
+    nav.preferredContentSize            = CGSizeMake(420, 560);
+
+    @try {
+        [presenter presentViewController:nav animated:YES completion:nil];
+    }
+    @catch (NSException *e) {
+        BOOST_LOG_TRIVIAL(error) << "orca-ios-picker: multiple choice presentation THREW "
+                                 << [[e name] UTF8String] << ": " << [[e reason] UTF8String];
+        [picker release];
+        return false;
+    }
+
+    gs_picker       = [nav retain];
+    gs_picker_owner = owner;
+    orca_ios_picker_watch(nav, picker, 0);
+    [picker release];
+
+    BOOST_LOG_TRIVIAL(error) << "orca-ios-picker: multiple choice, " << items.size()
+                             << " row(s), " << selected.size() << " ticked";
+    return true;
+}
