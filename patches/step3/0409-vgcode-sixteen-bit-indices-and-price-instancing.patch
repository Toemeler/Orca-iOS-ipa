diff --git a/src/libvgcode/src/ShadersES.hpp b/src/libvgcode/src/ShadersES.hpp
index 49770a6f3..35ae9fc9d 100644
--- a/src/libvgcode/src/ShadersES.hpp
+++ b/src/libvgcode/src/ShadersES.hpp
@@ -258,6 +258,28 @@ static const char* Segments_Bench_Vertex_Shader_ES =
 "  gl_Position = vec4(x + corner.x, y + corner.y, 0.0, 1.0);\n"
 "}\n";
 
+// The same control, drawn flat: no instancing, no index buffer, no vertex
+// attributes - 24 * N vertices from one glDrawArrays, with the segment and the
+// corner derived from gl_VertexID. Against benchnull (the instanced control) it
+// prices instancing itself, which benchnull says is 88% of the toolpath frame.
+//
+// If this is much faster, the fix is to draw the toolpath this way: 24
+// invocations per segment instead of 8, but no per-instance cost, and the same
+// pixels. If it is not, the cost is per-vertex dispatch and neither shape wins.
+static const char* Segments_Bench_Flat_Vertex_Shader_ES =
+"#version 300 es\n"
+"precision highp float;\n"
+"out mediump vec3 color;\n"
+"void main() {\n"
+"  int seg = gl_VertexID / 24;\n"
+"  int corner = gl_VertexID - seg * 24;\n"
+"  float x = float(seg & 255) * (2.0 / 255.0) - 1.0;\n"
+"  float y = float((seg >> 8) & 255) * (2.0 / 255.0) - 1.0;\n"
+"  vec2 c = vec2(float(corner & 1), float((corner >> 1) & 1)) * 0.01;\n"
+"  color = vec3(0.5);\n"
+"  gl_Position = vec4(x + c.x, y + c.y, 0.0, 1.0);\n"
+"}\n";
+
 static const char* Segments_Fragment_Shader_ES =
 "#version 300 es\n"
 "precision highp float;\n"
