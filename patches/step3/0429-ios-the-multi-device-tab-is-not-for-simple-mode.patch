 // SoftFever
+// Add or remove the Multi-device tab for the mode now in force.
+//
+// The page goes in at tpMultiDevice, an index that is only right once the
+// three pages before it are in the notebook - that is what the Monitor check
+// stands for. When they are not there, either init_tabpanel() or show_device()
+// is about to build the whole set, and both carry the same condition.
+void MainFrame::orca_update_multi_device_tab()
+{
+    if (m_tabpanel == nullptr)
+        return;
+    const bool want = wxGetApp().is_enable_multi_machine() && wxGetApp().get_mode() != comSimple;
+    const int  idx  = m_multi_machine == nullptr ? wxNOT_FOUND : m_tabpanel->FindPage(m_multi_machine);
+    if (want == (idx != wxNOT_FOUND))
+        return;
+    if (want) {
+        if (m_monitor == nullptr || m_tabpanel->FindPage(m_monitor) == wxNOT_FOUND)
+            return;
+        if (m_multi_machine == nullptr) {
+            m_multi_machine = new MultiMachinePage(m_tabpanel, wxID_ANY, wxDefaultPosition, wxDefaultSize);
+            m_multi_machine->SetBackgroundColour(*wxWHITE);
+        }
+        m_multi_machine->Show(false);
+        m_tabpanel->InsertPage(tpMultiDevice, m_multi_machine, _L("Multi-device"),
+                               std::string("tab_multi_active"), std::string("tab_multi_active"), false);
+    } else {
+        // Removing the selected page takes the notebook with it, so step off
+        // it first.
+        if (m_tabpanel->GetSelection() == idx)
+            select_tab(size_t(tp3DEditor));
+        m_multi_machine->Show(false);
+        m_tabpanel->RemovePage(idx);
+    }
+}
