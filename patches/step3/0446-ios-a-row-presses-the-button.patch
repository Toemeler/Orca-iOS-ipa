+// Presses a button the way a finger does, and not the way an event does.
+//
+// A TAP IS A MOUSE DOWN AND A MOUSE UP, and sending only wxEVT_BUTTON is not
+// the same thing. Orca's Button binds EVT_LEFT_DOWN/EVT_LEFT_UP in its event
+// table and sends wxEVT_BUTTON itself from mouseReleased(), so the pair
+// produces the command event for everything bound the ordinary way - but this
+// GUI binds wxEVT_LEFT_DOWN *directly* 220 times across 69 files, 19 of them in
+// MsgDialog.cpp and ReleaseNote.cpp alone, which are the two files the alerts
+// come out of. A button bound that way never sees a wxEVT_BUTTON at all:
+//
+//   m_button_confirm->Bind(wxEVT_LEFT_DOWN, [this](auto& e) { EndModal(wxCLOSE); });
+//
+// Every one of those was silently skipped. It did not show, because the alert
+// still returned the row's id and most such handlers do nothing but EndModal()
+// with that same id - so the dialog answered correctly while the work beside
+// the EndModal() never ran.
+//
+// Button::keyDownUp() already does exactly this for Space and Return: a bare
+// wxMouseEvent, which carries position (0,0) and so lands inside the button's
+// rect, which is what mouseReleased() checks before sending the command event.
+//
+// A wxButton is the exception and gets the command event instead: its peer is a
+// UIButton whose action comes from UIKit, so it does not turn wx mouse events
+// into anything at all. Everything else in this application that can be a row -
+// Orca's Button, which is a StaticBox and not a wxButton - takes the press.
+//
+// The test is written that way round on purpose. The command event is the
+// special case, for the two or three classes wx implements natively; a
+// simulated tap is the general one, and is what an unknown widget should get.
+static void orca_ios_press(wxWindow *widget)
+{
+    if (widget == nullptr)
+        return;
+
+    if (dynamic_cast<wxButton *>(widget) != nullptr) {
+        wxCommandEvent evt(wxEVT_BUTTON, widget->GetId());
+        evt.SetEventObject(widget);
+        widget->GetEventHandler()->ProcessEvent(evt);
+        return;
+    }
+
+    wxMouseEvent down(wxEVT_LEFT_DOWN);
+    down.SetEventObject(widget);
+    widget->GetEventHandler()->ProcessEvent(down);
+
+    wxMouseEvent up(wxEVT_LEFT_UP);
+    up.SetEventObject(widget);
+    widget->GetEventHandler()->ProcessEvent(up);
+}
+
