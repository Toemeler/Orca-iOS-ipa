+                     "hidden=%d frame=%.0f,%.0f %.0fx%.0f level=%.0f",
+                     show ? "SHOW" : "HIDE",
+                     clsName, label,
+                     style,
+                     (int) isPopup,
+                     (int) (m_macWindow == gs_mainWindow),
+                     (int) [m_macWindow isHidden],
+                     (double) frame.origin.x, (double) frame.origin.y,
+                     (double) frame.size.width, (double) frame.size.height,
