+// Present it, watch it, and wait for it - the three steps every alert in this
+// file takes, and the reason the text entry and the choice list below are a
+// dozen lines each rather than a copy of this one.
+//
+// THE PRESENTER'S WINDOW AND NOT THE DIALOG'S. wxMessageDialog never calls
+// wxDialog::Create() - wxMessageDialogBase only stores the message, the
+// caption and the style - so it has no native window at all and the wxWindow*
+// overload of wxModalEventLoop would be handed a null one. The loop uses the
+// window for nothing but its log line; it is the CFRunLoop underneath that
+// matters, and that is the same one either way.
+static int wxOSXIPhoneRunAlert(UIAlertController* alert, wxOSXAlertBox* box,
+                               UIViewController* presenter)
+{
+    @try
+    {
+        [presenter presentViewController:alert animated:YES completion:nil];
+    }
+    @catch ( NSException* e )
+    {
+        wxLogDebug("wx-ios: alert presentation threw %s",
+                   wxString([[e reason] UTF8String], wxConvUTF8));
+        return wxID_CANCEL;
+    }
+
+    wxOSXAlertWatch(alert, box, 0);
+
+    wxModalEventLoop modalLoop((WXWindow) presenter.view.window);
+    box->loop = &modalLoop;
+    modalLoop.Run();
+    box->loop = nullptr;
+
+    return box->code;
+}
+
+// A box in the state every caller wants it in.
+static wxOSXAlertBox* wxOSXIPhoneNewAlertBox()
+{
+    wxOSXAlertBox* const box = [[[wxOSXAlertBox alloc] init] autorelease];
+    box->loop       = nullptr;
+    box->code       = wxID_CANCEL;
+    box->cancelCode = wxID_CANCEL;
+    box->chosen     = NO;
+    box->finished   = NO;
+    return box;
+}
