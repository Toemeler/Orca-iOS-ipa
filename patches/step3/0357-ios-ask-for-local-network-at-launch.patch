+// Ask for local-network permission at launch, rather than whenever something
+// happens to touch the LAN first.
+//
+// iOS gates every local-network connection behind a one-time prompt. Nothing in
+// the app raises it deliberately, so it appeared at some arbitrary later moment
+// - or not at all, in which case the printer simply never connects and the
+// failure is silent. A Bonjour browse for the service already declared in
+// NSBonjourServices is the documented way to trigger the prompt on demand; it
+// does not need to find anything, and the multicast entitlement is irrelevant
+// here because raising the prompt is the entire point.
+//
+// The browser is kept alive in a static and stopped a few seconds later: an
+// NSNetServiceBrowser released immediately can cancel the request before iOS
+// has put the alert on screen.
+void orca_ios_request_local_network_permission()
+{
+    static NSNetServiceBrowser *browser = nil;
+    if (browser != nil)
+        return; // once per launch
+
+    browser = [[NSNetServiceBrowser alloc] init];
+    [browser searchForServicesOfType:@"_bambulab._tcp" inDomain:@"local."];
+    BOOST_LOG_TRIVIAL(error) << "orca-ios-lan: asked for local network permission (_bambulab._tcp)";
+
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(6 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+        [browser stop];
+    });
+}
+
