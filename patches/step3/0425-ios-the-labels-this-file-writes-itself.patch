+// The labels this file writes itself.
+//
+// Everything else it shows arrives already translated from the C++ side -
+// tab titles, tooltips, the two entries under the plus - because _L() is not
+// reachable from here. These few are ours, and _L(s) is only
+// wxGetTranslation(wxString(s, wxConvUTF8)), which is reachable, so they go
+// through the same catalogue as the rest of the interface. Their msgids are
+// carried in orca-overlay/localization/i18n/de/OrcaSlicer_de.po; an msgid the
+// catalogue does not have comes back unchanged, and that is the English.
+static NSString *orca_ios_tr(const char *s)
+{
+    const wxString t = wxGetTranslation(wxString(s, wxConvUTF8));
+    return [NSString stringWithUTF8String:t.utf8_str().data()];
+}
