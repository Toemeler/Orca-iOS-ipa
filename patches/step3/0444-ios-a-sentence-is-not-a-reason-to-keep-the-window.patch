+// The text a subclass added directly to the dialog, in the order the children
+// are in - which is the order they were created in, and so the order they read
+// in on the desktop.
+wxString MsgDialog::orca_ios_extra_text() const
+{
+    wxString out;
+
+    for (wxWindow *const child : GetChildren()) {
+        if (orca_ios_known_child(child))
+            continue;
+
+        const wxStaticText *const text = wxDynamicCast(child, wxStaticText);
+        if (text == nullptr)
+            continue;
+
+        const wxString label = text->GetLabel();
+        if (label.IsEmpty())
+            continue;
+
+        if (!out.IsEmpty())
+            out += "\n\n";
+        out += label;
+    }
+
+    return out;
+}
